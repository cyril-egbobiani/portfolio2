---
import Layout from '../components/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ContactSection from '../components/ContactSection.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import '../styles.css';

const interests = [
  {
    title: 'Photography',
    subtitle: 'Street & portraiture',
    image: 'https://images.unsplash.com/photo-1542038784456-1ea8e935640e?auto=format&fit=crop&w=600&q=80',
    tag: 'Visuals',
  },
  {
    title: 'Football',
    subtitle: 'Tactics & matchdays',
    image: 'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=600&q=80',
    tag: 'Sport',
  },
  {
    title: 'Cooking',
    subtitle: 'Culinary experiments',
    image: 'https://images.unsplash.com/photo-1556910103-1c02745aae4d?auto=format&fit=crop&w=600&q=80',
    tag: 'Craft',
  },
  {
    title: 'Cars',
    subtitle: 'Automotive design',
    image: 'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=600&q=80',
    tag: 'Engineering',
  },
];
---

<Layout title="Profile | Cyril Egbobiani">
  <main class="min-h-screen bg-[var(--surface)] px-4 pt-8 sm:pt-12 pb-24 font-[var(--font-sans)] text-[var(--text-primary)] sm:px-6">
    <div class="mx-auto flex w-full max-w-[660px] flex-col gap-8">

      <!-- Top Row: Back Button (Left) & Theme Toggle (Right) -->
      <nav class="flex w-full items-center justify-between" aria-label="Profile navigation">
        <a
          href="/"
          class="profile-standalone-back-btn group flex size-9 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface-subtle)] text-[var(--text-muted)] transition-all duration-200 ease-[var(--ease-smooth-out)] hover:border-[var(--border-default)] hover:text-[var(--text-primary)]"
          aria-label="Back to home"
        >
          <svg class="size-4 opacity-70 transition-transform duration-200 group-hover:-translate-x-0.5 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </a>

        <ThemeToggle />
      </nav>

      <!-- Main Profile Column with Staggered Motion Entrance -->
      <div class="t-stagger flex flex-col gap-14">

        <!-- 1. Hero Framed Photo Banner -->
        <section class="t-stagger-line t-stagger-line--1 group relative overflow-hidden rounded-[8px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] transition-all duration-300 ease-[var(--ease-smooth-out)]">
          <img
            src="https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?auto=format&fit=crop&w=1200&q=80"
            alt="Cyril Egbobiani"
            class="h-[280px] w-full object-cover object-center transition-transform duration-700 ease-[var(--ease-smooth-out)] group-hover:scale-[1.02] sm:h-[340px]"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[rgba(13,13,13,0.7)] via-transparent to-transparent opacity-80"></div>
         
        </section>

        <!-- 2. Editorial Narrative Statement -->
        <section class="t-stagger-line t-stagger-line--2 flex flex-col gap-5">
          <h1 class="m-0 font-display text-2xl sm:text-3xl font-normal leading-[1.25] tracking-[-0.04em] text-[var(--text-primary)]">
            Design curiosity came first. Code gave it a way to become <span class="italic font-normal text-[var(--text-primary)]">more</span> useful.
          </h1>
          <p class="m-0 text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            I've always liked making things, pulling them apart, and understanding why they work. That started with sketching, physical objects, and small experiments. Software made that curiosity feel bigger because the idea, interaction, and final experience can all live in the same medium.
          </p>
        </section>

        <!-- Hair-Line Separator (Benji.org Cadence) -->
        <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

        <!-- 3. Interests Section (Unified Design System Skin) -->
        <section class="t-stagger-line t-stagger-line--3 flex flex-col gap-6">
          <div class="flex items-center">
            <h2 class="m-0 font-sans text-sm sm:text-base font-normal tracking-tight text-[var(--text-muted)]">
              Beyond code & design
            </h2>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {interests.map((item) => (
              <div class="interest-card group relative flex h-[110px] w-full overflow-hidden rounded-[12px] bg-[var(--surface-subtle)] p-4 transition-all duration-300 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)]">
                
                <!-- Left Details -->
                <div class="z-10 flex flex-col justify-between pr-4">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">
                    {item.tag}
                  </span>
                  <div class="flex flex-col">
                    <span class="font-display text-lg font-normal tracking-[-0.03em] text-[var(--text-primary)]">
                      {item.title}
                    </span>
                    <span class="text-xs text-[var(--text-muted)] font-sans">
                      {item.subtitle}
                    </span>
                  </div>
                </div>

                <!-- Right Thumbnail Image (Masked Split View) -->
                <div class="absolute right-0 top-0 bottom-0 h-full w-[42%] overflow-hidden">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="h-full w-full object-cover object-center grayscale contrast-[1.05] opacity-60 transition-all duration-500 ease-[var(--ease-smooth-out)] group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105"
                    loading="lazy"
                  />
                  <!-- Gradient Blend to Surface -->
                  <div class="absolute inset-0 bg-gradient-to-r from-[var(--surface-subtle)] via-transparent to-transparent group-hover:from-[var(--surface-interactive)]"></div>
                </div>

              </div>
            ))}
          </div>
        </section>

        <!-- Hair-Line Separator -->
        <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

        <!-- 4. Contact Section -->
        <div class="t-stagger-line t-stagger-line--4">
          <ContactSection />
        </div>

        <!-- 5. Footer Stamp -->
        <PortfolioFooter />

      </div>

    </div>
  </main>
</Layout>

<style>
  /* Kinetic Micro-Interactions matching Home Design Language */
  .profile-standalone-back-btn:active {
    transform: scale(0.95);
  }

  @media (hover: hover) and (pointer: fine) {
    .interest-card:hover {
      transform: translateY(-2px) scale(1.015);
    }
  }

  .interest-card:active {
    transform: scale(0.97);
  }
</style>

<script>
  // Stagger reveal animation matching Home intro
  const block = document.querySelector<HTMLElement>('.t-stagger');
  if (block) {
    requestAnimationFrame(() => {
      block.classList.add('is-shown');
    });
  }
</script>
