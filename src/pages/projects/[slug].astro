---
import Layout from '../../components/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import PortfolioFooter from '../../components/PortfolioFooter.astro';
import { projects, type ProjectData } from '../../data/projects';
import '../../styles.css';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: ProjectData };
---

<Layout title={`${project.title} — Case Study | Cyril Egbobiani`} description={project.description}>
  <main class="min-h-screen bg-[var(--surface)] px-4 pt-8 sm:pt-12 pb-24 font-[var(--font-sans)] text-[var(--text-primary)] sm:px-6">
    <div class="mx-auto flex w-full max-w-[660px] flex-col gap-12">

      <!-- ── Top Nav: Breadcrumb (Left) + Theme Toggle (Right) ── -->
      <nav class="project-nav flex w-full items-center justify-between" aria-label="Project navigation">
        <a
          href="/#projects"
          class="back-link group inline-flex items-center gap-2 text-[13px] font-medium text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]"
          aria-label="Back to all projects"
        >
          <span class="inline-flex size-6 items-center justify-center rounded-full bg-[var(--surface-subtle)] text-[var(--text-muted)] transition-[transform,background-color,color] duration-160 ease-[var(--ease-smooth-out)] group-hover:-translate-x-0.5 group-hover:bg-[var(--surface-interactive)] group-hover:text-[var(--text-primary)]">
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6" />
            </svg>
          </span>
          <span class="tracking-tight">Work</span>
          <span class="text-[var(--text-faint)] font-mono">/</span>
          <span class="text-[var(--text-secondary)] font-normal truncate max-w-[160px] sm:max-w-none">{project.title}</span>
        </a>

        <div class="flex items-center">
          <ThemeToggle />
        </div>
      </nav>

      <!-- ── Main Case Study Article with Staggered Entrance ── -->
      <article class="t-stagger flex flex-col gap-16 sm:gap-20">

        <!-- 1. Hero Title & Premise -->
        <header class="t-stagger-line t-stagger-line--1 flex flex-col gap-5">
          <h1 class="project-headline m-0 text-[32px] sm:text-[40px] font-semibold leading-[1.15] tracking-[-0.04em] text-[var(--text-primary)] text-wrap">
            {project.title}
          </h1>

          <p class="m-0 text-[16.5px] sm:text-[18px] leading-[1.65] text-[var(--text-secondary)] font-normal w-full">
            {project.description}
          </p>

          <!-- Editorial Specs Metadata Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 sm:pt-8 border-t border-[var(--border-subtle)] mt-4">
            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--text-muted)] font-medium">Role</span>
              <span class="font-sans text-[14px] sm:text-[14.5px] font-medium text-[var(--text-primary)] leading-snug">{project.role}</span>
            </div>

            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--text-muted)] font-medium">Timeline</span>
              <span class="font-mono tabular-nums text-[13.5px] font-medium text-[var(--text-primary)]">{project.year}</span>
            </div>

            <div class="flex flex-col gap-1.5">
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--text-muted)] font-medium">Category</span>
              <span class="font-mono text-[13.5px] font-medium text-[var(--text-primary)]">{project.category}</span>
            </div>
          </div>
        </header>

        <!-- 2. Responsive Hero Media Showcase (Clean Minimal Device Frame) -->
        <section class="t-stagger-line t-stagger-line--2">
          {project.heroMedia && project.heroMedia.device === 'phone' && (
            <div class="phone-frame group relative mx-auto max-w-[280px] sm:max-w-[320px] overflow-hidden rounded-[16px] border border-[var(--border-subtle)] transition-transform duration-250 ease-[var(--ease-smooth-out)] hover:-translate-y-1">
              <div class="relative w-full overflow-hidden flex items-center justify-center">
                {project.heroMedia.type === 'video' ? (
                  <video
                    src={project.heroMedia.src}
                    poster={project.heroMedia.poster}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-auto block object-contain"
                  ></video>
                ) : (
                  <img
                    src={project.heroMedia.src}
                    alt={project.heroMedia.alt}
                    class="w-full h-auto block object-contain"
                  />
                )}
              </div>
            </div>
          )}

          {project.heroMedia && project.heroMedia.device === 'desktop' && (
            <div class="desktop-frame group relative overflow-hidden rounded-[12px] border border-[var(--border-subtle)] transition-transform duration-250 ease-[var(--ease-smooth-out)] hover:-translate-y-1">
              <div class="relative aspect-[16/10] w-full overflow-hidden flex items-center justify-center">
                {project.heroMedia.type === 'video' ? (
                  <video
                    src={project.heroMedia.src}
                    poster={project.heroMedia.poster}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-contain"
                  ></video>
                ) : (
                  <img
                    src={project.heroMedia.src}
                    alt={project.heroMedia.alt}
                    class="w-full h-full object-contain"
                  />
                )}
              </div>
            </div>
          )}

          {!project.heroMedia && (
            <div class="hero-frame group relative overflow-hidden rounded-[12px] border border-[var(--border-subtle)]">
              <div
                class={`shot shot--${project.tone} relative aspect-[16/10] sm:aspect-[2.1/1] w-full overflow-hidden rounded-[8px] flex items-center justify-center cursor-zoom-in`}
                data-spring-zoom-trigger
                data-zoom-src={`#shot-${project.slug}`}
              >
                <div class="shot-inner-banner flex flex-col items-center gap-2 select-none">
                  <span class="shot-title font-mono text-[13px] font-medium tracking-wide uppercase text-[var(--text-secondary)] opacity-90">
                    {project.title}
                  </span>
                  <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-[var(--text-faint)]">
                    preview · {project.role}
                  </span>
                </div>
              </div>
            </div>
          )}
        </section>

        <!-- 3. Open Editorial Reasoning Narrative -->
        <section class="t-stagger-line t-stagger-line--3 reasoning-block flex flex-col gap-8 py-4 sm:py-6">
          <div class="reasoning-row flex flex-col gap-3">
            <span class="hand-label">the problem</span>
            <p class="m-0 text-[15.5px] sm:text-[16.5px] leading-[1.7] text-[var(--text-secondary)]">
              {project.problem}
            </p>
          </div>

          <svg class="mark-arrow" viewBox="0 0 64 26" fill="none" aria-hidden="true">
            <path d="M3 4c15-1.5 29 4 40 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M35 18.5l9.5 1-3-8.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>

          <div class="reasoning-row flex flex-col gap-3">
            <span class="hand-label">what I decided</span>
            <p class="m-0 text-[15.5px] sm:text-[16.5px] leading-[1.7] text-[var(--text-secondary)]">
              {project.decided}
            </p>
          </div>
        </section>

        <!-- 4. Interactive Phone & Desktop Showcase Gallery (Constant 2-Column Grid) -->
        {project.mediaGallery && project.mediaGallery.length > 0 && (
          <section class="t-stagger-line t-stagger-line--3 flex flex-col gap-6 py-8 sm:py-12 border-t border-[var(--border-subtle)]">
            <h2 class="m-0 font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
              Interface & Motion Showcase
            </h2>

            <div class="grid grid-cols-2 gap-6 sm:gap-10 items-start">
              {project.mediaGallery.map((item) => (
                <div class="showcase-card group flex flex-col gap-3">
                  <div
                    class="relative w-full cursor-zoom-in overflow-hidden rounded-[14px] sm:rounded-[18px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] transition-[transform,border-color,background-color] duration-200 ease-[var(--ease-smooth-out)] hover:-translate-y-1 hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
                    data-spring-zoom-trigger
                  >
                    {item.type === 'video' ? (
                      <video
                        src={item.src}
                        poster={item.poster}
                        autoplay
                        loop
                        muted
                        playsinline
                        class="w-full h-auto block object-contain pointer-events-none"
                      ></video>
                    ) : (
                      <img
                        src={item.src}
                        alt={item.alt}
                        class="w-full h-auto block object-contain pointer-events-none select-none"
                      />
                    )}
                  </div>
                  {item.caption && (
                    <span class="font-mono text-[11px] sm:text-[12px] text-[var(--text-muted)] text-center pt-1 leading-tight">{item.caption}</span>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- 5. Ecosystem System Architecture Breakdown (If present) -->
        {project.architecture && (
          <section class="t-stagger-line t-stagger-line--3 flex flex-col gap-5 py-2">
            <h2 class="m-0 font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
              System Architecture & 3-Tier Ecosystem
            </h2>
            <div class="flex flex-col gap-4">
              {project.architecture.map((arch) => (
                <div class="flex flex-col gap-1.5 py-2 border-b border-[var(--border-subtle)] last:border-0">
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-xs font-semibold text-[var(--text-muted)]">{arch.num}</span>
                    <h3 class="m-0 font-sans text-[15px] font-semibold text-[var(--text-primary)]">{arch.name}</h3>
                  </div>
                  <p class="m-0 pl-7 font-sans text-[14px] leading-relaxed text-[var(--text-secondary)]">
                    {arch.desc}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- 6. Technologies & Architecture (Open layout) -->
        <section class="t-stagger-line t-stagger-line--3 flex flex-col gap-3 py-2">
          <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-medium">
            Full Tech Stack Matrix
          </span>
          <div class="flex flex-wrap gap-2">
            {project.stack.map((item) => (
              <span class="stack-badge inline-flex items-center rounded-[6px] bg-[var(--surface-subtle)] px-3 py-1.5 text-[12.5px] font-mono text-[var(--text-secondary)] transition-colors hover:bg-[var(--surface-interactive)] hover:text-[var(--text-primary)]">
                {item}
              </span>
            ))}
          </div>

          <!-- External Live Link CTA if present -->
          {project.link && (
            <div class="pt-3">
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-link inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)] border-b border-[var(--text-primary)] pb-0.5 transition-colors hover:border-[var(--text-muted)] hover:text-[var(--text-muted)] active:opacity-70"
              >
                <span>Visit Live Project</span>
                <svg class="size-3 transition-transform duration-160 ease-[var(--ease-smooth-out)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 18l6-6-6-6" />
                </svg>
              </a>
            </div>
          )}
        </section>

        <!-- 7. Key Engineering & Design Highlights -->
        {project.highlights && project.highlights.length > 0 && (
          <section class="t-stagger-line t-stagger-line--4 flex flex-col gap-4 py-2">
            <h2 class="m-0 font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
              Engineering & Design Accomplishments
            </h2>
            <div class="flex flex-col gap-4">
              {project.highlights.map((item, idx) => (
                <div class="flex items-start gap-4 py-1">
                  <span class="font-mono text-xs font-semibold text-[var(--text-muted)] pt-0.5 shrink-0">0{idx + 1}</span>
                  <span class="font-sans text-[14.5px] leading-relaxed text-[var(--text-secondary)]">{item}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- 8. Next Case Study Showcase Card (Interactive Footer CTA) -->
        <footer class="t-stagger-line t-stagger-line--4 flex flex-col gap-4 pt-6">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">Up Next</span>
            <a href="/#projects" class="group inline-flex items-center gap-1.5 font-mono text-xs text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)] no-underline">
              <span>Back to all projects</span>
              <svg class="size-3 transition-transform duration-160 ease-[var(--ease-smooth-out)] group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </a>
          </div>

          <a
            href={`/projects/${project.nextSlug}`}
            class="next-card group flex items-center justify-between gap-4 rounded-[12px] bg-[var(--surface-subtle)] p-4 sm:p-5 no-underline transition-[background-color,transform] duration-200 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)] hover:-translate-y-0.5 active:scale-[0.985]"
          >
            <div class="flex items-center gap-4 min-w-0">
              <div class={`mini-shot shot--${project.nextTone} size-12 shrink-0 rounded-[6px]`}></div>
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-medium">
                  Next Case Study
                </span>
                <span class="font-sans text-[17px] sm:text-[18px] font-semibold tracking-tight text-[var(--text-primary)] truncate">
                  {project.nextTitle}
                </span>
              </div>
            </div>

            <!-- Tactile Chevron Button -->
            <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--surface)] text-[var(--text-muted)] transition-[color,transform] duration-160 ease-[var(--ease-smooth-out)] group-hover:text-[var(--text-primary)] group-hover:translate-x-0.5">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </div>
          </a>
        </footer>

      </article>

      <PortfolioFooter />

    </div>
  </main>
</Layout>

<!-- Fullscreen Spring Zoom Backdrop -->
<div
  id="spring-zoom-backdrop"
  class="spring-zoom-backdrop fixed inset-0 z-40 bg-[rgba(13,13,13,0.92)] backdrop-blur-md transition-opacity duration-260 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<style>
  /* ── Screenshots & Gradients ── */
  .shot {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shot--a { background: linear-gradient(148deg, #2b3350 0%, #1a1e30 62%, #141726 100%); }
  .shot--b { background: linear-gradient(148deg, #2d3a34 0%, #1b2420 62%, #151b18 100%); }
  .shot--c { background: linear-gradient(148deg, #3a2b33 0%, #241a20 62%, #1a1318 100%); }
  .shot--d { background: linear-gradient(148deg, #33302a 0%, #211f1b 62%, #181713 100%); }

  :global([data-theme='light']) .shot--a { background: linear-gradient(148deg, #dfe4f2 0%, #eef1f8 100%); }
  :global([data-theme='light']) .shot--b { background: linear-gradient(148deg, #dfeae4 0%, #eff5f1 100%); }
  :global([data-theme='light']) .shot--c { background: linear-gradient(148deg, #f0e2e8 0%, #f8eff3 100%); }
  :global([data-theme='light']) .shot--d { background: linear-gradient(148deg, #efeae0 0%, #f7f4ee 100%); }

  /* ── Handwritten Reasoning Annotations ── */
  .hand-label {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--text-secondary);
    line-height: 1.2;
  }

  .mark-arrow {
    display: block;
    width: 54px;
    height: 22px;
    margin: 2px 0 2px 12px;
    color: var(--text-muted);
    opacity: 0.8;
  }

  /* ── Staggered Entrance Animations ── */
  .t-stagger-line {
    opacity: 0;
    transform: translateY(var(--stagger-distance, 12px));
    filter: blur(var(--stagger-blur, 3px));
    transition:
      opacity var(--stagger-dur, 500ms) var(--stagger-ease, cubic-bezier(0.23, 1, 0.32, 1)),
      transform var(--stagger-dur, 500ms) var(--stagger-ease, cubic-bezier(0.23, 1, 0.32, 1)),
      filter var(--stagger-dur, 500ms) var(--stagger-ease, cubic-bezier(0.23, 1, 0.32, 1));
    will-change: transform, opacity, filter;
  }

  .t-stagger-line--1 { transition-delay: 0ms; }
  .t-stagger-line--2 { transition-delay: 50ms; }
  .t-stagger-line--3 { transition-delay: 100ms; }
  .t-stagger-line--4 { transition-delay: 150ms; }

  .t-stagger.is-shown .t-stagger-line {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* ── Zoom Backdrop ── */
  .spring-zoom-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-stagger-line {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Play staggered entrance animation immediately on render
  const block = document.querySelector<HTMLElement>('.t-stagger');
  if (block) {
    requestAnimationFrame(() => {
      block.classList.add('is-shown');
    });
  }

  // ── Spring Physics Zoom & Retract Lightbox for Showcase Images ──
  const SPRING = 'cubic-bezier(0.23, 1, 0.32, 1)';
  const backdrop = document.getElementById('spring-zoom-backdrop');
  const triggers = document.querySelectorAll<HTMLElement>('[data-spring-zoom-trigger]');

  let activeClone: HTMLElement | null = null;
  let activeSource: HTMLElement | null = null;
  let isZoomed = false;

  function retract() {
    if (!isZoomed || !activeClone || !activeSource) return;
    isZoomed = false;
    backdrop?.classList.remove('is-active');

    activeClone.style.transition = `transform 320ms ${SPRING}, opacity 260ms ease-out`;
    activeClone.style.transform = 'translate3d(0,0,0) scale(1)';
    activeClone.style.opacity = '0';

    const sourceEl = activeSource;
    setTimeout(() => {
      activeClone?.remove();
      activeClone = null;
      if (sourceEl) sourceEl.style.opacity = '1';
      activeSource = null;
      document.body.style.overflow = '';
    }, 320);
  }

  triggers.forEach((tile) => {
    tile.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isZoomed) {
        retract();
        return;
      }

      const rect = tile.getBoundingClientRect();
      const clone = tile.cloneNode(true) as HTMLElement;

      clone.classList.add('spring-zoom-clone');
      clone.style.position = 'fixed';
      clone.style.zIndex = '1000';
      clone.style.top = `${rect.top}px`;
      clone.style.left = `${rect.left}px`;
      clone.style.width = `${rect.width}px`;
      clone.style.height = `${rect.height}px`;
      clone.style.margin = '0';
      clone.style.pointerEvents = 'auto';
      clone.style.cursor = 'zoom-out';
      document.body.appendChild(clone);

      activeClone = clone;
      activeSource = tile;
      tile.style.opacity = '0';
      isZoomed = true;

      backdrop?.classList.add('is-active');
      document.body.style.overflow = 'hidden';

      const maxW = Math.min(window.innerWidth * 0.9, 1000);
      const maxH = Math.min(window.innerHeight * 0.88, 900);
      let targetW = maxW;
      let targetH = maxW * (rect.height / rect.width);
      if (targetH > maxH) {
        targetH = maxH;
        targetW = maxH * (rect.width / rect.height);
      }

      const scale = targetW / rect.width;
      // Center the zoomed clone precisely at window center (50% 50%)
      const translateX = (window.innerWidth / 2) - (rect.left + rect.width / 2);
      const translateY = (window.innerHeight / 2) - (rect.top + rect.height / 2);

      requestAnimationFrame(() => {
        clone.style.transition = `transform 420ms ${SPRING}`;
        clone.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
      });

      clone.addEventListener('click', retract);
    });
  });

  backdrop?.addEventListener('click', retract);

  // Keyboard navigation & Escape key retract
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isZoomed) {
      retract();
      return;
    }

    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    
    if (e.key === 'ArrowRight') {
      const nextCard = document.querySelector<HTMLAnchorElement>('.next-card');
      if (nextCard && nextCard.href) {
        window.location.href = nextCard.href;
      }
    } else if (e.key === 'ArrowLeft') {
      const backLink = document.querySelector<HTMLAnchorElement>('.back-link');
      if (backLink && backLink.href) {
        window.location.href = backLink.href;
      }
    }
  });
</script>
