---
import Layout from '../../components/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import PortfolioFooter from '../../components/PortfolioFooter.astro';
import '../../styles.css';

export function getStaticPaths() {
  // NOTE: slugs must stay in sync with src/components/ProjectsSection.astro
  // `role`, `year` and `stack` are placeholders pending confirmation.
  const projects = [
    {
      slug: 'forge',
      title: 'Forge',
      category: 'Builds',
      tone: 'a',
      year: '2026',
      role: 'Design & Development',
      stack: ['React Native', 'Expo', 'TypeScript'],
      description: 'A spiritual app for kids — games, teachings, devotions and a church prayer wall.',
      longDescription:
        'Most faith apps for kids are a wall of text and good intentions. Forge teaches through games and short devotions instead of reading. It also carries a prayer section that surfaces the prayer chat from your own church — because when someone asks you to pray for a person, you usually have no idea what you are actually praying about.',
      highlights: [
        'Teaching delivered through games and short devotions rather than long reading.',
        'Prayer wall shows your own church prayer chat, so prayer has real context.',
        'Devotions and teachings structured for a young attention span.',
      ],
      gallery: [],
      link: '',
      nextSlug: '9to5er',
      nextTitle: '9to5er',
    },
    {
      slug: '9to5er',
      title: '9to5er',
      category: 'Builds',
      tone: 'b',
      year: '2026',
      role: 'Design & Development',
      stack: ['Astro', 'TypeScript', 'Postgres'],
      description: 'Deep-dives on agencies, for people about to join one.',
      longDescription:
        'Joining a new agency you are mostly guessing — what they really do, how they work, how organised they actually are. You can ask a general chatbot and get a confident summary of nothing. 9to5er goes narrow instead: structured breakdowns of specific agencies, their workflow and their structure. Being genuinely useful about a small thing beats being vague about everything.',
      highlights: [
        'Structured agency breakdowns covering workflow, structure and how teams operate.',
        'Deliberately narrow and accountable rather than a general answer engine.',
        'Built for people entering the field or moving between agencies.',
      ],
      gallery: [],
      link: '',
      nextSlug: 'token-extractor',
      nextTitle: 'Token Extractor',
    },
    {
      slug: 'token-extractor',
      title: 'Token Extractor',
      category: 'Builds',
      tone: 'd',
      year: '2024',
      role: 'Design & Development',
      stack: ['TypeScript', 'Browser Extension', 'Monorepo'],
      description: 'A browser extension that pulls the real design tokens off any page.',
      longDescription:
        'Rebuilding someone else’s design language usually means eyedropping it one hex code at a time. This extension scans a page and extracts the actual design tokens — colours, shadows, text colours. It was my first proper build, and shipping it as multiple packages is how I learned to work with monorepos.',
      highlights: [
        'Extracts colours, shadows and text styles directly from any live page.',
        'First project I shipped, and where I learned monorepo tooling.',
      ],
      gallery: [],
      link: '',
      nextSlug: 'model-portfolio',
      nextTitle: 'Model Portfolio',
    },
    {
      slug: 'model-portfolio',
      title: 'Model Portfolio',
      category: 'Designs',
      tone: 'c',
      year: '2025',
      role: 'Design & Development',
      stack: ['Astro', 'TypeScript', 'CSS'],
      description: 'A site for a friend who models, built around her distinct style sets.',
      longDescription:
        'A model is judged on the same thing the portfolio is — how it looks. Template portfolio sites flatten everyone into one identical grid. This one is organised around her distinct style sets rather than a single uniform gallery, so the range itself becomes the point.',
      highlights: [
        'Organised around distinct style sets instead of one flat gallery.',
        'Layout built so range and variety read immediately.',
      ],
      gallery: [],
      link: '',
      nextSlug: 'forge',
      nextTitle: 'Forge',
    },
  ];

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Cyril Egbobiani`}>
  <main class="min-h-screen bg-[var(--surface)] px-4 pt-8 sm:pt-12 pb-24 font-[var(--font-sans)] text-[var(--text-primary)] sm:px-6">
    <div class="mx-auto flex w-full max-w-[660px] flex-col gap-10">

      <!-- Top Row: Back Button (Left) & Theme Toggle (Right) -->
      <nav class="flex w-full items-center justify-between" aria-label="Project navigation">
        <a
          href="/#projects"
          class="group inline-flex size-9 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface)] text-[var(--text-muted)] no-underline transition-[transform,border-color,background-color,color] duration-200 ease-[var(--ease-smooth-out)] hover:-translate-y-[2px] hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)] hover:text-[var(--text-primary)] active:scale-[0.92]"
          aria-label="Back to work section"
        >
          <svg class="size-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </a>

        <ThemeToggle />
      </nav>

      <!-- Main Project Description Content with Staggered Entrance -->
      <article class="t-stagger flex flex-col gap-10">

        <!-- 1. Project Title & High-Level Summary -->
        <header class="t-stagger-line t-stagger-line--1 flex flex-col gap-3">
          <h1 class="m-0 font-sans text-[28px] font-medium leading-[1.2] tracking-[-0.035em] text-[var(--text-primary)]">
            {project.title}
          </h1>

          <p class="m-0 font-sans text-[15.5px] sm:text-[16px] leading-[1.68] text-[var(--text-secondary)] font-normal">
            {project.description}
          </p>
        </header>

        <!-- 2. Architectural Spec-Sheet Table & Editorial Link -->
        <section class="t-stagger-line t-stagger-line--2 flex flex-col gap-5">
          <!-- Spec Table -->
          <div class="flex flex-col border-y border-[var(--border-subtle)] divide-y divide-[var(--border-subtle)]">
            <!-- Row: Role -->
            <div class="flex items-center justify-between py-2.5 text-xs">
              <span class="flex items-center gap-2 font-mono uppercase tracking-wider text-[var(--text-muted)] font-medium">
                Role
              </span>
              <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-primary)]">
                {project.role}
              </span>
            </div>

            <!-- Row: Timeline -->
            <div class="flex items-center justify-between py-2.5 text-xs">
              <span class="flex items-center gap-2 font-mono uppercase tracking-wider text-[var(--text-muted)] font-medium">
                Timeline
              </span>
              <span class="font-mono tabular-nums text-xs font-medium uppercase tracking-wider text-[var(--text-primary)]">
                {project.year}
              </span>
            </div>

            <!-- Row: Tech Stack -->
            {project.stack && project.stack.length > 0 && (
              <div class="flex items-center justify-between py-2.5 text-xs gap-4">
                <span class="flex items-center gap-2 shrink-0 font-mono uppercase tracking-wider text-[var(--text-muted)] font-medium">
                  Tech Stack
                </span>
                <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-primary)] text-right">
                  {project.stack.join(', ')}
                </span>
              </div>
            )}

            <!-- Row: Category -->
            <div class="flex items-center justify-between py-2.5 text-xs">
              <span class="flex items-center gap-2 font-mono uppercase tracking-wider text-[var(--text-muted)] font-medium">
                Category
              </span>
              <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-primary)]">
                {project.category}
              </span>
            </div>
          </div>

          <!-- Editorial Underlined CTA Link — only when there is somewhere to go -->
          {project.link && (
            <div class="pt-1">
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)] border-b border-[var(--text-primary)] pb-0.5 transition-colors duration-200 hover:border-[var(--text-muted)] hover:text-[var(--text-muted)] active:opacity-70"
              >
                <span>View Full Project</span>
                <span class="inline-block transition-transform duration-200 ease-[var(--ease-smooth-out)] group-hover:translate-x-1">→</span>
              </a>
            </div>
          )}
        </section>

        <!-- 3. Hero Framed Preview Banner -->
        <section class="t-stagger-line t-stagger-line--2 group relative overflow-hidden rounded-[8px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-1.5 transition-[border-color] duration-300 ease-[var(--ease-smooth-out)]">
          {project.image ? (
            <div
              class="relative aspect-[16/9] sm:aspect-[2.1/1] w-full overflow-hidden rounded-[6px] bg-[var(--surface-interactive)] cursor-zoom-in"
              data-spring-zoom-trigger
              data-zoom-src={project.image}
            >
              <img
                src={project.image}
                alt={project.title}
                class="h-full w-full object-cover object-center contrast-[1.02] opacity-95 transition-transform duration-700 ease-[var(--ease-smooth-out)] group-hover:scale-[1.015]"
                loading="eager"
              />
            </div>
          ) : (
            <div class={`shot shot--${project.tone} relative aspect-[16/9] sm:aspect-[2.1/1] w-full overflow-hidden rounded-[6px] flex items-center justify-center`}>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-[var(--text-faint)]">screenshot</span>
            </div>
          )}
        </section>

        <!-- Hair-Line Separator -->
        <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

        <!-- 4. Deep-Dive Case Study Narrative & Key Highlights -->
        <section class="t-stagger-line t-stagger-line--3 flex flex-col gap-6">
          <div class="flex flex-col gap-3">
            <h2 class="m-0 font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
              Overview & Architecture
            </h2>
            <p class="m-0 font-sans text-[15.5px] sm:text-[16px] leading-[1.68] text-[var(--text-secondary)] font-normal">
              {project.longDescription}
            </p>
          </div>

          <!-- Key Deliverables & Technical Highlights -->
          {project.highlights && project.highlights.length > 0 && (
            <div class="flex flex-col gap-3 pt-2">
              <h3 class="m-0 font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
                Key Highlights
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {project.highlights.map((item, idx) => (
                  <div class="flex flex-col gap-2 rounded-[6px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-3.5 transition-colors duration-200 hover:border-[var(--border-default)]">
                    <span class="font-mono text-xs font-medium text-[var(--text-muted)]">0{idx + 1}</span>
                    <span class="font-sans text-[13.5px] sm:text-[14px] leading-relaxed text-[var(--text-secondary)]">{item}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>

        <!-- 5. Visual Gallery (Zoomable Framed Media Containers) -->
        {project.gallery && project.gallery.length > 0 && (
          <section class="t-stagger-line t-stagger-line--4 flex flex-col gap-4 pt-2">
            <h2 class="m-0 font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">
              Visual Gallery
            </h2>
            <div class="flex flex-col gap-6">
              {project.gallery.map((imgUrl) => (
                <div
                  class="relative aspect-[16/9] w-full overflow-hidden rounded-[8px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-1.5 cursor-zoom-in group"
                  data-spring-zoom-trigger
                  data-zoom-src={imgUrl}
                >
                  <div class="relative h-full w-full overflow-hidden rounded-[6px]">
                    <img
                      src={imgUrl}
                      alt={`${project.title} preview`}
                      class="h-full w-full object-cover object-center opacity-95 transition-transform duration-500 ease-[var(--ease-smooth-out)] group-hover:scale-[1.02]"
                      loading="lazy"
                    />
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Hair-Line Separator -->
        <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

        <!-- 6. Next Project Showcase Banner -->
        <footer class="t-stagger-line t-stagger-line--4 flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">UP NEXT</span>
            <a href="/#projects" class="font-mono text-xs text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]">
              Back to all projects ↗
            </a>
          </div>

          <a
            href={`/projects/${project.nextSlug}`}
            class="group flex items-center justify-between gap-4 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-4 sm:p-5 no-underline transition-[border-color,background-color,transform] duration-250 ease-[var(--ease-smooth-out)] hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)] active:scale-[0.985]"
          >
            <div class="flex flex-col gap-1">
              <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--text-muted)]">NEXT CASE STUDY</span>
              <span class="font-display text-lg sm:text-xl font-bold tracking-[-0.03em] text-[var(--text-primary)]">
                {project.nextTitle}
              </span>
            </div>

            <!-- Tactile Circular Arrow Button -->
            <div class="flex size-8 shrink-0 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface)] text-[var(--text-muted)] transition-[border-color,color,transform] duration-200 ease-[var(--ease-smooth-out)] group-hover:border-[var(--border-default)] group-hover:text-[var(--text-primary)] group-hover:translate-x-1">
              <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </div>
          </a>
        </footer>

      </article>

      <PortfolioFooter />

    </div>
  </main>
</Layout>

<!-- Fullscreen FLIP Spring Zoom Backdrop -->
<div
  id="spring-zoom-backdrop"
  class="spring-zoom-backdrop fixed inset-0 z-40 bg-[rgba(13,13,13,0.94)] backdrop-blur-md transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<style>
  .project-back-btn:active {
    transform: scale(0.95);
  }

  .spring-zoom-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  // Stagger reveal animation matching Home intro
  const block = document.querySelector<HTMLElement>('.t-stagger');
  if (block) {
    requestAnimationFrame(() => {
      block.classList.add('is-shown');
    });
  }

  // FLIP Spring Shared-Element Zoom & Retraction Engine
  const backdrop = document.getElementById('spring-zoom-backdrop');
  const zoomCards = document.querySelectorAll<HTMLElement>('[data-spring-zoom-trigger]');
  let activeClone: HTMLImageElement | null = null;
  let activeSourceEl: HTMLElement | null = null;
  let isZoomed = false;

  const retractZoom = () => {
    if (!activeClone || !activeSourceEl || !isZoomed) return;
    isZoomed = false;

    if (backdrop) backdrop.classList.remove('is-active');

    // Smooth spring retraction back to exact origin
    activeClone.style.transition = 'transform 380ms cubic-bezier(0.23, 1, 0.32, 1)';
    activeClone.style.transform = 'translate3d(0px, 0px, 0) scale(1)';

    const handleEnd = () => {
      if (activeSourceEl) activeSourceEl.style.opacity = '1';
      requestAnimationFrame(() => {
        if (activeClone && activeClone.parentNode) {
          activeClone.parentNode.removeChild(activeClone);
        }
        activeClone = null;
        activeSourceEl = null;
        document.body.style.overflow = '';
      });
    };

    activeClone.addEventListener('transitionend', handleEnd, { once: true });
  };

  zoomCards.forEach((card) => {
    card.addEventListener('click', () => {
      if (isZoomed) {
        retractZoom();
        return;
      }

      const imgEl = card.querySelector('img');
      const src = card.dataset.zoomSrc;
      if (!imgEl || !src) return;

      isZoomed = true;
      activeSourceEl = card;
      const sourceRect = imgEl.getBoundingClientRect();

      const clone = document.createElement('img');
      clone.src = src;
      clone.className = 'fixed z-50 shadow-2xl object-contain cursor-zoom-out select-none';
      clone.style.left = `${sourceRect.left}px`;
      clone.style.top = `${sourceRect.top}px`;
      clone.style.width = `${sourceRect.width}px`;
      clone.style.height = `${sourceRect.height}px`;
      clone.style.transformOrigin = 'top left';
      clone.style.willChange = 'transform';

      document.body.appendChild(clone);
      activeClone = clone;
      card.style.opacity = '0';

      if (backdrop) backdrop.classList.add('is-active');
      document.body.style.overflow = 'hidden';

      const maxW = Math.min(window.innerWidth * 0.9, 1200);
      const maxH = Math.min(window.innerHeight * 0.85, 900);
      
      let targetW = maxW;
      let targetH = maxW * (sourceRect.height / sourceRect.width);
      if (targetH > maxH) {
        targetH = maxH;
        targetW = maxH * (sourceRect.width / sourceRect.height);
      }

      const targetLeft = (window.innerWidth - targetW) / 2;
      const targetTop = (window.innerHeight - targetH) / 2;

      const scale = targetW / sourceRect.width;
      const translateX = targetLeft - sourceRect.left;
      const translateY = targetTop - sourceRect.top;

      void clone.offsetWidth;

      clone.style.transition = 'transform 420ms cubic-bezier(0.23, 1, 0.32, 1)';
      clone.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;

      clone.addEventListener('click', retractZoom);
    });
  });

  if (backdrop) backdrop.addEventListener('click', retractZoom);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isZoomed) {
      retractZoom();
    }
  });
</script>
