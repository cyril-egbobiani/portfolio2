      longDescription: 'Cybertron AI is an advanced agentic development environment designed for high-velocity software engineering. Built to bridge human intent with autonomous code generation, it features real-time canvas visualization, instant terminal command execution, and deep AST refactoring capabilities.',
      highlights: [
        'Built custom agent orchestration engine using TypeScript and Node.js.',
        'Designed high-contrast editorial UI inspired by benji.org and ana.sh.',
        'Implemented real-time WebSocket telemetry and subagent status streams.',
        'Optimized canvas rendering performance achieving steady 60fps animations.',
      ],
      image: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80',
      gallery: [
        'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1000&q=80',
        'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?auto=format&fit=crop&w=1000&q=80',
      ],
      link: 'https://github.com',
      nextSlug: 'stelar-studio',
      nextTitle: 'Stelar Studio',
    },
    {
      slug: 'stelar-studio',
      title: 'Stelar Studio',
      category: 'Builds',
      year: '2024',
      role: 'WebGL & Frontend Developer',
      stack: ['Astro', 'WebGL', 'Tailwind', 'Three.js'],
      description: 'High-performance WebGL canvas animation & interactive physics engine.',
      longDescription: 'Stelar Studio is an interactive WebGL canvas playground exploring fluid dynamics, particle simulations, and real-time GPU shaders for modern web applications.',
      highlights: [
        'Created custom GLSL fragment shaders for interactive noise and bloom.',
        'Integrated spring physics for smooth cursor distortion effects.',
        'Zero-dependency particle engine handling 50,000+ active particles.',
      ],
      image: 'https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?auto=format&fit=crop&w=1200&q=80',
      gallery: [
        'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1000&q=80',
      ],
      link: 'https://github.com',
      nextSlug: 'firstbank-mobile',
      nextTitle: 'FirstBank Mobile',
    },
    {
      slug: 'firstbank-mobile',
      title: 'FirstBank Mobile',
      category: 'Builds',
      year: '2024',
      role: 'Mobile Developer Intern',
      stack: ['React Native', 'TypeScript', 'Design System'],
      description: 'Fintech mobile banking application redesign & design system.',
      longDescription: 'A comprehensive mobile banking experience refactor focused on biometric authentication security, instant fund transfers, and accessibility compliance for millions of active users.',
      highlights: [
        'Redesigned core account dashboard and transfer checkout flows.',
        'Architected cross-platform React Native design system components.',
        'Improved app cold start performance by 35%.',
      ],
      image: 'https://images.unsplash.com/photo-1559526324-4b87b5e36e44?auto=format&fit=crop&w=1200&q=80',
      gallery: [
        'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1000&q=80',
      ],
      link: 'https://github.com',
      nextSlug: 'nova-design-system',
      nextTitle: 'Nova Design System',
    },
    {
      slug: 'nova-design-system',
