const { project } = Astro.props;
---

<Layout title={`${project.title} | Cyril Egbobiani`}>
  <main class="min-h-screen bg-[var(--surface)] px-4 pt-8 sm:pt-12 pb-24 font-[var(--font-sans)] text-[var(--text-primary)] sm:px-6">
    <div class="mx-auto flex w-full max-w-[660px] flex-col gap-10">

      <!-- Top Row: Back Button (Left) & Theme Toggle (Right) -->
      <nav class="flex w-full items-center justify-between" aria-label="Project navigation">
        <a
          href="/#projects"
          class="project-back-btn group flex size-9 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface-subtle)] text-[var(--text-muted)] transition-all duration-200 ease-[var(--ease-smooth-out)] hover:border-[var(--border-default)] hover:text-[var(--text-primary)]"
          aria-label="Back to work section"
        >
          <svg class="size-4 opacity-70 transition-transform duration-200 group-hover:-translate-x-0.5 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </a>

        <ThemeToggle />
      </nav>

      <!-- Main Project Description Content with Staggered Entrance -->
      <article class="t-stagger flex flex-col gap-10">

        <!-- 1. Hero Framed Preview Banner -->
        <header class="t-stagger-line t-stagger-line--1 group relative overflow-hidden rounded-[16px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-2 transition-all duration-300 ease-[var(--ease-smooth-out)]">
          <div
            class="relative aspect-[16/9] sm:aspect-[2.1/1] w-full overflow-hidden rounded-[8px] bg-[var(--surface-interactive)] cursor-zoom-in"
            data-spring-zoom-trigger
            data-zoom-src={project.image}
          >
            <img
              src={project.image}
              alt={project.title}
              class="h-full w-full object-cover object-center contrast-[1.03] opacity-90 transition-transform duration-700 ease-[var(--ease-smooth-out)] group-hover:scale-[1.02]"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[rgba(13,13,13,0.7)] via-transparent to-transparent opacity-60"></div>
          </div>
        </header>

        <!-- 2. Project Title & Overview -->
        <section class="t-stagger-line t-stagger-line--2 flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">
              {project.category}
            </span>
            <span class="text-xs text-[var(--text-faint)] font-mono">•</span>
            <span class="font-mono tabular-nums text-[11px] text-[var(--text-muted)]">
              {project.year}
            </span>
          </div>

          <h1 class="m-0 font-display text-2xl sm:text-3xl font-normal leading-[1.25] tracking-[-0.04em] text-[var(--text-primary)]">
            {project.title}
          </h1>

          <p class="m-0 text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            {project.description}
          </p>
        </section>

        <!-- Hair-Line Separator -->
        <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

        <!-- 3. Metadata Table Bar (Role, Timeline, Action CTA) -->
        <section class="t-stagger-line t-stagger-line--3 flex flex-wrap items-center justify-between gap-4 border-b border-dashed border-[var(--border-subtle)] py-4 my-1">
          <div class="flex items-center gap-6 sm:gap-10">
            <div class="flex flex-col gap-0.5">
              <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">ROLE</span>
              <span class="text-xs sm:text-sm font-medium text-[var(--text-primary)]">{project.role}</span>
            </div>

            <div class="flex flex-col gap-0.5">
              <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">TIMELINE</span>
              <span class="font-mono tabular-nums text-xs sm:text-sm font-medium text-[var(--text-primary)]">{project.year}</span>
            </div>
          </div>

          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3.5 py-1.5 font-sans text-xs font-medium text-[var(--text-primary)] no-underline transition-all duration-200 hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)] hover:scale-[1.02]"
          >
            <span>Visit Project</span>
            <svg class="size-3.5 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </a>
        </section>

        <!-- 4. Deep-Dive Case Study Narrative & Key Highlights -->
        <section class="t-stagger-line t-stagger-line--4 flex flex-col gap-5 pt-2">
          <div class="flex flex-col gap-2">
            <h2 class="m-0 font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">
              Overview & Architecture
            </h2>
            <p class="m-0 text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
              {project.longDescription}
            </p>
          </div>

          <!-- Key Deliverables & Technical Highlights -->
          {project.highlights && project.highlights.length > 0 && (
            <div class="flex flex-col gap-3 pt-1">
              <h3 class="m-0 font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">
                Key Highlights
              </h3>
              <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
                {project.highlights.map((item, idx) => (
                  <li class="flex items-start gap-3 text-xs sm:text-sm text-[var(--text-secondary)]">
                    <span class="font-mono text-[11px] tabular-nums text-[var(--text-muted)] pt-0.5 shrink-0">0{idx + 1}</span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>

        <!-- 5. Visual Gallery (Zoomable Framed Media Containers) -->
        {project.gallery && project.gallery.length > 0 && (
          <section class="t-stagger-line t-stagger-line--4 flex flex-col gap-4 pt-4">
            <h2 class="m-0 font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">
              Visual Gallery
            </h2>
            <div class="flex flex-col gap-6">
              {project.gallery.map((imgUrl) => (
                <div
                  class="relative aspect-[16/9] w-full overflow-hidden rounded-[12px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] cursor-zoom-in"
                  data-spring-zoom-trigger
                  data-zoom-src={imgUrl}
                >
                  <img
                    src={imgUrl}
                    alt={`${project.title} preview`}
                    class="h-full w-full object-cover object-center opacity-90 transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Hair-Line Separator -->
        <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

        <!-- 6. Next Project Showcase Banner -->
        <footer class="t-stagger-line t-stagger-line--4 flex flex-col gap-4 pt-2">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-muted)]">UP NEXT</span>
            <a href="/#projects" class="font-mono text-xs text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]">
              Back to all projects ↗
            </a>
          </div>

          <a
            href={`/projects/${project.nextSlug}`}
            class="group flex items-center justify-between gap-4 rounded-[16px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-4 sm:p-5 no-underline transition-all duration-300 ease-[var(--ease-smooth-out)] hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)]"
          >
            <div class="flex flex-col gap-1">
              <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--text-muted)]">NEXT CASE STUDY</span>
              <span class="font-display text-base sm:text-lg font-normal tracking-[-0.03em] text-[var(--text-primary)]">
                {project.nextTitle}
              </span>
            </div>

            <!-- Tactile Circular Arrow Button -->
            <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface)] text-[var(--text-primary)] transition-all duration-300 ease-[var(--ease-smooth-out)] group-hover:border-[var(--border-strong)] group-hover:scale-110">
              <svg class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </div>
          </a>
        </footer>

      </article>

      <PortfolioFooter />

    </div>
  </main>
</Layout>

<!-- Fullscreen FLIP Spring Zoom Backdrop -->
<div
  id="spring-zoom-backdrop"
  class="spring-zoom-backdrop fixed inset-0 z-40 bg-[rgba(13,13,13,0.92)] backdrop-blur-xl transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<style>
  .project-back-btn:active {
    transform: scale(0.95);
  }

  .spring-zoom-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  // Stagger reveal animation matching Home intro
  const block = document.querySelector<HTMLElement>('.t-stagger');
  if (block) {
    requestAnimationFrame(() => {
      block.classList.add('is-shown');
    });
  }

  // FLIP Spring Shared-Element Zoom & Retraction Engine
  const backdrop = document.getElementById('spring-zoom-backdrop');
  const zoomCards = document.querySelectorAll<HTMLElement>('[data-spring-zoom-trigger]');
  let activeClone: HTMLImageElement | null = null;
  let activeSourceEl: HTMLElement | null = null;
  let isZoomed = false;

  const retractZoom = () => {
    if (!activeClone || !activeSourceEl || !isZoomed) return;
    isZoomed = false;

    if (backdrop) backdrop.classList.remove('is-active');

    // Smooth spring retraction back to exact origin
    activeClone.style.transition = 'transform 380ms cubic-bezier(0.23, 1, 0.32, 1)';
    activeClone.style.transform = 'translate3d(0px, 0px, 0) scale(1)';

    const handleEnd = () => {
      if (activeSourceEl) activeSourceEl.style.opacity = '1';
      requestAnimationFrame(() => {
        if (activeClone && activeClone.parentNode) {
          activeClone.parentNode.removeChild(activeClone);
        }
        activeClone = null;
        activeSourceEl = null;
        document.body.style.overflow = '';
      });
    };

    activeClone.addEventListener('transitionend', handleEnd, { once: true });
  };

  zoomCards.forEach((card) => {
    card.addEventListener('click', () => {
      if (isZoomed) {
        retractZoom();
        return;
      }

      const imgEl = card.querySelector('img');
      const src = card.dataset.zoomSrc;
      if (!imgEl || !src) return;

      isZoomed = true;
      activeSourceEl = card;
      const sourceRect = imgEl.getBoundingClientRect();

      const clone = document.createElement('img');
      clone.src = src;
      clone.className = 'fixed z-50 shadow-2xl object-contain cursor-zoom-out select-none';
      clone.style.left = `${sourceRect.left}px`;
      clone.style.top = `${sourceRect.top}px`;
      clone.style.width = `${sourceRect.width}px`;
      clone.style.height = `${sourceRect.height}px`;
      clone.style.transformOrigin = 'top left';
      clone.style.willChange = 'transform';

      document.body.appendChild(clone);
      activeClone = clone;
      card.style.opacity = '0';

      if (backdrop) backdrop.classList.add('is-active');
      document.body.style.overflow = 'hidden';

      const maxW = Math.min(window.innerWidth * 0.9, 1200);
      const maxH = Math.min(window.innerHeight * 0.85, 900);
      
      let targetW = maxW;
      let targetH = maxW * (sourceRect.height / sourceRect.width);
      if (targetH > maxH) {
        targetH = maxH;
        targetW = maxH * (sourceRect.width / sourceRect.height);
      }

      const targetLeft = (window.innerWidth - targetW) / 2;
      const targetTop = (window.innerHeight - targetH) / 2;

      const scale = targetW / sourceRect.width;
      const translateX = targetLeft - sourceRect.left;
      const translateY = targetTop - sourceRect.top;

      void clone.offsetWidth;

      clone.style.transition = 'transform 420ms cubic-bezier(0.23, 1, 0.32, 1)';
      clone.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;

      clone.addEventListener('click', retractZoom);
    });
  });

  if (backdrop) backdrop.addEventListener('click', retractZoom);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isZoomed) {
      retractZoom();
    }
  });
</script>
