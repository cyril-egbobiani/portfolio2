      highlights: [
        'Authored GLSL shaders for volumetric lighting and noise distortion.',
        'Live code editor interface with instant hot-reloading GLSL canvas.',
      ],
      image: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1200&q=80',
      gallery: [
