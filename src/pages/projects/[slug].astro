---
// src/pages/projects/[slug].astro — Project case study (content: src/content/projects)
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import CaseStudyLayout from '../../components/case-study/CaseStudyLayout.astro';
import Figure from '../../components/case-study/Figure.astro';
import Phone from '../../components/case-study/Phone.astro';
import { caseStudyComponents } from '../../components/case-study';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);

  // The homepage card order is the reading order; "Next" wraps around
  const ordered = projects
    .map((card) => entries.find((entry) => entry.id === card.slug))
    .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

  return ordered.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, nextId: ordered.length > 1 ? ordered[(index + 1) % ordered.length].id : undefined },
  }));
}

const { entry, nextId } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const card = projects.find((project) => project.slug === entry.id);
const nextCard = projects.find((project) => project.slug === nextId);
---

<CaseStudyLayout
  kind="Project"
  title={data.title}
  summary={data.summary}
  year={data.year}
  role={data.role}
  team={data.team}
  tools={data.stack}
  toolsLabel="Stack"
  status={data.status}
  links={data.links}
  draft={data.draft}
  backHref="/#projects"
  backLabel="Back to work"
  next={nextCard
    ? {
        href: `/projects/${nextCard.slug}`,
        title: nextCard.title,
        summary: nextCard.shortBlurb,
        image: nextCard.thumbnailImage,
        device: nextCard.deviceType,
      }
    : undefined}
>
  {card?.thumbnailImage && (
    <Figure slot="hero">
      {card.deviceType === 'phone' ? (
        <Phone src={card.thumbnailImage} alt={`${data.title} app screen`} size="lg" />
      ) : (
        <Image src={card.thumbnailImage} alt={`${data.title} screen`} widths={[640, 1280]} sizes="(min-width: 700px) 616px, 90vw" loading="eager" />
      )}
    </Figure>
  )}

  <Content components={caseStudyComponents} />
</CaseStudyLayout>
