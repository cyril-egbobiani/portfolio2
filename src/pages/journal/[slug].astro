---
// src/pages/journal/[slug].astro — A journal entry written on this site
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import PageTopNav from '../../components/PageTopNav.astro';
import NavArrow from '../../components/NavArrow.astro';
import { formatJournalDate, readingMinutes } from '../../data/journal';
import '../../styles/article.css';

export async function getStaticPaths() {
  const entries = await getCollection(
    'journal',
    ({ data }) => !data.externalUrl && (import.meta.env.DEV || !data.draft)
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, excerpt, tags, draft } = entry.data;
const minutes = readingMinutes(entry.body);
---

<Layout title={`${title} — Cyril Egbobiani`} description={excerpt}>
  <div class="entry-progress" data-read-progress aria-hidden="true"></div>

  <PageTopNav backHref="/journal" backLabel="Back to journal" />

  <main class="page-blur-entry min-h-screen bg-[var(--surface)] px-6 sm:px-8 pt-[108px] sm:pt-[124px] pb-12 sm:pb-16 text-[var(--text-primary)] antialiased">
    <div class="mx-auto flex w-full max-w-[680px] flex-col">
      <article class="entry" data-entry>
        <header class="entry-header">
          <p class="entry-meta">
            <time datetime={date.toISOString()}>{formatJournalDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {draft && <span class="entry-draft">Draft</span>}
          </p>
          <h1 class="entry-title">{title}</h1>
          {tags.length > 0 && (
            <ul class="entry-tags" role="list">
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </header>

        <div class="entry-body" data-entry-body>
          <Content />
        </div>
      </article>

      <nav class="entry-end" aria-label="Journal">
        <a href="/journal" data-astro-prefetch><span>All entries</span><NavArrow direction="right" size={16} /></a>
        <a href="https://cyriljnr.substack.com" target="_blank" rel="noopener noreferrer"><span>Subscribe on Substack</span><NavArrow direction="up-right" size={14} /></a>
        <button type="button" data-entry-top>
          <span>Back to top</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
        </button>
      </nav>
      <p class="entry-end__time"><span data-entry-time></span>in Lagos</p>
    </div>
  </main>
</Layout>

<script>
  import { initArticlePage } from '../../utils/article';

  // The entry ends with its own links and the time in Lagos instead of the site footer
  function initEntryEnd() {
    const time = document.querySelector<HTMLElement>('[data-entry-time]');
    if (time) {
      try {
        const now = new Intl.DateTimeFormat('en-US', { timeZone: 'Africa/Lagos', hour: 'numeric', minute: '2-digit', hour12: true }).format(new Date());
        time.textContent = `${now} `;
      } catch {
        time.parentElement?.remove();
      }
    }

    document.querySelector('[data-entry-top]')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initArticlePage();
    initEntryEnd();
  });
</script>
