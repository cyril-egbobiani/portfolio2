---
// src/pages/journal/[slug].astro — A journal entry written on this site
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import PageTopNav from '../../components/PageTopNav.astro';
import PortfolioFooter from '../../components/PortfolioFooter.astro';
import NavArrow from '../../components/NavArrow.astro';
import { formatJournalDate, readingMinutes } from '../../data/journal';
import '../../styles/article.css';

export async function getStaticPaths() {
  const entries = await getCollection(
    'journal',
    ({ data }) => !data.externalUrl && (import.meta.env.DEV || !data.draft)
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, excerpt, tags, draft } = entry.data;
const minutes = readingMinutes(entry.body);
---

<Layout title={`${title} — Cyril Egbobiani`} description={excerpt}>
  <div class="entry-progress" data-read-progress aria-hidden="true"></div>

  <PageTopNav backHref="/journal" backLabel="Back to journal" />

  <main class="page-blur-entry min-h-screen bg-[var(--surface)] px-6 sm:px-8 pt-[108px] sm:pt-[124px] pb-12 sm:pb-16 text-[var(--text-primary)] antialiased">
    <div class="mx-auto flex w-full max-w-[680px] flex-col">
      <article class="entry" data-entry>
        <header class="entry-header">
          <p class="entry-meta">
            <time datetime={date.toISOString()}>{formatJournalDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {draft && <span class="entry-draft">Draft</span>}
          </p>
          <h1 class="entry-title">{title}</h1>
          {tags.length > 0 && (
            <ul class="entry-tags" role="list">
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </header>

        <div class="entry-body" data-entry-body>
          <Content />
        </div>
      </article>

      <nav class="entry-end" aria-label="Journal">
        <a href="/journal" data-astro-prefetch><NavArrow direction="left" size={14} />All entries</a>
        <a href="https://cyriljnr.substack.com" target="_blank" rel="noopener noreferrer">Subscribe on Substack<NavArrow direction="up-right" size={12} /></a>
      </nav>

      <div class="mt-14">
        <PortfolioFooter compact />
      </div>
    </div>
  </main>
</Layout>

<script>
  import { initArticlePage } from '../../utils/article';

  document.addEventListener('astro:page-load', initArticlePage);
</script>
