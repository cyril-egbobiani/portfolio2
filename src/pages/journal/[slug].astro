---
// src/pages/journal/[slug].astro — A journal entry written on this site
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import PageTopNav from '../../components/PageTopNav.astro';
import PortfolioFooter from '../../components/PortfolioFooter.astro';
import { formatJournalDate, readingMinutes } from '../../data/journal';

export async function getStaticPaths() {
  const entries = await getCollection(
    'journal',
    ({ data }) => !data.externalUrl && (import.meta.env.DEV || !data.draft)
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, excerpt, tags, draft } = entry.data;
const minutes = readingMinutes(entry.body);
---

<Layout title={`${title} — Cyril Egbobiani`} description={excerpt}>
  <div class="entry-progress" data-read-progress aria-hidden="true"></div>

  <PageTopNav backHref="/journal" backLabel="Back to journal" />

  <main class="page-blur-entry min-h-screen bg-[var(--surface)] px-6 sm:px-8 pt-[108px] sm:pt-[124px] pb-12 sm:pb-16 text-[var(--text-primary)] antialiased">
    <div class="mx-auto flex w-full max-w-[680px] flex-col">
      <article class="entry" data-entry>
        <header class="entry-header">
          <p class="entry-meta">
            <time datetime={date.toISOString()}>{formatJournalDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {draft && <span class="entry-draft">Draft</span>}
          </p>
          <h1 class="entry-title">{title}</h1>
          {tags.length > 0 && (
            <ul class="entry-tags" role="list">
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </header>

        <div class="entry-body" data-entry-body>
          <Content />
        </div>
      </article>

      <nav class="entry-end" aria-label="Journal">
        <a href="/journal" data-astro-prefetch>← All entries</a>
        <a href="https://cyriljnr.substack.com" target="_blank" rel="noopener noreferrer">Subscribe on Substack ↗</a>
      </nav>

      <div class="mt-24 sm:mt-28">
        <PortfolioFooter />
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /* ── Reading progress: a thin pencil line ── */
  .entry-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 2px;
    background: var(--text-faint);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  /* ── Header ── */
  .entry-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 36px;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 13px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .entry-draft {
    margin-left: 4px;
    padding: 1px 7px;
    border-radius: 9999px;
    background: var(--surface-interactive);
    font-size: 11px;
    font-weight: 500;
  }

  .entry-title {
    margin: 0;
    font-size: 19.5px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    .entry-title {
      font-size: 22px;
    }
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: var(--text-muted);
  }

  /* ── Body copy ── */
  .entry-body {
    position: relative;
    font-size: 15.5px;
    line-height: 1.75;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
  }

  .entry-body > :first-child {
    margin-top: 0;
  }

  .entry-body p,
  .entry-body ul,
  .entry-body ol,
  .entry-body blockquote,
  .entry-body pre,
  .entry-body figure {
    margin: 0 0 1.15em;
  }

  .entry-body h2,
  .entry-body h3 {
    margin: 2.2em 0 0.6em;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .entry-body h2 { font-size: 17px; }
  .entry-body h3 { font-size: 15.5px; }

  .entry-body strong {
    font-weight: 600;
    color: var(--text-primary);
  }

  .entry-body a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-default);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms var(--ease-smooth-out);
  }

  .entry-body a:hover {
    text-decoration-color: var(--text-muted);
  }

  .entry-body ul,
  .entry-body ol {
    padding-left: 1.25em;
  }

  .entry-body ul { list-style: disc; }
  .entry-body ol { list-style: decimal; }

  .entry-body li {
    margin: 0.35em 0;
    padding-left: 0.2em;
  }

  .entry-body li::marker {
    color: var(--text-faint);
  }

  .entry-body blockquote {
    padding-left: 16px;
    border-left: 2px solid var(--border-default);
    color: var(--text-muted);
  }

  .entry-body hr {
    margin: 2.4em 0;
    border: none;
    border-top: 1px solid var(--border-subtle);
  }

  .entry-body img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  .entry-body :not(pre) > code {
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--surface-subtle);
    font-size: 0.88em;
    color: var(--text-primary);
  }

  .entry-body pre {
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
  }

  /* Footnote references */
  .entry-body sup a {
    padding: 0 2px;
    font-size: 11px;
    color: var(--text-muted);
    text-decoration: none;
  }

  .entry-body .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Footnotes stay at the bottom on narrow screens */
  .entry-body section[data-footnotes] {
    margin-top: 3em;
    padding-top: 1.2em;
    border-top: 1px solid var(--border-subtle);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .entry-body section[data-footnotes] ol {
    margin: 0;
  }

  [data-margin-notes] section[data-footnotes] {
    display: none;
  }

  /* ── Margin notes: footnotes handwritten beside their line (wide screens) ── */
  .entry-margin-note {
    position: absolute;
    right: -224px;
    width: 184px;
    font-family: var(--font-script);
    font-size: 19px;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--ink);
    transform: rotate(-1.4deg);
    transform-origin: left top;
  }

  .entry-margin-note p {
    display: inline;
    margin: 0;
  }

  .entry-margin-note code {
    font-size: 0.8em;
  }

  .entry-margin-note__num {
    margin-right: 5px;
    font-family: var(--font-sans);
    font-size: 10px;
    color: var(--text-faint);
    vertical-align: 3px;
  }

  /* ── End of entry ── */
  .entry-end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .entry-end a {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 160ms var(--ease-smooth-out);
  }

  .entry-end a:hover {
    color: var(--text-primary);
  }
</style>

<script>
  function initEntryPage() {
    const article = document.querySelector<HTMLElement>('[data-entry]');
    const body = article?.querySelector<HTMLElement>('[data-entry-body]');
    if (!article || !body) return;

    const bar = document.querySelector<HTMLElement>('[data-read-progress]');
    const wide = window.matchMedia('(min-width: 1180px)');

    // Lift footnotes into the margin beside the line that references them
    const placeMarginNotes = () => {
      body.querySelectorAll('.entry-margin-note').forEach((note) => note.remove());
      article.removeAttribute('data-margin-notes');
      if (!wide.matches) return;

      const refs = body.querySelectorAll<HTMLAnchorElement>('a[data-footnote-ref]');
      if (refs.length === 0) return;

      const bodyTop = body.getBoundingClientRect().top;
      let nextFreeTop = 0;

      refs.forEach((ref) => {
        const source = document.getElementById(decodeURIComponent(ref.hash.slice(1)));
        if (!source) return;

        const note = document.createElement('aside');
        note.className = 'entry-margin-note';
        note.innerHTML = source.innerHTML;
        note.querySelectorAll('[data-footnote-backref]').forEach((back) => back.remove());

        const num = document.createElement('span');
        num.className = 'entry-margin-note__num';
        num.textContent = ref.textContent ?? '';
        note.prepend(num);

        body.appendChild(note);
        const top = Math.max(ref.getBoundingClientRect().top - bodyTop - 4, nextFreeTop);
        note.style.top = `${top}px`;
        nextFreeTop = top + note.offsetHeight + 16;
      });

      article.setAttribute('data-margin-notes', '');
    };

    const updateProgress = () => {
      if (!bar) return;
      const rect = article.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / scrollable));
      bar.style.transform = `scaleX(${progress})`;
    };

    const onResize = () => {
      placeMarginNotes();
      updateProgress();
    };

    placeMarginNotes();
    updateProgress();
    document.fonts?.ready.then(placeMarginNotes);

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', onResize);
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', updateProgress);
        window.removeEventListener('resize', onResize);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initEntryPage);
</script>
