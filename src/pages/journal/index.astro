---
// src/pages/journal/index.astro — All journal entries as tiles, grouped by month
import Layout from '../../components/Layout.astro';
import PageTopNav from '../../components/PageTopNav.astro';
import JournalRow from '../../components/JournalRow.astro';
import PortfolioFooter from '../../components/PortfolioFooter.astro';
import NavArrow from '../../components/NavArrow.astro';
import { getJournalEntries, type JournalEntry } from '../../data/journal';

const SUBSTACK_URL = 'https://cyriljnr.substack.com';

const entries = await getJournalEntries();

// Entries arrive newest first, so months keep that order
const months = new Map<string, { month: string; year: number; entries: JournalEntry[] }>();
for (const entry of entries) {
  const key = `${entry.date.getUTCFullYear()}-${entry.date.getUTCMonth()}`;
  const group = months.get(key) ?? {
    month: entry.date.toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' }),
    year: entry.date.getUTCFullYear(),
    entries: [],
  };
  group.entries.push(entry);
  months.set(key, group);
}
const currentYear = new Date().getUTCFullYear();

const showFilters = entries.some((e) => e.external) && entries.some((e) => !e.external);
const filters = [
  { id: 'all', label: 'All' },
  { id: 'here', label: 'Here' },
  { id: 'elsewhere', label: 'Elsewhere' },
];
---

<Layout
  title="Journal — Cyril Egbobiani"
  description="Journal entries by Cyril Egbobiani, written here and on Substack."
>
  <PageTopNav />

  <main id="content" tabindex="-1" class="page-blur-entry min-h-screen bg-[var(--surface)] px-6 sm:px-8 pt-[108px] sm:pt-[124px] pb-12 sm:pb-16 text-[var(--text-primary)] antialiased">
    <div class="mx-auto flex w-full max-w-[680px] flex-col">
      <header class="journal-header">
        <h1 class="journal-heading">Journal</h1>
        <p class="journal-lede">
          Writing, mostly kept here with the occasional post on{' '}
          <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">Substack<span class="sr-only"> (opens in a new tab)</span></a>.
        </p>
      </header>

      {showFilters && (
        <div class="journal-filters" role="group" aria-label="Filter entries" data-journal-filters>
          <span class="journal-filters__pill" aria-hidden="true" data-journal-pill></span>
          {filters.map((filter, index) => (
            <button type="button" class="journal-filter" data-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {filter.label}
            </button>
          ))}
        </div>
      )}

      <!-- Says out loud what the filter did, for anyone not watching the list -->
      <p class="sr-only" role="status" aria-live="polite" data-journal-status></p>

      {entries.length === 0 ? (
        <p class="journal-empty">
          <span class="journal-empty__hand">first entry coming soon</span>
          <span>In the meantime, <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">subscribe on Substack<span class="sr-only"> (opens in a new tab)</span></a>.</span>
        </p>
      ) : (
        <div class="journal-months">
          {[...months.values()].map((group) => (
            <section class="journal-month" data-journal-group>
              <h2 class="journal-month__label">
                {group.month}
                <span>
                  {group.year !== currentYear && <>{group.year} · </>}
                  <span data-journal-count>{group.entries.length} {group.entries.length === 1 ? 'entry' : 'entries'}</span>
                </span>
              </h2>
              <ul class="journal-month__list" role="list">
                {group.entries.map((entry) => <JournalRow entry={entry} />)}
              </ul>
            </section>
          ))}
          {showFilters && (
            <p class="journal-none" data-journal-none hidden>
              <span class="journal-empty__hand">nothing here yet</span>
            </p>
          )}
        </div>
      )}

      <div class="journal-links">
        <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">Substack<NavArrow direction="up-right" size={12} /><span class="sr-only"> (opens in a new tab)</span></a>
        <a href="/journal/rss.xml">RSS</a>
      </div>

      <div class="mt-24 sm:mt-28">
        <PortfolioFooter />
      </div>
    </div>
  </main>
</Layout>

<style>
  .journal-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 36px;
  }

  .journal-heading {
    margin: 0;
    font-size: 19.5px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .journal-lede {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.7;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
  }

  .journal-lede a,
  .journal-empty a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-default);
    text-underline-offset: 3px;
  }

  .journal-filters {
    position: relative;
    display: inline-flex;
    align-self: flex-start;
    gap: 2px;
    padding: 3px;
    margin-bottom: 24px;
    border-radius: 9999px;
    background: var(--surface-subtle);
  }

  /* One pill slides under the pressed filter (same motion as Builds / Designs) */
  .journal-filters__pill {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 0;
    border-radius: 9999px;
    background: var(--surface);
    pointer-events: none;
    transition:
      transform 300ms var(--ease-smooth-out),
      width 300ms var(--ease-smooth-out);
  }

  /* Until the script places the pill, the pressed button paints its own */
  .journal-filters:not(.has-pill) .journal-filter[aria-pressed='true'] {
    background: var(--surface);
  }

  .journal-filter {
    position: relative;
    z-index: 1;
    padding: 6px 14px;
    border: none;
    border-radius: 9999px;
    background: transparent;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      color 200ms var(--ease-smooth-out),
      transform 120ms var(--ease-smooth-out);
  }

  .journal-filter[aria-pressed='true'] {
    color: var(--text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .journal-filter:hover {
      color: var(--text-primary);
    }
  }

  .journal-filter:active {
    transform: scale(0.96);
  }

  /* Touch screens get a full-size target without changing the desktop look */
  @media (pointer: coarse) {
    .journal-filter {
      min-height: 40px;
      padding: 0 16px;
    }
  }

  .journal-filter:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 1px;
  }

  /* Entries that come back after a filter change settle in one after another */
  :global(.journal-tile-item.is-entering) {
    animation: journalTileIn 360ms var(--ease-smooth-out) both;
    animation-delay: calc(var(--stagger, 0) * 40ms);
  }

  .journal-month.is-entering .journal-month__label {
    animation: journalTileIn 360ms var(--ease-smooth-out) both;
  }

  @keyframes journalTileIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .journal-none {
    margin: 0;
    padding: 8px 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-filters__pill {
      transition: none;
    }

    :global(.journal-tile-item.is-entering),
    .journal-month.is-entering .journal-month__label {
      animation: none;
    }
  }

  .journal-months {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .journal-month__label {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 12px 4px;
    font-size: 19.5px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .journal-month__label span {
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-muted);
  }

  .journal-month__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
  }

  .journal-empty {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 28px 0;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .journal-empty__hand {
    font-family: var(--font-script);
    font-size: 24px;
    color: var(--text-secondary);
  }

  .journal-links {
    display: flex;
    gap: 16px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .journal-links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color 160ms var(--ease-smooth-out);
  }

  .journal-links a:hover {
    color: var(--text-primary);
  }
</style>

<script>
  function initJournalFilters() {
    const bar = document.querySelector<HTMLElement>('[data-journal-filters]');
    if (!bar || bar.dataset.bound) return;
    bar.dataset.bound = 'true';

    const pill = bar.querySelector<HTMLElement>('[data-journal-pill]');
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-journal-group]')];
    const none = document.querySelector<HTMLElement>('[data-journal-none]');
    const status = document.querySelector<HTMLElement>('[data-journal-status]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const placePill = (button: HTMLElement, animate: boolean) => {
      if (!pill || button.offsetWidth === 0) return;
      if (!animate) pill.style.transition = 'none';
      pill.style.width = `${button.offsetWidth}px`;
      pill.style.transform = `translateX(${button.offsetLeft}px)`;
      if (!animate) {
        void pill.offsetWidth;
        pill.style.transition = '';
      }
      bar.classList.add('has-pill');
    };

    const pressed = () => buttons.find((b) => b.getAttribute('aria-pressed') === 'true') ?? buttons[0];

    const apply = (button: HTMLButtonElement, { push = true } = {}) => {
      const filter = button.dataset.filter;
      // The choice lives in the URL, so a filtered view can be shared or reloaded
      if (push) {
        const url = new URL(window.location.href);
        if (filter && filter !== 'all') url.searchParams.set('show', filter);
        else url.searchParams.delete('show');
        history.pushState({ filter }, '', url);
      }
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      placePill(button, true);

      let stagger = 0;
      let total = 0;
      groups.forEach((group) => {
        let visible = 0;
        group.querySelectorAll<HTMLElement>('[data-journal-source]').forEach((row) => {
          const show = filter === 'all' || row.dataset.journalSource === filter;
          const wasHidden = row.hidden;
          row.hidden = !show;
          if (!show) return;
          visible += 1;
          // Replay the entrance on every entry that is showing after the change
          if (!reduceMotion) {
            row.classList.remove('is-entering');
            void row.offsetWidth;
            row.style.setProperty('--stagger', String(stagger++));
            row.classList.add('is-entering');
          } else if (wasHidden) {
            row.classList.remove('is-entering');
          }
        });

        const wasGroupHidden = group.hidden;
        group.hidden = visible === 0;
        if (!group.hidden && wasGroupHidden && !reduceMotion) {
          group.classList.remove('is-entering');
          void group.offsetWidth;
          group.classList.add('is-entering');
        }

        const count = group.querySelector<HTMLElement>('[data-journal-count]');
        if (count) count.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
        total += visible;
      });

      if (none) none.hidden = total > 0;
      if (status) {
        status.textContent = `${button.textContent?.trim()}: ${total} ${total === 1 ? 'entry' : 'entries'}`;
      }
    };

    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button || button.getAttribute('aria-pressed') === 'true') return;
      apply(button);
    });

    // Open a shared link, or press Back, and the right filter is showing
    const fromUrl = () => {
      const wanted = new URL(window.location.href).searchParams.get('show') ?? 'all';
      const button = buttons.find((b) => b.dataset.filter === wanted) ?? buttons[0];
      if (button.getAttribute('aria-pressed') !== 'true') apply(button, { push: false });
    };
    const onPopState = () => fromUrl();
    window.addEventListener('popstate', onPopState);
    fromUrl();

    // Clean up the entrance classes once they have played
    document.querySelector('.journal-months')?.addEventListener('animationend', (event) => {
      const target = event.target as HTMLElement;
      (target.closest('.is-entering') ?? target).classList.remove('is-entering');
    });

    const realign = () => placePill(pressed(), false);
    realign();
    document.fonts?.ready.then(realign);
    window.addEventListener('resize', realign);
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('resize', realign);
        window.removeEventListener('popstate', onPopState);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initJournalFilters);
</script>
