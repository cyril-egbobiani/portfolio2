---
import Layout from '../components/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import NavArrow from '../components/NavArrow.astro';
---

<Layout title="404: Page Not Found | Cyril Egbobiani">
  <main class="flex min-h-screen flex-col justify-center bg-[var(--surface)] px-6 py-8 sm:px-8 sm:py-12 font-[var(--font-sans)] text-[var(--text-primary)]">
    
    <div class="mx-auto flex w-full max-w-[660px] flex-col gap-12">
      
      <!-- Top Nav Header -->
      <header class="flex w-full items-center justify-between">
        <a
          href="/"
          class="inline-flex size-9 items-center justify-center rounded-full bg-[var(--surface-subtle)] text-[var(--text-secondary)] no-underline transition-[background-color,color] duration-200 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)] hover:text-[var(--text-primary)] active:scale-[0.95]"
          aria-label="Back to home"
        >
          <NavArrow direction="left" size={16} />
        </a>

        <ThemeToggle />
      </header>

      <!-- Main 404 Hero Content -->
      <div class="flex flex-col items-start gap-6 py-12">
        
        <!-- Status Badge Pill -->
        <div class="flex items-center gap-2 rounded-[4px] bg-[var(--surface-subtle)] px-2.5 py-1">
          <span class="relative flex size-2 items-center justify-center">
            <span class="relative inline-flex size-1.5 rounded-full bg-[var(--text-primary)]"></span>
          </span>
          <span class="font-sans text-xs text-[var(--text-muted)] tracking-tight">404 · Page Not Found</span>
        </div>

        <!-- Heading & Copy -->
        <div class="flex flex-col gap-3">
          <h1 class="m-0 font-display text-3xl sm:text-4xl font-bold tracking-normal text-[var(--text-primary)]">
            How did you get here?
          </h1>
          <p class="m-0 max-w-md font-sans text-[16px] leading-[1.62] text-[var(--text-secondary)] font-normal">
            The page you requested doesn't exist, has been removed, or moved to the main showcase.
          </p>
        </div>

        <!-- Action Button -->
        <div class="pt-2">
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-[6px] bg-[var(--surface-subtle)] px-4 py-2.5 font-sans text-[14px] font-medium text-[var(--text-primary)] no-underline transition-[background-color,transform] duration-200 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
          >
            <NavArrow direction="left" size={15} />
            <span>Return to Homepage</span>
          </a>
        </div>

      </div>

    </div>

  </main>
</Layout>

<style>
  a:active {
    transform: scale(0.97);
  }
</style>
