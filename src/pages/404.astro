---
import Layout from '../components/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles.css';
---

<Layout title="404: Page Not Found | Cyril Egbobiani">
  <main class="flex min-h-screen flex-col justify-center bg-[var(--surface)] px-4 py-8 sm:px-6 sm:py-12 font-[var(--font-sans)] text-[var(--text-primary)]">
    
    <div class="mx-auto flex w-full max-w-[660px] flex-col gap-12">
      
      <!-- Top Nav Header -->
      <header class="flex w-full items-center justify-between">
        <a
          href="/"
          class="group inline-flex size-9 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface)] text-[var(--text-muted)] no-underline transition-all duration-200 ease-[var(--ease-smooth-out)] hover:-translate-y-[2px] hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)] hover:text-[var(--text-primary)] active:scale-[0.92]"
          aria-label="Back to home"
        >
          <svg class="size-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </a>

        <ThemeToggle />
      </header>

      <!-- Main 404 Hero Content -->
      <div class="flex flex-col items-start gap-6 py-12">
        
        <!-- Status Badge Pill -->
        <div class="flex items-center gap-2 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-2.5 py-1">
          <span class="relative flex size-2 items-center justify-center">
            <span class="relative inline-flex size-1.5 rounded-full bg-rose-500"></span>
          </span>
          <span class="font-mono text-xs text-[var(--text-muted)] tracking-tight">404 · Page Not Found</span>
        </div>

        <!-- Heading & Copy -->
        <div class="flex flex-col gap-3">
          <h1 class="m-0 font-display text-3xl sm:text-4xl font-semibold tracking-[-0.05em] text-[var(--text-primary)]">
            Lost in space
          </h1>
          <p class="m-0 max-w-md font-sans text-[15.5px] sm:text-[16px] leading-[1.62] text-[var(--text-secondary)] font-normal">
            The page you requested doesn't exist, has been removed, or moved to the main showcase.
          </p>
        </div>

        <!-- Action Button -->
        <div class="pt-2">
          <a
            href="/"
            class="group inline-flex items-center gap-2 rounded-[6px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-4 py-2.5 font-mono text-xs font-medium text-[var(--text-primary)] no-underline transition-all duration-200 ease-[var(--ease-smooth-out)] hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
          >
            <svg class="size-4 text-[var(--text-muted)] transition-transform duration-200 group-hover:-translate-x-0.5 group-hover:text-[var(--text-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Return to Homepage</span>
          </a>
        </div>

      </div>

    </div>

  </main>
</Layout>

<style>
  a:active {
    transform: scale(0.97);
  }
</style>
