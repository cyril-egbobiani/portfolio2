---
// 404 — on the design system: top bar, mono status, serif heading, pills.
import Layout from '../components/Layout.astro';
import PageTopNav from '../components/PageTopNav.astro';

const places = [
  { href: '/#projects', label: 'Work' },
  { href: '/journal', label: 'Journal' },
  { href: '/about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<Layout title="404: Page Not Found | Cyril Egbobiani">
  <PageTopNav />

  <main id="content" tabindex="-1" class="flex min-h-screen flex-col justify-center bg-[var(--surface)] px-6 py-24 sm:px-8 font-[var(--font-sans)] text-[var(--text-primary)]">
    <div class="mx-auto flex w-full max-w-[640px] flex-col items-start gap-6">
      <span class="nf-status"><span class="nf-dot" aria-hidden="true"></span>404 · PAGE NOT FOUND</span>

      <div class="flex flex-col gap-3">
        <h1 class="nf-title">How did you get here?</h1>
        <p class="nf-copy">The page you requested doesn't exist, has been removed, or moved to the main showcase.</p>
      </div>

      <div class="flex flex-wrap items-center gap-2 pt-2">
        <a href="/" class="btn btn-primary">Back home</a>
        {places.map((place) => <a href={place.href} class="btn btn-secondary">{place.label}</a>)}
      </div>
    </div>
  </main>
</Layout>

<style>
  .nf-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 9999px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .nf-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--brand);
  }

  .nf-title {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(28px, 6vw, 36px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .nf-copy {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }
</style>
