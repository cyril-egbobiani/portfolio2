---
// src/pages/about.astro — Dedicated Profile & Human Half Page
import Layout from '../components/Layout.astro';
import profileIntroImg from '../assets/images/optimized/profile-intro.webp?url';
import photographyImg from '../assets/images/optimized/photography.webp?url';
import footballImg from '../assets/images/optimized/football.webp?url';
import cookingImg from '../assets/images/optimized/cooking.webp?url';
import carsImg from '../assets/images/optimized/cars.webp?url';
import soundscapesImg from '../assets/images/optimized/soundscapes.webp?url';
import ContactSection from '../components/ContactSection.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
---

<Layout
  title="About Cyril Egbobiani — Software Engineer & Designer"
  description="The human half of Cyril Egbobiani. Background, philosophy, personal interests, photography, and creative explorations."
>
  <main class="min-h-screen bg-[var(--surface)] px-6 sm:px-8 pt-8 sm:pt-12 pb-24 sm:pb-32 font-[var(--font-sans)] text-[var(--text-primary)] antialiased">
    <div class="mx-auto flex w-full max-w-[680px] flex-col">

      <!-- ── 1. Top Navigation Bar: Home (Left) + Theme Toggle (Right) ── -->
      <nav class="flex w-full items-center justify-between mb-14 sm:mb-18" aria-label="Page navigation">
        <a
          href="/"
          class="nav-icon-btn size-9 rounded-full bg-[var(--surface-subtle)] hover:bg-[var(--surface-interactive)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center justify-center transition-[background-color,color,transform] duration-160 ease-[var(--ease-smooth-out)] active:scale-95 border border-[var(--border-subtle)] no-underline"
          aria-label="Back to home"
          title="Back to home"
        >
          <svg class="size-4 text-inherit" viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="currentColor" fill-rule="evenodd" d="M10.772 2.688a2 2 0 0 1 2.456 0l8.384 6.521c.753.586.337 1.791-.615 1.791H20v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8h-.997c-.953 0-1.367-1.206-.615-1.79z" clip-rule="evenodd" />
          </svg>
        </a>

        <!-- Theme Toggle Button -->
        <button
          type="button"
          class="nav-icon-btn size-9 rounded-full bg-[var(--surface-subtle)] hover:bg-[var(--surface-interactive)] text-[var(--text-secondary)] inline-flex items-center justify-center transition-[background-color,color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:text-[var(--text-primary)] active:scale-95 cursor-pointer border border-[var(--border-subtle)]"
          aria-label="Toggle theme"
          title="Toggle theme"
          data-about-theme-toggle
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="theme-icon-sun size-4" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="4.5" />
            <path stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M12 2v2.5M12 19.5v2.5M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12h2.5M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"/>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="theme-icon-moon size-4" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.003 3a9 9 0 1 0 8.997 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1h.003z" />
          </svg>
        </button>
      </nav>

      <!-- ── Main Sections (Matching Homepage gap-24 sm:gap-28 rhythm) ── -->
      <div class="flex flex-col gap-24 sm:gap-28">

        <!-- ── 2. Hero Identity Showcase: Profile Card (Own Row) + Introduction ── -->
        <section class="t-stagger is-shown flex flex-col gap-6">
        <!-- Row 1: Tactile Physical Ticket Pass Profile Card -->
        <div class="tkt-wrapper w-full max-w-[185px] sm:max-w-[195px] select-none" aria-label="Cyril Egbobiani — CE Archive verified pass" id="tktWrapper" data-tilt-card>
          <div class="tkt-card relative w-full bg-[#ececed] rounded-[4px] overflow-visible border border-[rgba(60,45,30,0.08)]" id="tktCard" data-tilt-target>

            <!-- Tactile Cardstock Grain Overlay -->
            <div class="tkt-paper-texture pointer-events-none" aria-hidden="true"></div>

            <!-- Specular Light Glare Sheen -->
            <div class="tkt-glare" id="tktGlare" aria-hidden="true"></div>

            <!-- 4 Corner Concave Notches -->
            <div class="absolute -top-2.5 -left-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
            <div class="absolute -top-2.5 -right-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
            <div class="absolute -bottom-2.5 -left-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
            <div class="absolute -bottom-2.5 -right-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>

            <!-- Column Layout Inside Card -->
            <div class="tkt-inner-content flex flex-col p-3 gap-2.5">
              <!-- Top Framed B&W Photo -->
              <div class="tkt-photo-layer w-full aspect-[4/3.8] rounded-[2px] overflow-hidden bg-[#e2e2e5] border border-[rgba(0,0,0,0.06)]">
                <img
                  src={profileIntroImg}
                  alt="Cyril Egbobiani"
                  width="400"
                  height="380"
                  class="w-full h-full object-cover object-[50%_25%] filter grayscale contrast-[1.08] brightness-[0.98]"
                  loading="eager"
                  decoding="async"
                />
              </div>

              <!-- Dashed Perforation Line with Side Notches -->
              <div class="relative w-full my-0.5 flex items-center" aria-hidden="true">
                <div class="absolute -left-[22px] size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10"></div>
                <div class="w-full border-t border-dashed border-[#d4d4d8]"></div>
                <div class="absolute -right-[22px] size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10"></div>
              </div>

              <!-- Bottom Stub: Verified Pass + Barcode -->
              <div class="tkt-stub-layer flex items-center justify-between gap-2 px-0.5">
                <span class="font-sans text-[9.5px] font-bold uppercase tracking-[0.14em] text-[#18181b]">
                  LIVING
                </span>
                <div class="w-11 h-3.5 text-[#18181b] opacity-85 shrink-0" role="img" aria-label="ticket barcode">
                  <svg viewBox="0 0 56 18" fill="currentColor" class="w-full h-full" preserveAspectRatio="none">
                    <rect x="0" y="0" width="2" height="18" />
                    <rect x="4" y="0" width="3" height="18" />
                    <rect x="9" y="0" width="1" height="18" />
                    <rect x="12" y="0" width="2.5" height="18" />
                    <rect x="16" y="0" width="1" height="18" />
                    <rect x="19" y="0" width="3" height="18" />
                    <rect x="24" y="0" width="1.5" height="18" />
                    <rect x="27" y="0" width="2" height="18" />
                    <rect x="31" y="0" width="3.5" height="18" />
                    <rect x="36" y="0" width="1" height="18" />
                    <rect x="39" y="0" width="2" height="18" />
                    <rect x="43" y="0" width="1" height="18" />
                    <rect x="46" y="0" width="3" height="18" />
                    <rect x="51" y="0" width="1.5" height="18" />
                    <rect x="54" y="0" width="2" height="18" />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Row 2: Narrative & Biography -->
        <div class="flex flex-col gap-4 w-full">
       

          <p class="text-[15.5px] leading-[1.7] text-[var(--text-secondary)]">
            Drawing became a coping tool for me at a very young age, It was just me and my notebook... then it finished. I drew almost on anything in sight but my mum's beating finally humbled me.
          </p>

          <p class="text-[15.5px] leading-[1.7] text-[var(--text-secondary)]">
Then I came across tech, coding in particular. It was so weird seeing someone write some combination of letters just to create a rectangle, I didn't really like the process but was a big fan of the result.          </p>
          <p class="text-[15.5px] leading-[1.7] text-[var(--text-secondary)]">
As time passed, I knew I had to learn how to code and it's been an awesome rollercoaster ever since.</p>

        </div>
      </section>

      <!-- ── 3. Dynamic Visual Moodboard / Hobbies Section ── -->
      <section class="flex flex-col gap-6 pt-2" aria-labelledby="hobbiesHeading">
        <div class="flex items-center justify-between">
          <h2 id="hobbiesHeading" class="section-title">
            My other domains
          </h2>
        </div>

        <!-- Dynamic Handcrafted Collage Grid (Compact & Borderless) -->
        <div class="dynamic-polaroid-grid grid grid-cols-1 sm:grid-cols-12 gap-3.5 sm:gap-4 w-full select-none" id="polaroidGallery">
          
          <!-- Card 1: Cars (Col 1-6) -->
          <div class="sm:col-span-6">
            <button
              type="button"
              class="polaroid-card group relative w-full p-2 sm:p-2.5 bg-[var(--surface-subtle)] rounded-[14px] cursor-pointer text-left active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] -rotate-1 hover:rotate-0"
              data-lisse="14"
              data-polaroid-card
              data-base-rotate="-1"
              aria-label="Cars (tap to reveal thoughts)"
            >
              <div class="polaroid-frame relative w-full aspect-[16/10] rounded-[9px] overflow-hidden bg-[var(--surface)]" data-lisse="9">
                <div class="polaroid-glare" aria-hidden="true"></div>
                
                <!-- Main Image (Blurs out on tap) -->
                <img
                  src={carsImg}
                  alt="Automotive design & classic silhouettes"
                  class="polaroid-img w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />

                <!-- In-Place Subtext Narrative Overlay (Comes in on tap) -->
                <div class="polaroid-text-overlay absolute inset-0 p-3.5 sm:p-4 flex flex-col justify-center bg-[var(--surface-raised)]/95 dark:bg-[#121215]/95 backdrop-blur-md">
                  <p class="text-[12px] sm:text-[12.5px] leading-[1.5] text-[var(--text-primary)] font-normal m-0 select-text">
                    Obsessed with classic wedge silhouettes, pop-up headlights, manual gearboxes, and the pure tactile feedback of 80s aerodynamics.
                  </p>
                </div>
              </div>

              <!-- Bottom Bar: Title + Subtle Flip Hint -->
              <div class="mt-1.5 px-0.5 flex items-center justify-between">
                <span class="font-display font-medium text-[13px] sm:text-[13.5px] text-[var(--text-primary)]">Cars</span>
                <span class="polaroid-flip-indicator inline-flex items-center gap-1 font-sans text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-[color,opacity] duration-160 opacity-80 group-hover:opacity-100">
                  <span class="indicator-read">Thoughts</span>
                  <span class="indicator-close hidden">Close</span>
                  <svg class="indicator-icon size-3 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17l9.2-9.2M17 17V8H8"/>
                  </svg>
                </span>
              </div>
            </button>
          </div>

          <!-- Card 2: Photography (Col 7-12) -->
          <div class="sm:col-span-6">
            <button
              type="button"
              class="polaroid-card group relative w-full p-2 sm:p-2.5 bg-[var(--surface-subtle)] rounded-[14px] cursor-pointer text-left active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] rotate-1 hover:rotate-0"
              data-lisse="14"
              data-polaroid-card
              data-base-rotate="1"
              aria-label="Photography (tap to reveal thoughts)"
            >
              <div class="polaroid-frame relative w-full aspect-[16/10] rounded-[9px] overflow-hidden bg-[var(--surface)]" data-lisse="9">
                <div class="polaroid-glare" aria-hidden="true"></div>
                
                <!-- Main Image (Blurs out on tap) -->
                <img
                  src={photographyImg}
                  alt="Street photography around Lagos"
                  class="polaroid-img w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />

                <!-- In-Place Subtext Narrative Overlay (Comes in on tap) -->
                <div class="polaroid-text-overlay absolute inset-0 p-3.5 sm:p-4 flex flex-col justify-center bg-[var(--surface-raised)]/95 dark:bg-[#121215]/95 backdrop-blur-md">
                  <p class="text-[12px] sm:text-[12.5px] leading-[1.5] text-[var(--text-primary)] font-normal m-0 select-text">
                    Walking through Lagos with a 35mm prime lens, searching for honest light and unscripted rhythm in everyday chaos.
                  </p>
                </div>
              </div>

              <!-- Bottom Bar: Title + Subtle Flip Hint -->
              <div class="mt-1.5 px-0.5 flex items-center justify-between">
                <span class="font-display font-medium text-[13px] sm:text-[13.5px] text-[var(--text-primary)]">Photography</span>
                <span class="polaroid-flip-indicator inline-flex items-center gap-1 font-sans text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-[color,opacity] duration-160 opacity-80 group-hover:opacity-100">
                  <span class="indicator-read">Thoughts</span>
                  <span class="indicator-close hidden">Close</span>
                  <svg class="indicator-icon size-3 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17l9.2-9.2M17 17V8H8"/>
                  </svg>
                </span>
              </div>
            </button>
          </div>

          <!-- Card 3: Football (Col 1-4) -->
          <div class="sm:col-span-4">
            <button
              type="button"
              class="polaroid-card group relative w-full p-2 sm:p-2.5 bg-[var(--surface-subtle)] rounded-[14px] cursor-pointer text-left active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] -rotate-1 hover:rotate-0"
              data-lisse="14"
              data-polaroid-card
              data-base-rotate="-1"
              aria-label="Football & Tactics (tap to reveal thoughts)"
            >
              <div class="polaroid-frame relative w-full aspect-[4/3] rounded-[9px] overflow-hidden bg-[var(--surface)]" data-lisse="9">
                <div class="polaroid-glare" aria-hidden="true"></div>
                
                <!-- Main Image (Blurs out on tap) -->
                <img
                  src={footballImg}
                  alt="Football tactics and Arsenal matchdays"
                  class="polaroid-img w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />

                <!-- In-Place Subtext Narrative Overlay (Comes in on tap) -->
                <div class="polaroid-text-overlay absolute inset-0 p-3.5 sm:p-4 flex flex-col justify-center bg-[var(--surface-raised)]/95 dark:bg-[#121215]/95 backdrop-blur-md">
                  <p class="text-[12px] sm:text-[12.5px] leading-[1.5] text-[var(--text-primary)] font-normal m-0 select-text">
                    Systems architecture on grass. Studying positional play and pressing triggers under maximum pressure.
                  </p>
                </div>
              </div>

              <!-- Bottom Bar: Title + Subtle Flip Hint -->
              <div class="mt-1.5 px-0.5 flex items-center justify-between">
                <span class="font-display font-medium text-[13px] sm:text-[13.5px] text-[var(--text-primary)]">Football & Tactics</span>
                <span class="polaroid-flip-indicator inline-flex items-center gap-1 font-sans text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-[color,opacity] duration-160 opacity-80 group-hover:opacity-100">
                  <span class="indicator-read">Thoughts</span>
                  <span class="indicator-close hidden">Close</span>
                  <svg class="indicator-icon size-3 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17l9.2-9.2M17 17V8H8"/>
                  </svg>
                </span>
              </div>
            </button>
          </div>

          <!-- Card 4: Cooking (Col 5-8) -->
          <div class="sm:col-span-4">
            <button
              type="button"
              class="polaroid-card group relative w-full p-2 sm:p-2.5 bg-[var(--surface-subtle)] rounded-[14px] cursor-pointer text-left active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] rotate-1 hover:rotate-0"
              data-lisse="14"
              data-polaroid-card
              data-base-rotate="1"
              aria-label="Cooking (tap to reveal thoughts)"
            >
              <div class="polaroid-frame relative w-full aspect-[4/3] rounded-[9px] overflow-hidden bg-[var(--surface)]" data-lisse="9">
                <div class="polaroid-glare" aria-hidden="true"></div>
                
                <!-- Main Image (Blurs out on tap) -->
                <img
                  src={cookingImg}
                  alt="Culinary cooking experiments and family recipes"
                  class="polaroid-img w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />

                <!-- In-Place Subtext Narrative Overlay (Comes in on tap) -->
                <div class="polaroid-text-overlay absolute inset-0 p-3.5 sm:p-4 flex flex-col justify-center bg-[var(--surface-raised)]/95 dark:bg-[#121215]/95 backdrop-blur-md">
                  <p class="text-[12px] sm:text-[12.5px] leading-[1.5] text-[var(--text-primary)] font-normal m-0 select-text">
                    Pure flow state away from screens. Recreating family recipes and balancing complex spices by instinct.
                  </p>
                </div>
              </div>

              <!-- Bottom Bar: Title + Subtle Flip Hint -->
              <div class="mt-1.5 px-0.5 flex items-center justify-between">
                <span class="font-display font-medium text-[13px] sm:text-[13.5px] text-[var(--text-primary)]">Cooking</span>
                <span class="polaroid-flip-indicator inline-flex items-center gap-1 font-sans text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-[color,opacity] duration-160 opacity-80 group-hover:opacity-100">
                  <span class="indicator-read">Thoughts</span>
                  <span class="indicator-close hidden">Close</span>
                  <svg class="indicator-icon size-3 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17l9.2-9.2M17 17V8H8"/>
                  </svg>
                </span>
              </div>
            </button>
          </div>

          <!-- Card 5: Soundscapes (Col 9-12) -->
          <div class="sm:col-span-4">
            <button
              type="button"
              class="polaroid-card group relative w-full p-2 sm:p-2.5 bg-[var(--surface-subtle)] rounded-[14px] cursor-pointer text-left active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] -rotate-1 hover:rotate-0"
              data-lisse="14"
              data-polaroid-card
              data-base-rotate="-1"
              aria-label="Soundscapes (tap to reveal thoughts)"
            >
              <div class="polaroid-frame relative w-full aspect-[4/3] rounded-[9px] overflow-hidden bg-[var(--surface)]" data-lisse="9">
                <div class="polaroid-glare" aria-hidden="true"></div>
                
                <!-- Main Image (Blurs out on tap) -->
                <img
                  src={soundscapesImg}
                  alt="Minimalist vinyl turntable and studio headphones workspace"
                  class="polaroid-img w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />

                <!-- In-Place Subtext Narrative Overlay (Comes in on tap) -->
                <div class="polaroid-text-overlay absolute inset-0 p-3.5 sm:p-4 flex flex-col justify-center bg-[var(--surface-raised)]/95 dark:bg-[#121215]/95 backdrop-blur-md">
                  <p class="text-[12px] sm:text-[12.5px] leading-[1.5] text-[var(--text-primary)] font-normal m-0 select-text">
                    Invisible architecture of mood. Analog vinyl warmth and high-tempo rhythms setting the tempo for code.
                  </p>
                </div>
              </div>

              <!-- Bottom Bar: Title + Subtle Flip Hint -->
              <div class="mt-1.5 px-0.5 flex items-center justify-between">
                <span class="font-display font-medium text-[13px] sm:text-[13.5px] text-[var(--text-primary)]">Soundscapes</span>
                <span class="polaroid-flip-indicator inline-flex items-center gap-1 font-sans text-[11px] text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-[color,opacity] duration-160 opacity-80 group-hover:opacity-100">
                  <span class="indicator-read">Thoughts</span>
                  <span class="indicator-close hidden">Close</span>
                  <svg class="indicator-icon size-3 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17l9.2-9.2M17 17V8H8"/>
                  </svg>
                </span>
              </div>
            </button>
          </div>

        </div>

        <p class="text-[14.5px] sm:text-[15px] leading-[1.65] text-[var(--text-secondary)] mt-2">
          Outside of designing tools and writing code, you will usually find me watching Arsenal match replays, experimenting in the kitchen with family recipes, walking around Lagos with a prime lens looking for honest light, or listening to analog vinyl & Afrobeats.
        </p>
      </section>

      <!-- ── 4. Contact & Footer matching home page ── -->
      <ContactSection />
      <PortfolioFooter />

      </div>
    </div>
  </main>
</Layout>

<style>
  /* ─────────────────────────────────────────────────────────
     AUTHENTIC CARDSTOCK TICKET PASS (3D SPRING PARALLAX)
     ───────────────────────────────────────────────────────── */
  .tkt-wrapper {
    position: relative;
    perspective: 900px;
    cursor: pointer;
    animation: ticketEntrance 550ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  @keyframes ticketEntrance {
    0% {
      opacity: 0;
      transform: perspective(800px) translateY(14px) scale(0.96);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: perspective(800px) translateY(0) scale(1);
      filter: blur(0);
    }
  }

  .tkt-card {
    position: relative;
    width: 100%;
    background-color: #ececed;
    border-radius: 4px;
    box-shadow: none;
    transform-style: preserve-3d;
    will-change: transform;
    animation: calmLevitate 6.8s ease-in-out infinite alternate;
  }

  .tkt-paper-texture {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    opacity: 0.25;
    background-image: radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 0);
    background-size: 4px 4px;
    mix-blend-mode: multiply;
    z-index: 2;
  }

  .tkt-card.is-interacting {
    animation-play-state: paused;
  }

  @keyframes calmLevitate {
    0% {
      transform: perspective(800px) translateY(0px) rotateX(1.4deg) rotateY(-1.8deg);
    }
    50% {
      transform: perspective(800px) translateY(-5px) rotateX(-1deg) rotateY(1.5deg);
    }
    100% {
      transform: perspective(800px) translateY(2px) rotateX(1.8deg) rotateY(-1.2deg);
    }
  }

  .tkt-inner-content {
    transform-style: preserve-3d;
    position: relative;
    z-index: 5;
  }

  .tkt-photo-layer {
    transform: translateZ(6px);
    transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tkt-stub-layer {
    transform: translateZ(4px);
  }

  .tkt-glare {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    pointer-events: none;
    z-index: 8;
    opacity: 0;
    background: radial-gradient(
      circle 180px at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.45) 0%,
      rgba(255, 255, 255, 0.12) 45%,
      transparent 75%
    );
    mix-blend-mode: overlay;
    transition: opacity 280ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .tkt-card {
      animation: none !important;
      transform: none !important;
    }
    .tkt-photo-layer,
    .tkt-stub-layer {
      transform: none !important;
    }
  }

  /* ─────────────────────────────────────────────────────────
     DYNAMIC POLAROID CARDS (BORDERLESS, COMPACT & BLUR SWAP)
     ───────────────────────────────────────────────────────── */
  .polaroid-card {
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03), 0 1px 2px rgba(0, 0, 0, 0.02);
    will-change: transform, box-shadow;
    transform-origin: center center;
  }

  .polaroid-card:hover {
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06), 0 2px 4px rgba(0, 0, 0, 0.03);
  }

  :global([data-theme="dark"]) .polaroid-card {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  :global([data-theme="dark"]) .polaroid-card:hover {
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
  }

  /* Active In-Place Flipped Focus State */
  .polaroid-card.is-flipped {
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.07), 0 2px 6px rgba(0, 0, 0, 0.03);
  }

  :global([data-theme="dark"]) .polaroid-card.is-flipped {
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
  }

  .polaroid-frame {
    position: relative;
    overflow: hidden;
  }

  /* Image Transition: Crystal Sharp -> Atmospheric Ambient Glow */
  .polaroid-img {
    transition: filter 340ms cubic-bezier(0.23, 1, 0.32, 1),
                opacity 340ms cubic-bezier(0.23, 1, 0.32, 1),
                transform 420ms cubic-bezier(0.23, 1, 0.32, 1);
    transform-origin: center center;
    will-change: filter, opacity, transform;
  }

  .polaroid-card.is-flipped .polaroid-img {
    filter: blur(18px) brightness(0.65) saturate(1.2);
    opacity: 0.2;
    transform: scale(1.1);
  }

  /* Text Narrative Overlay: Hidden blur-away -> Crisp reveal */
  .polaroid-text-overlay {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(4px) scale(0.98);
    pointer-events: none;
    transition: opacity 300ms cubic-bezier(0.23, 1, 0.32, 1),
                filter 300ms cubic-bezier(0.23, 1, 0.32, 1),
                transform 320ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: opacity, filter, transform;
  }

  .polaroid-card.is-flipped .polaroid-text-overlay {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .polaroid-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    opacity: 0;
    background: radial-gradient(
      circle 180px at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.32) 0%,
      rgba(255, 255, 255, 0.06) 45%,
      transparent 75%
    );
    mix-blend-mode: overlay;
    transition: opacity 240ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global([data-theme="dark"]) .polaroid-glare {
    background: radial-gradient(
      circle 180px at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.16) 0%,
      rgba(255, 255, 255, 0.03) 45%,
      transparent 75%
    );
    mix-blend-mode: screen;
  }

  /* Subtle Indicator for Polaroid Behind-the-Scenes Thoughts */
  .polaroid-flip-indicator .indicator-read { display: inline; }
  .polaroid-flip-indicator .indicator-close { display: none; }
  
  .polaroid-card.is-flipped .polaroid-flip-indicator .indicator-read { display: none; }
  .polaroid-card.is-flipped .polaroid-flip-indicator .indicator-close { display: inline; }
  .polaroid-card.is-flipped .polaroid-flip-indicator .indicator-icon {
    transform: rotate(45deg);
  }
  .polaroid-card.is-flipped .polaroid-flip-indicator {
    color: var(--text-primary);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .polaroid-card {
      transform: none !important;
      transition: none !important;
    }
    .polaroid-img,
    .polaroid-text-overlay {
      transition: none !important;
    }
  }

  /* Single Icon Visibility for Top Theme Toggle */
  .theme-icon-sun { display: block; }
  .theme-icon-moon { display: none; }
  :global([data-theme="light"]) .theme-icon-sun { display: none !important; }
  :global([data-theme="light"]) .theme-icon-moon { display: block !important; }
</style>

<script>
  import { initLisse } from '../utils/lisse';

  // ── Unified Physics-based 3D Card Tilt Controller (Profile Card & Polaroids) ──
  function setup3DCardTilt() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const cards = document.querySelectorAll<HTMLElement>('[data-tilt-card], .polaroid-card');

    cards.forEach((wrapper) => {
      const target = wrapper.querySelector<HTMLElement>('[data-tilt-target]') || wrapper;
      const glare = wrapper.querySelector<HTMLElement>('.tkt-glare, .polaroid-glare');

      let isHovering = false;
      let isPressed = false;
      let rafId: number | null = null;
      let targetRotateX = 0;
      let targetRotateY = 0;
      let currentRotateX = 0;
      let currentRotateY = 0;
      let currentTranslateZ = 0;
      let targetTranslateZ = 0;

      const isTicket = wrapper.classList.contains('tkt-wrapper');
      const maxTilt = isTicket ? 9 : 3.8;

      const updateSpring = () => {
        if (isHovering && !wrapper.classList.contains('is-flipped')) {
          currentRotateX += (targetRotateX - currentRotateX) * 0.14;
          currentRotateY += (targetRotateY - currentRotateY) * 0.14;
          currentTranslateZ += (targetTranslateZ - currentTranslateZ) * 0.14;

          if (isTicket) {
            target.style.transform = `perspective(900px) rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg) translateZ(${currentTranslateZ.toFixed(1)}px)`;
          } else {
            const baseRot = parseFloat(wrapper.dataset.baseRotate || '0');
            target.style.transform = `perspective(800px) rotate(${baseRot}deg) rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg) translateZ(${currentTranslateZ.toFixed(1)}px)`;
          }

          rafId = requestAnimationFrame(updateSpring);
        }
      };

      const onPointerMove = (e: PointerEvent) => {
        const rect = wrapper.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;

        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const normX = Math.max(-1, Math.min(1, (x - centerX) / centerX));
        const normY = Math.max(-1, Math.min(1, (y - centerY) / centerY));

        targetRotateY = normX * maxTilt;
        targetRotateX = -normY * maxTilt;
        targetTranslateZ = isPressed ? -2 : 4;

        if (glare) {
          const glareX = (x / rect.width) * 100;
          const glareY = (y / rect.height) * 100;
          glare.style.setProperty('--glare-x', `${glareX.toFixed(1)}%`);
          glare.style.setProperty('--glare-y', `${glareY.toFixed(1)}%`);
          glare.style.opacity = isTicket ? '0.35' : '0.24';
        }
      };

      wrapper.addEventListener('pointerenter', () => {
        isHovering = true;
        isPressed = false;
        target.style.transition = 'none';
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(updateSpring);
      });

      wrapper.addEventListener('pointermove', onPointerMove);

      wrapper.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.button !== 0) return;
        isPressed = true;
      });

      wrapper.addEventListener('pointerup', () => {
        isPressed = false;
      });

      wrapper.addEventListener('pointerleave', () => {
        isHovering = false;
        isPressed = false;
        targetRotateX = 0;
        targetRotateY = 0;
        targetTranslateZ = 0;

        if (glare) {
          glare.style.opacity = '0';
        }

        if (isTicket) {
          target.style.transition = 'transform 380ms cubic-bezier(0.23, 1, 0.32, 1)';
          target.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
        } else {
          const baseRot = parseFloat(wrapper.dataset.baseRotate || '0');
          target.style.transition = 'transform 380ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 250ms cubic-bezier(0.23, 1, 0.32, 1)';
          target.style.transform = `perspective(800px) rotate(${baseRot}deg) rotateX(0deg) rotateY(0deg) translateZ(0px)`;
        }
      });
    });
  }

  // ── In-Place Polaroid Image Blur & Narrative Text Swap Controller ──
  function setupPolaroidInteractivity() {
    const cards = document.querySelectorAll<HTMLButtonElement>('[data-polaroid-card]');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const isFlipped = card.classList.contains('is-flipped');
        
        if (isFlipped) {
          card.classList.remove('is-flipped');
          card.setAttribute('aria-expanded', 'false');
        } else {
          card.classList.add('is-flipped');
          card.setAttribute('aria-expanded', 'true');
        }

        // Recompute continuous squircle clip paths with Lisse
        initLisse();
      });
    });
  }

  // ── Theme toggle handler for the top bar button ──
  function setupAboutThemeToggle() {
    const btn = document.querySelector('[data-about-theme-toggle]');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

      document.documentElement.classList.add('theme-switching');
      document.documentElement.dataset.theme = nextTheme;

      try {
        localStorage.setItem('portfolio-theme', nextTheme);
      } catch (err) {
        console.warn('LocalStorage error:', err);
      }

      setTimeout(() => {
        document.documentElement.classList.remove('theme-switching');
        initLisse();
      }, 120);
    });
  }

  function initAboutPage() {
    initLisse();
    setup3DCardTilt();
    setupPolaroidInteractivity();
    setupAboutThemeToggle();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutPage);
  } else {
    initAboutPage();
  }
  document.addEventListener('astro:page-load', initAboutPage);
</script>
