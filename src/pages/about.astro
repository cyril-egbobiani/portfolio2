---
// src/pages/about.astro — The human half.
// Design system: a ring-framed photo beside "Of me", the story with one line
// pulled out as a quote, then the Off the clock gallery (Gallery A: two
// masonry columns of ring cards with varied heights) and the contact block.
import Layout from '../components/Layout.astro';
import PageTopNav from '../components/PageTopNav.astro';
import { Image } from 'astro:assets';
import profileIntroImg from '../assets/images/optimized/profile-intro.webp';
import photographyImg from '../assets/images/optimized/photography.webp';
import footballImg from '../assets/images/optimized/football.webp';
import cookingImg from '../assets/images/optimized/cooking.webp';
import carsImg from '../assets/images/optimized/cars.webp';
import longWalksImg from '../assets/images/optimized/long-walks.jpg';
import musicImg from '../assets/images/optimized/soundscapes.webp';
import ContactSection from '../components/ContactSection.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';

// Two columns, each a stack; the heights vary so the gallery reads as a wall
// of photos rather than a grid of thumbnails.
const columns = [
  [
    { img: photographyImg, alt: 'Photograph of Lagos', title: 'Photography', note: 'Lagos can be a literal cinema at times.', h: 300 },
    { img: cookingImg, alt: 'Cooking', title: 'Cooking', note: "Mum's influence here, and I'm not mad.", h: 170 },
    { img: musicImg, alt: 'Record player and headphones', title: 'Singing', note: 'Just started.', h: 210 },
  ],
  [
    { img: footballImg, alt: 'Football', title: 'Football', note: 'Come on you Gunners!', h: 170 },
    { img: carsImg, alt: 'Cars', title: 'Cars', note: 'Dream car: the GT 63 S 4-door coupé E Performance. Yes, that one.', h: 280 },
    { img: longWalksImg, alt: 'A long walk', title: 'Long walks', note: 'How I decompress, watch the city and think.', h: 230 },
  ],
];

const rewatching = ['iCarly', 'Victorious', 'Sam & Cat'];
---

<Layout
  title="About Cyril Egbobiani — Software Engineer & Product Designer"
  description="The human half of Cyril Egbobiani. Background, philosophy, personal interests, photography, and creative explorations."
>
  <PageTopNav />

  <main id="content" tabindex="-1" class="page-blur-entry min-h-screen bg-[var(--surface)] px-6 sm:px-8 pt-[112px] sm:pt-[140px] pb-24 sm:pb-32 font-[var(--font-sans)] text-[var(--text-primary)] antialiased">
    <div class="mx-auto flex w-full max-w-[640px] flex-col gap-20 sm:gap-[88px]">

      <!-- Photo, title and story are one group: the heading sits just above
           the paragraphs it introduces instead of floating on its own -->
      <div class="about-intro">
      <section class="about-hero">
        <div class="about-photo">
          <Image src={profileIntroImg} alt="Cyril Egbobiani" width={192} height={192} class="about-photo__img" loading="eager" />
        </div>
        <h1 class="about-title">Of me</h1>
      </section>

      <section class="about-story">
        <p>
          Drawing became a coping tool for me at a very young age. It was just me and my notebook… then it
          finished. I drew on almost anything in sight, but my mum's beating finally humbled me.
        </p>
        <p>Then I came across tech, coding in particular.</p>
        <blockquote class="about-quote">
          “It was so weird seeing someone write some combination of letters just to create a rectangle.”
        </blockquote>
        <p>
          I didn't really like the process, but I was a big fan of the result. As time passed, I knew I had to
          learn how to code, and it's been an awesome rollercoaster ever since.
        </p>
      </section>
      </div>

      <section class="flex flex-col gap-6" aria-labelledby="offClock">
        <div class="section-head">
          <div class="section-head__text">
            <h2 id="offClock" class="section-title">Off the clock</h2>
          </div>
        </div>

        <div class="gallery">
          {columns.map((column) => (
            <div class="gallery__col">
              {column.map((item) => (
                <figure class="shot">
                  <div class="shot__frame">
                    <div class="shot__well" style={`height: ${item.h}px`}>
                      <Image src={item.img} alt={item.alt} widths={[320, 640]} sizes="(min-width: 640px) 312px, 45vw" class="shot__img" loading="lazy" decoding="async" />
                    </div>
                  </div>
                  <figcaption class="shot__cap">
                    <span class="shot__title">{item.title}</span>
                    <span class="shot__note">{item.note}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>

        <div class="rewatch">
          <span class="rewatch__label">Rewatching for the humour:</span>
          {rewatching.map((show) => <span class="rewatch__pill">{show}</span>)}
        </div>
      </section>

      <ContactSection />
      <PortfolioFooter />
    </div>
  </main>
</Layout>

<style>
  /* ── Hero + story, one group ──────────────────────────── */
  .about-intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .about-hero {
    display: flex;
    align-items: flex-end;
    gap: 20px;
  }

  /* Ring frame: 10 = 6 + 4 */
  .about-photo {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    padding: 4px;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
  }

  .about-photo :global(.about-photo__img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-inset);
    object-fit: cover;
    object-position: 50% 25%;
  }

  .about-title {
    margin: 0;
    font-family: var(--font-title);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  /* ── Story ────────────────────────────────────────────── */
  .about-story {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-story p {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .about-quote {
    margin: 0;
    padding: 4px 0 4px 20px;
    border-left: 1px solid var(--border-default);
    font-family: var(--font-title);
    font-size: 22px;
    line-height: 1.4;
    color: var(--text-primary);
  }

  /* ── Gallery A: two masonry columns ───────────────────── */
  .gallery {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .gallery__col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .shot__frame {
    padding: 4px;
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
  }

  .shot__well {
    overflow: hidden;
    border-radius: var(--radius-inset);
    background: var(--surface-inset);
  }

  .shot :global(.shot__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 480ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (max-width: 479px) {
    .shot__well { height: auto !important; aspect-ratio: 4 / 5; }
  }

  @media (hover: hover) and (pointer: fine) {
    .shot:hover :global(.shot__img) { transform: scale(1.03); }
  }

  .shot__cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 2px;
  }

  .shot__title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
  }

  .shot__note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .rewatch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .rewatch__label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .rewatch__pill {
    padding: 4px 10px;
    border-radius: 9999px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .shot :global(.shot__img) { transition: none; }
  }
</style>
