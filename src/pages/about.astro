---
// src/pages/about.astro — Dedicated Profile & Human Half Page
import Layout from '../components/Layout.astro';
import BottomNav from '../components/BottomNav.astro';
import profileIntroImg from '../assets/images/optimized/profile-intro.webp?url';
import photographyImg from '../assets/images/optimized/photography.webp?url';
import footballImg from '../assets/images/optimized/football.webp?url';
import cookingImg from '../assets/images/optimized/cooking.webp?url';
import carsImg from '../assets/images/optimized/cars.webp?url';
import profilePolaroid from '../assets/images/optimized/profile-polaroid.webp?url';
import profileAvatar from '../assets/images/optimized/profile-avatar.webp?url';
import ContactSection from '../components/ContactSection.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
---

<Layout
  title="About Cyril Egbobiani — Software Engineer & Designer"
  description="The human half of Cyril Egbobiani. Background, philosophy, personal interests, photography, and creative explorations."
>
  <main class="min-h-screen bg-[var(--surface)] px-6 pt-8 sm:pt-12 pb-28 sm:pb-36 font-[var(--font-sans)] text-[var(--text-primary)] sm:px-8">
    <div class="mx-auto flex w-full max-w-[680px] flex-col gap-12 sm:gap-16">

      <!-- ── 1. Top Navigation Bar: Home (Left) + Theme Toggle (Right) ── -->
      <nav class="flex w-full items-center justify-between" aria-label="Page navigation">
        <a
          href="/"
          class="nav-icon-btn size-9 rounded-full bg-[var(--surface-subtle)] hover:bg-[var(--surface-interactive)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] inline-flex items-center justify-center transition-[background-color,color,transform] duration-160 ease-[var(--ease-smooth-out)] active:scale-95 border border-[var(--border-subtle)] no-underline"
          aria-label="Back to home"
          title="Back to home"
        >
          <svg class="size-4 text-inherit" viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="currentColor" fill-rule="evenodd" d="M10.772 2.688a2 2 0 0 1 2.456 0l8.384 6.521c.753.586.337 1.791-.615 1.791H20v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8h-.997c-.953 0-1.367-1.206-.615-1.79z" clip-rule="evenodd" />
          </svg>
        </a>

        <!-- Theme Toggle Button -->
        <button
          type="button"
          class="nav-icon-btn size-9 rounded-full bg-[var(--surface-subtle)] hover:bg-[var(--surface-interactive)] text-[var(--text-secondary)] inline-flex items-center justify-center transition-[background-color,color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:text-[var(--text-primary)] active:scale-95 cursor-pointer border border-[var(--border-subtle)]"
          aria-label="Toggle theme"
          title="Toggle theme"
          data-about-theme-toggle
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="theme-icon-sun size-4" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="4.5" />
            <path stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M12 2v2.5M12 19.5v2.5M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12h2.5M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"/>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="theme-icon-moon size-4" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.003 3a9 9 0 1 0 8.997 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1h.003z" />
          </svg>
        </button>
      </nav>

      <!-- ── 2. Hero Identity Showcase: Profile Card (Own Row) + Introduction ── -->
      <section class="t-stagger is-shown flex flex-col gap-6 pt-2">
        <!-- Row 1: Tactile Physical Ticket Pass Profile Card -->
        <div class="tkt-wrapper w-full max-w-[185px] sm:max-w-[195px] select-none" aria-label="Cyril Egbobiani — CE Archive verified pass" id="tktWrapper" data-tilt-card>
          <div class="tkt-card relative w-full bg-[#ececed] rounded-[4px] overflow-visible border border-[rgba(60,45,30,0.08)]" id="tktCard" data-tilt-target>

            <!-- Tactile Cardstock Grain Overlay -->
            <div class="tkt-paper-texture pointer-events-none" aria-hidden="true"></div>

            <!-- Specular Light Glare Sheen -->
            <div class="tkt-glare" id="tktGlare" aria-hidden="true"></div>

            <!-- 4 Corner Concave Notches -->
            <div class="absolute -top-2.5 -left-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
            <div class="absolute -top-2.5 -right-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
            <div class="absolute -bottom-2.5 -left-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
            <div class="absolute -bottom-2.5 -right-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>

            <!-- Column Layout Inside Card -->
            <div class="tkt-inner-content flex flex-col p-3 gap-2.5">
              <!-- Top Framed B&W Photo -->
              <div class="tkt-photo-layer w-full aspect-[4/3.8] rounded-[2px] overflow-hidden bg-[#e2e2e5] border border-[rgba(0,0,0,0.06)]">
                <img
                  src={profileIntroImg}
                  alt="Cyril Egbobiani"
                  width="400"
                  height="380"
                  class="w-full h-full object-cover object-[50%_25%] filter grayscale contrast-[1.08] brightness-[0.98]"
                  loading="eager"
                  decoding="async"
                />
              </div>

              <!-- Dashed Perforation Line with Side Notches -->
              <div class="relative w-full my-0.5 flex items-center" aria-hidden="true">
                <div class="absolute -left-[22px] size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10"></div>
                <div class="w-full border-t border-dashed border-[#d4d4d8]"></div>
                <div class="absolute -right-[22px] size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10"></div>
              </div>

              <!-- Bottom Stub: Verified Pass + Barcode -->
              <div class="tkt-stub-layer flex items-center justify-between gap-2 px-0.5">
                <span class="font-sans text-[9.5px] font-bold uppercase tracking-[0.14em] text-[#18181b]">
                  LIVING
                </span>
                <div class="w-11 h-3.5 text-[#18181b] opacity-85 shrink-0" role="img" aria-label="ticket barcode">
                  <svg viewBox="0 0 56 18" fill="currentColor" class="w-full h-full" preserveAspectRatio="none">
                    <rect x="0" y="0" width="2" height="18" />
                    <rect x="4" y="0" width="3" height="18" />
                    <rect x="9" y="0" width="1" height="18" />
                    <rect x="12" y="0" width="2.5" height="18" />
                    <rect x="16" y="0" width="1" height="18" />
                    <rect x="19" y="0" width="3" height="18" />
                    <rect x="24" y="0" width="1.5" height="18" />
                    <rect x="27" y="0" width="2" height="18" />
                    <rect x="31" y="0" width="3.5" height="18" />
                    <rect x="36" y="0" width="1" height="18" />
                    <rect x="39" y="0" width="2" height="18" />
                    <rect x="43" y="0" width="1" height="18" />
                    <rect x="46" y="0" width="3" height="18" />
                    <rect x="51" y="0" width="1.5" height="18" />
                    <rect x="54" y="0" width="2" height="18" />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Row 2: Narrative & Biography -->
        <div class="flex flex-col gap-4 w-full">
       

          <p class="text-[15.5px] leading-[1.7] text-[var(--text-secondary)]">
            Drawing became a coping tool for me at a very young age, It was just me and my notebook... then it finished. I drew almost on anything in sight but my mum's beating finally humbled me.
          </p>

          <p class="text-[15.5px] leading-[1.7] text-[var(--text-secondary)]">
Then I came across tech, coding in particular. It was so weird seeing someone write some combination of letters just to create a rectangle, I didn't really like the process but was a big fan of the result.          </p>
          <p class="text-[15.5px] leading-[1.7] text-[var(--text-secondary)]">
As time passed, I knew I had to learn how to code and it's been an awesome rollercoaster ever since.</p>

        </div>
      </section>

      <!-- ── 3. Dynamic Visual Moodboard ── -->
      <section class="flex flex-col gap-8 pt-2">
        <div class="section-head reveal-item">
          <div class="section-head__text">
            <h2 class="section-title font-display leading-[1.4] tracking-normal font-bold text-[20px]">My other domains</h2>
          </div>
        </div>

        <!-- Dynamic Graphic Layout (Natural page surface, no enclosing poster box) -->
        <div class="relative w-full flex flex-col gap-8 sm:gap-11">

          <!-- Unit 1: Top Wide Landscape Frame (Cars) + Explanation -->
          <div class="flex flex-col sm:flex-row items-start justify-between gap-5 sm:gap-8 w-full">
            <!-- Frame 1: Cars -->
            <div class="dynamic-frame-wrapper w-full sm:w-[62%] aspect-[16/10.5]" data-tilt-card>
              <div class="dynamic-frame w-full h-full shadow-xs" data-tilt-target>
                <div class="dynamic-frame-glare" aria-hidden="true"></div>
                <div class="dynamic-frame-inner">
                  <img src={carsImg} alt="Automotive design & classic silhouettes" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
              </div>
            </div>

            <!-- Text 1: Cars Explanation -->
            <div class="flex flex-col gap-1.5 sm:w-[35%] sm:pt-2">
              <h3 class="font-display text-[18px] sm:text-[19px] font-semibold text-[var(--text-primary)] m-0 leading-tight">Cars</h3>
              <p class="text-[14px] leading-[1.65] text-[var(--text-secondary)] m-0">
                Automotive design, classic silhouettes, and an obsession with 80s turbo aerodynamics.
              </p>
            </div>
          </div>

          <!-- Unit 2: Photography Frame (Left) + Centerpiece Hero Portrait (Right) with Overlap -->
          <div class="relative flex flex-col sm:flex-row items-start justify-between gap-6 sm:gap-7 w-full my-1">
            
            <!-- Left: Photography Frame + Text -->
            <div class="flex flex-col gap-3 w-full sm:w-[40%]">
              <div class="dynamic-frame-wrapper w-full aspect-[4/4.6]" data-tilt-card>
                <div class="dynamic-frame w-full h-full shadow-xs" data-tilt-target>
                  <div class="dynamic-frame-glare" aria-hidden="true"></div>
                  <div class="dynamic-frame-inner">
                    <img src={photographyImg} alt="Street & portraiture photography around Lagos" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                  </div>
                </div>
              </div>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-[17px] sm:text-[18px] font-semibold text-[var(--text-primary)] m-0 leading-tight">Photography</h3>
                <p class="text-[13.5px] leading-[1.6] text-[var(--text-secondary)] m-0">
                  Street &amp; portraiture around Lagos with a prime lens, always looking for honest light.
                </p>
              </div>
            </div>

            <!-- Right: Centerpiece Hero Frame (Cyril Portrait) + Text -->
            <div class="flex flex-col gap-3 w-full sm:w-[56%] sm:-ml-2 sm:mt-2 z-10">
              <div class="dynamic-frame-wrapper w-full aspect-[4/3.8]" data-tilt-card>
                <div class="dynamic-frame dynamic-frame--hero w-full h-full shadow-md" data-tilt-target>
                  <div class="dynamic-frame-glare" aria-hidden="true"></div>
                  <div class="dynamic-frame-inner">
                    <img src={profilePolaroid} alt="Cyril Egbobiani" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                  </div>
                </div>
              </div>
              <div class="flex flex-col gap-1">
                <h3 class="font-display text-[18px] sm:text-[20px] font-semibold text-[var(--text-primary)] m-0 leading-tight">Cyril Egbobiani</h3>
                <p class="text-[14px] leading-[1.65] text-[var(--text-secondary)] m-0">
                  Software engineer &amp; UI/UX designer building at the intersection of systematic code and tactile craft.
                </p>
              </div>
            </div>

          </div>

          <!-- Unit 3: Football Frame + Explanation -->
          <div class="flex flex-col sm:flex-row items-start justify-between gap-5 sm:gap-8 w-full">
            <!-- Frame 3: Football -->
            <div class="dynamic-frame-wrapper w-full sm:w-[54%] aspect-[4/3.3] sm:ml-4" data-tilt-card>
              <div class="dynamic-frame w-full h-full shadow-xs" data-tilt-target>
                <div class="dynamic-frame-glare" aria-hidden="true"></div>
                <div class="dynamic-frame-inner">
                  <img src={footballImg} alt="Football tactics and Arsenal matchdays" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
              </div>
            </div>

            <!-- Text 3: Football Explanation -->
            <div class="flex flex-col gap-1.5 sm:w-[40%] sm:pt-2">
              <h3 class="font-display text-[18px] sm:text-[19px] font-semibold text-[var(--text-primary)] m-0 leading-tight">Football</h3>
              <p class="text-[14px] leading-[1.65] text-[var(--text-secondary)] m-0">
                Tactics &amp; matchdays. Watching Arsenal through the banter and the beauty.
              </p>
            </div>
          </div>

          <!-- Unit 4: Bottom Alcove Frame (Cooking) + Explanation -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-8 w-full pt-2">
            <div class="dynamic-frame-wrapper w-[175px] sm:w-[195px] aspect-[4/4.2] shrink-0" data-tilt-card>
              <div class="dynamic-frame w-full h-full shadow-xs" data-tilt-target>
                <div class="dynamic-frame-glare" aria-hidden="true"></div>
                <div class="dynamic-frame-inner">
                  <img src={cookingImg} alt="Cooking culinary experiments" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-1.5 text-center sm:text-left max-w-[280px]">
              <h3 class="font-display text-[17px] sm:text-[18px] font-semibold text-[var(--text-primary)] m-0 leading-tight">Cooking</h3>
              <p class="text-[13.5px] leading-[1.6] text-[var(--text-secondary)] m-0">
                Culinary experiments, family recipes, and finding flow away from computer monitors.
              </p>
            </div>
          </div>

        </div>

        <p class="text-[15.5px] leading-[1.7] text-[var(--text-secondary)] mt-2">
          Outside of designing tools and writing code, you will usually find me watching Arsenal match replays, experimenting in the kitchen with family recipes, or walking around Lagos with a prime lens looking for honest light.
        </p>
      </section>

      <!-- ── 4. Contact & Footer matching home page ── -->
      <ContactSection />
      <PortfolioFooter />

    </div>
  </main>

  <!-- Bottom Floating Dock Navigation -->
  <BottomNav />
</Layout>

<style>
  /* ─────────────────────────────────────────────────────────
     AUTHENTIC CARDSTOCK TICKET PASS (3D SPRING PARALLAX)
     ───────────────────────────────────────────────────────── */
  .tkt-wrapper {
    position: relative;
    perspective: 900px;
    cursor: pointer;
    animation: ticketEntrance 550ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  @keyframes ticketEntrance {
    0% {
      opacity: 0;
      transform: perspective(800px) translateY(14px) scale(0.96);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: perspective(800px) translateY(0) scale(1);
      filter: blur(0);
    }
  }

  .tkt-card {
    position: relative;
    width: 100%;
    background-color: #ececed;
    border-radius: 4px;
    box-shadow: none;
    transform-style: preserve-3d;
    will-change: transform;
    animation: calmLevitate 6.8s ease-in-out infinite alternate;
  }

  .tkt-paper-texture {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    opacity: 0.25;
    background-image: radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 0);
    background-size: 4px 4px;
    mix-blend-mode: multiply;
    z-index: 2;
  }

  .tkt-card.is-interacting {
    animation-play-state: paused;
  }

  @keyframes calmLevitate {
    0% {
      transform: perspective(800px) translateY(0px) rotateX(1.4deg) rotateY(-1.8deg);
    }
    50% {
      transform: perspective(800px) translateY(-5px) rotateX(-1deg) rotateY(1.5deg);
    }
    100% {
      transform: perspective(800px) translateY(2px) rotateX(1.8deg) rotateY(-1.2deg);
    }
  }

  .tkt-inner-content {
    transform-style: preserve-3d;
    position: relative;
    z-index: 5;
  }

  .tkt-photo-layer {
    transform: translateZ(6px);
    transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tkt-stub-layer {
    transform: translateZ(4px);
  }

  .tkt-glare {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    pointer-events: none;
    z-index: 8;
    opacity: 0;
    background: radial-gradient(
      circle 180px at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.45) 0%,
      rgba(255, 255, 255, 0.12) 45%,
      transparent 75%
    );
    mix-blend-mode: overlay;
    transition: opacity 280ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .tkt-card {
      animation: none !important;
      transform: none !important;
    }
    .tkt-photo-layer,
    .tkt-stub-layer {
      transform: none !important;
    }
  }

  /* ─────────────────────────────────────────────────────────
     DYNAMIC 3D TILT FRAMES
     ───────────────────────────────────────────────────────── */
  .dynamic-frame-wrapper {
    position: relative;
    perspective: 900px;
    transform-style: preserve-3d;
  }

  .dynamic-frame {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 6px;
    transform-style: preserve-3d;
    will-change: transform, box-shadow;
    transform: perspective(900px) rotateX(0deg) rotateY(0deg) translateZ(0px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .dynamic-frame.is-interacting {
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04);
    border-color: var(--border-default);
  }

  :global([data-theme="dark"]) .dynamic-frame.is-interacting {
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.42), 0 2px 8px rgba(0, 0, 0, 0.2);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .dynamic-frame-glare {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    pointer-events: none;
    z-index: 10;
    opacity: 0;
    background: radial-gradient(
      circle 200px at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.45) 0%,
      rgba(255, 255, 255, 0.12) 40%,
      transparent 75%
    );
    mix-blend-mode: overlay;
    transition: opacity 260ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global([data-theme="dark"]) .dynamic-frame-glare {
    background: radial-gradient(
      circle 200px at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0.06) 45%,
      transparent 75%
    );
    mix-blend-mode: screen;
  }

  .dynamic-frame-inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 4px;
    background-color: var(--surface-subtle);
    transform-style: preserve-3d;
    transform: translateZ(6px);
  }

  .dynamic-frame-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .dynamic-frame--hero {
    border-color: var(--border-default);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
  }

  :global([data-theme="dark"]) .dynamic-frame--hero {
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .dynamic-frame {
      transform: none !important;
      transition: none !important;
    }
  }

  /* Single Icon Visibility for Top Theme Toggle */
  .theme-icon-sun { display: block; }
  .theme-icon-moon { display: none; }
  :global([data-theme="light"]) .theme-icon-sun { display: none !important; }
  :global([data-theme="light"]) .theme-icon-moon { display: block !important; }
</style>

<script>
  // ── Unified Physics-based 3D Card Tilt Controller (Profile Card & Moodboard Cards) ──
  function setup3DCardTilt() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const cards = document.querySelectorAll<HTMLElement>('[data-tilt-card]');

    cards.forEach((wrapper) => {
      const target = wrapper.querySelector<HTMLElement>('[data-tilt-target]') || wrapper;
      const glare = wrapper.querySelector<HTMLElement>('.tkt-glare, .dynamic-frame-glare');

      let isHovering = false;
      let isPressed = false;
      let rafId: number | null = null;
      let targetRotateX = 0;
      let targetRotateY = 0;
      let currentRotateX = 0;
      let currentRotateY = 0;
      let currentTranslateZ = 0;
      let targetTranslateZ = 0;
      let currentScale = 1;
      let targetScale = 1;

      const isTicket = wrapper.classList.contains('tkt-wrapper');
      const maxTilt = isTicket ? 9 : 7.5;

      const updateSpring = () => {
        if (isHovering) {
          currentRotateX += (targetRotateX - currentRotateX) * 0.13;
          currentRotateY += (targetRotateY - currentRotateY) * 0.13;
          currentTranslateZ += (targetTranslateZ - currentTranslateZ) * 0.13;
          currentScale += (targetScale - currentScale) * 0.13;

          target.style.transform = `perspective(900px) rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg) translateZ(${currentTranslateZ.toFixed(1)}px) scale(${currentScale.toFixed(3)})`;

          rafId = requestAnimationFrame(updateSpring);
        }
      };

      const onPointerMove = (e: PointerEvent) => {
        const rect = wrapper.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;

        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const normX = Math.max(-1, Math.min(1, (x - centerX) / centerX));
        const normY = Math.max(-1, Math.min(1, (y - centerY) / centerY));

        targetRotateY = normX * maxTilt;
        targetRotateX = -normY * maxTilt;
        targetTranslateZ = isPressed ? -3 : 6;
        targetScale = isPressed ? 0.985 : 1.018;

        if (glare) {
          const glareX = (x / rect.width) * 100;
          const glareY = (y / rect.height) * 100;
          glare.style.setProperty('--glare-x', `${glareX.toFixed(1)}%`);
          glare.style.setProperty('--glare-y', `${glareY.toFixed(1)}%`);
          glare.style.opacity = isTicket ? '0.35' : '0.28';
        }
      };

      wrapper.addEventListener('pointerenter', () => {
        isHovering = true;
        isPressed = false;
        target.classList.add('is-interacting');
        target.style.transition = '';
        cancelAnimationFrame(rafId ?? 0);
        rafId = requestAnimationFrame(updateSpring);
      });

      wrapper.addEventListener('pointermove', onPointerMove);

      wrapper.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.button !== 0) return;
        isPressed = true;
        targetTranslateZ = -4;
        targetScale = 0.985;
      });

      wrapper.addEventListener('pointerup', () => {
        isPressed = false;
        if (isHovering) {
          targetTranslateZ = 6;
          targetScale = 1.018;
        }
      });

      wrapper.addEventListener('pointerleave', () => {
        isHovering = false;
        isPressed = false;
        targetRotateX = 0;
        targetRotateY = 0;
        targetTranslateZ = 0;
        targetScale = 1;

        if (glare) {
          glare.style.opacity = '0';
        }

        target.style.transition = 'transform 420ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 420ms cubic-bezier(0.23, 1, 0.32, 1)';
        target.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) translateZ(0px) scale(1)';

        setTimeout(() => {
          if (!isHovering) {
            target.classList.remove('is-interacting');
            target.style.transition = '';
            target.style.transform = '';
          }
        }, 420);
      });
    });
  }

  // ── Theme toggle handler for the top bar button ──
  function setupAboutThemeToggle() {
    const btn = document.querySelector('[data-about-theme-toggle]');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

      document.documentElement.classList.add('theme-switching');
      document.documentElement.dataset.theme = nextTheme;

      try {
        localStorage.setItem('portfolio-theme', nextTheme);
      } catch (err) {
        console.warn('LocalStorage error:', err);
      }

      setTimeout(() => {
        document.documentElement.classList.remove('theme-switching');
      }, 120);
    });
  }

  function initAboutPage() {
    setup3DCardTilt();
    setupAboutThemeToggle();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutPage);
  } else {
    initAboutPage();
  }
  document.addEventListener('astro:page-load', initAboutPage);
</script>
