---
// src/pages/about.astro — The human half.
// About V2: the District 01 figure (the childhood lot) across the top, "Of me", the story (the
// rectangle line kept as plain text), then Off the clock as an even 2 × 3 grid of
// 4:3 photos, the rewatching pills, and the contact block.
import Layout from '../components/Layout.astro';
import PageTopNav from '../components/PageTopNav.astro';
import { Image } from 'astro:assets';
import profileIntroImg from '../assets/images/profile.jpg'; // full-resolution original, resized by Astro
import photographyImg from '../assets/images/optimized/photography.webp';
import footballImg from '../assets/images/optimized/football.webp';
import cookingImg from '../assets/images/optimized/cooking.webp';
import carsImg from '../assets/images/optimized/cars.webp';
import longWalksImg from '../assets/images/optimized/long-walks.jpg';
import musicImg from '../assets/images/optimized/soundscapes.webp';
import ContactSection from '../components/ContactSection.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import JourneyDistrict from '../components/JourneyDistrict.astro';

// An even two-column grid of 4:3 photos, so every row lines up.
const photos = [
    { img: photographyImg, alt: 'Photograph of Lagos', title: 'Photography', note: 'Lagos can be a literal cinema at times.' },
    { img: footballImg, alt: 'Football', title: 'Football', note: 'Come on you Gunners!' },
    { img: cookingImg, alt: 'Cooking', title: 'Cooking', note: "Mum's influence here, and I'm not mad." },
    { img: carsImg, alt: 'Cars', title: 'Cars', note: 'Dream car: the GT 63 S 4-door coupé E Performance. Yes, that one.' },
    { img: musicImg, alt: 'Record player and headphones', title: 'Singing', note: 'Just started.' },
    { img: longWalksImg, alt: 'A long walk', title: 'Long walks', note: 'How I decompress, watch the city and think.' },
];

const rewatching = ['iCarly', 'Victorious', 'Sam & Cat'];
---

<Layout
  title="About Cyril Egbobiani — Software Engineer & Product Designer"
  description="The human half of Cyril Egbobiani. Background, philosophy, personal interests, photography, and creative explorations."
>
  <PageTopNav />

  <main id="content" tabindex="-1" class="page-blur-entry min-h-screen bg-[var(--surface)] px-6 sm:px-8 pt-[112px] sm:pt-[140px] pb-24 sm:pb-32 font-[var(--font-sans)] text-[var(--text-primary)] antialiased">
    <div class="mx-auto flex w-full max-w-[700px] flex-col gap-20 sm:gap-[88px]">

      <!-- Photo, title and story are one group: the heading sits just above
           the paragraphs it introduces instead of floating on its own -->
      <div class="about-intro">
      <section class="about-hero">
              <JourneyDistrict />

      
        <h1 class="about-title">Of me</h1>
      </section>

      <section class="about-story">
        <p>
          Drawing became a coping tool for me at a very young age. It was just me and my notebook… then it
          finished. I drew on almost anything in sight, but my mum's beating finally humbled me.
        </p>
        <p>Then I stumbled into tech, coding.</p>
        <p>
          It was so weird (but also cool) seeing someone write some combination of letters and numbers just to create a rectangle.
        </p>
        <p>
          I didn't really like the process, but I was a big fan of the result. As time passed, I knew I had to
          learn how to code, and it's been a rollercoaster ever since.
        </p>
      </section>
      </div>

      <section class="flex flex-col gap-6" aria-labelledby="offClock">
        <div class="section-head">
          <div class="section-head__text">
            <h2 id="offClock" class="section-title">Off the clock</h2>
          </div>
        </div>

        <div class="gallery">
          {photos.map((item) => (
            <figure class="shot">
              <div class="shot__frame">
                <div class="shot__well">
                  <Image src={item.img} alt={item.alt} widths={[320, 640]} sizes="(min-width: 700px) 312px, 45vw" class="shot__img" loading="lazy" decoding="async" />
                </div>
              </div>
              <figcaption class="shot__cap">
                <span class="shot__title">{item.title}</span>
                <span class="shot__note">{item.note}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="rewatch">
          <span class="rewatch__label">Rewatching for the humour:</span>
          {rewatching.map((show) => <span class="rewatch__pill">{show}</span>)}
        </div>
      </section>

      <ContactSection />
      <PortfolioFooter />
    </div>
  </main>
</Layout>

<style>
  /* ── Hero + story, one group ──────────────────────────── */
  .about-intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .about-hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Wide portrait in a ring frame: 10 = 6 + 4 */
  .about-banner {
    padding: 4px;
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
  }

  .about-banner :global(.about-banner__img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    height: auto;
    border-radius: var(--radius-inset);
    object-fit: cover;
    object-position: 50% 62%;
  }

  .about-title {
    margin: 0;
    font-family: var(--font-title);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  /* ── Story ────────────────────────────────────────────── */
  .about-story {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-story p {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* ── Gallery: even 2 × 3 grid ─────────────────────────── */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
  }

  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .shot__frame {
    padding: 4px;
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
  }

  .shot__well {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-inset);
    background: var(--surface-inset);
  }

  .shot :global(.shot__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 480ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .shot:hover :global(.shot__img) { transform: scale(1.03); }
  }

  .shot__cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 2px;
  }

  .shot__title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
  }

  .shot__note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .rewatch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .rewatch__label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .rewatch__pill {
    padding: 4px 10px;
    border-radius: 9999px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .shot :global(.shot__img) { transition: none; }
  }
</style>