---
// Header.astro — Minimal in-flow top bar with brand & live status
---

<header class="w-full flex items-center justify-between pt-5 sm:pt-7 pb-1" id="top">
  <!-- Brand Name -->
  <a href="#top" class="group flex items-center gap-2 text-inherit no-underline" aria-label="Cyril Egbobiani - Home">
    <span class="font-sans font-semibold text-[15px] sm:text-[16px] tracking-tight text-[var(--text-primary)] transition-opacity duration-160 group-hover:opacity-75">
      Cyril Egbobiani
    </span>
  </a>

  <!-- Minimal status / location stamp -->
  <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] tracking-tight">
    <span class="inline-block size-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
    <span>Lagos, NG</span>
  </div>
</header>
