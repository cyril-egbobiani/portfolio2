---
const tabs = ['Builds', 'Designs', 'Playground'];

const projects = {
  Builds: [
    {
      title: 'Cybertron AI',
      year: '2025',
      description: 'Autonomous code intelligence studio & agent workflow engine.',
      link: '#',
      image: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1000&q=80',
    },
    {
      title: 'Stelar Studio',
      year: '2024',
      description: 'High-performance WebGL canvas animation & interactive physics engine.',
      link: '#',
      image: 'https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?auto=format&fit=crop&w=1000&q=80',
    },
    {
      title: 'FirstBank Mobile',
      year: '2024',
      description: 'Fintech mobile banking application redesign & design system.',
      link: '#',
      image: 'https://images.unsplash.com/photo-1559526324-4b87b5e36e44?auto=format&fit=crop&w=1000&q=80',
    },
  ],
  Designs: [
    {
      title: 'Nova Design System',
      year: '2025',
      description: 'Editorial token design system with dark mode priority & motion guidelines.',
      link: '#',
      image: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?auto=format&fit=crop&w=1000&q=80',
    },
    {
      title: 'Pulse Analytics',
      year: '2024',
      description: 'Real-time telemetry dashboard for cloud infrastructure monitoring.',
      link: '#',
      image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1000&q=80',
    },
  ],
  Playground: [
    {
      title: 'Shader Lab',
      year: '2025',
      description: 'Interactive GLSL raymarching fragments and post-processing filters.',
      link: '#',
      image: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1000&q=80',
    },
    {
      title: 'Kinetic Type',
      year: '2024',
      description: 'Variable font spring physics engine driven by cursor velocity.',
      link: '#',
      image: 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1000&q=80',
    },
  ],
};
---

<section class="flex flex-col gap-6" id="projects">
  
  <!-- Section Header + Sliding Tabs Bar -->
  <div class="flex items-center justify-between gap-4">
    <h2 class="m-0 text-base font-normal tracking-[-0.015em] text-[var(--text-muted)]">Work</h2>

    <!-- Sliding Pill Tabs Bar -->
    <div class="tabs-bar w-fit" role="tablist" aria-label="Project categories">
      <span class="tabs-pill" aria-hidden="true"></span>
      {tabs.map((tab, index) => (
        <button
          class={`tab ${index === 0 ? 'tab-active' : ''}`}
          type="button"
          role="tab"
          aria-selected={index === 0}
          data-tab-trigger
          data-tab-id={tab}
        >
          {tab}
        </button>
      ))}
    </div>
  </div>

  <!-- Tab Panels Container -->
  <div class="relative min-h-[300px]">
    {tabs.map((tab) => (
      <div
        class="tab-panel flex flex-col gap-5"
        data-tab-panel
        data-tab-id={tab}
        hidden={tab !== 'Builds'}
      >
        {projects[tab].map((project) => (
          <article class="project-card group relative flex flex-col overflow-hidden rounded-[14px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-2 transition-all duration-300 ease-[var(--ease-smooth-out)] hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)]">
            
            <!-- Project Preview Image Frame with Refined Roundness -->
            <div class="relative aspect-[16/9] sm:aspect-[2.1/1] w-full overflow-hidden rounded-[10px] bg-[var(--surface-interactive)]">
              <img
                src={project.image}
                alt={project.title}
                class="h-full w-full object-cover object-center opacity-85 transition-all duration-500 ease-[var(--ease-smooth-out)] group-hover:opacity-100 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(13,13,13,0.7)] via-transparent to-transparent opacity-50"></div>
              
              <!-- Year Badge -->
              <span class="absolute top-3 right-3 rounded-[6px] border border-[rgba(255,255,255,0.12)] bg-[rgba(13,13,13,0.75)] px-2.5 py-0.5 font-mono text-[11px] text-[var(--text-muted)] backdrop-blur-md">
                {project.year}
              </span>
            </div>

            <!-- Project Details Card Body -->
            <div class="flex flex-col gap-1.5 p-3 sm:p-4">
              <div class="flex items-center justify-between gap-4">
                <h3 class="m-0 font-display text-base sm:text-lg font-normal tracking-[-0.02em] text-[var(--text-primary)] transition-colors group-hover:text-white">
                  {project.title}
                </h3>
                <a
                  href={project.link}
                  class="project-link inline-flex items-center gap-1 font-mono text-xs text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)]"
                  aria-label={`View ${project.title}`}
                >
                  <span>View</span>
                  <svg class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                </a>
              </div>

              <p class="m-0 text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">
                {project.description}
              </p>
            </div>

          </article>
        ))}
      </div>
    ))}
  </div>

</section>

<style>
  /* Kinetic Micro-Interactions */
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      transform: translateY(-2px) scale(1.01);
    }
  }

  .project-card:active {
    transform: scale(0.98);
  }

  .tab:active {
    transform: scale(0.96);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.tabs-bar');
  const pill = bar?.querySelector<HTMLElement>('.tabs-pill');
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]');
  const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');

  const movePill = (tab: HTMLButtonElement, animate: boolean) => {
    if (!pill || !bar) return;
    if (!animate) {
      const prev = pill.style.transition;
      pill.style.transition = 'none';
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
      pill.style.width = `${tab.offsetWidth}px`;
      void pill.offsetWidth;
      pill.style.transition = prev;
    } else {
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
      pill.style.width = `${tab.offsetWidth}px`;
    }
  };

  const activeTrigger = () =>
    [...triggers].find((t) => t.getAttribute('aria-selected') === 'true') ||
    triggers[0];

  const activateTab = (id: string) => {
    const nextTrigger = [...triggers].find((t) => t.dataset.tabId === id);

    triggers.forEach((trigger) => {
      const isActive = trigger.dataset.tabId === id;
      trigger.classList.toggle('tab-active', isActive);
      trigger.setAttribute('aria-selected', String(isActive));
    });

    if (nextTrigger) movePill(nextTrigger, true);

    panels.forEach((panel) => {
      const isTarget = panel.dataset.tabId === id;
      if (isTarget) {
        panel.hidden = false;
        panel.classList.add('is-entering');
        setTimeout(() => panel.classList.remove('is-entering'), 350);
      } else {
        panel.hidden = true;
      }
    });
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.dataset.tabId;
      if (id) activateTab(id);
    });
  });

  requestAnimationFrame(() => {
    const active = activeTrigger();
    if (active) movePill(active, false);
  });
  window.addEventListener('resize', () => {
    const active = activeTrigger();
    if (active) movePill(active, false);
  });
</script>
