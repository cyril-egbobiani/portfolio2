---
// ProjectsSection.astro — Work, as a 2-column grid of ring cards.
// Each card: a 4px frame, a grey well holding the screenshot (or the project's
// name in mono while it has none), then title, year and one line.
// Year comes from the case study frontmatter so it never drifts from the page.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';

const order = ['forge', 'gdg-babcock', 'fbdil-attendance', '9to5er', 'model-portfolio', 'token-extractor'];

const studies = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);

const cards = order.flatMap((slug) => {
  const project = projects.find((p) => p.slug === slug);
  if (!project) return [];
  const study = studies.find((s) => s.id === slug);
  return [{
    slug,
    title: project.title,
    blurb: project.shortBlurb,
    image: project.thumbnailImage,
    device: project.deviceType,
    year: study?.data.year,
    hasPage: Boolean(study),
  }];
});
---

<section class="flex flex-col gap-6 scroll-mt-20 sm:scroll-mt-24" id="projects">
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title">Work</h2>
    </div>
  </div>

  <div class="work-grid">
    {cards.map((card, index) => (
      <a
        href={card.hasPage ? `/projects/${card.slug}` : undefined}
        data-astro-prefetch={card.hasPage ? '' : undefined}
        class={`work-card reveal-item reveal-delay-${(index % 4) + 1}`}
      >
        <div class="work-card__well">
          {card.image ? (
            <Image
              src={card.image}
              alt={`${card.title} preview`}
              widths={card.device === 'phone' ? [160, 320] : [320, 640]}
              sizes="(min-width: 700px) 300px, 90vw"
              class={`work-card__shot work-card__shot--${card.device}`}
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <span class="meta-mono">[ {card.title.toUpperCase()} ]</span>
          )}
        </div>

        <div class="work-card__text">
          <div class="work-card__head">
            <h3 class="work-card__title">{card.title}</h3>
            {card.year && <span class="meta-mono">{card.year}</span>}
          </div>
          <p class="work-card__blurb">{card.blurb}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  @media (min-width: 560px) {
    .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Ring card: 10 = 6 + 4 */
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 4px;
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    color: var(--text-primary);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 320ms var(--ease-bounce);
  }

  .work-card__well {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    box-sizing: border-box;
    border: 1px solid var(--border-inset);
    border-radius: var(--radius-inset);
    background: var(--surface-inset);
  }

  .work-card__shot {
    display: block;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 520ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .work-card__shot--phone { max-height: 90%; max-width: 70%; }
  .work-card__shot--desktop { max-height: 82%; max-width: 88%; }

  .work-card__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 4px 6px 6px;
  }

  .work-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .work-card__title {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .work-card__blurb {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-card[href]:hover { transform: translateY(-2px); }
    .work-card[href]:hover .work-card__shot { transform: scale(1.04); }
  }

  .work-card[href]:active { transform: scale(0.985); }

  .work-card:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-card__shot { transition: none; }
  }
</style>