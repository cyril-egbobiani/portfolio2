---
// ProjectsSection.astro
// Builds  → product cards. Anything listed here is shipped and reachable.
// Designs → visual work. No cards, no detail pages: a masonry gallery that
//           springs open to full view on tap.
// NOTE: build slugs must stay in sync with getStaticPaths in src/pages/projects/[slug].astro
const tabs = ['Builds', 'Designs'];

interface Build {
  slug: string;
  title: string;
  blurb: string;
  tone: 'a' | 'b' | 'c' | 'd';
  image?: string;
}

const builds: Build[] = [
  {
    slug: 'forge',
    title: 'Forge',
    blurb: 'A spiritual app for kids, built around games, teachings, devotions and a church prayer wall.',
    tone: 'a',
  },
  {
    slug: '9to5er',
    title: '9to5er',
    blurb: 'Deep-dives on agencies, for people about to join one.',
    tone: 'b',
  },
  {
    slug: 'model-portfolio',
    title: 'Model Portfolio',
    blurb: 'A site for a friend who models, built around her distinct style sets.',
    tone: 'c',
  },
  {
    slug: 'token-extractor',
    title: 'Token Extractor',
    blurb: 'A browser extension that pulls the real design tokens off any page.',
    tone: 'd',
  },
];

// Placeholder network images with deliberately varied dimensions so the
// masonry sizing is visible. Swap for real design work.
const designs = [
  { src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?auto=format&fit=crop&w=800&h=1080&q=80', alt: 'Design study, portrait', w: 800, h: 1080 },
  { src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&h=520&q=80', alt: 'Dashboard layout', w: 800, h: 520 },
  { src: 'https://images.unsplash.com/photo-1555774698-0b77e0d5fac6?auto=format&fit=crop&w=800&h=800&q=80', alt: 'Interface detail', w: 800, h: 800 },
  { src: 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&w=800&h=1200&q=80', alt: 'Mobile screens', w: 800, h: 1200 },
  { src: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&h=600&q=80', alt: 'Visual exploration', w: 800, h: 600 },
  { src: 'https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?auto=format&fit=crop&w=800&h=950&q=80', alt: 'Type and colour study', w: 800, h: 950 },
];
---

<section class="flex flex-col gap-6" id="projects">

  <div class="section-head">
    <div class="section-head__text">
      <h2 class="section-title">Work</h2>
    </div>

    <div class="tabs-bar w-fit" role="tablist" aria-label="Project categories">
      <span class="tabs-pill" aria-hidden="true"></span>
      {tabs.map((tab, index) => (
        <button
          class={`tab font-mono text-xs font-medium ${index === 0 ? 'tab-active' : ''}`}
          type="button"
          role="tab"
          aria-selected={index === 0}
          data-tab-trigger
          data-tab-id={tab}
        >
          {tab}
        </button>
      ))}
    </div>
  </div>

  <div class="relative">

    <!-- ── BUILDS: product cards ───────────────────────────── -->
    <div class="tab-panel builds-grid" data-tab-panel data-tab-id="Builds">
      {builds.map((project) => (
        <a href={`/projects/${project.slug}`} data-astro-prefetch class="project-card group">
          <div class={`shot shot--${project.tone}`}>
            {project.image ? (
              <img src={project.image} alt={project.title} class="shot__img" loading="lazy" />
            ) : (
              <span class="shot__pending">screenshot</span>
            )}
          </div>

          <div class="card-head">
            <h3 class="card-title">{project.title}</h3>
             
          </div>

          <p class="card-blurb">{project.blurb}</p>
        </a>
      ))}
    </div>

    <!-- ── DESIGNS: masonry gallery, springs open on tap ───── -->
    <div class="tab-panel design-grid" data-tab-panel data-tab-id="Designs" hidden>
      {designs.map((item) => (
        <button type="button" class="design-tile" data-zoom-tile aria-label={`Expand: ${item.alt}`}>
          <img
            src={item.src}
            alt={item.alt}
            width={item.w}
            height={item.h}
            loading="lazy"
          />
          <span class="design-tile__hint" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
            </svg>
          </span>
        </button>
      ))}
    </div>

  </div>
</section>

<!-- Zoom overlay -->
<div id="design-zoom-backdrop" class="design-backdrop" aria-hidden="true"></div>
<button id="design-zoom-close" class="design-close" type="button" aria-label="Close expanded image">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 6l12 12M18 6L6 18" />
  </svg>
</button>

<style>
  /* ── Builds ───────────────────────────────────────────── */
  .builds-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: start;
  }

  @media (min-width: 640px) {
    .builds-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 200ms var(--ease-smooth-out);
    will-change: transform;
  }

  .shot {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      border-color 200ms var(--ease-smooth-out),
      box-shadow 200ms var(--ease-smooth-out);
  }

  .shot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms var(--ease-smooth-out);
    will-change: transform;
  }

  .shot__pending {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }

  .card-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    min-width: 0;
  }

  .card-blurb {
    margin: 5px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      transform: translateY(-3px);
    }
    .project-card:hover .shot {
      border-color: var(--border-default);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
    .project-card:hover .shot__img {
      transform: scale(1.04);
    }
  }

  .project-card:active {
    transform: scale(0.97);
  }

  /* ── Designs: true masonry via CSS columns ────────────── */
  .design-grid {
    columns: 2;
    column-gap: 14px;
  }

  .design-tile {
    display: block;
    width: 100%;
    margin: 0 0 14px;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface-subtle);
    cursor: zoom-in;
    position: relative;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    transition:
      border-color var(--duration-fast) var(--ease-smooth-out),
      transform var(--duration-fast) var(--ease-smooth-out);
  }

  /* Height follows the image's own dimensions — this is what makes the grid dynamic */
  .design-tile img {
    display: block;
    width: 100%;
    height: auto;
  }

  .design-tile__hint {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(13, 13, 13, 0.6);
    backdrop-filter: blur(6px);
    color: #fff;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity var(--duration-quick) var(--ease-smooth-out),
      transform var(--duration-quick) var(--ease-smooth-out);
  }

  .design-tile__hint svg { width: 13px; height: 13px; }

  @media (hover: hover) and (pointer: fine) {
    .design-tile:hover {
      border-color: var(--border-default);
      transform: translateY(-2px);
    }

    .design-tile:hover .design-tile__hint {
      opacity: 1;
      transform: scale(1);
    }
  }

  .design-tile:active { transform: scale(0.985); }

  .design-tile:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  @media (max-width: 420px) {
    .design-grid { column-gap: 10px; }
    .design-tile { margin-bottom: 10px; }
  }

  /* ── Zoom overlay ─────────────────────────────────────── */
  .design-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(9, 9, 9, 0.92);
    backdrop-filter: blur(10px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms var(--ease-smooth-out);
  }

  .design-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .design-close {
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 62;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(28, 28, 28, 0.72);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.92);
    transition:
      opacity 200ms var(--ease-smooth-out),
      transform 200ms var(--ease-smooth-out),
      background-color 160ms var(--ease-smooth-out);
  }

  .design-close.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .design-close svg { width: 17px; height: 17px; }

  @media (hover: hover) and (pointer: fine) {
    .design-close:hover { background: rgba(45, 45, 45, 0.85); }
  }

  .design-close:active { transform: scale(0.92); }

  :global(.design-zoom-clone) {
    position: fixed;
    z-index: 61;
    object-fit: contain;
    border-radius: 10px;
    cursor: zoom-out;
    transform-origin: top left;
    will-change: transform;
    user-select: none;
  }

  /* Staggered entry on tab activation */
  .tab-panel.is-entering > * {
    animation: cardCascade 280ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .tab-panel.is-entering > *:nth-child(1) { animation-delay: 0ms; }
  .tab-panel.is-entering > *:nth-child(2) { animation-delay: 40ms; }
  .tab-panel.is-entering > *:nth-child(3) { animation-delay: 80ms; }
  .tab-panel.is-entering > *:nth-child(4) { animation-delay: 120ms; }
  .tab-panel.is-entering > *:nth-child(5) { animation-delay: 160ms; }
  .tab-panel.is-entering > *:nth-child(6) { animation-delay: 200ms; }

  @keyframes cardCascade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .shot__img,
    .design-tile {
      transition: none;
    }

    .project-card:hover,
    .design-tile:hover {
      transform: none;
    }

    .tab-panel.is-entering > * {
      animation: none;
    }
  }
</style>

<script>
  // ── Tab bar ─────────────────────────────────────────────
  const bar = document.querySelector<HTMLElement>('.tabs-bar');
  const pill = bar?.querySelector<HTMLElement>('.tabs-pill');
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]');
  const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');

  const movePill = (tab: HTMLButtonElement, animate: boolean) => {
    if (!pill || !bar) return;
    if (!animate) {
      const prev = pill.style.transition;
      pill.style.transition = 'none';
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
      pill.style.width = `${tab.offsetWidth}px`;
      void pill.offsetWidth;
      pill.style.transition = prev;
    } else {
      pill.style.transition =
        'transform 220ms cubic-bezier(0.16, 1, 0.3, 1), width 220ms cubic-bezier(0.16, 1, 0.3, 1)';
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
      pill.style.width = `${tab.offsetWidth}px`;
    }
  };

  const activeTrigger = () =>
    [...triggers].find((t) => t.getAttribute('aria-selected') === 'true') || triggers[0];

  const activateTab = (id: string) => {
    const nextTrigger = [...triggers].find((t) => t.dataset.tabId === id);

    triggers.forEach((trigger) => {
      const isActive = trigger.dataset.tabId === id;
      trigger.classList.toggle('tab-active', isActive);
      trigger.setAttribute('aria-selected', String(isActive));
    });

    if (nextTrigger) movePill(nextTrigger, true);

    panels.forEach((panel) => {
      const isTarget = panel.dataset.tabId === id;
      if (isTarget) {
        panel.hidden = false;
        panel.classList.add('is-entering');
        setTimeout(() => panel.classList.remove('is-entering'), 350);
      } else {
        panel.hidden = true;
      }
    });
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.dataset.tabId;
      if (id) activateTab(id);
    });
  });

  requestAnimationFrame(() => {
    const active = activeTrigger();
    if (active) movePill(active, false);
  });
  window.addEventListener('resize', () => {
    const active = activeTrigger();
    if (active) movePill(active, false);
  });

  // ── FLIP spring zoom for design tiles ───────────────────
  const backdrop = document.getElementById('design-zoom-backdrop');
  const closeBtn = document.getElementById('design-zoom-close');
  const tiles = document.querySelectorAll<HTMLButtonElement>('[data-zoom-tile]');

  const SPRING = 'cubic-bezier(0.23, 1, 0.32, 1)';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let clone: HTMLImageElement | null = null;
  let sourceTile: HTMLElement | null = null;
  let isZoomed = false;
  let isAnimating = false;

  const retract = () => {
    if (!clone || !sourceTile || !isZoomed || isAnimating) return;
    isZoomed = false;
    isAnimating = true;

    backdrop?.classList.remove('is-active');
    closeBtn?.classList.remove('is-active');

    const finish = () => {
      if (sourceTile) sourceTile.style.opacity = '1';
      clone?.remove();
      clone = null;
      sourceTile = null;
      isAnimating = false;
      document.body.style.overflow = '';
    };

    if (reduceMotion) {
      finish();
      return;
    }

    // Exit is quicker than entry — the system responding, not the user deciding
    clone.style.transition = `transform 340ms ${SPRING}`;
    clone.style.transform = 'translate3d(0px, 0px, 0) scale(1)';
    clone.addEventListener('transitionend', finish, { once: true });
  };

  tiles.forEach((tile) => {
    tile.addEventListener('click', () => {
      if (isZoomed || isAnimating) return;

      const img = tile.querySelector('img');
      if (!img) return;

      const rect = img.getBoundingClientRect();

      clone = img.cloneNode(true) as HTMLImageElement;
      clone.className = 'design-zoom-clone';
      clone.style.left = `${rect.left}px`;
      clone.style.top = `${rect.top}px`;
      clone.style.width = `${rect.width}px`;
      clone.style.height = `${rect.height}px`;
      document.body.appendChild(clone);

      sourceTile = tile;
      tile.style.opacity = '0';
      isZoomed = true;

      backdrop?.classList.add('is-active');
      closeBtn?.classList.add('is-active');
      document.body.style.overflow = 'hidden';

      // Fit the image inside the viewport, preserving its aspect ratio
      const maxW = Math.min(window.innerWidth * 0.9, 1100);
      const maxH = Math.min(window.innerHeight * 0.86, 940);
      let targetW = maxW;
      let targetH = maxW * (rect.height / rect.width);
      if (targetH > maxH) {
        targetH = maxH;
        targetW = maxH * (rect.width / rect.height);
      }

      const scale = targetW / rect.width;
      const translateX = (window.innerWidth - targetW) / 2 - rect.left;
      const translateY = (window.innerHeight - targetH) / 2 - rect.top;

      if (reduceMotion) {
        clone.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
      } else {
        void clone.offsetWidth; // force reflow so the transition runs
        clone.style.transition = `transform 420ms ${SPRING}`;
        clone.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
      }

      clone.addEventListener('click', retract);
      closeBtn?.focus();
    });
  });

  backdrop?.addEventListener('click', retract);
  closeBtn?.addEventListener('click', retract);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isZoomed) retract();
  });
</script>
