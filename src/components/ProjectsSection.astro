---
// ProjectsSection.astro
// Builds  → product cards linking to /projects/<slug>.
// Designs → design case studies (src/content/designs) linking to /designs/<slug>,
//           each card showing a "sketch → final" thumbnail.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import DesignThumb from './DesignThumb.astro';

const tabs = ['Builds', 'Designs'];

const builds = projects.map((p) => ({
  slug: p.slug,
  title: p.title,
  blurb: p.shortBlurb,
  image: p.thumbnailImage,
  deviceType: p.deviceType,
}));

// Drafts show while developing only. Lower `order` comes first, then newest year.
const designs = (await getCollection('designs', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year.localeCompare(a.data.year)
);
---

<section class="flex flex-col gap-6 scroll-mt-20 sm:scroll-mt-24" id="projects">

  <div class="section-head reveal-item flex items-center justify-between w-full">
    <div class="section-head__text flex items-center">
      <h2 class="section-title">Work</h2>
    </div>

    <div class="tabs-bar w-fit" role="tablist" aria-label="Project categories">
      <span class="tabs-pill" aria-hidden="true"></span>
      {tabs.map((tab, index) => (
        <button
          class={`tab font-sans text-xs font-medium ${index === 0 ? 'tab-active' : ''}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          data-tab-trigger
          data-tab-id={tab}
        >
          {tab}
        </button>
      ))}
    </div>
  </div>

  <div class="relative">

    <!-- ── BUILDS: framed showcase cards ───────────────────────── -->
    <div class="tab-panel builds-grid is-active" data-tab-panel data-tab-id="Builds">
      {builds.map((project, index) => (
        <a
          href={`/projects/${project.slug}`}
          data-astro-prefetch
          class={`project-card group reveal-item reveal-delay-${(index % 4) + 1}`}
        >
          <div class="frame">
            <div class="frame__stage">
              {project.image ? (
                <Image
                  src={project.image}
                  alt={`${project.title} preview`}
                  widths={project.deviceType === 'phone' ? [160, 320] : [320, 640]}
                  sizes={project.deviceType === 'phone' ? '150px' : '(min-width: 640px) 300px, 80vw'}
                  class={`card-shot card-shot--${project.deviceType}`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : project.deviceType === 'phone' ? (
                <div class="screen screen--phone">
                  <span class="screen__pending">Mobile Screen</span>
                </div>
              ) : (
                <div class="screen screen--desktop">
                  {project.slug === '9to5er' ? (
                    <div class="schematic-agency" aria-hidden="true">
                      <div class="schematic-top">
                        <span class="schematic-chip is-active">Workflow</span>
                        <span class="schematic-chip">Hierarchy</span>
                        <span class="schematic-chip">Health</span>
                      </div>
                      <div class="schematic-grid">
                        <div class="schematic-card">
                          <span class="schematic-card-label">Autonomy Score</span>
                          <span class="schematic-card-val">94%</span>
                          <div class="schematic-bar"><span style="width: 94%;"></span></div>
                        </div>
                        <div class="schematic-card">
                          <span class="schematic-card-label">Design Velocity</span>
                          <span class="schematic-card-val">High</span>
                          <div class="schematic-bar"><span style="width: 82%;"></span></div>
                        </div>
                      </div>
                    </div>
                  ) : project.slug === 'token-extractor' ? (
                    <div class="schematic-tokens" aria-hidden="true">
                      <div class="schematic-tokens-head">
                        <span class="schematic-tokens-title">Computed CSS AST</span>
                        <span class="schematic-tokens-badge">Auto-Sync</span>
                      </div>
                      <div class="schematic-tokens-list">
                        <div class="token-row">
                          <span class="token-color-chip" style="background: var(--text-primary);"></span>
                          <span class="token-var">--color-accent:</span>
                          <span class="token-val">#000000</span>
                        </div>
                        <div class="token-row">
                          <span class="token-color-chip" style="background: var(--text-muted);"></span>
                          <span class="token-var">--font-family:</span>
                          <span class="token-val">'Geist'</span>
                        </div>
                        <div class="token-row">
                          <span class="token-color-chip" style="background: var(--surface-interactive);"></span>
                          <span class="token-var">--border-radius:</span>
                          <span class="token-val">16px</span>
                        </div>
                      </div>
                    </div>
                  ) : project.slug === 'model-portfolio' ? (
                    <div class="schematic-editorial" aria-hidden="true">
                      <span class="schematic-editorial-tag">{project.title.toUpperCase()}</span>
                      <span class="schematic-editorial-title">Editorial Style Sets & Spring Physics</span>
                    </div>
                  ) : (
                    <div class="schematic-editorial" aria-hidden="true">
                      <span class="schematic-editorial-tag">{project.title.toUpperCase()}</span>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>

          <h3 class="card-title">{project.title}</h3>
          <p class="card-blurb">{project.blurb}</p>
        </a>
      ))}
    </div>

    <!-- ── DESIGNS: case studies, sketch → final ─────────────── -->
    <div class="tab-panel builds-grid" data-tab-panel data-tab-id="Designs" hidden>
      {designs.length > 0 ? (
        designs.map((study, index) => (
          <a
            href={`/designs/${study.id}`}
            data-astro-prefetch
            class={`project-card group reveal-item reveal-delay-${(index % 4) + 1}`}
          >
            <div class="frame">
              <div class="frame__stage">
                <DesignThumb
                  title={study.data.title}
                  sketch={study.data.sketch}
                  final={study.data.final}
                  device={study.data.device}
                />
              </div>
            </div>

            <h3 class="card-title">
              {study.data.title}
              {study.data.draft && <span class="card-draft">Draft</span>}
            </h3>
            <p class="card-blurb">{study.data.summary}</p>
          </a>
        ))
      ) : (
        <p class="designs-empty">
          <span class="designs-empty__hand">case studies on the way</span>
          <span>Sketches, wireframes, and the thinking behind the final screens.</span>
        </p>
      )}
    </div>

  </div>
</section>

<style>
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  /* ── Segmented Sliding Pill Tab Bar ── */
  .tabs-bar {
    position: relative;
    display: inline-flex;
    align-items: center;
    background: var(--surface-subtle);
    padding: 3px;
    border-radius: 9999px;
    border: none;
    box-sizing: border-box;
  }

  .tabs-pill {
    position: absolute;
    top: 3px;
    left: 0;
    height: calc(100% - 6px);
    background: var(--surface);
    border-radius: 9999px;
    will-change: transform, width;
    pointer-events: none;
    box-sizing: border-box;
  }

  .tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 18px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 9999px;
    transition: color 160ms var(--ease-smooth-out), transform 120ms var(--ease-smooth-out);
    user-select: none;
  }

  .tab:active {
    transform: scale(0.96);
  }

  .tab.tab-active,
  .tab[aria-selected="true"] {
    color: var(--text-primary);
  }

  .tab:hover {
    color: var(--text-primary);
  }

  /* ── Tab Panels Switching Animation ── */
  .tab-panel[hidden] {
    display: none !important;
  }

  .tab-panel:not([hidden]),
  .tab-panel.is-active {
    display: block !important;
  }

  /* Animate only when switching tabs, never on first load */
  .tab-panel.is-entering {
    animation: tabFadeIn 320ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  .builds-grid:not([hidden]),
  .builds-grid.is-active {
    display: grid !important;
  }

  @keyframes tabFadeIn {
    0% {
      opacity: 0;
      transform: translateY(12px) scale(0.988);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Stagger child cards/tiles as the active panel slides into view */
  .tab-panel.is-entering .project-card {
    animation: tabItemCascade 340ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  .tab-panel.is-entering .project-card:nth-child(1) { animation-delay: 0ms; }

  .tab-panel.is-entering .project-card:nth-child(2) { animation-delay: 45ms; }

  .tab-panel.is-entering .project-card:nth-child(3) { animation-delay: 90ms; }

  .tab-panel.is-entering .project-card:nth-child(4) { animation-delay: 135ms; }

  @keyframes tabItemCascade {
    0% {
      opacity: 0;
      transform: translateY(14px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-panel,
    .tab-panel.is-entering .project-card {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }

  /* ── Builds: framed showcase cards ───────────────────── */
  .builds-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 640px) {
    .builds-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 28px;
      row-gap: 48px;
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* One quiet panel per card; screenshots sit on it square-edged, unframed */
  .frame {
    border-radius: 16px;
  }

  .frame__stage {
    position: relative;
    aspect-ratio: 1 / 1.02;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface-subtle);
  }

  .screen {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    transition: transform 320ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
  }

  .screen--phone {
    height: 86%;
    aspect-ratio: 9 / 19.5;
  }

  .screen--desktop {
    width: 84%;
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screen__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .screen__pending {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* Mockup images sit straight on the panel: no inner frame, nothing cropped */
  .card-shot {
    display: block;
    width: auto;
    height: auto;
    max-width: 90%;
    max-height: 88%;
    object-fit: contain;
    transition: transform 320ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .card-shot--desktop {
    width: 90%;
  }

  .card-shot--phone {
    height: 86%;
  }

  /* 9to5er Agency UI Preview */
  .schematic-agency {
    width: 100%;
    height: 100%;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-sizing: border-box;
    user-select: none;
  }

  .schematic-top {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .schematic-chip {
    font-family: var(--font-sans);
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 9999px;
    background: var(--surface-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .schematic-chip.is-active {
    color: var(--text-secondary);
    background: var(--surface-interactive);
    border-color: var(--border-default);
    font-weight: 500;
  }

  .schematic-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    flex: 1;
  }

  .schematic-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    gap: 3px;
  }

  .schematic-card-label {
    font-family: var(--font-sans);
    font-size: 9px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .schematic-card-val {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: -0.02em;
  }

  .schematic-bar {
    width: 100%;
    height: 4px;
    border-radius: 9999px;
    background: var(--border-subtle);
    overflow: hidden;
    margin-top: 2px;
  }

  .schematic-bar span {
    display: block;
    height: 100%;
    background: var(--text-faint);
    border-radius: 9999px;
  }

  /* Token Extractor CSS AST Preview */
  .schematic-tokens {
    width: 100%;
    height: 100%;
    padding: 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    user-select: none;
  }

  .schematic-tokens-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .schematic-tokens-title {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    color: var(--text-muted);
  }

  .schematic-tokens-badge {
    font-family: var(--font-sans);
    font-size: 9px;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-weight: 500;
  }

  .schematic-tokens-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .token-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 7px;
    border-radius: 6px;
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    font-family: ui-monospace, monospace;
    font-size: 10px;
  }

  .token-color-chip {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    border: 1px solid var(--border-default);
    flex-shrink: 0;
    opacity: 0.55;
  }

  .token-var {
    color: var(--text-muted);
  }

  .token-val {
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Editorial Preview */
  .schematic-editorial {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    padding: 16px;
  }

  .schematic-editorial-tag {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--text-muted);
  }

  .schematic-editorial-title {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: -0.02em;
    max-width: 220px;
  }

  /* ── Card text ── */
  /* Matches the list-item scale used in Experience & Services */
  .card-title {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .card-blurb {
    margin: 3px 0 0;
    font-size: var(--text-base);
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  @media (min-width: 640px) {
    .card-title { font-size: var(--text-base); }
    .card-blurb { font-size: var(--text-base); }
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover .frame {
      border-color: var(--border-default);
    }
    .project-card:hover .screen,
    .project-card:hover .card-shot {
      transform: translateY(-4px) scale(1.015);
    }
  }

  .project-card:active {
    transform: scale(0.985);
  }

  .project-card:focus-visible {
    outline: none;
  }

  .project-card:focus-visible .frame {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  /* ── Designs: case study cards reuse the Builds card styles ── */
  .card-draft {
    margin-left: 8px;
    padding: 1px 7px;
    border-radius: 9999px;
    background: var(--surface-interactive);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-muted);
    vertical-align: 2px;
  }

  .designs-empty {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 28px 0;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .designs-empty__hand {
    font-family: var(--font-script);
    font-size: 24px;
    color: var(--text-secondary);
  }

  /* Staggered entry on tab activation */
  .tab-panel.is-entering > * {
    animation: cardCascade 280ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .tab-panel.is-entering > *:nth-child(1) { animation-delay: 0ms; }
  .tab-panel.is-entering > *:nth-child(2) { animation-delay: 40ms; }
  .tab-panel.is-entering > *:nth-child(3) { animation-delay: 80ms; }
  .tab-panel.is-entering > *:nth-child(4) { animation-delay: 120ms; }
  .tab-panel.is-entering > *:nth-child(5) { animation-delay: 160ms; }
  .tab-panel.is-entering > *:nth-child(6) { animation-delay: 200ms; }

  @keyframes cardCascade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .screen,
    .card-shot {
      transition: none;
    }

    .project-card:hover {
      transform: none;
    }

    .tab-panel.is-entering > * {
      animation: none;
    }
  }
</style>

<script>
  function initProjectTabs() {
    const bar = document.querySelector<HTMLElement>('.tabs-bar');
    if (!bar) return;

    const pill = bar.querySelector<HTMLElement>('.tabs-pill');
    const triggers = bar.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]');
    const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');

    const movePill = (tab: HTMLElement, animate: boolean) => {
      if (!pill || !bar) return;
      const left = tab.offsetLeft;
      const width = tab.offsetWidth;
      if (width <= 0) return;

      if (!animate) {
        const prev = pill.style.transition;
        pill.style.transition = 'none';
        pill.style.transform = `translateX(${left}px)`;
        pill.style.width = `${width}px`;
        void pill.offsetWidth;
        pill.style.transition = prev;
      } else {
        pill.style.transition =
          'transform 220ms cubic-bezier(0.16, 1, 0.3, 1), width 220ms cubic-bezier(0.16, 1, 0.3, 1)';
        pill.style.transform = `translateX(${left}px)`;
        pill.style.width = `${width}px`;
      }
    };

    const activateTab = (id: string) => {
      const nextTrigger = bar.querySelector<HTMLButtonElement>(`[data-tab-trigger][data-tab-id="${id}"]`);

      triggers.forEach((trigger) => {
        const isActive = trigger.dataset.tabId === id;
        trigger.classList.toggle('tab-active', isActive);
        trigger.setAttribute('aria-selected', String(isActive));
      });

      if (nextTrigger) {
        movePill(nextTrigger, true);
      }

      panels.forEach((panel) => {
        const isTarget = panel.dataset.tabId === id;
        if (isTarget) {
          panel.removeAttribute('hidden');
          panel.hidden = false;
          panel.classList.add('is-active');
          panel.classList.remove('is-entering');
          void panel.offsetWidth;
          panel.classList.add('is-entering');
          setTimeout(() => {
            panel.classList.remove('is-entering');
          }, 380);
        } else {
          panel.setAttribute('hidden', '');
          panel.hidden = true;
          panel.classList.remove('is-active');
          panel.classList.remove('is-entering');
        }
      });
    };

    // Wire delegated click handler on bar (ensures clicks never miss)
    if (!bar.hasAttribute('data-tabs-bound')) {
      bar.setAttribute('data-tabs-bound', 'true');
      bar.addEventListener('click', (e) => {
        const targetBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab-trigger]');
        if (!targetBtn) return;
        e.preventDefault();
        const id = targetBtn.dataset.tabId;
        if (id) activateTab(id);
      });
    }

    // Deep link: /#designs opens the Designs tab (case study back links, "What I do")
    if (window.location.hash === '#designs') {
      activateTab('Designs');
      document.getElementById('projects')?.scrollIntoView({ block: 'start' });
    }

    // Same-page links to /#designs: the page router swallows the hash change,
    // so catch the click first and switch tabs directly
    if (!(window as any).__designsLinkBound) {
      (window as any).__designsLinkBound = true;
      document.addEventListener(
        'click',
        (event) => {
          const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href="/#designs"]');
          const designsTab = document.querySelector<HTMLButtonElement>('[data-tab-trigger][data-tab-id="Designs"]');
          if (!link || !designsTab || window.location.pathname !== '/') return;
          event.preventDefault();
          designsTab.click();
          document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '/#designs');
        },
        { capture: true }
      );
    }

    // Initial pill placement
    const active = bar.querySelector<HTMLButtonElement>('.tab.tab-active') || triggers[0];
    if (active) {
      requestAnimationFrame(() => movePill(active, false));
      setTimeout(() => movePill(active, false), 80);
    }
  }

  function initProjects() {
    initProjectTabs();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjects);
  } else {
    initProjects();
  }
  document.addEventListener('astro:page-load', initProjects);

  window.addEventListener('resize', () => {
    const bar = document.querySelector<HTMLElement>('.tabs-bar');
    const active = bar?.querySelector<HTMLButtonElement>('.tab.tab-active, [aria-selected="true"]');
    const pill = bar?.querySelector<HTMLElement>('.tabs-pill');
    if (bar && active && pill) {
      pill.style.transition = 'none';
      pill.style.transform = `translateX(${active.offsetLeft}px)`;
      pill.style.width = `${active.offsetWidth}px`;
    }
  });
</script>