---
const tabs = ['Builds', 'Designs', 'Playground'];

interface Project {
  slug: string;
  title: string;
  year: string;
  description: string;
  image: string;
  video?: string;
  aspect?: string;
  category?: 'Desktop' | 'Mobile';
}

const projects: Record<string, Project[]> = {
  Builds: [
    {
      slug: 'cybertron-ai',
      title: 'Cybertron AI',
      year: '2025',
      description: 'Autonomous code intelligence studio & agent workflow engine.',
      image: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1000&q=80',
    },
    {
      slug: 'stelar-studio',
      title: 'Stelar Studio',
      year: '2024',
      description: 'High-performance WebGL canvas animation & interactive physics engine.',
      image: 'https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?auto=format&fit=crop&w=1000&q=80',
    },
    {
      slug: 'firstbank-mobile',
      title: 'FirstBank Mobile',
      year: '2024',
      description: 'Fintech mobile banking application redesign & design system.',
      image: 'https://images.unsplash.com/photo-1559526324-4b87b5e36e44?auto=format&fit=crop&w=1000&q=80',
    },
  ],
  Designs: [
    {
      slug: 'nova-design-system',
      title: 'Nova Design System',
      year: '2025',
      description: 'Editorial token design system',
      category: 'Desktop',
      aspect: 'aspect-[16/10]',
      image: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?auto=format&fit=crop&w=1200&q=80',
    },
    {
      slug: 'flow-pay-mobile',
      title: 'Flow Pay Wallet',
      year: '2025',
      description: 'Fintech mobile interface',
      category: 'Mobile',
      aspect: 'aspect-[3/4]',
      image: 'https://images.unsplash.com/photo-1555774698-0b77e0d5fac6?auto=format&fit=crop&w=1000&q=80',
    },
    {
      slug: 'pulse-analytics',
      title: 'Pulse Telemetry',
      year: '2024',
      description: 'Real-time telemetry dashboard',
      category: 'Desktop',
      aspect: 'aspect-[16/10]',
      image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80',
    },
    {
      slug: 'aura-fitness',
      title: 'Aura Companion',
      year: '2024',
      description: 'Minimalist health metric companion',
      category: 'Mobile',
      aspect: 'aspect-[3/4]',
      image: 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&w=1000&q=80',
    },
  ],
  Playground: [
    {
      slug: 'shader-lab',
      title: 'Shader Lab',
      year: '2025',
      description: 'Interactive GLSL raymarching fragments and post-processing filters.',
      image: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1000&q=80',
    },
    {
      slug: 'kinetic-type',
      title: 'Kinetic Type',
      year: '2024',
      description: 'Variable font spring physics engine driven by cursor velocity.',
      image: 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1000&q=80',
    },
  ],
};
---

<section class="flex flex-col gap-6" id="projects">
  
  <!-- Section Header + Sliding Tabs Bar -->
  <div class="flex items-center justify-between gap-4">
    <h2 class="m-0 font-sans text-sm sm:text-base font-normal tracking-tight text-[var(--text-muted)]">Work</h2>

    <!-- Sliding Pill Tabs Bar -->
    <div class="tabs-bar w-fit" role="tablist" aria-label="Project categories">
      <span class="tabs-pill" aria-hidden="true"></span>
      {tabs.map((tab, index) => (
        <button
          class={`tab ${index === 0 ? 'tab-active' : ''}`}
          type="button"
          role="tab"
          aria-selected={index === 0}
          data-tab-trigger
          data-tab-id={tab}
        >
          {tab}
        </button>
      ))}
    </div>
  </div>

  <!-- Tab Panels Container -->
  <div class="relative min-h-[300px]">
    {tabs.map((tab) => (
      <div
        class="tab-panel grid grid-cols-1 sm:grid-cols-2 gap-4 items-start"
        data-tab-panel
        data-tab-id={tab}
        hidden={tab !== 'Builds'}
      >
        {tab === 'Designs' ? (
          /* Pure Visual Gallery (Sharp Rectangular Design Frames inspired by design.gallery) */
          projects[tab].map((project) => (
            <div
              class="design-thumb-card group relative overflow-hidden transition-all duration-300 ease-[var(--ease-smooth-out)] cursor-zoom-in"
              data-spring-zoom-trigger
              data-zoom-src={project.image}
              data-zoom-title={project.title}
            >
              <div class={`relative ${project.aspect || 'aspect-[4/3]'} w-full overflow-hidden`}>
                <img
                  src={project.image}
                  alt={project.title}
                  class="h-full w-full object-cover object-center opacity-95 transition-all duration-500 ease-[var(--ease-smooth-out)] group-hover:scale-[1.03] group-hover:opacity-100"
                  loading="lazy"
                />
                
                <!-- Hover Corner Badge -->
                <div class="absolute bottom-2.5 right-2.5 flex size-7 items-center justify-center rounded-full bg-[rgba(13,13,13,0.7)] text-[var(--text-primary)] opacity-0 backdrop-blur-md transition-all duration-200 group-hover:opacity-100 group-hover:scale-105">
                  <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M20.25 20.25v-4.5m0 4.5h-4.5m4.5 0L15 15" />
                  </svg>
                </div>
              </div>
            </div>
          ))
        ) : (
          /* Builds & Playground Standard Cards */
          projects[tab].map((project) => (
            <a
              href={`/projects/${project.slug}`}
              data-astro-prefetch
              class="project-card group relative flex flex-col justify-between overflow-hidden rounded-[16px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-2 no-underline transition-all duration-300 ease-[var(--ease-smooth-out)] hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)]"
            >
              <div class={`relative ${project.aspect || 'aspect-[4/3]'} w-full overflow-hidden rounded-[8px] bg-[var(--surface-interactive)] border border-[var(--border-subtle)]`}>
                {project.video ? (
                  <video
                    src={project.video}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="h-full w-full object-cover object-center transition-all duration-500 ease-[var(--ease-smooth-out)] group-hover:scale-[1.04]"
                  ></video>
                ) : (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="h-full w-full object-cover object-center opacity-90 transition-all duration-500 ease-[var(--ease-smooth-out)] group-hover:opacity-100 group-hover:scale-[1.04]"
                    loading="lazy"
                  />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-[rgba(13,13,13,0.7)] via-transparent to-transparent opacity-40"></div>
              </div>

              <!-- Bottom Content & Action Trigger Row -->
              <div class="flex items-end justify-between gap-3 pt-2 pb-0.5 px-1">
                <div class="flex flex-col gap-0.5 min-w-0">
                  <h3 class="m-0 font-display text-base font-normal tracking-[-0.03em] text-[var(--text-primary)] truncate">
                    {project.title}
                  </h3>
                  <p class="m-0 text-xs text-[var(--text-muted)] truncate">
                    {project.description}
                  </p>
                </div>

                <div class="project-action-btn flex size-7 sm:size-8 shrink-0 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface-subtle)] text-[var(--text-muted)] transition-all duration-300 ease-[var(--ease-smooth-out)] group-hover:border-[var(--border-strong)] group-hover:bg-[var(--surface-interactive)] group-hover:text-[var(--text-primary)] group-hover:scale-110">
                  <svg class="size-3.5 transition-transform duration-300 ease-[var(--ease-smooth-out)] group-hover:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                </div>
              </div>
            </a>
          ))
        )}
      </div>
    ))}
  </div>

</section>

<!-- Fullscreen FLIP Spring Zoom Backdrop -->
<div
  id="spring-zoom-backdrop"
  class="spring-zoom-backdrop fixed inset-0 z-40 bg-[rgba(13,13,13,0.92)] backdrop-blur-xl transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<style>
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover, .design-thumb-card:hover {
      transform: translateY(-2px);
    }
  }

  .project-card:active, .design-thumb-card:active {
    transform: scale(0.98);
  }

  .tab:active {
    transform: scale(0.96);
  }

  .spring-zoom-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  // Tab Bar Controller
  const bar = document.querySelector<HTMLElement>('.tabs-bar');
  const pill = bar?.querySelector<HTMLElement>('.tabs-pill');
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]');
  const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');

  const movePill = (tab: HTMLButtonElement, animate: boolean) => {
    if (!pill || !bar) return;
    if (!animate) {
      const prev = pill.style.transition;
      pill.style.transition = 'none';
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
      pill.style.width = `${tab.offsetWidth}px`;
      void pill.offsetWidth;
      pill.style.transition = prev;
    } else {
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
      pill.style.width = `${tab.offsetWidth}px`;
    }
  };

  const activeTrigger = () =>
    [...triggers].find((t) => t.getAttribute('aria-selected') === 'true') ||
    triggers[0];

  const activateTab = (id: string) => {
    const nextTrigger = [...triggers].find((t) => t.dataset.tabId === id);

    triggers.forEach((trigger) => {
      const isActive = trigger.dataset.tabId === id;
      trigger.classList.toggle('tab-active', isActive);
      trigger.setAttribute('aria-selected', String(isActive));
    });

    if (nextTrigger) movePill(nextTrigger, true);

    panels.forEach((panel) => {
      const isTarget = panel.dataset.tabId === id;
      if (isTarget) {
        panel.hidden = false;
        panel.classList.add('is-entering');
        setTimeout(() => panel.classList.remove('is-entering'), 350);
      } else {
        panel.hidden = true;
      }
    });
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.dataset.tabId;
      if (id) activateTab(id);
    });
  });

  requestAnimationFrame(() => {
    const active = activeTrigger();
    if (active) movePill(active, false);
  });
  window.addEventListener('resize', () => {
    const active = activeTrigger();
    if (active) movePill(active, false);
  });

  // FLIP Spring Shared-Element Zoom & Retraction Engine
  const backdrop = document.getElementById('spring-zoom-backdrop');
  const zoomCards = document.querySelectorAll<HTMLElement>('[data-spring-zoom-trigger]');
  let activeClone: HTMLImageElement | null = null;
  let activeSourceEl: HTMLElement | null = null;
  let isZoomed = false;

  const retractZoom = () => {
    if (!activeClone || !activeSourceEl || !isZoomed) return;
    isZoomed = false;

    if (backdrop) backdrop.classList.remove('is-active');

    // Smooth retraction back to exact origin translate3d(0, 0, 0) scale(1)
    activeClone.style.transition = 'transform 380ms cubic-bezier(0.23, 1, 0.32, 1)';
    activeClone.style.transform = 'translate3d(0px, 0px, 0) scale(1)';

    const handleEnd = () => {
      if (activeSourceEl) activeSourceEl.style.opacity = '1';
      requestAnimationFrame(() => {
        if (activeClone && activeClone.parentNode) {
          activeClone.parentNode.removeChild(activeClone);
        }
        activeClone = null;
        activeSourceEl = null;
        document.body.style.overflow = '';
      });
    };

    activeClone.addEventListener('transitionend', handleEnd, { once: true });
  };

  zoomCards.forEach((card) => {
    card.addEventListener('click', () => {
      if (isZoomed) {
        retractZoom();
        return;
      }

      const imgEl = card.querySelector('img');
      const src = card.dataset.zoomSrc;
      if (!imgEl || !src) return;

      isZoomed = true;
      activeSourceEl = card;
      const sourceRect = imgEl.getBoundingClientRect();

      // Create Shared Element FLIP Clone at exact thumbnail rect
      const clone = document.createElement('img');
      clone.src = src;
      clone.className = 'fixed z-50 shadow-2xl object-contain cursor-zoom-out select-none';
      clone.style.left = `${sourceRect.left}px`;
      clone.style.top = `${sourceRect.top}px`;
      clone.style.width = `${sourceRect.width}px`;
      clone.style.height = `${sourceRect.height}px`;
      clone.style.transformOrigin = 'top left';
      clone.style.willChange = 'transform';

      document.body.appendChild(clone);
      activeClone = clone;
      card.style.opacity = '0';

      if (backdrop) backdrop.classList.add('is-active');
      document.body.style.overflow = 'hidden';

      // Calculate uniform target scale in viewport
      const maxW = Math.min(window.innerWidth * 0.9, 1200);
      const maxH = Math.min(window.innerHeight * 0.85, 900);
      
      let targetW = maxW;
      let targetH = maxW * (sourceRect.height / sourceRect.width);
      if (targetH > maxH) {
        targetH = maxH;
        targetW = maxH * (sourceRect.width / sourceRect.height);
      }

      const targetLeft = (window.innerWidth - targetW) / 2;
      const targetTop = (window.innerHeight - targetH) / 2;

      const scale = targetW / sourceRect.width;
      const translateX = targetLeft - sourceRect.left;
      const translateY = targetTop - sourceRect.top;

      // Force reflow
      void clone.offsetWidth;

      // Uniform spring scale to center
      clone.style.transition = 'transform 420ms cubic-bezier(0.23, 1, 0.32, 1)';
      clone.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;

      clone.addEventListener('click', retractZoom);
    });
  });

  if (backdrop) backdrop.addEventListener('click', retractZoom);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isZoomed) {
      retractZoom();
    }
  });
</script>
