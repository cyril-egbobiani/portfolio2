---
import { Image } from 'astro:assets';
import ieslLogo from '../assets/images/iesl-logo.png';
import firstBankLogo from '../assets/images/first-bank-logo.png';
import globeSvg from '../assets/images/globe.svg';

interface ExperienceItem {
  company: string;
  role: string;
  dates: string;
  location?: string;
  logo?: ImageMetadata | string;
  themeAdaptive?: boolean;
  description: string;
  highlights: string[];
}

const experience: ExperienceItem[] = [
  {
    company: 'International Energy Services Limited',
    role: 'Frontend Developer & Product Designer',
    dates: '2026 – Present',
    location: 'Lagos, Nigeria',
    logo: ieslLogo,
    themeAdaptive: false,
    description: 'Leading digital product design and frontend architecture for enterprise energy management systems.',
    highlights: [
      'Architected high-throughput web dashboards handling real-time telemetry datasets.',
      'Established tokenized design system streamlining cross-team UI development.',
      'Optimized client-side rendering pipeline to achieve steady 60fps canvas performance.',
    ],
  },
  {
    company: 'Freelance',
    role: 'Software Developer & Designer',
    dates: '2025 – Present',
    location: 'Remote',
    logo: globeSvg,
    themeAdaptive: true,
    description: 'Designing and engineering bespoke digital experiences, brand identities, and WebGL canvases for global clients.',
    highlights: [
      'Delivered 10+ custom web apps with dark mode priority and kinetic micro-interactions.',
      'Collaborated directly with founders on product positioning and UI engineering.',
    ],
  },
  {
    company: 'First Bank Digital Innovation Lab',
    role: 'Mobile Developer Intern',
    dates: '2024 – 2024',
    location: 'Lagos, Nigeria',
    logo: firstBankLogo,
    themeAdaptive: false,
    description: 'Contributed to the core mobile banking application refactor and cross-platform design system components.',
    highlights: [
      'Redesigned checkout and fund transfer confirmation user flows.',
      'Improved React Native app cold-start launch speed by 35%.',
    ],
  },
];
---

<section class="relative flex flex-col gap-6" id="experience">
  <div class="section-head">
    <div class="section-head__text">
      <h2 class="section-title">Where I've been.</h2>
      <span class="section-aside">the short version</span>
    </div>
  </div>

  <div class="flex flex-col divide-y divide-dashed divide-[var(--border-subtle)] border-y border-dashed border-[var(--border-subtle)]" data-experience-list>
    {experience.map((item, index) => (
      <div
        class="experience-card group relative flex flex-col overflow-hidden py-3.5 px-2 sm:px-3 transition-[background-color,border-color,transform] duration-200 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)] cursor-pointer select-none rounded-[6px] active:scale-[0.995]"
        data-experience-item
        data-visible="false"
        data-expanded={index === 0 ? 'true' : 'false'}
        role="button"
        tabindex="0"
        aria-expanded={index === 0 ? 'true' : 'false'}
      >
        <!-- Card Header Row -->
        <div class="flex items-start gap-3.5 sm:gap-4">
          <!-- Logo Badge: Subtle hairline frame (48px x 48px, 12px radius) -->
          <div class={`experience-badge flex size-[46px] sm:size-[50px] shrink-0 items-center justify-center rounded-[12px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-2 transition-transform duration-200 ease-[var(--ease-smooth-out)] group-hover:scale-[1.03] ${item.themeAdaptive ? 'text-[var(--text-primary)]' : ''}`}>
            {item.logo ? (
              typeof item.logo === 'string' ? (
                <img
                  src={item.logo}
                  alt={item.company}
                  class={`max-h-full max-w-full h-auto w-auto object-contain shrink-0 ${item.themeAdaptive ? 'theme-adaptive-svg' : ''}`}
                />
              ) : (
                <Image
                  class={`max-h-full max-w-full h-auto w-auto object-contain shrink-0 ${item.themeAdaptive ? 'theme-adaptive-svg' : ''}`}
                  src={item.logo}
                  alt={item.company}
                />
              )
            ) : (
              <span class="font-mono text-sm font-semibold text-[var(--text-secondary)]">CY</span>
            )}
          </div>

          <!-- Role Summary Header -->
          <div class="flex min-w-0 flex-1 flex-col gap-1 pt-0.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="m-0 font-sans text-[15px] sm:text-[16px] font-medium tracking-[-0.02em] text-[var(--text-primary)]">
                {item.company}
              </h3>
              
              <!-- Rotating Chevron Indicator -->
              <div class="experience-chevron-box flex size-6 items-center justify-center rounded-full text-[var(--text-muted)] transition-[color,transform] duration-200 ease-[var(--ease-smooth-out)] group-hover:text-[var(--text-primary)]">
                <svg class="experience-chevron size-3.5 transition-transform duration-250 ease-[var(--ease-smooth-out)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 text-xs sm:text-[13.5px] text-[var(--text-muted)]">
              <span>{item.role}</span>
              <span class={`experience-dates font-mono tabular-nums text-xs ${item.dates.includes('Present') ? 'is-current' : 'text-[var(--text-muted)]'}`}>
                {item.dates.includes('Present') && <span class="current-dot" aria-hidden="true"></span>}
                {item.dates}
              </span>
            </div>
          </div>
        </div>

        <!-- Expandable Role Drawer (0fr -> 1fr CSS Grid Animation) -->
        <div
          class="experience-drawer grid transition-[grid-template-rows,opacity] duration-250 ease-[var(--ease-smooth-out)]"
          style={index === 0 ? 'grid-template-rows: 1fr; opacity: 1;' : 'grid-template-rows: 0fr; opacity: 0;'}
          data-experience-content
        >
          <div class="overflow-hidden">
            <div class="flex flex-col gap-3 pt-3 pb-1 pl-[58px] sm:pl-[64px]">
              <p class="m-0 font-sans text-[14px] sm:text-[14.5px] leading-[1.65] text-[var(--text-secondary)] font-normal">
                {item.description}
              </p>

              <!-- Highlights Bullet List -->
              <div class="flex flex-col gap-2 pt-1">
                <span class="hand-label">what I actually did</span>
                <ul class="m-0 flex list-none flex-col gap-2 p-0">
                  {item.highlights.map((h, i) => (
                    <li class="flex items-start gap-2.5 text-[13.5px] sm:text-[14px] text-[var(--text-secondary)]">
                      <span class="font-mono tabular-nums text-xs text-[var(--text-muted)] pt-0.5">0{i + 1}</span>
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>

<style>
  /* Chevron rotation state when expanded */
  .experience-card[data-expanded="true"] .experience-chevron {
    transform: rotate(180deg);
  }

  .experience-card[data-expanded="true"] {
    background-color: var(--surface-interactive);
  }

  /* Current roles carry the same ink marker used for in-progress work */
  .experience-dates {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .experience-dates.is-current {
    color: var(--ink);
  }

  .current-dot {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--ink);
    flex-shrink: 0;
  }

  /* Staggered scroll reveal */
  .experience-card {
    opacity: 0;
    transform: translateY(var(--distance-medium));
    transition:
      opacity var(--duration-very-slow) var(--ease-smooth-out),
      transform var(--duration-very-slow) var(--ease-smooth-out),
      background-color 200ms ease;
    transition-delay: calc(var(--index) * var(--duration-stagger));
  }

  .experience-card[data-visible='true'] {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-experience-item]')
  );

  // IntersectionObserver for staggered reveal
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-visible', 'true');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    cards.forEach((card, index) => card.style.setProperty('--index', String(index)));
    cards.forEach((card) => observer.observe(card));
  } else {
    cards.forEach((card) => card.setAttribute('data-visible', 'true'));
  }

  // Tap / Click Accordion Drawer Toggle
  cards.forEach((card) => {
    const toggle = (expand: boolean) => {
      card.setAttribute('data-expanded', String(expand));
      card.setAttribute('aria-expanded', String(expand));
      const drawer = card.querySelector<HTMLElement>('[data-experience-content]');
      if (drawer) {
        drawer.style.gridTemplateRows = expand ? '1fr' : '0fr';
        drawer.style.opacity = expand ? '1' : '0';
      }
    };

    card.addEventListener('click', () => {
      const isExpanded = card.getAttribute('data-expanded') === 'true';

      // Accordion collapse others
      cards.forEach((other) => {
        if (other !== card) {
          other.setAttribute('data-expanded', 'false');
          other.setAttribute('aria-expanded', 'false');
          const otherDrawer = other.querySelector<HTMLElement>('[data-experience-content]');
          if (otherDrawer) {
            otherDrawer.style.gridTemplateRows = '0fr';
            otherDrawer.style.opacity = '0';
          }
        }
      });

      toggle(!isExpanded);
    });

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.click();
      }
    });
  });
</script>
