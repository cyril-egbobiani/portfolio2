---
// ExperienceSection.astro — Where I've been.
// Hairline rows: the dates in mono on the left, the company and one line on
// the right. No arrows; these rows are not links.
// A plain, always-visible timeline. Each role gets one line: the title, what was
// actually done there, and where. Nothing is hidden behind a control — this is
// the section people skim before deciding to get in touch, so detail behind a
// tap is detail most of them never read.

import { Image } from 'astro:assets';
import ieslLogo from '../assets/images/iesl-logo.png';
import firstBankLogo from '../assets/images/first-bank-logo.png';
import globeSvg from '../assets/images/globe.svg';

// The summary is a run of segments so a project can be named inline mid-sentence:
// plain `text`, or `before` + a linked label + `after`.
interface Segment {
  text?: string;
  before?: string;
  link?: { label: string; href: string };
  after?: string;
}

interface ExperienceItem {
  company: string;
  dates: string;
  current?: boolean;
  logo: ImageMetadata;
  themeAdaptive?: boolean;
  summary: Segment[];
}

const experience: ExperienceItem[] = [
  {
    company: 'International Energy Services Limited',
    dates: '2026 — Now',
    current: true,
    logo: ieslLogo,
    summary: [
      { text: 'Software engineer and product designer — the compliance admin panel, now Audit Pro. Lagos, on NYSC.' },
    ],
  },
  {
    company: 'Freelance',
    dates: '2025 — Now',
    current: true,
    logo: globeSvg,
    themeAdaptive: true,
    summary: [
      {
        before: 'Designer and developer, remote. Built ',
        link: { label: 'Dubem', href: '/projects/model-portfolio' },
        after: ', a model’s portfolio organised around her style sets; now a mobile app for GLP users.',
      },
    ],
  },
  {
    company: 'First Bank Digital Innovation Lab',
    dates: '2024 · 6 mo',
    logo: firstBankLogo,
    summary: [
      {
        before: 'Mobile developer intern — six months that put me on Flutter, and an ',
        link: { label: 'attendance system', href: '/projects/fbdil-attendance' },
        after: ' built with fellow interns. Lagos.',
      },
    ],
  },
];
---

<section class="flex flex-col gap-6 scroll-mt-20 sm:scroll-mt-24" id="experience">
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title">Experience</h2>
    </div>
  </div>

  <ol class="xp-list" role="list">
    {experience.map((item) => (
      <li class="xp">
        <span class="xp__dates meta-mono">
          {item.current && <><span class="xp__now" aria-hidden="true" /><span class="sr-only">Current, </span></>}
          {item.dates.toUpperCase()}
        </span>
        <div class="xp__main">
          <span class={`xp__badge ${item.themeAdaptive ? 'xp__badge--adaptive' : ''}`} aria-hidden="true">
            <Image src={item.logo} alt="" class={`xp__logo ${item.themeAdaptive ? 'theme-adaptive-svg' : ''}`} />
          </span>
          <div class="xp__body">
          <h3 class="xp__company">{item.company}</h3>
          <p class="xp__summary">
            {item.summary.map((segment) => (
              <>
                {segment.text}
                {segment.before}
                {segment.link && (
                  <a href={segment.link.href} class="xp__link" data-astro-prefetch>{segment.link.label}</a>
                )}
                {segment.after}
              </>
            ))}
          </p>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .xp-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-subtle);
  }

  .xp {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 560px) {
    .xp {
      flex-direction: row;
      align-items: flex-start;
      gap: 24px;
    }
  }

  .xp__dates {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    gap: 6px;
    width: 112px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .xp__now {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--brand);
  }

  .xp__main {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  /* Logo on a small ring tile: 36 = 4 + 28 + 4 */
  .xp__badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 6px;
    box-sizing: border-box;
    border-radius: var(--radius-tile);
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
  }

  .xp__badge--adaptive { color: var(--text-primary); }

  .xp__badge :global(.xp__logo) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .xp__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .xp__company {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .xp__summary {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .xp__link {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-default);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms var(--ease-smooth-out);
  }

  .xp__link:hover { text-decoration-color: var(--brand); }
</style>
