---
import { Image } from 'astro:assets';
import ieslLogo from '../assets/images/iesl-logo.png';
import firstBankLogo from '../assets/images/first-bank-logo.png';
import globeSvg from '../assets/images/globe.svg';

interface ExperienceItem {
  company: string;
  role: string;
  dates: string;
  location?: string;
  logo?: ImageMetadata | string;
  themeAdaptive?: boolean; // Set to true for single-color SVG logos that should adapt to light/dark mode
  description: string;
  highlights: string[];
}

const experience: ExperienceItem[] = [
  {
    company: 'International Energy Services Limited',
    role: 'Frontend Developer & Product Designer',
    dates: '2026 – Present',
    location: 'Lagos, Nigeria',
    logo: ieslLogo,
    themeAdaptive: false,
    description: 'Leading digital product design and frontend architecture for enterprise energy management systems.',
    highlights: [
      'Architected high-throughput web dashboards handling real-time telemetry datasets.',
      'Established tokenized design system streamlining cross-team UI development.',
      'Optimized client-side rendering pipeline to achieve steady 60fps canvas performance.',
    ],
  },
  {
    company: 'Freelance',
    role: 'Software Developer & Designer',
    dates: '2025 – Present',
    location: 'Remote',
    logo: globeSvg,
    themeAdaptive: true,
    description: 'Designing and engineering bespoke digital experiences, brand identities, and WebGL canvases for global clients.',
    highlights: [
      'Delivered 10+ custom web apps with dark mode priority and kinetic micro-interactions.',
      'Collaborated directly with founders on product positioning and UI engineering.',
    ],
  },
  {
    company: 'First Bank Digital Innovation Lab',
    role: 'Mobile Developer Intern',
    dates: '2024 – 2024',
    location: 'Lagos, Nigeria',
    logo: firstBankLogo,
    themeAdaptive: false,
    description: 'Contributed to the core mobile banking application refactor and cross-platform design system components.',
    highlights: [
      'Redesigned checkout and fund transfer confirmation user flows.',
      'Improved React Native app cold-start launch speed by 35%.',
    ],
  },
];
---

<section class="flex flex-col gap-5" id="experience">
  <div class="flex items-center justify-between">
    <h2 class="m-0 font-mono text-xs font-medium tracking-wider uppercase text-[var(--text-muted)]">Experience</h2>
    <span class="font-mono text-xs text-[var(--text-muted)] opacity-70">TAP TO EXPAND</span>
  </div>

  <div class="flex flex-col divide-y divide-dashed divide-[var(--border-subtle)]" data-experience-list>
    {experience.map((item, index) => (
      <div
        class="experience-card group relative flex flex-col overflow-hidden py-4 px-2 sm:px-3 transition-all duration-300 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)] cursor-pointer select-none rounded-[6px]"
        data-experience-item
        data-visible="false"
        role="button"
        tabindex="0"
        aria-expanded="false"
      >
        <!-- Card Header Row -->
        <div class="flex items-start gap-3.5 sm:gap-4">
          <!-- Logo Badge: Clean subtle hairline frame (54px x 54px, 14px radius, 10px padding) -->
          <div class={`experience-badge flex size-[54px] shrink-0 items-center justify-center rounded-[14px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-2.5 transition-transform duration-200 group-hover:scale-[1.03] ${item.themeAdaptive ? 'text-[var(--text-primary)]' : ''}`}>
            {item.logo ? (
              typeof item.logo === 'string' ? (
                <img
                  src={item.logo}
                  alt={item.company}
                  class={`max-h-full max-w-full h-auto w-auto object-contain shrink-0 ${item.themeAdaptive ? 'theme-adaptive-svg' : ''}`}
                />
              ) : (
                <Image
                  class={`max-h-full max-w-full h-auto w-auto object-contain shrink-0 ${item.themeAdaptive ? 'theme-adaptive-svg' : ''}`}
                  src={item.logo}
                  alt={item.company}
                />
              )
            ) : (
              <span class="font-mono text-base font-semibold text-[var(--text-secondary)]">CY</span>
            )}
          </div>

          <!-- Role Summary Header -->
          <div class="flex min-w-0 flex-1 flex-col gap-1 pt-0.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="m-0 font-sans text-[15.5px] sm:text-[17px] font-medium tracking-[-0.02em] text-[var(--text-primary)]">
                {item.company}
              </h3>
              
              <!-- Rotating Chevron Indicator -->
              <svg class="experience-chevron size-4 shrink-0 text-[var(--text-muted)] opacity-60 transition-all duration-300 ease-[var(--ease-smooth-out)] group-hover:opacity-100 group-hover:text-[var(--text-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 text-[13.5px] sm:text-sm text-[var(--text-muted)]">
              <span>{item.role}</span>
              <span class="font-mono tabular-nums text-xs text-[var(--text-muted)]">{item.dates}</span>
            </div>
          </div>
        </div>

        <!-- Expandable Role Drawer (0fr -> 1fr CSS Grid Animation) -->
        <div class="experience-drawer grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-[var(--ease-smooth-out)]">
          <div class="overflow-hidden">
            <div class="flex flex-col gap-4 pt-4 mt-3.5 border-t border-dashed border-[var(--border-subtle)]">
              <p class="m-0 font-sans text-[14px] sm:text-[14.5px] leading-relaxed text-[var(--text-secondary)]">
                {item.description}
              </p>

              <!-- Highlights Bullet List -->
              <div class="flex flex-col gap-2">
                <span class="font-mono text-xs uppercase tracking-wider text-[var(--text-muted)]">Key Deliverables & Impact</span>
                <ul class="m-0 flex list-none flex-col gap-2 p-0">
                  {item.highlights.map((h, i) => (
                    <li class="flex items-start gap-2.5 text-[13.5px] sm:text-[14px] text-[var(--text-secondary)]">
                      <span class="font-mono tabular-nums text-xs text-[var(--text-muted)] pt-0.5">0{i + 1}</span>
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>

<style>
  .experience-card:active {
    transform: scale(0.985);
  }

  .experience-card[aria-expanded="true"] {
    border-color: var(--border-default);
    background-color: var(--surface-interactive);
  }

  .experience-card[aria-expanded="true"] .experience-drawer {
    grid-template-rows: 1fr;
  }

  .experience-card[aria-expanded="true"] .experience-chevron {
    transform: rotate(180deg);
  }

  /* Staggered reveal */
  .experience-card {
    opacity: 0;
    transform: translateY(var(--distance-medium));
    transition:
      opacity var(--duration-very-slow) var(--ease-smooth-out),
      transform var(--duration-very-slow) var(--ease-smooth-out),
      border-color 200ms ease,
      background-color 200ms ease;
    transition-delay: calc(var(--index) * var(--duration-stagger));
  }

  .experience-card[data-visible='true'] {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-experience-item]')
  );

  // IntersectionObserver for staggered reveal
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-visible', 'true');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    cards.forEach((card, index) => card.style.setProperty('--index', String(index)));
    cards.forEach((card) => observer.observe(card));
  } else {
    cards.forEach((card) => card.setAttribute('data-visible', 'true'));
  }

  // Tap / Click Accordion Drawer Toggle
  cards.forEach((card) => {
    const toggle = () => {
      const isExpanded = card.getAttribute('aria-expanded') === 'true';
      card.setAttribute('aria-expanded', String(!isExpanded));
    };

    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });
</script>
