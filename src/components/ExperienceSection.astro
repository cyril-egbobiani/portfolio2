---
// ExperienceSection.astro — Where I've been.
// A plain, always-visible timeline: each role says what was actually done there,
// in a sentence or two, instead of a title-sized summary.
import { Image } from 'astro:assets';
import ieslLogo from '../assets/images/iesl-logo.png';
import firstBankLogo from '../assets/images/first-bank-logo.png';
import globeSvg from '../assets/images/globe.svg';

// A point may name a project inline: `before` + linked label + `after`
interface Point {
  text?: string;
  before?: string;
  link?: { label: string; href: string };
  after?: string;
}

interface ExperienceItem {
  company: string;
  role: string;
  dates: string;
  current?: boolean;
  location: string;
  logo: ImageMetadata;
  themeAdaptive?: boolean;
  points: Point[];
}

const experience: ExperienceItem[] = [
  {
    company: 'International Energy Services Limited',
    role: 'Software Engineer & Product Designer',
    dates: '2026 – Present · NYSC',
    current: true,
    location: 'Lagos, Nigeria',
    logo: ieslLogo,
    points: [
      { text: 'Redesigned the admin panel for the compliance system.' },
      { text: 'Now redesigning the Audit Pro system, with more internal systems planned to follow.' },
    ],
  },
  {
    company: 'Freelance',
    role: 'Designer & Developer',
    dates: '2025 – Present',
    current: true,
    location: 'Remote',
    logo: globeSvg,
    themeAdaptive: true,
    points: [
      {
        before: 'Designed and built ',
        link: { label: 'Dubem', href: '/projects/model-portfolio' },
        after: ', a portfolio site for a model, organised around her style sets.',
      },
      { text: 'Currently building a mobile app for GLP users.' },
    ],
  },
  {
    company: 'First Bank Digital Innovation Lab',
    role: 'Mobile Developer Intern',
    dates: '2024 · 6 months',
    location: 'Lagos, Nigeria',
    logo: firstBankLogo,
    points: [
      { text: 'A six-month programme that set me on the path to Flutter.' },
      {
        before: 'Built an ',
        link: { label: 'attendance system', href: '/projects/fbdil-attendance' },
        after: ' with fellow developer and UX design interns.',
      },
    ],
  },
];
---

<section class="relative flex flex-col gap-6 scroll-mt-20 sm:scroll-mt-24" id="experience">
  <div class="section-head reveal-item">
    <div class="section-head__text flex items-baseline justify-between w-full">
      <h2 class="section-title">Where I've been</h2>
    </div>
  </div>

  <ol class="xp-list" role="list">
    {experience.map((item) => (
      <li class="xp">
        <div class={`xp__badge ${item.themeAdaptive ? 'xp__badge--adaptive' : ''}`} aria-hidden="true">
          <Image
            src={item.logo}
            alt=""
            class={`xp__logo ${item.themeAdaptive ? 'theme-adaptive-svg' : ''}`}
          />
        </div>

        <div class="xp__body">
          <div class="xp__head">
            <h3 class="xp__company">{item.company}</h3>
            <span class="xp__dates">
              {item.current && <span class="xp__now">Now</span>}
              {item.dates}
            </span>
          </div>

          <p class="xp__role">
            {item.role}
            <span aria-hidden="true">·</span>
            {item.location}
          </p>

          <ul class="xp__points" role="list">
            {item.points.map((point) => (
              <li>
                {point.text}
                {point.before}
                {point.link && (
                  <a href={point.link.href} class="xp__link" data-astro-prefetch>{point.link.label}</a>
                )}
                {point.after}
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .xp-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xp {
    display: flex;
    gap: 16px;
    padding: 20px 0;
  }

  .xp:first-child {
    padding-top: 4px;
  }

  .xp + .xp {
    border-top: 1px solid var(--border-subtle);
  }

  .xp__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 8px;
    border-radius: 10px;
    background: var(--surface-subtle);
  }

  .xp__badge--adaptive {
    color: var(--text-primary);
  }

  .xp__logo {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .xp__body {
    flex: 1;
    min-width: 0;
  }

  .xp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .xp__company {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .xp__dates {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .xp__now {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-primary);
    font-weight: 500;
  }

  .xp__now::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: currentColor;
  }

  .xp__role {
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
    margin: 2px 0 0;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .xp__points {
    display: grid;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .xp__points li {
    position: relative;
    padding-left: 14px;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .xp__points li::before {
    content: '';
    position: absolute;
    top: 0.72em;
    left: 1px;
    width: 4px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--text-faint);
  }

  .xp__link {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-default);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms var(--ease-smooth-out);
  }

  .xp__link:hover {
    text-decoration-color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .xp {
      gap: 18px;
    }

    .xp__badge {
      width: 48px;
      height: 48px;
    }

    .xp__company {
      font-size: var(--text-base);
    }

    .xp__points li {
      font-size: var(--text-base);
    }
  }
</style>
