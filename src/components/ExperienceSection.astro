---
// ExperienceSection.astro — Where I've been.
// A plain, always-visible timeline. Each role gets one line: the title, what was
// actually done there, and where. Nothing is hidden behind a control — this is
// the section people skim before deciding to get in touch, so detail behind a
// tap is detail most of them never read.
import { Image } from 'astro:assets';
import ieslLogo from '../assets/images/iesl-logo.png';
import firstBankLogo from '../assets/images/first-bank-logo.png';
import globeSvg from '../assets/images/globe.svg';

// The summary is a run of segments so a project can be named inline mid-sentence:
// plain `text`, or `before` + a linked label + `after`.
interface Segment {
  text?: string;
  before?: string;
  link?: { label: string; href: string };
  after?: string;
}

interface ExperienceItem {
  company: string;
  dates: string;
  current?: boolean;
  logo: ImageMetadata;
  themeAdaptive?: boolean;
  summary: Segment[];
}

const experience: ExperienceItem[] = [
  {
    company: 'International Energy Services Limited',
    dates: '2026 – Present',
    current: true,
    logo: ieslLogo,
    summary: [
      { text: 'Software engineer and product designer — the compliance admin panel, now Audit Pro. Lagos, on NYSC.' },
    ],
  },
  {
    company: 'Freelance',
    dates: '2025 – Present',
    current: true,
    logo: globeSvg,
    themeAdaptive: true,
    summary: [
      {
        before: 'Designer and developer, remote. Built ',
        link: { label: 'Dubem', href: '/projects/model-portfolio' },
        after: ', a model’s portfolio organised around her style sets; now a mobile app for GLP users.',
      },
    ],
  },
  {
    company: 'First Bank Digital Innovation Lab',
    dates: '2024 · 6 months',
    logo: firstBankLogo,
    summary: [
      {
        before: 'Mobile developer intern — six months that put me on Flutter, and an ',
        link: { label: 'attendance system', href: '/projects/fbdil-attendance' },
        after: ' built with fellow interns. Lagos.',
      },
    ],
  },
];
---

<section class="relative flex flex-col gap-6 scroll-mt-20 sm:scroll-mt-24" id="experience">
  <div class="section-head reveal-item">
    <div class="section-head__text flex items-baseline justify-between w-full">
      <h2 class="section-title">Where I've been</h2>
    </div>
  </div>

  <ol class="xp-list" role="list">
    {experience.map((item) => (
      <li class="xp">
        <div class={`xp__badge ${item.themeAdaptive ? 'xp__badge--adaptive' : ''}`} aria-hidden="true">
          <Image
            src={item.logo}
            alt=""
            class={`xp__logo ${item.themeAdaptive ? 'theme-adaptive-svg' : ''}`}
          />
        </div>

        <div class="xp__body">
          <div class="xp__head">
            <h3 class="xp__company">{item.company}</h3>
            <span class="xp__dates">
              {item.current && <span class="xp__now">Now</span>}
              {item.dates}
            </span>
          </div>

          <p class="xp__summary">
            {item.summary.map((segment) => (
              <>
                {segment.text}
                {segment.before}
                {segment.link && (
                  <a href={segment.link.href} class="xp__link" data-astro-prefetch>{segment.link.label}</a>
                )}
                {segment.after}
              </>
            ))}
          </p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .xp-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xp {
    display: flex;
    gap: 16px;
    padding: 20px 0;
  }

  .xp:first-child {
    padding-top: 4px;
  }

  .xp + .xp {
    border-top: 1px solid var(--border-subtle);
  }

  .xp__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 8px;
    border-radius: 10px;
    background: var(--surface-subtle);
  }

  .xp__badge--adaptive {
    color: var(--text-primary);
  }

  .xp__logo {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .xp__body {
    flex: 1;
    min-width: 0;
  }

  .xp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .xp__company {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .xp__dates {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .xp__now {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-primary);
    font-weight: 500;
  }

  .xp__now::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: currentColor;
  }

  /* --text-muted, matching the supporting line under a title everywhere else
     on the page. --text-secondary sits too close to the company name above it. */
  .xp__summary {
    margin: 3px 0 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .xp__link {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-default);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms var(--ease-smooth-out);
  }

  .xp__link:hover {
    text-decoration-color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .xp {
      gap: 18px;
    }

    .xp__badge {
      width: 48px;
      height: 48px;
    }

    .xp__company {
      font-size: var(--text-base);
    }

    .xp__summary {
      font-size: var(--text-base);
    }
  }
</style>
