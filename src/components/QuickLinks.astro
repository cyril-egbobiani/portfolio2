---
// Quick links — sticky glass top navigation with a scroll-spy that
// highlights the active section via a sliding indicator.
// The profile "About" link routes to /profile.
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { label: 'Work', href: '#projects', external: false },
  { label: 'Experience', href: '#experience', external: false },
  { label: 'Contact', href: '#contact', external: false },
  { label: 'About', href: '/profile', external: true },
];
---

<nav class="quick-links" aria-label="Quick links">
  <a class="quick-links__brand" href="/" aria-label="Home">
  </a>

  <div class="quick-links__menu">
    <span class="quick-links__pill" aria-hidden="true"></span>
    {links.map((link) => (
      <a
        class="quick-links__item"
        href={link.href}
        data-quick-link
        data-scroll-link
      >
        {link.label}
      </a>
    ))}
  </div>
  <ThemeToggle />
</nav>

<style>
  .quick-links {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 56px;
    padding: 0;
    -webkit-backdrop-filter: blur(14px) saturate(150%);
  }

  .quick-links__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0 6px;
    text-decoration: none;
    color: var(--text-primary);
    border-radius: 0.9rem;
  }

  .quick-links__brand svg {
    display: block;
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .quick-links__menu {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 9999px;
    background: var(--surface-subtle);
  }

  .quick-links__item {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 14px;
    min-height: 32px;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 9999px;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-smooth-out);
  }

  /* Hover in: quick + direct. */
  .quick-links__item:hover {
    color: var(--text-primary);
  }

  /* Active (scroll-spy): filled pill + explicit color. */
  .quick-links__item.is-active {
    color: var(--text-primary);
  }

  /* Sliding pill behind the active item — reuse the project's
     transitions.dev "sliding tabs" motion (250ms, smooth ease out). */
  .quick-links__pill {
    position: absolute;
    top: 4px;
    left: 0;
    height: calc(100% - 8px);
    background: var(--surface-interactive);
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    box-shadow: var(--shadow-card);
    transform: translateX(0);
    transition:
      transform var(--duration-fast) var(--ease-smooth-out),
      width var(--duration-fast) var(--ease-smooth-out);
    will-change: transform, width;
    pointer-events: none;
    z-index: 0;
  }

  /* Mobile: shrink logo + nav items so the bar doesn't overflow */
  @media (max-width: 640px) {
    .quick-links {
      height: 48px;
      gap: 0.5rem;
      padding: 0 4px;
    }

    .quick-links__brand {
      padding: 0 4px;
    }

    .quick-links__brand svg {
      height: 28px;
    }

    .quick-links__menu {
      gap: 1px;
      padding: 3px;
    }

    .quick-links__item {
      padding: 4px 8px;
      min-height: 30px;
      font-size: 0.75rem;
    }

    .quick-links__pill {
      top: 3px;
      height: calc(100% - 6px);
    }
  }

  @media (max-width: 380px) {
    .quick-links__item {
      padding: 4px 6px;
      font-size: 0.7rem;
    }
  }

</style>

<script>
  // Scroll-spy: highlight the quick link of the currently visible section,
  // and move the sliding pill under the active item.
  const anchors = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-quick-link]')
  );
  const menu = document.querySelector<HTMLElement>('.quick-links__menu');
  const pill = document.querySelector<HTMLElement>('.quick-links__pill');

  const scrollLinks = anchors.filter((a) => a.hasAttribute('data-scroll-link'));

  const setActive = (id: string) => {
    anchors.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('is-active', isActive);
    });

    // Move the pill under the active in-page link.
    const active = scrollLinks.find((l) => l.getAttribute('href') === `#${id}`);
    if (pill && menu && active) {
      const menuRect = menu.getBoundingClientRect();
      const itemRect = active.getBoundingClientRect();
      const offsetLeft = itemRect.left - menuRect.left;
      pill.style.width = `${itemRect.width}px`;
      pill.style.transform = `translateX(${offsetLeft}px)`;
    }
  };

  const sections = scrollLinks
    .map((link) => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => Boolean(el));

  const onScroll = () => {
    const scrollPos = window.scrollY + window.innerHeight * 0.4;
    let current = sections[0]?.id ?? '';
    for (const section of sections) {
      if (section.offsetTop <= scrollPos) {
        current = section.id;
      }
    }
    setActive(current);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  onScroll();
</script>
</content>
