---
// Quick links — floating glass top navigation dock (navbar.gallery inspired)
// Highlights the active section via a sliding pill indicator and embeds an inline ThemeToggle.
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { label: 'Work', href: '#projects', external: false },
  { label: 'Experience', href: '#experience', external: false },
  { label: 'Contact', href: '#contact', external: false },
  { label: 'About', href: '/profile', external: true },
];
---

<nav class="quick-links" aria-label="Quick links">
  <div class="quick-links__dock">
    
    <!-- Home Brand Micro Icon -->

    <!-- Nav Items Menu -->
    <div class="quick-links__menu">
      <span class="quick-links__pill" aria-hidden="true"></span>
      {links.map((link) => (
        <a
          class="quick-links__item"
          href={link.href}
          data-quick-link
          data-scroll-link
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="quick-links__divider" role="separator"></div>

    <!-- Integrated Inline Theme Toggle -->
    <div class="quick-links__toggle-wrapper">
      <ThemeToggle />
    </div>

  </div>
</nav>

<style>
  /* Floating Top Dock (Navbar.gallery floating island pattern) */
  .quick-links {
    position: sticky;
    top: 12px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    pointer-events: none;
  }

  .quick-links__dock {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 40px;
    padding: 0 6px;
    border-radius: 9999px;
    background: var(--surface-subtle);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    transition:
      border-color var(--duration-fast) var(--ease-smooth-out),
      background-color var(--duration-fast) var(--ease-smooth-out);
  }

  .quick-links__dock:hover {
    border-color: var(--border-default);
  }

  .quick-links__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    padding: 0 8px;
    text-decoration: none;
    border-radius: 9999px;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .quick-links__brand:active {
    transform: scale(0.94);
  }

  .quick-links__divider {
    width: 1px;
    height: 14px;
    background: var(--border-subtle);
    flex-shrink: 0;
  }

  .quick-links__menu {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .quick-links__item {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    min-height: 28px;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 9999px;
    white-space: nowrap;
    transition:
      color 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .quick-links__item:hover {
      color: var(--text-primary);
    }
  }

  .quick-links__item:active {
    transform: scale(0.96);
  }

  .quick-links__item.is-active {
    color: var(--text-primary);
    font-weight: 500;
  }

  /* Sliding pill behind the active item */
  .quick-links__pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    transform: translateX(0);
    transition:
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      width 200ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform, width;
    pointer-events: none;
    z-index: 0;
  }

  .quick-links__toggle-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Compact Theme Toggle override inside dock */
  .quick-links__toggle-wrapper :global(.theme-toggle) {
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    border-radius: 9999px;
  }

  .quick-links__toggle-wrapper :global(.theme-toggle:hover) {
    background: var(--surface-interactive);
    transform: scale(1.05);
  }

  /* Mobile */
  @media (max-width: 640px) {
    .quick-links {
      top: 8px;
    }

    .quick-links__dock {
      height: 36px;
      padding: 0 4px;
      gap: 2px;
    }

    .quick-links__brand {
      padding: 0 6px;
      height: 24px;
    }

    .quick-links__item {
      padding: 3px 8px;
      min-height: 24px;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 380px) {
    .quick-links__item {
      padding: 3px 6px;
      font-size: 0.7rem;
    }
  }
</style>

<script>
  // Scroll-spy: highlight active section link and slide the pill
  const anchors = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-quick-link]')
  );
  const menu = document.querySelector<HTMLElement>('.quick-links__menu');
  const pill = document.querySelector<HTMLElement>('.quick-links__pill');

  const scrollLinks = anchors.filter((a) => a.hasAttribute('data-scroll-link'));

  const setActive = (id: string) => {
    anchors.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('is-active', isActive);
    });

    const active = scrollLinks.find((l) => l.getAttribute('href') === `#${id}`);
    if (pill && menu && active) {
      const menuRect = menu.getBoundingClientRect();
      const itemRect = active.getBoundingClientRect();
      const offsetLeft = itemRect.left - menuRect.left;
      pill.style.width = `${itemRect.width}px`;
      pill.style.transform = `translateX(${offsetLeft}px)`;
    }
  };

  const sections = scrollLinks
    .map((link) => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => Boolean(el));

  const onScroll = () => {
    const scrollPos = window.scrollY + window.innerHeight * 0.4;
    let current = sections[0]?.id ?? '';
    for (const section of sections) {
      if (section.offsetTop <= scrollPos) {
        current = section.id;
      }
    }
    setActive(current);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  onScroll();
</script>
