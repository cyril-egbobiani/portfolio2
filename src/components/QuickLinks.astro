---
// Quick links — floating glass bottom navigation dock (macOS dock inspired)
// Uses Heroicons for clean icon representation with floating tooltips and sliding pill indicator.
import ThemeToggle from './ThemeToggle.astro';
import profileImg from '../assets/images/profile-.png?url';

const links = [
  { label: 'Work', href: '#projects', external: false, icon: 'folder' },
  { label: 'Experience', href: '#experience', external: false, icon: 'briefcase' },
  { label: 'About', href: '#about', external: false, icon: 'avatar', avatarSrc: profileImg },
  { label: 'Contact', href: '#contact', external: false, icon: 'envelope' },
];
---

<nav class="quick-links" aria-label="Quick links navigation">
  <div class="quick-links__dock">
    
    <!-- Nav Items Menu -->
    <div class="quick-links__menu">
      <span class="quick-links__pill" aria-hidden="true"></span>
      {links.map((link) => (
        <a
          class="quick-links__item"
          href={link.href}
          aria-label={link.label}
          data-quick-link
          data-scroll-link={!link.external ? '' : undefined}
        >
          <span class="quick-links__icon-wrapper" aria-hidden="true">
            {link.icon === 'folder' && (
              <svg class="quick-links__icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.5 21a3 3 0 0 0 3-3V9a3 3 0 0 0-3-3h-5.379a1.5 1.5 0 0 1-1.06-.44L10.94 3.44A1.5 1.5 0 0 0 9.879 3H4.5a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h15Z" />
              </svg>
            )}
            {link.icon === 'briefcase' && (
              <svg class="quick-links__icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.5 7.5A2.25 2.25 0 0 0 2.25 9.75v8.25A2.25 2.25 0 0 0 4.5 20.25h15a2.25 2.25 0 0 0 2.25-2.25V9.75A2.25 2.25 0 0 0 19.5 7.5h-3.75V5.25a2.25 2.25 0 0 0-2.25-2.25h-3a2.25 2.25 0 0 0-2.25 2.25V7.5H4.5ZM10.5 5.25a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V7.5h-4.5V5.25Z" />
              </svg>
            )}
            {link.icon === 'envelope' && (
              <svg class="quick-links__icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
              </svg>
            )}
            {link.icon === 'avatar' && link.avatarSrc && (
              <img
                class="quick-links__avatar-img"
                src={link.avatarSrc}
                alt=""
                width="20"
                height="20"
                loading="eager"
              />
            )}
          </span>
          <span class="quick-links__tooltip" role="tooltip">{link.label}</span>
        </a>
      ))}
    </div>


    <!-- Integrated Inline Theme Toggle -->
    <div class="quick-links__toggle-wrapper">
      <ThemeToggle />
    </div>

  </div>
</nav>

<style>
  /* Floating Bottom Dock (macOS dock island pattern) */
  .quick-links {
    position: fixed;
    bottom: 20px;
    bottom: max(20px, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .quick-links__dock {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    height: fit-content;
    padding: 4px 5px;
    border-radius: 9999px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    transition:
      border-color var(--duration-fast) var(--ease-smooth-out),
      background-color var(--duration-fast) var(--ease-smooth-out);
  }

  .quick-links__dock:hover {
    border-color: var(--border-default);
  }

  .quick-links__divider {
    width: 1px;
    height: 16px;
    background: var(--border-subtle);
    flex-shrink: 0;
    margin: 0 2px;
  }

  .quick-links__menu {
    position: relative;
    display: flex;
    align-items: center;
  }

  .quick-links__item {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 6px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 9999px;
    transition:
      color 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .quick-links__icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .quick-links__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .quick-links__avatar-img {
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    object-fit: cover;
    flex-shrink: 0;
  }

  /* Floating Tooltip */
  .quick-links__tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 3px 8px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .quick-links__item:hover .quick-links__tooltip,
    .quick-links__item:focus-visible .quick-links__tooltip {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }

    .quick-links__item:hover {
      color: var(--text-primary);
    }
  }

  .quick-links__item:active {
    transform: scale(0.92);
  }

  .quick-links__item.is-active {
    color: var(--text-primary);
  }

  /* Clean sliding active pill */
  .quick-links__pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--surface);
    border-radius: 9999px;
    border: 1px solid var(--border-subtle);
    transform: translateX(0);
    transition:
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      width 200ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform, width;
    pointer-events: none;
    z-index: 0;
  }

  .quick-links__toggle-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Compact Theme Toggle override inside dock */
  .quick-links__toggle-wrapper :global(.theme-toggle) {
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition:
      color 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .quick-links__toggle-wrapper :global(.theme-toggle:hover) {
    color: var(--text-primary);
  }

  .quick-links__toggle-wrapper :global(.theme-toggle:active) {
    transform: scale(0.92);
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .quick-links {
      bottom: 16px;
      bottom: max(16px, env(safe-area-inset-bottom));
    }

    .quick-links__dock {
      height: 40px;
      padding: 0 4px;
    }

    .quick-links__item {
      width: 32px;
      height: 32px;
    }

    .quick-links__icon {
      width: 16px;
      height: 16px;
    }

    .quick-links__toggle-wrapper :global(.theme-toggle) {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  // Scroll-spy: highlight active section link and slide the pill
  const anchors = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-quick-link]')
  );
  const menu = document.querySelector<HTMLElement>('.quick-links__menu');
  const pill = document.querySelector<HTMLElement>('.quick-links__pill');

  const scrollLinks = anchors.filter((a) => a.hasAttribute('data-scroll-link'));

  const setActive = (id: string) => {
    anchors.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('is-active', isActive);
    });

    const active = scrollLinks.find((l) => l.getAttribute('href') === `#${id}`);
    if (pill && menu && active) {
      const menuRect = menu.getBoundingClientRect();
      const itemRect = active.getBoundingClientRect();
      const offsetLeft = itemRect.left - menuRect.left;
      pill.style.width = `${itemRect.width}px`;
      pill.style.transform = `translateX(${offsetLeft}px)`;
    }
  };

  const sections = scrollLinks
    .map((link) => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => Boolean(el));

  const onScroll = () => {
    const scrollPos = window.scrollY + window.innerHeight * 0.4;
    let current = sections[0]?.id ?? '';
    for (const section of sections) {
      if (section.offsetTop <= scrollPos) {
        current = section.id;
      }
    }
    setActive(current);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  onScroll();
</script>
