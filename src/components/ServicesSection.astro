---
// ServicesSection.astro — Interactive Capability Showcase
const services = [
  {
    id: 'mobile-dev',
    num: '01',
    title: 'Mobile Development',
    summary: 'Building cross-platform mobile apps with fluid native gestures, offline caching, and responsive UI architecture.',
    tags: ['iOS', 'Android', 'React Native', 'Expo'],
  },
  {
    id: 'web-dev',
    num: '02',
    title: 'Web Development',
    summary: 'High-performance web applications designed for instantaneous load times, SEO best practices, and accessible UX.',
    tags: ['Astro', 'Next.js', 'TypeScript', 'Tailwind'],
  },
  {
    id: 'product-design',
    num: '03',
    title: 'Product Design',
    summary: 'End-to-end product design, tokenized design systems, component libraries, and user research workflows.',
    tags: ['Design Systems', 'Figma', 'UI/UX', 'Prototyping'],
  },
  {
    id: 'design-eng',
    num: '04',
    title: 'Design Engineering',
    summary: 'Bridging design and code with hardware-accelerated CSS animations, micro-interactions, and custom shaders.',
    tags: ['Micro-interactions', 'Motion', 'CSS Physics', 'WebGL'],
  },
];
---

<section class="flex flex-col gap-5" id="services">
  <div class="flex items-center justify-between">
    <h2 class="m-0 font-mono text-xs font-medium tracking-wider uppercase text-[var(--text-muted)]">Services</h2>
  </div>

  <div class="flex flex-col divide-y divide-dashed divide-[var(--border-subtle)] border-y border-dashed border-[var(--border-subtle)]">
    {services.map((service, index) => (
      <div
        class="service-item group flex flex-col py-3 px-2 sm:px-3 rounded-[6px] transition-[background-color] duration-200 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)] cursor-pointer select-none"
        data-service-id={service.id}
        data-expanded={index === 0 ? 'true' : 'false'}
      >
        <!-- Header Row Trigger -->
        <button
          type="button"
          class="service-trigger flex w-full cursor-pointer items-center justify-between gap-4 text-left focus:outline-none transition-[color,transform] duration-160 ease-[var(--ease-smooth-out)] active:scale-[0.99]"
          aria-expanded={index === 0 ? 'true' : 'false'}
          data-service-trigger
        >
          <!-- Left: Index + Title -->
          <div class="flex items-center gap-4 min-w-0">
            <span class="font-mono tabular-nums text-xs text-[var(--text-muted)] transition-colors duration-160 group-hover:text-[var(--text-primary)]">
              {service.num}
            </span>
            <span class="font-sans text-[15.5px] sm:text-[16.5px] font-medium tracking-[-0.02em] text-[var(--text-primary)] truncate">
              {service.title}
            </span>
          </div>

          <!-- Right: Toggle Indicator -->
          <div class="flex items-center gap-2 shrink-0">
            <div class="service-icon-box flex size-6 sm:size-7 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface-subtle)] text-[var(--text-muted)] transition-[border-color,color,background-color,transform] duration-200 ease-[var(--ease-smooth-out)] group-hover:border-[var(--border-strong)] group-hover:bg-[var(--surface-interactive)] group-hover:text-[var(--text-primary)]">
              <svg class="service-chevron size-3.5 transition-transform duration-250 ease-[var(--ease-smooth-out)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
        </button>

        <!-- Expanded Detail Body (Fluid Grid Transition) -->
        <div
          class="service-content grid transition-[grid-template-rows,opacity] duration-250 ease-[var(--ease-smooth-out)]"
          style={index === 0 ? 'grid-template-rows: 1fr; opacity: 1;' : 'grid-template-rows: 0fr; opacity: 0;'}
          data-service-content
        >
          <div class="overflow-hidden">
            <div class="flex flex-col gap-3 pt-2.5 pb-1 pl-8 sm:pl-9">
              <p class="m-0 font-sans text-[14px] sm:text-[14.5px] leading-[1.65] text-[var(--text-secondary)] font-normal">
                {service.summary}
              </p>
              
              <!-- Tech Stack Tags -->
              <div class="flex flex-wrap gap-1.5 pt-1">
                {service.tags.map((tag) => (
                  <span class="rounded-[4px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-muted)] transition-[color,border-color] duration-160 hover:text-[var(--text-primary)] hover:border-[var(--border-default)]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>

<style>
  /* Chevron rotation state when expanded */
  .service-item[data-expanded="true"] .service-chevron {
    transform: rotate(180deg);
  }

  .service-item[data-expanded="true"] .service-icon-box {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-trigger:hover .service-chevron {
      color: var(--text-primary);
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-service-id]');

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-service-trigger]');
    const content = item.querySelector<HTMLElement>('[data-service-content]');

    const toggle = (expand: boolean) => {
      item.setAttribute('data-expanded', String(expand));
      trigger?.setAttribute('aria-expanded', String(expand));
      if (content) {
        content.style.gridTemplateRows = expand ? '1fr' : '0fr';
        content.style.opacity = expand ? '1' : '0';
      }
    };

    item.addEventListener('click', (e) => {
      // Don't toggle if clicking a link or tag
      if ((e.target as HTMLElement).closest('a')) return;

      const isExpanded = item.getAttribute('data-expanded') === 'true';

      // Accordion toggle behavior
      items.forEach((other) => {
        if (other !== item) {
          const otherTrigger = other.querySelector<HTMLButtonElement>('[data-service-trigger]');
          const otherContent = other.querySelector<HTMLElement>('[data-service-content]');
          other.setAttribute('data-expanded', 'false');
          otherTrigger?.setAttribute('aria-expanded', 'false');
          if (otherContent) {
            otherContent.style.gridTemplateRows = '0fr';
            otherContent.style.opacity = '0';
          }
        }
      });

      toggle(!isExpanded);
    });
  });
</script>
