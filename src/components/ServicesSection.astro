---
// ServicesSection.astro
// Each capability carries its own hand-drawn line mark, in the same style as
// the plant: no fill, 1.6 stroke, round caps, slightly uneven contours.
const services = [
  {
    id: 'mobile-dev',
    mark: 'mobile',
    title: 'Mobile Development',
    summary:
      'Cross-platform apps with native-feeling gestures, offline caching and layouts that hold up on real devices.',
    tags: ['iOS', 'Android', 'React Native', 'Expo'],
  },
  {
    id: 'web-dev',
    mark: 'web',
    title: 'Web Development',
    summary:
      'Fast, accessible web applications. Quick to load, sensible to navigate, built to stay maintainable.',
    tags: ['Astro', 'Next.js', 'TypeScript', 'Tailwind'],
  },
  {
    id: 'product-design',
    mark: 'product',
    title: 'Product Design',
    summary:
      'End-to-end product work: research, flows, design systems and the component libraries that keep them honest.',
    tags: ['Design Systems', 'Figma', 'UI/UX', 'Prototyping'],
  },
  {
    id: 'design-eng',
    mark: 'engineering',
    title: 'Design Engineering',
    summary:
      'The seam between design and code. Motion, micro-interactions and interface detail that survives implementation.',
    tags: ['Micro-interactions', 'Motion', 'CSS Physics', 'WebGL'],
  },
];
---

<section class="flex flex-col gap-6" id="services">
  <div class="section-head">
    <div class="section-head__text">
      <h2 class="section-title">Services</h2>
    </div>
  </div>

  <div class="service-list">
    {services.map((service, index) => (
      <div class="service-item" data-service-id={service.id} data-expanded={index === 0 ? 'true' : 'false'}>
        <button
          type="button"
          class="service-trigger"
          aria-expanded={index === 0 ? 'true' : 'false'}
          data-service-trigger
        >
          <span class="service-mark" aria-hidden="true">
            {service.mark === 'mobile' && (
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {/* Phone body — slightly wobbly rectangle */}
                <rect x="9" y="4" width="14" height="24" rx="3" ry="3" />
                {/* Speaker notch */}
                <path d="M14 7.5 L18 7.5" />
                {/* Home indicator bar */}
                <path d="M13.5 24.5 L18.5 24.5" />
                {/* Screen content lines */}
                <path d="M12.5 12 L19.5 12" opacity="0.4" />
                <path d="M12.5 15.5 L17 15.5" opacity="0.4" />
              </svg>
            )}
            {service.mark === 'web' && (
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {/* Browser window */}
                <rect x="4" y="5" width="24" height="20" rx="2.5" ry="2.5" />
                {/* Title bar line */}
                <path d="M4 11 L28 11" />
                {/* Window dots */}
                <circle cx="8" cy="8" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="11" cy="8" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="14" cy="8" r="0.9" fill="currentColor" stroke="none" />
                {/* Code lines inside */}
                <path d="M8 15 L15 15" opacity="0.5" />
                <path d="M10 18.5 L20 18.5" opacity="0.35" />
                <path d="M8 22 L13 22" opacity="0.5" />
              </svg>
            )}
            {service.mark === 'product' && (
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {/* Artboard frame */}
                <rect x="5" y="5" width="22" height="22" rx="2" ry="2" />
                {/* Grid cross */}
                <path d="M5 14 L27 14" opacity="0.3" />
                <path d="M16 5 L16 27" opacity="0.3" />
                {/* Pen tool triangle — design symbol */}
                <path d="M11 20 L16 10 L21 20" stroke-width="1.8" />
                <path d="M13 17 L19 17" stroke-width="1.4" opacity="0.5" />
              </svg>
            )}
            {service.mark === 'engineering' && (
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {/* Left angle bracket */}
                <path d="M10 10 L5 16 L10 22" />
                {/* Right angle bracket */}
                <path d="M22 10 L27 16 L22 22" />
                {/* Connecting bezier — the "design" in design engineering */}
                <path d="M13 20 C15 13, 17 13, 19 20" stroke-width="1.8" />
              </svg>
            )}
          </span>

          <span class="service-title">{service.title}</span>

          <span class="service-chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19.5 8.25 12 15.75 4.5 8.25" />
            </svg>
          </span>
        </button>

        <div
          class="service-content"
          style={index === 0 ? 'grid-template-rows: 1fr; opacity: 1;' : 'grid-template-rows: 0fr; opacity: 0;'}
          data-service-content
        >
          <div class="service-content__clip">
            <div class="service-body">
              <p class="service-summary">{service.summary}</p>
              <div class="service-tags">
                {service.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .service-list {
    display: flex;
    flex-direction: column;
  }

  /* Symmetric full-width hairlines — no one-sided borders */
  .service-item + .service-item {
    border-top: 1px solid var(--border-subtle);
  }

  .service-item {
    cursor: pointer;
    user-select: none;
  }

  .service-trigger {
    display: flex;
    align-items: center;
    gap: 15px;
    width: 100%;
    padding: 18px 2px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .service-trigger:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* The hand-drawn mark, in the plant's line language */
  .service-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: var(--text-faint);
    transition: color var(--duration-fast) var(--ease-smooth-out);
  }

  .service-mark svg {
    width: 100%;
    height: 100%;
  }

  .service-title {
    flex: 1;
    min-width: 0;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  .service-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--text-faint);
    transition:
      transform var(--duration-fast) var(--ease-smooth-out),
      color var(--duration-fast) var(--ease-smooth-out);
  }

  .service-chevron svg {
    width: 100%;
    height: 100%;
  }

  /* Open state: the drawing carries the emphasis, nothing else changes shape */
  .service-item[data-expanded='true'] .service-mark {
    color: var(--ink);
  }

  .service-item[data-expanded='true'] .service-chevron {
    transform: rotate(180deg);
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-item:hover .service-mark {
      color: var(--text-muted);
    }

    .service-item[data-expanded='true']:hover .service-mark {
      color: var(--ink);
    }

    .service-item:hover .service-chevron {
      color: var(--text-muted);
    }
  }

  .service-content {
    display: grid;
    transition:
      grid-template-rows var(--duration-fast) var(--ease-smooth-out),
      opacity var(--duration-fast) var(--ease-smooth-out);
  }

  .service-content__clip {
    overflow: hidden;
  }

  /* Indented to sit under the title, clear of the drawing */
  .service-body {
    padding: 0 0 22px 47px;
  }

  .service-summary {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.68;
    color: var(--text-secondary);
    max-width: 54ch;
  }

  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
  }

  /* Plain type rather than chips — fewer boxes, quieter section */
  .service-tags span {
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .service-trigger {
      gap: 13px;
      padding: 16px 2px;
    }

    .service-mark {
      width: 28px;
      height: 28px;
    }

    .service-title {
      font-size: 15.5px;
    }

    .service-body {
      padding-left: 41px;
      padding-bottom: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-mark,
    .service-chevron,
    .service-content {
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-service-id]');

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-service-trigger]');
    const content = item.querySelector<HTMLElement>('[data-service-content]');

    const setExpanded = (el: HTMLElement, expand: boolean) => {
      el.setAttribute('data-expanded', String(expand));
      el.querySelector('[data-service-trigger]')?.setAttribute('aria-expanded', String(expand));
      const body = el.querySelector<HTMLElement>('[data-service-content]');
      if (body) {
        body.style.gridTemplateRows = expand ? '1fr' : '0fr';
        body.style.opacity = expand ? '1' : '0';
      }
    };

    item.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;

      const isExpanded = item.getAttribute('data-expanded') === 'true';

      // Accordion: only one open at a time
      items.forEach((other) => {
        if (other !== item) setExpanded(other, false);
      });

      setExpanded(item, !isExpanded);
    });

    trigger?.addEventListener('click', (e) => e.preventDefault());
    void content;
  });
</script>
