---
const services = [
  {
    num: '01',
    title: 'Mobile Development',
    details: 'iOS · Android · React Native · Expo',
  },
  {
    num: '02',
    title: 'Web Development',
    details: 'Astro · Next.js · TypeScript · WebGL',
  },
  {
    num: '03',
    title: 'Product Design',
    details: 'Design Systems · Figma · UI/UX',
  },
  {
    num: '04',
    title: 'Design Engineering',
    details: 'Micro-interactions · Motion · CSS Physics',
  },
];
---

<section class="flex flex-col gap-5" id="services">
  <div class="flex items-center justify-between">
    <h2 class="m-0 font-sans text-sm sm:text-base font-normal tracking-tight text-[var(--text-muted)]">Services</h2>
  </div>

  <div class="flex flex-col border-t border-dashed border-[var(--border-subtle)]">
    {services.map((service) => (
      <div
        class="service-row group relative flex items-center justify-between gap-4 border-b border-dashed border-[var(--border-subtle)] py-4 sm:py-5 transition-all duration-200 ease-[var(--ease-smooth-out)] cursor-pointer"
        data-service-row
      >
        <!-- Left: Index + Title -->
        <div class="z-10 flex items-center gap-4">
          <span class="font-mono tabular-nums text-xs text-[var(--text-muted)] transition-colors duration-200 group-hover:text-[var(--text-primary)]">
            {service.num}
          </span>
          <span class="font-display text-base sm:text-lg font-normal tracking-[-0.02em] text-[var(--text-primary)] transition-colors duration-200 group-hover:text-white">
            {service.title}
          </span>
        </div>

        <!-- Right: Spring Bouncy Chip (Hidden until hover) + Arrow -->
        <div class="z-10 flex items-center gap-3">
          <!-- Bouncy Spring Chip Popover -->
          <div class="service-bouncy-chip flex items-center rounded-[4px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-2.5 py-1 transition-all duration-300">
            <span class="font-mono text-xs text-[var(--text-muted)]">
              {service.details}
            </span>
          </div>

          <!-- Chevron Right Indicator -->
          <svg class="size-4 text-[var(--text-muted)] opacity-40 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Progressive Disclosure: Hidden at resting state, springs into view on hover */
  .service-bouncy-chip {
    opacity: 0;
    transform: translateY(4px) scale(0.95);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Spring Bounce Curve: cubic-bezier(0.34, 1.36, 0.64, 1) */
    .service-row:hover .service-bouncy-chip {
      opacity: 1;
      transform: translateY(0) scale(1);
      border-color: var(--border-default);
      transition:
        transform 300ms cubic-bezier(0.34, 1.36, 0.64, 1),
        opacity 180ms ease,
        border-color 180ms ease;
    }
  }

  .service-row:active {
    transform: scale(0.985);
  }
</style>
