---
// ServicesSection.astro — What I do.
// One row per service: a framed tile with a tinted well and a line icon, the
// title, and the tools in grey on the right (under the title on small screens).
interface Service {
  id: 'mobile' | 'web' | 'design';
  title: string;
  stack: string;
  href: string;
}

const services: Service[] = [
  { id: 'mobile', title: 'Mobile apps', stack: 'Flutter, cross-platform, real-time', href: '/projects/forge' },
  { id: 'web', title: 'Web products', stack: 'React, TypeScript, Astro', href: '/projects/9to5er' },
  { id: 'design', title: 'Product design', stack: 'Figma, Jitter, design engineering', href: '/projects/token-extractor' },
];
---

<section class="flex flex-col gap-6 scroll-mt-20 sm:scroll-mt-24" id="services">
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title">What I do</h2>
    </div>
  </div>

  <ul class="service-list" role="list">
    {services.map((service) => (
      <li class={`service service--${service.id}`}>
        <span class="service__tile" aria-hidden="true">
          <span class="service__well">
            {service.id === 'mobile' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="2" width="14" height="20" rx="3" />
                <path d="M12 18h.01" stroke-width="2" />
                <circle class="anim anim--tap" cx="12" cy="10" r="3.5" fill="currentColor" fill-opacity="0.18" stroke-width="1.2" />
                <circle cx="12" cy="10" r="1.2" fill="currentColor" />
              </svg>
            )}
            {service.id === 'web' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="3" />
                <path d="M3 8h18" stroke-width="1.4" />
                <circle cx="6" cy="5.5" r="0.75" fill="currentColor" />
                <circle cx="8.5" cy="5.5" r="0.75" fill="currentColor" opacity="0.6" />
                <g class="anim anim--sweep">
                  <path d="M11 5.5h4" stroke-width="1.4" />
                </g>
                <rect x="6" y="11" width="12" height="7" rx="1.5" fill="currentColor" fill-opacity="0.18" stroke-width="1.2" />
              </svg>
            )}
            {service.id === 'design' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="2.5" />
                <path d="M7 8h10M7 12h6" stroke-width="1.4" opacity="0.6" />
                <path d="M6 16c4 0 6-3 10-3" stroke-width="1.4" stroke-dasharray="3 2" />
                <circle cx="16" cy="13" r="1.2" fill="currentColor" />
                <g class="anim anim--pen" style="transform-origin: 16px 13px;">
                  <path d="M14 8l5.5-5.5a1.5 1.5 0 0 1 2 2L16 10l-2 1 1-3Z" fill="var(--tint-bg)" stroke-width="1.4" />
                </g>
              </svg>
            )}
          </span>
        </span>

        <div class="service__body">
          <h3 class="service__title"><a href={service.href} data-astro-prefetch>{service.title}</a></h3>
          <span class="service__stack">{service.stack}</span>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .service-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 4px 0;
  }

  .service--mobile { --tint-bg: var(--tint-mobile-bg); --tint-ink: var(--tint-mobile-ink); }
  .service--web { --tint-bg: var(--tint-web-bg); --tint-ink: var(--tint-web-ink); }
  .service--design { --tint-bg: var(--tint-design-bg); --tint-ink: var(--tint-design-ink); }

  /* Framed tile: 44 = 4 + 36 + 4, corners 10 = 6 + 4 */
  .service__tile {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 4px;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
  }

  .service__well {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-inset);
    background: var(--tint-bg);
    color: var(--tint-ink);
  }

  .service__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
  }

  .service__title {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .service__title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .service__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--tint-ink);
    text-underline-offset: 3px;
  }

  .service__stack {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* The original hover motions: a tap pulse, the URL bar sweeping, the pen lifting */
  .anim {
    transition:
      transform var(--duration-medium) var(--ease-smooth-out),
      opacity var(--duration-medium) var(--ease-smooth-out);
  }

  .anim--tap { transform-box: fill-box; transform-origin: center; }

  .service__tile {
    transition: transform 200ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .service:hover .service__tile { transform: translateY(-1px); }
    .service:hover .anim--tap { animation: touch-pulse 2s cubic-bezier(0.23, 1, 0.32, 1) infinite; }
    .service:hover .anim--sweep { transform: translateX(3.5px); }
    .service:hover .anim--pen { transform: rotate(-18deg) translateY(-1px); }
  }

  @keyframes touch-pulse {
    0% { transform: scale(0.85); opacity: 0.9; }
    50% { transform: scale(1.18); opacity: 0.35; }
    100% { transform: scale(0.85); opacity: 0.9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim,
    .service__tile {
      transition: none;
      animation: none !important;
    }
  }
</style>
