---
// ServicesSection.astro — Interactive Capability Showcase (hiartem.com inspired)
const services = [
  {
    id: 'mobile-dev',
    num: '01',
    title: 'Mobile Development',
    summary: 'Building cross-platform mobile apps with fluid native gestures, offline caching, and responsive UI architecture.',
    tags: ['iOS', 'Android', 'React Native', 'Expo'],
  },
  {
    id: 'web-dev',
    num: '02',
    title: 'Web Development',
    summary: 'High-performance web applications designed for instantaneous load times, SEO best practices, and accessible UX.',
    tags: ['Astro', 'Next.js', 'TypeScript', 'Tailwind'],
  },
  {
    id: 'product-design',
    num: '03',
    title: 'Product Design',
    summary: 'End-to-end product design, tokenized design systems, component libraries, and user research workflows.',
    tags: ['Design Systems', 'Figma', 'UI/UX', 'Prototyping'],
  },
  {
    id: 'design-eng',
    num: '04',
    title: 'Design Engineering',
    summary: 'Bridging design and code with hardware-accelerated CSS animations, micro-interactions, and custom shaders.',
    tags: ['Micro-interactions', 'Motion', 'CSS Physics', 'WebGL'],
  },
];
---

<section class="flex flex-col gap-5" id="services">
  <div class="flex items-center justify-between">
    <h2 class="m-0 font-sans text-sm sm:text-base font-normal tracking-tight text-[var(--text-muted)]">Services</h2>
  </div>

  <div class="flex flex-col border-t border-dashed border-[var(--border-subtle)]">
    {services.map((service, index) => (
      <div
        class="service-item group border-b border-dashed border-[var(--border-subtle)] py-4 transition-all duration-200"
        data-service-id={service.id}
      >
        <!-- Header Row Trigger -->
        <button
          type="button"
          class="service-trigger flex w-full cursor-pointer items-center justify-between gap-4 text-left transition-colors duration-200 focus:outline-none"
          aria-expanded={index === 0 ? 'true' : 'false'}
          data-service-trigger
        >
          <!-- Left: Index + Title -->
          <div class="flex items-center gap-4">
            <span class="font-mono tabular-nums text-xs text-[var(--text-muted)] transition-colors duration-200 group-hover:text-[var(--text-primary)]">
              {service.num}
            </span>
            <span class="font-display text-base sm:text-lg font-normal tracking-[-0.02em] text-[var(--text-primary)]">
              {service.title}
            </span>
          </div>

          <!-- Right: Toggle Indicator -->
          <div class="flex items-center gap-2">
            <span class="service-tag-count hidden sm:inline-block font-mono text-[11px] text-[var(--text-muted)] px-2 py-0.5 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)]">
              {service.tags.length} Skills
            </span>
            <div class="service-icon-box flex size-6 items-center justify-center rounded-full border border-[var(--border-subtle)] text-[var(--text-muted)] transition-all duration-300 group-hover:border-[var(--border-default)] group-hover:text-[var(--text-primary)]">
              <svg class="service-chevron size-3.5 transition-transform duration-300 ease-[var(--ease-smooth-out)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
        </button>

        <!-- Expanded Detail Body -->
        <div
          class="service-content grid transition-all duration-300 ease-[var(--ease-smooth-out)]"
          style={index === 0 ? 'grid-template-rows: 1fr; opacity: 1;' : 'grid-template-rows: 0fr; opacity: 0;'}
          data-service-content
        >
          <div class="overflow-hidden">
            <div class="flex flex-col gap-3 pt-3 pb-1 pl-8 sm:pl-9">
              <p class="m-0 text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">
                {service.summary}
              </p>
              
              <!-- Tech Stack Tags (Clean Hairline Styling) -->
              <div class="flex flex-wrap gap-1.5 pt-1">
                {service.tags.map((tag) => (
                  <span class="rounded-[4px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-2 py-1 font-mono text-[11px] text-[var(--text-muted)] transition-colors duration-200 hover:text-[var(--text-primary)] hover:border-[var(--border-default)]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>

<style>
  .service-trigger:active {
    transform: scale(0.99);
  }

  /* Chevron rotation state when expanded */
  .service-item[data-expanded="true"] .service-chevron {
    transform: rotate(180deg);
  }

  .service-item[data-expanded="true"] .service-trigger {
    color: var(--text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-trigger:hover .service-chevron {
      color: var(--text-primary);
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-service-id]');

  items.forEach((item, idx) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-service-trigger]');
    const content = item.querySelector<HTMLElement>('[data-service-content]');

    if (idx === 0) item.setAttribute('data-expanded', 'true');

    trigger?.addEventListener('click', () => {
      const isExpanded = item.getAttribute('data-expanded') === 'true';

      // Accordion toggle behavior
      items.forEach((other) => {
        const otherTrigger = other.querySelector<HTMLButtonElement>('[data-service-trigger]');
        const otherContent = other.querySelector<HTMLElement>('[data-service-content]');
        other.setAttribute('data-expanded', 'false');
        otherTrigger?.setAttribute('aria-selected', 'false');
        if (otherContent) {
          otherContent.style.gridTemplateRows = '0fr';
          otherContent.style.opacity = '0';
        }
      });

      if (!isExpanded) {
        item.setAttribute('data-expanded', 'true');
        trigger.setAttribute('aria-expanded', 'true');
        if (content) {
          content.style.gridTemplateRows = '1fr';
          content.style.opacity = '1';
        }
      }
    });
  });
</script>
