---
// ServicesSection.astro — What I do.
// Three always-visible rows. Each one names the tools actually used and links to
// the work that proves it, so the claim and the evidence sit side by side.
// Each row keeps its hand-drawn line mark: no fill, round caps, a small motion on hover.
interface Proof {
  label: string;
  href: string;
}

interface Service {
  id: string;
  mark: 'mobile' | 'web' | 'product';
  title: string;
  summary: string;
  proof: Proof[];
}

const services: Service[] = [
  {
    id: 'mobile',
    mark: 'mobile',
    title: 'Mobile apps',
    summary: 'Cross-platform apps in Flutter, from design tokens through to real-time features.',
    proof: [{ label: 'Forge', href: '/projects/forge' }],
  },
  {
    id: 'web',
    mark: 'web',
    title: 'Web products',
    summary: 'Sites and web apps in React, TypeScript, and Astro that load quickly and are easy to find your way around.',
    proof: [
      { label: '9to5er', href: '/projects/9to5er' },
      { label: 'Dubem', href: '/projects/model-portfolio' },
    ],
  },
  {
    id: 'design',
    mark: 'product',
    title: 'Product design & design engineering',
    summary: 'Research, flows, and interfaces in Figma and Jitter, carried through to motion and detail in code.',
    proof: [
      { label: 'Token Extractor', href: '/projects/token-extractor' },
      { label: 'Design work', href: '/#designs' },
    ],
  },
];
---

<section class="flex flex-col gap-6 scroll-mt-20 sm:scroll-mt-24" id="services">
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title">What I do</h2>
    </div>
  </div>

  <ul class="service-list" role="list">
    {services.map((service) => (
      <li class="service-item">
        <span class="service-mark" aria-hidden="true">
          {service.mark === 'mobile' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="3" />
              <path d="M12 18h.01" stroke-width="2" />
              <circle class="mark-anim-element mark-anim-element--touch-tap" cx="12" cy="10" r="3.5" fill="var(--surface-interactive)" opacity="0.4" stroke-width="1.2" />
              <circle cx="12" cy="10" r="1.2" fill="currentColor" />
            </svg>
          )}
          {service.mark === 'web' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <path d="M3 8h18" stroke-width="1.4" />
              <circle cx="6" cy="5.5" r="0.75" fill="currentColor" />
              <circle cx="8.5" cy="5.5" r="0.75" fill="currentColor" opacity="0.6" />
              <g class="mark-anim-element mark-anim-element--url-sweep">
                <path d="M11 5.5h4" stroke-width="1.4" stroke-linecap="round" />
              </g>
              <rect x="6" y="11" width="12" height="7" rx="1.5" fill="var(--surface-interactive)" opacity="0.5" stroke-width="1.2" />
            </svg>
          )}
          {service.mark === 'product' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="2.5" />
              <path d="M7 8h10M7 12h6" stroke-width="1.4" opacity="0.6" />
              <path d="M6 16c4 0 6-3 10-3" stroke-width="1.4" stroke-dasharray="3 2" />
              <circle cx="16" cy="13" r="1.2" fill="currentColor" />
              <g class="mark-anim-element mark-anim-element--vector-draw" style="transform-origin: 16px 13px;">
                <path d="M14 8l5.5-5.5a1.5 1.5 0 0 1 2 2L16 10l-2 1 1-3Z" fill="var(--surface-interactive)" opacity="0.9" stroke-width="1.4" />
              </g>
            </svg>
          )}
        </span>

        <div class="service-body">
          <h3 class="service-title">{service.title}</h3>
          <p class="service-summary">{service.summary}</p>
          <p class="service-proof">
            <span>Seen in</span>
            {service.proof.map((item, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a href={item.href} data-astro-prefetch>{item.label}</a>
              </>
            ))}
          </p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .service-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-item {
    display: flex;
    gap: 14px;
    padding: 18px 0;
  }

  .service-item:first-child {
    padding-top: 4px;
  }

  .service-item + .service-item {
    border-top: 1px solid var(--border-subtle);
  }

  /* The hand-drawn mark */
  .service-mark {
    display: flex;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    margin-top: 1px;
    color: var(--text-faint);
    transition: color var(--duration-fast) var(--ease-smooth-out);
  }

  .service-mark svg {
    width: 100%;
    height: 100%;
  }

  .service-body {
    flex: 1;
    min-width: 0;
  }

  .service-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .service-summary {
    max-width: 54ch;
    margin: 4px 0 0;
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .service-proof {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
    margin: 8px 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .service-proof a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-default);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms var(--ease-smooth-out);
  }

  .service-proof a:hover {
    text-decoration-color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .service-item {
      gap: 18px;
    }

    .service-mark {
      width: 32px;
      height: 32px;
    }

    .service-title {
      font-size: var(--text-base);
    }

    .service-summary {
      font-size: var(--text-base);
    }
  }

  /* Small motion in each mark when its row is hovered */
  .mark-anim-element {
    transition:
      transform var(--duration-medium) var(--ease-smooth-out),
      opacity var(--duration-medium) var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-item:hover .service-mark {
      color: var(--text-muted);
    }

    .service-item:hover .mark-anim-element--touch-tap {
      animation: touchPulse 2s cubic-bezier(0.23, 1, 0.32, 1) infinite;
    }

    .service-item:hover .mark-anim-element--url-sweep {
      transform: translateX(3.5px);
    }

    .service-item:hover .mark-anim-element--vector-draw {
      transform: rotate(-18deg) translateY(-1px);
    }
  }

  @keyframes touchPulse {
    0% { transform: scale(0.85); opacity: 0.9; }
    50% { transform: scale(1.18); opacity: 0.35; }
    100% { transform: scale(0.85); opacity: 0.9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-mark,
    .mark-anim-element {
      transition: none;
      animation: none !important;
    }
  }
</style>
