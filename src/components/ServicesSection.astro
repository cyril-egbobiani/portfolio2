---
// ServicesSection.astro
// Each capability carries its own hand-drawn line mark, in the same style as
// the plant: no fill, 1.6 stroke, round caps, slightly uneven contours.
const services = [
  {
    id: 'mobile-dev',
    mark: 'mobile',
    title: 'Mobile Development',
    summary:
      'Cross-platform apps with native-feeling gestures, offline caching and layouts that hold up on real devices.',
    tags: ['iOS', 'Android', 'React Native', 'Expo'],
  },
  {
    id: 'web-dev',
    mark: 'web',
    title: 'Web Development',
    summary:
      'Fast, accessible web applications. Quick to load, sensible to navigate, built to stay maintainable.',
    tags: ['Astro', 'Next.js', 'TypeScript', 'Tailwind'],
  },
  {
    id: 'product-design',
    mark: 'product',
    title: 'Product Design',
    summary:
      'End-to-end product work: research, flows, design systems and the component libraries that keep them honest.',
    tags: ['Design Systems', 'Figma', 'UI/UX', 'Prototyping'],
  },
  {
    id: 'design-eng',
    mark: 'engineering',
    title: 'Design Engineering',
    summary:
      'The seam between design and code. Motion, micro-interactions and interface detail that survives implementation.',
    tags: ['Micro-interactions', 'Motion', 'CSS Physics', 'WebGL'],
  },
];
---

<section class="flex flex-col gap-6" id="services">
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title">Services</h2>
    </div>
  </div>

  <div class="service-list">
    {services.map((service, index) => (
      <div class={`service-item reveal-item reveal-delay-${index + 1}`} data-service-id={service.id} data-expanded={index === 0 ? 'true' : 'false'}>
        <button
          type="button"
          class="service-trigger"
          aria-expanded={index === 0 ? 'true' : 'false'}
          data-service-trigger
        >
          <!-- Domain-Specific Micro-Animated Vector Marks -->
          <span class="service-mark" aria-hidden="true">
            {service.mark === 'mobile' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <!-- Phone Frame -->
                <rect x="5" y="2" width="14" height="20" rx="3" />
                <path d="M12 18h.01" stroke-width="2" />
                <!-- Touch Screen Tap Target Ripple -->
                <circle class="mark-anim-element mark-anim-element--touch-tap" cx="12" cy="10" r="3.5" fill="var(--surface-interactive)" opacity="0.4" stroke-width="1.2" />
                <circle cx="12" cy="10" r="1.2" fill="currentColor" />
              </svg>
            )}
            {service.mark === 'web' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <!-- Browser Frame -->
                <rect x="3" y="3" width="18" height="18" rx="3" />
                <path d="M3 8h18" stroke-width="1.4" />
                <circle cx="6" cy="5.5" r="0.75" fill="currentColor" />
                <circle cx="8.5" cy="5.5" r="0.75" fill="currentColor" opacity="0.6" />
                <!-- Animated URL Loading Sweep -->
                <g class="mark-anim-element mark-anim-element--url-sweep">
                  <path d="M11 5.5h4" stroke-width="1.4" stroke-linecap="round" />
                </g>
                <!-- Web Viewport Layout Card -->
                <rect x="6" y="11" width="12" height="7" rx="1.5" fill="var(--surface-interactive)" opacity="0.5" stroke-width="1.2" />
              </svg>
            )}
            {service.mark === 'product' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <!-- Product UI Frame -->
                <rect x="3" y="4" width="18" height="16" rx="2.5" />
                <path d="M7 8h10M7 12h6" stroke-width="1.4" opacity="0.6" />
                <!-- Curved Bezier Vector Path & Active Anchor Node -->
                <path d="M6 16c4 0 6-3 10-3" stroke-width="1.4" stroke-dasharray="3 2" />
                <circle cx="16" cy="13" r="1.2" fill="currentColor" />
                
                <!-- Animated Vector Pen Tool Cursor (Rotates around anchor pivot) -->
                <g class="mark-anim-element mark-anim-element--vector-draw" style="transform-origin: 16px 13px;">
                  <path d="M14 8l5.5-5.5a1.5 1.5 0 0 1 2 2L16 10l-2 1 1-3Z" fill="var(--surface-interactive)" opacity="0.9" stroke-width="1.4" />
                </g>
              </svg>
            )}
            {service.mark === 'engineering' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="5" height="5" rx="1" />
                <rect x="16" y="3" width="5" height="5" rx="1" />
                <rect x="16" y="16" width="5" height="5" rx="1" />
                <rect x="3" y="16" width="5" height="5" rx="1" />
                <!-- Kinetic CSS Physics Overshoot Spring Connectors -->
                <g class="mark-anim-element mark-anim-element--physics-spring" style="transform-origin: 12px 12px;">
                  <path d="M8 5.5h8M8 18.5h8M5.5 8v8M18.5 8v8" stroke-dasharray="3 2" />
                </g>
              </svg>
            )}
          </span>

          <span class="service-title">{service.title}</span>

          <span class="service-chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </button>

        <div
          class="service-content"
          style={index === 0 ? 'grid-template-rows: 1fr; opacity: 1;' : 'grid-template-rows: 0fr; opacity: 0;'}
          data-service-content
        >
          <div class="service-content__clip">
            <div class="service-body">
              <p class="service-summary">{service.summary}</p>
              
              <div class="service-tags">
                {service.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .service-list {
    display: flex;
    flex-direction: column;
  }

  .service-item + .service-item {
    border-top: 1px solid var(--border-subtle);
  }

  .service-item {
    cursor: pointer;
    user-select: none;
    padding: 0;
    transition: opacity 200ms ease;
  }

  .service-trigger {
    display: flex;
    align-items: center;
    gap: 15px;
    width: 100%;
    padding: 14px 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .service-trigger:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* The hand-drawn mark, in the plant's line language */
  .service-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: var(--text-faint);
    transition: color var(--duration-fast) var(--ease-smooth-out);
  }

  .service-mark svg {
    width: 100%;
    height: 100%;
  }

  .service-title {
    flex: 1;
    min-width: 0;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .service-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--text-faint);
    transition:
      transform var(--duration-fast) var(--ease-smooth-out),
      color var(--duration-fast) var(--ease-smooth-out);
  }

  .service-chevron svg {
    width: 100%;
    height: 100%;
  }

  /* Open state: the drawing carries the emphasis, nothing else changes shape */
  .service-item[data-expanded='true'] .service-mark {
    color: var(--ink);
  }

  .service-item[data-expanded='true'] .service-chevron {
    transform: rotate(180deg);
    color: var(--text-muted);
  }

  /* Domain-Specific Micro-Motions (Emil Kowalski Physics & Tokens) */
  .mark-anim-element {
    transition: transform var(--duration-medium) var(--ease-smooth-out), opacity var(--duration-medium) var(--ease-smooth-out);
    will-change: transform, opacity;
  }

  /* 1. Mobile Dev: Native Touch Screen Tap Ripple */
  .service-item[data-expanded="true"] .mark-anim-element--touch-tap,
  .service-item:hover .mark-anim-element--touch-tap {
    animation: touchPulse 2s cubic-bezier(0.23, 1, 0.32, 1) infinite;
  }

  @keyframes touchPulse {
    0% { transform: scale(0.85); opacity: 0.9; }
    50% { transform: scale(1.18); opacity: 0.35; }
    100% { transform: scale(0.85); opacity: 0.9; }
  }

  /* 2. Web Dev: URL Address Bar Loading Sweep */
  .service-item[data-expanded="true"] .mark-anim-element--url-sweep,
  .service-item:hover .mark-anim-element--url-sweep {
    transform: translateX(3.5px);
    transition: transform 300ms var(--ease-smooth-out);
  }

  /* 3. Product Design: Vector Pen Tool Curve Pivot Draw */
  .service-item[data-expanded="true"] .mark-anim-element--vector-draw,
  .service-item:hover .mark-anim-element--vector-draw {
    transform: rotate(-18deg) translateY(-1px);
    transition: transform 350ms var(--ease-smooth-out);
  }

  /* 4. Design Engineering: Kinetic CSS Physics Spring Overshoot Rotation */
  .service-item[data-expanded="true"] .mark-anim-element--physics-spring,
  .service-item:hover .mark-anim-element--physics-spring {
    transform: rotate(180deg);
    transition: transform 450ms cubic-bezier(0.34, 1.36, 0.64, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-item:hover .service-mark {
      color: var(--text-muted);
    }

    .service-item[data-expanded='true']:hover .service-mark {
      color: var(--ink);
    }

    .service-item:hover .service-chevron {
      color: var(--text-muted);
    }
  }

  /* Expandable Drawer (0fr -> 1fr CSS Grid Animation) */
  .service-content {
    display: grid;
    grid-template-rows: 0fr;
    transition:
      grid-template-rows 250ms var(--ease-smooth-out),
      opacity 250ms var(--ease-smooth-out);
  }

  .service-item[data-expanded='true'] .service-content {
    grid-template-rows: 1fr;
  }

  .service-content__clip {
    overflow: hidden;
  }

  /* Indented to sit under the title, clear of the drawing */
  .service-body {
    padding: 0 0 22px 47px;
  }

  .service-summary {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 54ch;
  }

  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
  }

  /* Plain type rather than chips — fewer boxes, quieter section */
  .service-tags span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .service-trigger {
      gap: 13px;
      padding: 16px 2px;
    }

    .service-mark {
      width: 28px;
      height: 28px;
    }

    .service-title {
      font-size: 15px;
    }

    .service-body {
      padding-left: 41px;
      padding-bottom: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-mark,
    .service-chevron,
    .service-content {
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-service-id]');

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-service-trigger]');
    const content = item.querySelector<HTMLElement>('[data-service-content]');

    const setExpanded = (el: HTMLElement, expand: boolean) => {
      el.setAttribute('data-expanded', String(expand));
      el.querySelector('[data-service-trigger]')?.setAttribute('aria-expanded', String(expand));
      const body = el.querySelector<HTMLElement>('[data-service-content]');
      if (body) {
        body.style.gridTemplateRows = expand ? '1fr' : '0fr';
        body.style.opacity = expand ? '1' : '0';
      }
    };

    item.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;

      const isExpanded = item.getAttribute('data-expanded') === 'true';

      // Accordion: only one open at a time
      items.forEach((other) => {
        if (other !== item) setExpanded(other, false);
      });

      setExpanded(item, !isExpanded);
    });

    trigger?.addEventListener('click', (e) => e.preventDefault());
    void content;
  });
</script>
