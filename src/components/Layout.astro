---
import '../styles.css';
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Cyril Egbobiani | Software Engineer & Product Designer',
  description = 'Software engineer and product designer based in Lagos, Nigeria, building mobile apps in Flutter, web products in React and TypeScript, and the systems behind them.',
  // 1200×630 share card in /public (shown when a link is shared)
  image = '/og-image.png',
  imageAlt = 'Cyril Egbobiani, software engineer and product designer, with screens from Forge, GDG Babcock and an attendance app',
} = Astro.props;

// Set once in astro.config.mjs (`site`)
const siteUrl = (Astro.site?.origin ?? 'https://cyril-jnr.vercel.app');
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    
    <!-- Primary SEO Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="Cyril Egbobiani Portfolio" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured Data (JSON-LD Person Schema) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Cyril Egbobiani",
      "url": siteUrl,
      "jobTitle": "Software Engineer & Product Designer",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lagos",
        "addressCountry": "Nigeria"
      },
      "sameAs": [
        "https://github.com/cyril-egbobiani",
        "https://www.linkedin.com/in/cyril-egbobiani-6802002b8/",
        "https://x.com/CyrilEgbobiani"
      ]
    })} />

    <!-- Preconnect Domains for Fast Font & Asset Delivery -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Non-render-blocking font stylesheet: only the weights the site uses -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500&family=Geist:wght@400;500;600;700&family=Patrick+Hand&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500&family=Geist:wght@400;500;600;700&family=Patrick+Hand&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500&family=Geist:wght@400;500;600;700&family=Patrick+Hand&display=swap" />
    </noscript>
  </head>

<body>
    <script is:inline>
      // Prevent flash of wrong theme by applying the saved preference before paint.
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var queryTheme = params.get('theme');
          if (queryTheme === 'light' || queryTheme === 'dark') {
            localStorage.setItem('portfolio-theme', queryTheme);
            document.documentElement.dataset.theme = queryTheme;
            return;
          }
          var saved = localStorage.getItem('portfolio-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          } else {
            document.documentElement.dataset.theme =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          }
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <slot />

    <script>
      // Ensure theme is preserved during client-side navigation in Astro ClientRouter
      function syncTheme() {
        try {
          const saved = localStorage.getItem('portfolio-theme');
          const theme = (saved === 'light' || saved === 'dark')
            ? saved
            : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      }

      // On client-side navigation, preserve theme and remove page-blur-entry on incoming document
      document.addEventListener('astro:before-swap', (e: any) => {
        const currentTheme = document.documentElement.dataset.theme || localStorage.getItem('portfolio-theme') || 'light';
        if (e.newDocument) {
          e.newDocument.documentElement.dataset.theme = currentTheme;
          e.newDocument.querySelectorAll('.page-blur-entry').forEach((el: Element) => {
            el.classList.remove('page-blur-entry');
          });
        }
      });

      document.addEventListener('astro:after-swap', () => {
        syncTheme();
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          syncTheme();
        });
      } else {
        syncTheme();
      }
      document.addEventListener('astro:page-load', () => {
        syncTheme();
      });
    </script>
  </body>
</html>
