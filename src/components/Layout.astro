---
import '../styles.css';
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Cyril Egbobiani | Software Engineer & Designer',
  description = 'Software Engineer & Designer based in Lagos, Nigeria. Crafting high-performance web applications, tokenized design systems, mobile apps, and WebGL experiences.',
  image = '/images/profile-1.png',
} = Astro.props;

const siteUrl = 'https://portfolio-screeching.brimble.app';
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    
    <!-- Primary SEO Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="Cyril Egbobiani Portfolio" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${image}`} />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Structured Data (JSON-LD Person Schema) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Cyril Egbobiani",
      "url": siteUrl,
      "jobTitle": "Software Engineer & Designer",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lagos",
        "addressCountry": "Nigeria"
      },
      "sameAs": [
        "https://github.com",
        "https://linkedin.com",
        "https://x.com"
      ]
    })} />

    <!-- Preconnect Domains for Fast Font & Asset Delivery -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />

    <!-- Non-render-blocking font stylesheets -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap" />
    </noscript>

    <link rel="preload" as="style" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&display=swap" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&display=swap" />
    </noscript>
  </head>

<body>
    <script is:inline>
      // Prevent flash of wrong theme by applying the saved preference before paint.
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var queryTheme = params.get('theme');
          if (queryTheme === 'light' || queryTheme === 'dark') {
            localStorage.setItem('portfolio-theme', queryTheme);
            document.documentElement.dataset.theme = queryTheme;
            return;
          }
          var saved = localStorage.getItem('portfolio-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          } else {
            document.documentElement.dataset.theme =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          }
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <slot />

    <script>
      import { initLisse } from '../utils/lisse';

      function initApp() {
        initLisse();
      }

      // Ensure theme is preserved during client-side navigation in Astro ClientRouter
      function syncTheme() {
        try {
          const saved = localStorage.getItem('portfolio-theme');
          const theme = (saved === 'light' || saved === 'dark')
            ? saved
            : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      }

      // On client-side navigation, preserve theme and remove page-blur-entry on incoming document
      document.addEventListener('astro:before-swap', (e: any) => {
        const currentTheme = document.documentElement.dataset.theme || localStorage.getItem('portfolio-theme') || 'light';
        if (e.newDocument) {
          e.newDocument.documentElement.dataset.theme = currentTheme;
          e.newDocument.querySelectorAll('.page-blur-entry').forEach((el: Element) => {
            el.classList.remove('page-blur-entry');
          });
        }
      });

      document.addEventListener('astro:after-swap', () => {
        syncTheme();
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          syncTheme();
          initApp();
        });
      } else {
        syncTheme();
        initApp();
      }
      document.addEventListener('astro:page-load', () => {
        syncTheme();
        initApp();
      });
    </script>
  </body>
</html>
