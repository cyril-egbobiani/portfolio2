---
import '../styles.css';
import Lenis from './Lenis.astro';

const {
  title = 'Cyril Egbobiani | Software Engineer & Designer',
  description = 'Software Engineer & Designer based in Lagos, Nigeria. Crafting high-performance web applications, tokenized design systems, mobile apps, and WebGL experiences.',
  image = '/images/profile-1.png',
} = Astro.props;

const siteUrl = 'https://portfolio-screeching.brimble.app';
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="Cyril Egbobiani Portfolio" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${image}`} />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Structured Data (JSON-LD Person Schema) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Cyril Egbobiani",
      "url": siteUrl,
      "jobTitle": "Software Engineer & Designer",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lagos",
        "addressCountry": "Nigeria"
      },
      "sameAs": [
        "https://github.com",
        "https://linkedin.com",
        "https://x.com"
      ]
    })} />

    <!-- Preconnect Domains for Instant Asset Delivery -->
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tiro+Tamil:ital@0;1&display=swap" rel="stylesheet" />

    <link rel="preconnect" href="https://images.unsplash.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>

<body>
    <script is:inline>
      // Prevent flash of wrong theme by applying the saved preference before paint.
      (function () {
        try {
          var saved = localStorage.getItem('portfolio-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          } else {
            document.documentElement.dataset.theme =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          }
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <slot />
    <Lenis />

    <script>
      function initScrollReveals() {
        const revealItems = document.querySelectorAll('.reveal-item');
        if (!revealItems.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealItems.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: '0px 0px -30px 0px',
            threshold: 0.05,
          }
        );

        revealItems.forEach((el) => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveals);
      } else {
        initScrollReveals();
      }
      document.addEventListener('astro:page-load', initScrollReveals);
    </script>
  </body>
</html>
