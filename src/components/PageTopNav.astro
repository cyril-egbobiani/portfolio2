---
// PageTopNav.astro — Fixed back button + theme toggle for inner pages,
// floating over a progressive blur so content softens as it scrolls beneath.
// Render it outside <main>: .page-blur-entry animates `filter`, which would
// stop position: fixed from working for anything inside it.

interface Props {
  backHref?: string;
  /** One word for where the pill goes: "Home", "Work", "Journal" */
  backLabel?: string;
  /** Match the page's content column so the buttons line up with it */
  maxWidth?: number;
}

const { backHref = '/', backLabel = 'Home', maxWidth = 640 } = Astro.props;
---

<nav class="page-top-nav" aria-label="Page navigation" style={`--nav-max: ${maxWidth}px`}>
  <div class="page-top-nav__blur" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="page-top-nav__inner">
    <!-- Ring pill: the arrow sits in its own grey circle -->
    <a href={backHref} class="page-top-nav__back" aria-label={`Back to ${backLabel.toLowerCase()}`} data-astro-prefetch>
      <span class="page-top-nav__arrow" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12.5 8h-9M7.5 4l-4 4 4 4"/></svg>
      </span>
      <span class="page-top-nav__label">{backLabel}</span>
    </a>

    <button type="button" class="page-top-nav__theme" aria-label="Switch theme" title="Switch theme" data-page-theme-toggle>
      <svg class="page-top-nav__moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 9.5A5.5 5.5 0 0 1 6.5 3a5.5 5.5 0 1 0 6.5 6.5z"/></svg>
      <svg class="page-top-nav__sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="2.8"/><path d="M8 1.5v1.3M8 13.2v1.3M1.5 8h1.3M13.2 8h1.3M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"/></svg>
    </button>
  </div>
</nav>

<style>
  .page-top-nav {
    --nav-pad: 16px;
    --nav-btn: 36px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    pointer-events: none;
  }

  /* ── Progressive blur: stacked layers, strongest at the top edge ── */
  .page-top-nav__blur {
    position: absolute;
    inset: 0 0 -28px 0;
  }

  .page-top-nav__blur > span,
  .page-top-nav__blur::after {
    position: absolute;
    inset: 0;
  }

  .page-top-nav__blur > span:nth-child(1) {
    backdrop-filter: blur(1px);
    -webkit-backdrop-filter: blur(1px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
  }

  .page-top-nav__blur > span:nth-child(2) {
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 80%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 80%);
  }

  .page-top-nav__blur > span:nth-child(3) {
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 25%, transparent 60%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 25%, transparent 60%);
  }

  .page-top-nav__blur > span:nth-child(4) {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 40%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 40%);
  }

  /* Soft tint so buttons stay legible over busy content */
  .page-top-nav__blur::after {
    content: '';
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--surface) 80%, transparent) 0%,
      color-mix(in srgb, var(--surface) 40%, transparent) 50%,
      transparent 100%
    );
  }

  .page-top-nav__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--nav-max, 640px);
    margin: 0 auto;
    padding: var(--nav-pad) 24px;
    box-sizing: content-box;
  }

  @media (min-width: 640px) {
    .page-top-nav__inner {
      padding-inline: 32px;
    }
  }

  /* Back: white pill on the hairline ring */
  .page-top-nav__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px 0 4px;
    box-sizing: border-box;
    border-radius: 9999px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    pointer-events: auto;
    transition: transform 160ms var(--ease-smooth-out);
  }

  .page-top-nav__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: var(--surface-inset);
    color: var(--text-secondary);
    transition: transform 200ms var(--ease-smooth-out), color 160ms var(--ease-smooth-out);
  }

  /* Theme: a round ring button */
  .page-top-nav__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    color: var(--text-secondary);
    cursor: pointer;
    pointer-events: auto;
    transition: transform 160ms var(--ease-smooth-out), color 160ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .page-top-nav__back:hover .page-top-nav__arrow {
      transform: translateX(-2px);
      color: var(--text-primary);
    }

    .page-top-nav__theme:hover { color: var(--text-primary); }
  }

  .page-top-nav__back:active,
  .page-top-nav__theme:active { transform: scale(0.96); }

  .page-top-nav__back:focus-visible,
  .page-top-nav__theme:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .page-top-nav__sun {
    display: none;
  }

  :global([data-theme='dark']) .page-top-nav__sun {
    display: block;
  }

  :global([data-theme='dark']) .page-top-nav__moon {
    display: none;
  }
</style>

<script>
  function initPageThemeToggle() {
    const btn = document.querySelector<HTMLButtonElement>('[data-page-theme-toggle]');
    if (!btn) return;

    // The label names what pressing it will do, so the current theme is never a guess
    const describe = () => {
      const goingDark = document.documentElement.dataset.theme !== 'dark';
      const label = goingDark ? 'Switch to dark theme' : 'Switch to light theme';
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    };
    describe();
    new MutationObserver(describe).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    if (btn.dataset.bound) return;
    btn.dataset.bound = 'true';

    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.classList.add('theme-switching');
      root.dataset.theme = next;
      describe();
      try {
        localStorage.setItem('portfolio-theme', next);
      } catch {
        // Storage unavailable — theme still applies for this visit
      }
      setTimeout(() => root.classList.remove('theme-switching'), 120);
    });
  }

  document.addEventListener('astro:page-load', initPageThemeToggle);
</script>
