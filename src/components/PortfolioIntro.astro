---
// PortfolioIntro.astro — Hero introduction on index.astro
import { Image } from 'astro:assets';
import ieslLogo from '../assets/images/iesl-logo.png';
import profileIntroImg from '../assets/images/optimized/profile-intro.webp';

const socials = [
  {
    name: 'X (Twitter)',
    href: 'https://x.com/CyrilEgbobiani',
    icon: `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    name: 'GitHub',
    href: 'https://github.com/cyril-egbobiani',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/cyril-egbobiani-6802002b8/',
    icon: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="4" height="12" rx="1"/><circle cx="4" cy="4" r="2"/><path d="M10 9h4v2.5a4 4 0 0 1 4-2.5c2.5 0 4 1.5 4 4.5V21h-4v-6.5c0-1.2-.8-2-2-2s-2 .8-2 2V21h-4V9z"/></svg>`,
  },
  {
    name: 'Email',
    href: 'mailto:egbobianicyril@gmail.com',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="14" x="3" y="5" rx="2.5"/><path d="m3 7 9 6 9-6"/></svg>`,
  },
  {
    name: 'Resume',
    href: 'https://drive.google.com/file/d/1XXSvad2gGp1N7c7Pc7x0WkOkr_0AUAWb/view',
    icon: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
];
---

<section class="hero flex flex-col gap-6 pt-30">
  <!-- Text Content Block -->
  <div class="hero-text-block flex flex-col gap-4 sm:gap-5 w-full">
    <!-- 1. Dual-Craft Identity Header Lockup -->
    <!-- Avatar matches the name + title column: two lines of base text at leading-snug (1.375) = 2.75 × --text-base -->
    <div class="flex items-center gap-3 mb-1">
      <!-- Lisse Squircle Avatar Frame -->
      <a
        href="/about"
        class="avatar-squircle-wrap relative size-[calc(var(--text-base)*2.75)] rounded-full shrink-0 overflow-hidden bg-[var(--surface-subtle)] select-none block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
        aria-label="About Cyril Egbobiani"
        title="About Cyril"
      >
        <Image
          src={profileIntroImg}
          width={96}
          fetchpriority="high"
          alt="Cyril Egbobiani"
          class="avatar-photo absolute inset-0 w-full h-full object-cover object-[50%_25%] filter  contrast-[1.06]"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Identity Text Stack -->
      <div class="flex flex-col min-w-0 justify-center">
        <h1 class="font-display text-[16px] font-medium tracking-[-0.01em] text-[var(--text-primary)] leading-snug m-0">
          Cyril Egbobiani
        </h1>
        <div class="text-[16px] text-[var(--text-muted)] font-normal leading-snug">
          Software Engineer | Designer
        </div>
      </div>
    </div>

    <p class="lede">
      I'm a software engineer and ux designer at <a
        href="https://ieslglobal.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-company-link"
      ><Image
        src={ieslLogo}
        height={28}
        alt=""
        class="inline-company-icon"
        style="display: inline-block !important; height: 14px !important; width: auto !important; vertical-align: -2px !important; margin-right: 5px !important; border-radius: 2px !important;"
      />International Energy Services Limited</a>.
    </p>

    <p class="lede">
      I realized there is no proper software without a good design, either in the system or ux field. I'm mostly involved in how these two domains work hand in hand to deliver a wonderful user experience.
    </p>

    <p class="lede">
      Currently, I'm building <a href="/projects/forge" class="inline-company-link" data-astro-prefetch>Forge</a>, a faith app for youth communities. I'm based in Lagos and open to <a
        href="#contact"
        class="inline-company-link"
      ><span class="inline-globe-wrap"><canvas class="mini-3d-globe" width="32" height="32" role="img" aria-label="Spinning wireframe globe in spectrum colours"></canvas></span>freelance collaborations</a>.
    </p>

    <!-- Minimalist Social Links + Profile Page Link -->
    <div class="flex flex-wrap items-center justify-between gap-y-3 pt-2 sm:pt-3 border-t border-[var(--border-subtle)]">
      <div class="flex flex-wrap items-center gap-1 sm:gap-1.5">
        {socials.map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith('mailto:') ? '_self' : '_blank'}
            rel={social.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            class="social-link"
            aria-label={social.name}
          >
            <span class="social-link__icon" set:html={social.icon} />
            <span>{social.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .statement {
    margin: 0;
  }

  .lede {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  /* Seamless Inline Company Link & Micro-Icon */
  .inline-company-link {
    display: inline;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-subtle);
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 160ms var(--ease-smooth-out),
                text-decoration-color 160ms var(--ease-smooth-out);
  }

  .inline-company-link:hover {
    color: var(--text-muted);
    text-decoration-color: var(--text-muted);
  }

  .inline-company-icon {
    display: inline-block;
    height: 14px;
    width: auto;
    vertical-align: -1.5px;
    margin-right: 5px;
    border-radius: 2px;
    object-fit: contain;
  }

  /* Inline Rotating 3D Dotted Globe */
  .inline-globe-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: -2px;
    margin: 0 4px 0 2px;
    user-select: none;
  }

  .mini-3d-globe {
    display: inline-block !important;
    width: 15px !important;
    height: 15px !important;
    cursor: pointer;
    transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .mini-3d-globe:hover {
      transform: scale(1.18);
    }
  }

  .mini-3d-globe:active {
    transform: scale(0.94);
  }

  /* Lisse Squircle Avatar */
  .avatar-squircle-wrap {
    transform-origin: center center;
    box-shadow: inset 0 0 0 1px var(--border-subtle);
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .avatar-squircle-wrap:hover {
      transform: scale(1.03);
    }
  }

  .avatar-squircle-wrap:active {
    transform: scale(0.97);
  }

  /* Tactile Social Pills */
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 7px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background-color 160ms var(--ease-smooth-out),
                color 160ms var(--ease-smooth-out),
                transform 140ms var(--ease-smooth-out);
    user-select: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      background: var(--surface-subtle);
      color: var(--text-primary);
    }
    .social-link:hover .social-link__icon {
      opacity: 1;
      color: var(--text-primary);
    }
  }

  .social-link:active {
    transform: scale(0.96);
  }

  .social-link__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.75;
    transition: opacity 160ms var(--ease-smooth-out), color 160ms var(--ease-smooth-out);
  }
</style>

<script>
  // ── Inline globe: prism wireframe ──
  // Eight meridian rings, each in its own spectrum colour, like light split by a
  // prism. Front arcs are bright, back arcs faint. On hover or focus the rings
  // fan out and the globe spins faster; everything eases back on leave.
  function initMini3DGlobe() {
    const canvas = document.querySelector<HTMLCanvasElement>('.mini-3d-globe');
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = 'true';

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TAU = Math.PI * 2;
    const RINGS = 8;
    const SEGMENTS = 48;
    const TILT = 0.31;
    const cosT = Math.cos(TILT);
    const sinT = Math.sin(TILT);

    // Draw in CSS pixels on a buffer sized for the screen density
    const cssSize = canvas.getBoundingClientRect().width || 15;
    const dpr = Math.min(3, window.devicePixelRatio || 1);
    canvas.width = Math.round(cssSize * dpr);
    canvas.height = Math.round(cssSize * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const c = cssSize / 2;
    const R = cssSize * 0.42;

    let angle = 0;
    let speed = 0.007;
    let spread = 0;
    let focused = false;
    let visible = true;
    let rafId: number | null = null;
    let last = 0;

    const project = (x: number, y: number, z: number, rotation: number) => {
      const cosY = Math.cos(rotation);
      const sinY = Math.sin(rotation);
      const x1 = x * cosY - z * sinY;
      const z1 = x * sinY + z * cosY;
      const y2 = y * cosT - z1 * sinT;
      const z2 = y * sinT + z1 * cosT;
      const k = 3.2 / (3.2 - z2);
      return { x: c + x1 * R * k, y: c + y2 * R * k, z: z2 };
    };

    const draw = (time: number) => {
      const dark = document.documentElement.dataset.theme !== 'light';
      const ink = dark ? '255, 255, 255' : '0, 0, 0';
      const lightness = dark ? 60 : 50;
      ctx.clearRect(0, 0, cssSize, cssSize);

      ctx.beginPath();
      ctx.arc(c, c, R + 0.4, 0, TAU);
      ctx.strokeStyle = `rgba(${ink}, 0.1)`;
      ctx.lineWidth = 0.5;
      ctx.stroke();

      for (let k = 0; k < RINGS; k++) {
        const meridian = (k * Math.PI) / RINGS + spread * Math.sin(time * 0.002 + k);
        const hue = (k * 360) / RINGS;
        const cosM = Math.cos(meridian);
        const sinM = Math.sin(meridian);
        let prev = project(cosM, 0, sinM, angle);

        for (let i = 1; i <= SEGMENTS; i++) {
          const u = (i / SEGMENTS) * TAU;
          const next = project(Math.cos(u) * cosM, Math.sin(u), Math.cos(u) * sinM, angle);
          const front = (prev.z + next.z) / 2 > 0;
          ctx.beginPath();
          ctx.moveTo(prev.x, prev.y);
          ctx.lineTo(next.x, next.y);
          ctx.strokeStyle = `hsla(${hue}, 90%, ${lightness}%, ${front ? 0.95 : 0.18})`;
          ctx.lineWidth = front ? 0.85 : 0.5;
          ctx.stroke();
          prev = next;
        }
      }
    };

    const frame = (time: number) => {
      const dt = Math.min(50, time - (last || time));
      last = time;
      speed += ((focused ? 0.02 : 0.007) - speed) * 0.08;
      spread += ((focused ? 0.5 : 0) - spread) * 0.08;
      angle += (speed * dt) / 16;
      draw(time);
      rafId = visible ? requestAnimationFrame(frame) : null;
    };

    const start = () => {
      if (reduceMotion || rafId !== null) return;
      last = 0;
      rafId = requestAnimationFrame(frame);
    };

    const link = canvas.closest('a') ?? canvas;
    const enter = () => {
      focused = true;
      if (reduceMotion) {
        spread = 0.5;
        draw(0);
      }
    };
    const leave = () => {
      focused = false;
      if (reduceMotion) {
        spread = 0;
        draw(0);
      }
    };
    link.addEventListener('pointerenter', enter);
    link.addEventListener('pointerleave', leave);
    link.addEventListener('focus', enter);
    link.addEventListener('blur', leave);

    // Only animate while the globe is on screen
    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
    });
    io.observe(canvas);

    // Redraw the outline colour on theme change (matters when not animating)
    const themeObserver = new MutationObserver(() => draw(performance.now()));
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    draw(0);
    start();

    document.addEventListener(
      'astro:before-swap',
      () => {
        if (rafId !== null) cancelAnimationFrame(rafId);
        io.disconnect();
        themeObserver.disconnect();
      },
      { once: true }
    );
  }

  function initIntro() {
    initMini3DGlobe();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIntro);
  } else {
    initIntro();
  }
  document.addEventListener('astro:page-load', initIntro);
</script>
