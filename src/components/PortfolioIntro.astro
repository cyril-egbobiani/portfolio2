---
// PortfolioIntro.astro — Hero introduction on index.astro
const socials = [
  {
    name: 'X (Twitter)',
    href: 'https://x.com',
    icon: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>`,
  },
  {
    name: 'GitHub',
    href: 'https://github.com/cyril-egbobiani',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com',
    icon: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="4" height="12" rx="1"/><circle cx="4" cy="4" r="2"/><path d="M10 9h4v2.5a4 4 0 0 1 4-2.5c2.5 0 4 1.5 4 4.5V21h-4v-6.5c0-1.2-.8-2-2-2s-2 .8-2 2V21h-4V9z"/></svg>`,
  },
  {
    name: 'Email',
    href: 'mailto:egbobianicyril@gmail.com',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="14" x="3" y="5" rx="2.5"/><path d="m3 7 9 6 9-6"/></svg>`,
  },
  {
    name: 'Resume',
    href: 'https://drive.google.com/file/d/1XXSvad2gGp1N7c7Pc7x0WkOkr_0AUAWb/view',
    icon: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
];
---

<section class="hero flex flex-col gap-6 pt-16 sm:pt-24">
  <!-- Text Content Block — Staggered Editorial Reveal -->
  <div class="hero-text-block t-stagger is-shown flex flex-col gap-4 sm:gap-5 w-full">
    <h1 class="statement t-stagger-line t-stagger-line--1 font-display text-5xl leading-[1] tracking-tight text-[var(--text-primary)] font-bold">
      Cyril Builds and Designs.
    </h1>

    <p class="lede t-stagger-line t-stagger-line--2">
      Based in Lagos, Nigeria. I specialize in tactile consumer app interfaces and high-performance creative tools that feel natural, fluid, and memorable to use.
    </p>

    <p class="lede t-stagger-line t-stagger-line--3">
      Currently, I'm a Frontend Engineer &amp; UI/UX Designer at <a href="https://ieslglobal.com/" target="_blank" rel="noopener noreferrer" class="story-link font-medium">International Energy Services Limited</a>.
    </p>

    <p class="lede t-stagger-line t-stagger-line--4">
      I'm also open for select design engineering contracts, product advisory, and creative collaborations.
    </p>

    <!-- Minimalist Social Links + Profile Page Link -->
    <div class="flex flex-wrap items-center justify-between gap-y-3 pt-2 sm:pt-3 t-stagger-line t-stagger-line--5 border-t border-[var(--border-subtle)]">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {socials.map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith('mailto:') ? '_self' : '_blank'}
            rel={social.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            class="social-link"
            aria-label={social.name}
          >
            <span class="social-link__icon" set:html={social.icon} />
            <span>{social.name}</span>
          </a>
        ))}
      </div>

      <a
        href="/about"
        class="inline-flex items-center gap-1.5 text-[13px] font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors no-underline group"
      >
        <span>The non-software half</span>
        <svg class="size-3.5 transition-transform duration-160 ease-[var(--ease-smooth-out)] group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .statement {
    margin: 0;
  }

  .lede {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  .story-link {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color 160ms var(--ease-smooth-out);
  }

  .story-link:hover {
    color: var(--text-muted);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 160ms var(--ease-smooth-out);
  }

  .social-link:hover {
    color: var(--text-primary);
  }

  .social-link__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 160ms var(--ease-smooth-out);
  }

  .social-link:hover .social-link__icon {
    opacity: 1;
  }
</style>
