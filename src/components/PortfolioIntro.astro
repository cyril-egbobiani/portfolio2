---

<section class="hero flex flex-col gap-6">
  <!-- 1. Refined Physical Ticket Pass (Compact Size, Authentic Cardstock, Flat 3D Motion) -->
  <div class="tkt-wrapper w-full max-w-[175px] mb-2 select-none" aria-label="Cyril Egbobiani — CE Archive verified pass" id="tktWrapper">
    <div class="tkt-card relative w-full bg-[#eee7dc] rounded-[4px] overflow-visible border border-[rgba(60,45,30,0.08)]" id="tktCard">

      <!-- Tactile Cardstock Grain Overlay -->
      <div class="tkt-paper-texture pointer-events-none" aria-hidden="true"></div>

      <!-- Specular Light Glare Sheen -->
      <div class="tkt-glare" id="tktGlare" aria-hidden="true"></div>

      <!-- 4 Corner Concave Notches -->
      <div class="absolute -top-2.5 -left-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
      <div class="absolute -top-2.5 -right-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
      <div class="absolute -bottom-2.5 -left-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>
      <div class="absolute -bottom-2.5 -right-2.5 size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10" aria-hidden="true"></div>

      <!-- Column Layout Inside Card -->
      <div class="tkt-inner-content flex flex-col p-2.5 gap-2">

        <!-- 1. Top Framed B&W Photo -->
        <div class="tkt-photo-layer w-full aspect-[4/3.6] rounded-[2px] overflow-hidden bg-[#e2e2e5] border border-[rgba(0,0,0,0.06)]">
          <img
            src={profileImg}
            alt="Cyril Egbobiani"
            width="400"
            height="360"
            class="w-full h-full object-cover object-[50%_25%] filter grayscale contrast-[1.08] brightness-[0.98]"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- 3. Horizontal Perforation Line with Anchored Side Notches -->
        <div class="relative w-full my-0.5 flex items-center" aria-hidden="true">
          <!-- Left tear notch -->
          <div class="absolute -left-[20px] size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10"></div>
          <!-- Dashed perforation line -->
          <div class="w-full border-t border-dashed border-[#d4d4d8]"></div>
          <!-- Right tear notch -->
          <div class="absolute -right-[20px] size-5 rounded-full bg-[var(--surface)] pointer-events-none z-10"></div>
        </div>

        <!-- 4. Bottom Stub: Verified Pass + Barcode -->
        <div class="tkt-stub-layer flex items-center justify-between gap-1.5 px-0.5">
          <span class="font-sans text-[9.5px] font-bold uppercase tracking-[0.14em] text-[#18181b]">
            LIVING
          </span>
          <div class="w-11 h-3.5 text-[#18181b] opacity-85 shrink-0" role="img" aria-label="ticket barcode">
            <svg viewBox="0 0 56 18" fill="currentColor" class="w-full h-full" preserveAspectRatio="none">
              <rect x="0" y="0" width="2" height="18" />
              <rect x="4" y="0" width="3" height="18" />
              <rect x="9" y="0" width="1" height="18" />
              <rect x="12" y="0" width="2.5" height="18" />
              <rect x="16" y="0" width="1" height="18" />
              <rect x="19" y="0" width="3" height="18" />
              <rect x="24" y="0" width="1.5" height="18" />
              <rect x="27" y="0" width="2" height="18" />
              <rect x="31" y="0" width="3.5" height="18" />
              <rect x="36" y="0" width="1" height="18" />
              <rect x="39" y="0" width="2" height="18" />
              <rect x="43" y="0" width="1" height="18" />
              <rect x="46" y="0" width="3" height="18" />
              <rect x="51" y="0" width="1.5" height="18" />
              <rect x="54" y="0" width="2" height="18" />
            </svg>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- 2. Text Content Block — Staggered Editorial Reveal -->
  <div class="hero-text-block t-stagger is-shown flex flex-col gap-4 sm:gap-5 w-full">
    <h1 class="statement t-stagger-line t-stagger-line--1 font-display text-[21px] sm:text-[24px]  leading-[1.4] tracking-[0.03em] text-[var(--text-primary)]">
Hi, I'm Cyril. I partner with founders to craft refined, high-performance software.    </h1>

    <p class="lede t-stagger-line t-stagger-line--2">
      Based in Lagos, Nigeria.  I specialize in tactile consumer app interfaces and high-performance creative tools that feel natural, fluid, and memorable to use.
    </p>

    <p class="lede t-stagger-line t-stagger-line--3">
      Currently, I'm a Frontend Engineer & UI/UX Designer at <a href="https://ieslglobal.com/" target="_blank" rel="noopener noreferrer" class="story-link font-medium">International Energy Services Limited</a>.
    </p>

    <p class="lede t-stagger-line t-stagger-line--4">
      I'm also open for select design engineering contracts, product advisory, and creative collaborations.
    </p>

    <!-- 3. Minimalist Social Links -->
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 pt-1 sm:pt-2 t-stagger-line t-stagger-line--5">
      {socials.map((social) => (
        <a
          href={social.href}
          target={social.href.startsWith('mailto:') ? '_self' : '_blank'}
          rel={social.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          class="social-link"
          aria-label={social.name}
        >
          <span class="social-link__icon" set:html={social.icon} />
          <span>{social.name}</span>
        </a>
      ))}
    </div>
  </div>

</section>

<script>
  // ── 3D Interactive Parallax & Spring Tilt Controller (Flat Physical Ticket) ──
  function setupTicket3D() {
    const wrapper = document.getElementById('tktWrapper');
    const card = document.getElementById('tktCard');
    const glare = document.getElementById('tktGlare');

    if (!wrapper || !card || !glare) return;

    let isHovering = false;
    let rafId: number | null = null;
    let targetRotateX = 0;
    let targetRotateY = 0;
    let currentRotateX = 0;
    let currentRotateY = 0;

    const onPointerMove = (e: PointerEvent) => {
      const rect = wrapper.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      // Normalised coordinates (-1 to 1)
      const normX = (x - centerX) / centerX;
      const normY = (y - centerY) / centerY;

      // Max tilt angles
      targetRotateY = normX * 8;
      targetRotateX = -normY * 8;

      // Position the glare sheen
      const glareX = (x / rect.width) * 100;
      const glareY = (y / rect.height) * 100;
      glare.style.setProperty('--glare-x', `${glareX}%`);
      glare.style.setProperty('--glare-y', `${glareY}%`);
      glare.style.opacity = '0.3';
    };

    const updateSpring = () => {
      if (isHovering) {
        currentRotateX += (targetRotateX - currentRotateX) * 0.12;
        currentRotateY += (targetRotateY - currentRotateY) * 0.12;

        card.style.transform = `perspective(800px) rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg) translateZ(4px) scale(1.015)`;

        rafId = requestAnimationFrame(updateSpring);
      }
    };

    wrapper.addEventListener('pointerenter', () => {
      isHovering = true;
      card.classList.add('is-interacting');
      cancelAnimationFrame(rafId ?? 0);
      rafId = requestAnimationFrame(updateSpring);
    });

    wrapper.addEventListener('pointermove', onPointerMove);

    wrapper.addEventListener('pointerleave', () => {
      isHovering = false;
      targetRotateX = 0;
      targetRotateY = 0;
      glare.style.opacity = '0';

      card.style.transition = 'transform 450ms cubic-bezier(0.23, 1, 0.32, 1)';
      card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(0px) scale(1)';

      setTimeout(() => {
        card.classList.remove('is-interacting');
        card.style.transition = '';
        card.style.transform = '';
      }, 450);
    });

    // Press down haptic visual feedback
    wrapper.addEventListener('pointerdown', () => {
      if (isHovering) {
        card.style.transform = `perspective(800px) rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg) translateZ(-3px) scale(0.988)`;
      }
    });

    wrapper.addEventListener('pointerup', () => {
      if (isHovering) {
        card.style.transform = `perspective(800px) rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg) translateZ(4px) scale(1.015)`;
      }
    });
  }

  // Initialise on load & on view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTicket3D);
  } else {
    setupTicket3D();
  }
  document.addEventListener('astro:page-load', setupTicket3D);
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* ─────────────────────────────────────────────────────────
     AUTHENTIC CARDSTOCK TICKET PASS (ZERO SHADOWS, PURE TEXTURE)
     ───────────────────────────────────────────────────────── */

  .tkt-wrapper {
    position: relative;
    width: 100%;
    max-width: 175px;
    margin-bottom: 0.75rem;
    perspective: 900px;
    cursor: pointer;
    animation: ticketEntrance 550ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  @keyframes ticketEntrance {
    0% {
      opacity: 0;
      transform: perspective(800px) translateY(14px) scale(0.96);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: perspective(800px) translateY(0) scale(1);
      filter: blur(0);
    }
  }

  /* Physical Card Surface: Flat, tactile cardstock */
  .tkt-card {
    position: relative;
    width: 100%;
    background-color: #ececed;
    border-radius: 4px;
    box-shadow: none; /* Removed shadow */
    transform-style: preserve-3d;
    will-change: transform;
    /* Ambient calming sine levitation when idle (pure flat rotation) */
    animation: calmLevitate 6.8s ease-in-out infinite alternate;
  }

  /* Tactile paper cardstock fiber & noise texture */
  .tkt-paper-texture {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    opacity: 0.25;
    background-image: radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 0);
    background-size: 4px 4px;
    mix-blend-mode: multiply;
    z-index: 2;
  }

  /* Pause ambient animation during cursor interaction */
  .tkt-card.is-interacting {
    animation-play-state: paused;
  }

  /* Calming ambient 3D floating animation (pure flat 3D transforms, zero drop-shadow) */
  @keyframes calmLevitate {
    0% {
      transform: perspective(800px) translateY(0px) rotateX(1.4deg) rotateY(-1.8deg);
    }
    50% {
      transform: perspective(800px) translateY(-5px) rotateX(-1deg) rotateY(1.5deg);
    }
    100% {
      transform: perspective(800px) translateY(2px) rotateX(1.8deg) rotateY(-1.2deg);
    }
  }

  /* Parallax depth on internal layers */
  .tkt-inner-content {
    transform-style: preserve-3d;
    position: relative;
    z-index: 5;
  }

  .tkt-photo-layer {
    transform: translateZ(6px);
    transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tkt-stub-layer {
    transform: translateZ(4px);
  }

  /* Specular Light Glare Sheen */
  .tkt-glare {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    pointer-events: none;
    z-index: 8;
    opacity: 0;
    background: radial-gradient(
      circle 180px at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.45) 0%,
      rgba(255, 255, 255, 0.12) 45%,
      transparent 75%
    );
    mix-blend-mode: overlay;
    transition: opacity 280ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tkt-card {
      animation: none !important;
      transform: none !important;
    }
    .tkt-photo-layer,
    .tkt-stub-layer {
      transform: none !important;
    }
  }


  /* ── Editorial Typography (below ticket) ── */
  .statement {
    margin: 0;
  }

  .lede {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  .story-link {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color 160ms var(--ease-smooth-out);
  }

  .story-link:hover {
    color: var(--text-muted);
  }

  /* ── Minimalist Social Links ── */
  .social-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 160ms var(--ease-smooth-out);
  }

  .social-link:hover {
    color: var(--text-primary);
  }

  .social-link__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 160ms var(--ease-smooth-out);
  }

  .social-link:hover .social-link__icon {
    opacity: 1;
  }
</style>

