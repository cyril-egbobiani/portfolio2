---
import emailIcon from '../assets/images/email.svg?url';
import githubIcon from '../assets/images/github.svg?url';
import linkedinIcon from '../assets/images/linkedin.svg?url';
import xIcon from '../assets/images/x.svg?url';

const socialLinks = [
  { label: 'X', href: 'https://x.com', icon: xIcon },
  { label: 'GitHub', href: 'https://github.com', icon: githubIcon },
  { label: 'LinkedIn', href: 'https://www.linkedin.com', icon: linkedinIcon },
  { label: 'Email', href: 'mailto:hello@example.com', icon: emailIcon },
];
---

<section class="flex flex-col gap-6">
  <div class="flex w-full flex-col gap-8">

    <!-- HEADER: Avatar with 3D Tilt & Cursor Glare -->
    <header class="flex w-full items-center justify-between">
      <div
        class="avatar-tilt-card group relative size-[72px] sm:size-[88px] cursor-pointer overflow-hidden rounded-3xl border border-[var(--border-subtle)] bg-[var(--surface-subtle)] shadow-sm"
        data-avatar-tilt
      >
        <img
          class="size-full rounded-3xl object-cover object-center scale-[1.08] transition-transform duration-300 group-hover:scale-[1.14]"
          src="/images/cyril.e.png"
          alt="Cyril Egbobiani"
          width="88"
          height="88"
          loading="eager"
        />
        <!-- Spotlight Glare Overlay -->
        <div class="avatar-tilt-glare absolute inset-0 pointer-events-none rounded-3xl" data-avatar-glare></div>
      </div>
    </header>

    <!-- MAIN CONTENT: Staggered reveal, proper typographic hierarchy -->
    <div class="t-stagger flex flex-col gap-5">

      <!-- Name Header (Inter Display: benji.org / rauno.me editorial signature) -->
      <h1 class="t-stagger-line t-stagger-line--1 m-0 text-2xl sm:text-3xl font-semibold leading-tight tracking-[-0.04em] text-[var(--text-primary)]">
        Cyril Egbobiani
      </h1>

      <!-- Role + Location -->
      <p class="t-stagger-line t-stagger-line--2 m-0 text-sm sm:text-base leading-snug text-[var(--text-muted)]">
        Software Engineer & Designer · Lagos, Nigeria&nbsp;🇳🇬
      </p>

      <!-- Hair-line separator -->
      <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

      <!-- Bio Copy -->
      <p class="t-stagger-line t-stagger-line--3 m-0 text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
        My drive is in imagining and executing every creative idea to make things better. Design and code are two sides of the same coin — and balancing both has been an extraordinary journey.
      </p>

      <!-- Social Links -->
      <nav class="pt-1" aria-label="Social links">
        <div class="flex flex-wrap gap-2">
          {socialLinks.map((link) => (
            <a
              class="group flex items-center gap-1.5 rounded-[4px] border border-[var(--border-subtle)] bg-transparent px-3 py-1.5 text-xs font-medium text-[var(--text-muted)] transition-all duration-[var(--duration-medium)] ease-[var(--ease-smooth-out)] hover:-translate-y-[3px] hover:scale-[1.015] hover:border-[var(--border-default)] hover:text-[var(--text-primary)]"
              href={link.href}
              aria-label={link.label}
            >
              <img class="size-[12px] shrink-0 opacity-50 transition-opacity duration-[var(--duration-fast)] group-hover:opacity-100" src={link.icon} alt="" />
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </nav>
    </div>

  </div>
</section>

<style>
  /* 3D Tilt Card & Glare Styles */
  .avatar-tilt-card {
    perspective: 600px;
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1), border-color 200ms ease;
    isolation: isolate;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
  }

  .avatar-tilt-card:hover {
    border-color: var(--border-default);
  }

  .avatar-tilt-glare {
    opacity: 0;
    background: radial-gradient(
      circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(255, 255, 255, 0.4) 0%,
      rgba(255, 255, 255, 0.1) 45%,
      transparent 70%
    );
    mix-blend-mode: overlay;
    transition: opacity 250ms ease;
  }

  .avatar-tilt-card:hover .avatar-tilt-glare {
    opacity: 1;
  }
</style>

<script>
  // Stagger reveal
  const block = document.querySelector<HTMLElement>('.t-stagger');
  if (block) {
    requestAnimationFrame(() => {
      block.classList.add('is-shown');
    });
  }

  // 3D Card Hover Tilt + Glare Effect (transitions-dev pattern)
  const avatarCard = document.querySelector<HTMLElement>('[data-avatar-tilt]');
  if (avatarCard) {
    const maxTilt = 18; // Max tilt angle in degrees

    avatarCard.addEventListener('mousemove', (e) => {
      const rect = avatarCard.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;

      const tiltX = (y - 0.5) * -maxTilt;
      const tiltY = (x - 0.5) * maxTilt;

      avatarCard.style.transform = `perspective(600px) rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg) scale3d(1.06, 1.06, 1.06)`;
      avatarCard.style.setProperty('--mouse-x', `${(x * 100).toFixed(1)}%`);
      avatarCard.style.setProperty('--mouse-y', `${(y * 100).toFixed(1)}%`);
    });

    avatarCard.addEventListener('mouseleave', () => {
      avatarCard.style.transform = 'perspective(600px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
    });
  }
</script>
