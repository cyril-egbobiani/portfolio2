---
import emailIcon from '../assets/images/email.svg?url';
import githubIcon from '../assets/images/github.svg?url';
import linkedinIcon from '../assets/images/linkedin.svg?url';
import xIcon from '../assets/images/x.svg?url';

const socialLinks = [
  { label: 'X', href: 'https://x.com', icon: xIcon },
  { label: 'GitHub', href: 'https://github.com', icon: githubIcon },
  { label: 'LinkedIn', href: 'https://www.linkedin.com', icon: linkedinIcon },
  { label: 'Email', href: 'mailto:hello@example.com', icon: emailIcon },
];
---

<section class="flex flex-col gap-6">
  <div class="flex w-full flex-col gap-8">

    <!-- HEADER: Avatar + Time-aware greeting (benji.org / ana.sh pattern) -->
    <header class="flex w-full items-start justify-between">
      <img
        class="size-[72px] sm:size-[88px] rounded-full object-cover"
        src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80"
        alt="Cyril Egbobiani"
        width="72"
        height="72"
        loading="eager"
      />

      <!-- Time-aware greeting: font-mono turns it into a dev-signature micro-detail -->
      <p
        id="greeting-label"
        class="self-end font-mono text-xs sm:text-sm text-[var(--text-muted)] tracking-wide"
        aria-live="polite"
      >
        Good morning.
      </p>
    </header>

    <!-- MAIN CONTENT: Staggered reveal, proper typographic hierarchy -->
    <div class="t-stagger flex flex-col gap-5">

      <!--
        PASS 3 CHANGE: Name elevated to h1 — first scannable identity anchor.
        BEFORE: Buried mid-sentence in body prose.
        AFTER: Standalone h1, tracking-tight, --text-primary.
        PRINCIPLE: Typographic hierarchy — visual weight must encode information priority.
      -->
      <h1 class="t-stagger-line t-stagger-line--1 m-0 text-xl sm:text-2xl font-semibold leading-none tracking-[-0.015em] text-[var(--text-primary)]">
        Cyril Egbobiani
      </h1>

      <!--
        PASS 3 CHANGE: Role + location as a distinct second tier.
        BEFORE: Merged into body prose ("I'm Cyril Egbobiani, a Software Engineer…")
        AFTER: Compact, factual eyebrow — benji.org's "Born in London" density.
        PRINCIPLE: Short, factual metadata reads faster than embedded prose.
      -->
      <p class="t-stagger-line t-stagger-line--2 m-0 text-sm sm:text-base leading-snug text-[var(--text-muted)]">
        Software Engineer & Designer · Lagos, Nigeria&nbsp;🇳🇬
      </p>

      <!-- Hair-line separator — rgba(255,255,255,0.06), invisible from distance -->
      <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

      <!--
        PASS 3 CHANGE: Grammar corrected ("in him" → removed), copy tightened.
        BEFORE: "every creative thought in him to better this world."
        AFTER: First-person, precise, no filler.
        PRINCIPLE: Copy errors are trust-signal failures on credibility-first profiles.
      -->
      <p class="t-stagger-line t-stagger-line--3 m-0 text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
        My drive is in imagining and executing every creative idea to make things better. Design and code are two sides of the same coin — and balancing both has been an extraordinary journey.
      </p>

      <!--
        PASS 3 CHANGE: Icon + label instead of icon-only pills.
        Sharp 4px radius, hair-line border, premium easing hover lift.
      -->
      <nav class="pt-1" aria-label="Social links">
        <div class="flex flex-wrap gap-2">
          {socialLinks.map((link) => (
            <a
              class="group flex items-center gap-1.5 rounded-[4px] border border-[var(--border-subtle)] bg-transparent px-3 py-1.5 text-xs font-medium text-[var(--text-muted)] transition-all duration-[var(--duration-medium)] ease-[var(--ease-smooth-out)] hover:-translate-y-[3px] hover:scale-[1.015] hover:border-[var(--border-default)] hover:text-[var(--text-primary)]"
              href={link.href}
              aria-label={link.label}
            >
              <img class="size-[12px] shrink-0 opacity-50 transition-opacity duration-[var(--duration-fast)] group-hover:opacity-100" src={link.icon} alt="" />
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </nav>
    </div>

  </div>
</section>

<script>
  // Stagger reveal — existing transitions.dev pattern
  const block = document.querySelector<HTMLElement>('.t-stagger');
  if (block) {
    requestAnimationFrame(() => {
      block.classList.add('is-shown');
    });
  }

  // Time-aware greeting — contextual micro-credibility signal (ana.sh / benji.org pattern)
  const greetingEl = document.getElementById('greeting-label');
  if (greetingEl) {
    const hour = new Date().getHours();
    const key =
      hour >= 5 && hour < 12 ? 'Good morning.'
      : hour >= 12 && hour < 17 ? 'Good afternoon.'
      : hour >= 17 && hour < 21 ? 'Good evening.'
      : 'Still up.';
    greetingEl.textContent = key;
  }
</script>
