---
// PortfolioIntro.astro — Hero & Introduction matching Figma screenshot
// Wide landscape portrait card with smooth progressive bottom dissolve into canvas.
// Clean typography with expressive script accents and 'Let's Talk' CTA button.
import profileImg from '../assets/images/profile-.png?url';
---

<section class="hero pt-16 sm:pt-24 flex flex-col gap-6 sm:gap-7">

  <!-- 1. Wide Display Photo Card with Progressive Downward Dissolve -->
  <div class="hero-photo-card group">
    <img
      class="hero-photo-img"
      src={profileImg}
      alt="Cyril Egbobiani"
      loading="eager"
    />
    <!-- Downward Progressive Fade into Canvas Surface -->
    <div class="hero-blur-tint" aria-hidden="true"></div>
    <div class="hero-blur-filter" aria-hidden="true"></div>
  </div>

  <!-- 2. Text Content Block -->
  <div class="hero-text-block flex flex-col gap-4 w-full pt-1">
    <p class="lede lede--first">
      Hi I'm Cyril, a Designer and Builder of software, mostly the parts people actually touch. The passion started from <em class="accent-script">drawing</em> then i eventually found code and realized <em class="accent-script">Hey!</em> this was a missing i needed. Since then, I've be designing and building systems for the web and mobile world.
    </p>

    <p class="lede lede--second">
      I currently serve as a Frontend Engineer and UI/UX designer at International Energy Services Limited, where I design and build software solutions.
    </p>

    <!-- 3. 'Let's Talk' CTA Button matching Figma -->
    <div class="pt-2">
      <a
        href="#contact"
        class="talk-btn"
        aria-label="Let's Talk - Go to contact section"
      >
        Let's Talk
      </a>
    </div>
  </div>

</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* ── Photo Banner Card ── */
  .hero-photo-card {
    position: relative;
    width: 100%;
    aspect-ratio: 2.1 / 1;
    border: none;
    overflow: hidden;
    background: transparent;
    box-shadow: none;
  }

  @media (min-width: 640px) {
    .hero-photo-card {
      aspect-ratio: 2.35 / 1;
    }
  }

  .hero-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transform: scale(1.01);
    transition: transform 600ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-photo-card:hover .hero-photo-img {
      transform: scale(1.025);
    }
  }

  /* Progressive downward fade matching canvas */
  .hero-blur-tint {
    position: absolute;
    inset: 0;
    top: auto;
    height: 52%;
    background: linear-gradient(
      to top,
      var(--surface) 0%,
      color-mix(in srgb, var(--surface) 92%, transparent) 30%,
      color-mix(in srgb, var(--surface) 50%, transparent) 65%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 1;
    transition: background-color 150ms var(--ease-smooth-out);
  }

  .hero-blur-filter {
    position: absolute;
    inset: 0;
    top: auto;
    height: 52%;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.6) 45%, rgba(0, 0, 0, 0) 100%);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.6) 45%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* ── Introduction Typography ── */
  .lede {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.68;
    color: var(--text-secondary);
    width: 100%;
    letter-spacing: -0.01em;
  }

  /* Expressive Display Accents ("drawing", "Hey!") */
  .accent-script {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.14em;
    color: var(--text-primary);
    letter-spacing: normal;
    padding: 0 1px;
  }

  /* ── 'Let's Talk' Button ── */
  .talk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--text-primary);
    color: var(--surface);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    padding: 7px 18px;
    border-radius: 9999px;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    transition:
      opacity 160ms var(--ease-smooth-out),
      transform 160ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .talk-btn:hover {
      opacity: 0.88;
    }
  }

  .talk-btn:active {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo-img,
    .talk-btn {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
