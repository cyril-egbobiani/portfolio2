---

<!-- Reading order is deliberate and descending: greeting, then the one thing
     I do, then context, then details, then links. Nothing competes. -->
<section class="hero pt-14 sm:pt-18">

  <div class="hero-top">
    <img
      class="hero-avatar"
      src={profileImg}
      alt="Cyril Egbobiani"
      width="104"
      height="104"
      loading="eager"
    />
  </div>

  <h1 class="statement">Cyril Egbobiani</h1>

  <p class="lede">
   Based in Lagos Nigeria, I'm a Designer and Builder of softwares, mostly the parts people actually touch. The passion for design and building softwares came from drawing, the instinct carried over.
  </p>

  <p class="lede">
  I currently serve as a Frontend Engineer and a UI/UX designer at the International Energy Services Limited company, where I design and build software solutions.
  </p>

  <nav class="social-row" aria-label="Social links">
    {socialLinks.map((link) => (
      <a class="social-link" href={link.href} aria-label={link.label}>
        <span class="social-link__icon" set:html={link.icon} />
        <span>{link.label}</span>
      </a>
    ))}
  </nav>

</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 24px;
  }

  .hero-avatar {
    width: 52px;
    height: 52px;
    border-radius: 9999px;
    object-fit: cover;
    background: var(--surface-subtle);
    flex-shrink: 0;
    animation: heroAvatarReveal 500ms var(--ease-smooth-out) 0ms both;
    will-change: transform, opacity;
  }

  /* Greeting is warm but subordinate — it sets tone, it is not the headline */
  .hero-hi {
    font-size: 27px;
    font-weight: 500;
    line-height: 1;
    color: var(--text-secondary);
  }

  /* The single largest thing on the page. One idea, one line. */
  .statement {
    margin: 0 0 18px;
    font-family: var(--font-sans);
    font-size: 30px;
    line-height: 1.28;
    letter-spacing: -0.05em;
    font-weight: 600;
    color: var(--text-primary);
    animation: heroTextReveal var(--stagger-dur, 500ms) var(--stagger-ease, cubic-bezier(0.16, 1, 0.3, 1)) 40ms both;
    will-change: transform, opacity, filter;
  }

  .lede {
    margin: 0 0 26px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 54ch;
    animation: heroTextReveal var(--stagger-dur, 500ms) var(--stagger-ease, cubic-bezier(0.16, 1, 0.3, 1)) both;
    will-change: transform, opacity, filter;
  }

  .lede:nth-of-type(1) {
    animation-delay: 90ms;
  }

  .lede:nth-of-type(2) {
    animation-delay: 140ms;
  }

  /* Quiet text links rather than four bordered pills, which read as noise
     directly under the headline. */
  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    animation: heroRowReveal 450ms var(--ease-smooth-out) 190ms both;
    will-change: transform, opacity;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    line-height: 1;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 160ms var(--ease-smooth-out),
      transform 160ms var(--ease-smooth-out);
  }

  .social-link__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 160ms var(--ease-smooth-out);
  }

  .social-link__icon :global(svg) {
    width: 14px;
    height: 14px;
    display: block;
  }

  @keyframes heroAvatarReveal {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(6px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes heroTextReveal {
    from {
      opacity: 0;
      transform: translateY(var(--stagger-distance, 12px));
      filter: blur(var(--stagger-blur, 3px));
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes heroRowReveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      color: var(--text-primary);
    }

    .social-link:hover .social-link__icon {
      opacity: 1;
    }
  }

  .social-link:active {
    transform: scale(0.97);
  }

  @media (max-width: 640px) {
    .statement {
      font-size: 24px;
    }

    .lede {
      font-size: 15.5px;
    }

    .social-row {
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-avatar,
    .statement,
    .lede,
    .social-row,
    .social-link,
    .social-link__icon {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
