---
import emailIcon from '../assets/images/email.svg?url';
import githubIcon from '../assets/images/github.svg?url';
import linkedinIcon from '../assets/images/linkedin.svg?url';
import xIcon from '../assets/images/x.svg?url';
import profileImg from '../assets/images/profile-.png?url';

const socialLinks = [
  { label: 'X', href: 'https://x.com', icon: xIcon },
  { label: 'GitHub', href: 'https://github.com', icon: githubIcon },
  { label: 'LinkedIn', href: 'https://www.linkedin.com', icon: linkedinIcon },
  { label: 'Email', href: 'mailto:hello@example.com', icon: emailIcon },
];
---

<section class="flex flex-col gap-6">
  <div class="flex w-full flex-col gap-8">

    <!-- HEADER: Avatar with Refined 3D Tilt & Tactile Press Motion -->
    <header class="flex w-full items-center justify-between">
      <div
        class="avatar-tilt-card group relative size-[72px] sm:size-[88px] mt-35 cursor-pointer overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-subtle)] shadow-sm select-none"
        data-avatar-tilt
      >
        <img
          class="avatar-img size-full object-cover object-center scale-[1.03] transition-transform duration-300 group-hover:scale-[1.06]"
          src={profileImg}
          alt="Cyril Egbobiani"
          width="88"
          height="88"
          loading="eager"
        />
        <!-- Spotlight Glare Overlay -->
        <div class="avatar-tilt-glare absolute inset-0 pointer-events-none rounded-2xl" data-avatar-glare></div>
      </div>
    </header>

    <!-- MAIN CONTENT: Clean, instant editorial hierarchy with calibrated typography -->
    <div class="flex flex-col gap-5">

      <!-- Name Header (Caveat signature handwriting display font) -->
      <h1 class="m-0 font-display text-3xl sm:text-[40px] font-bold tracking-normal leading-[1.15] text-[var(--text-primary)]">
        Cyril Egbobiani
      </h1>

      <!-- Role + Location -->
      <p class="m-0 font-sans text-sm sm:text-[14.5px] leading-snug text-[var(--text-muted)] font-normal">
        Software Engineer & Designer · Lagos, Nigeria
      </p>

      <!-- Hair-line separator with faded gradient mask -->
      <div class="w-full border-t border-dashed border-[var(--border-subtle)] border-masked-x" role="separator" aria-hidden="true"></div>

      <!-- Bio Copy (Calibrated 15.5px with comfortable 1.62 leading) -->
      <p class="m-0 font-sans text-[15.5px] sm:text-[16px] leading-[1.62] text-[var(--text-secondary)] font-normal">
        My drive is in imagining and executing every creative idea to make things better. Design and code are two sides of the same coin and balancing both has been an extraordinary journey.
      </p>

      <!-- Social Links -->
      <nav class="pt-1" aria-label="Social links">
        <div class="flex flex-wrap gap-2">
          {socialLinks.map((link) => (
            <a
              class="group flex items-center gap-1.5 rounded-[6px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-1.5 font-mono text-xs font-medium text-[var(--text-muted)] transition-[transform,border-color,color] duration-160 ease-[var(--ease-smooth-out)] hover:-translate-y-0.5 hover:border-[var(--border-default)] hover:text-[var(--text-primary)] active:scale-[0.97]"
              href={link.href}
              aria-label={link.label}
            >
              <img class="size-[12px] shrink-0 opacity-50 transition-opacity duration-150 group-hover:opacity-100" src={link.icon} alt="" />
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </nav>
    </div>

  </div>
</section>

<style>
  /* Refined 3D Avatar Physics Card (Emil Kowalski Design Engineering Rules) */
  .avatar-tilt-card {
    perspective: 800px;
    transform-style: preserve-3d;
    will-change: transform;
    transition:
      border-color 160ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
    isolation: isolate;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    touch-action: manipulation;
  }

  .avatar-tilt-card:hover {
    border-color: var(--border-default);
  }

  .avatar-tilt-glare {
    opacity: 0;
    background: radial-gradient(
      circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(255, 255, 255, 0.25) 0%,
      rgba(255, 255, 255, 0.08) 40%,
      transparent 70%
    );
    mix-blend-mode: overlay;
    transition: opacity 200ms ease;
  }

  .avatar-tilt-card:hover .avatar-tilt-glare {
    opacity: 1;
  }

  /* Tactile Press State */
  .avatar-tilt-card:active,
  .avatar-tilt-card.is-pressed {
    transform: perspective(800px) scale3d(0.96, 0.96, 0.96) !important;
  }
</style>

<script>
  // Refined Lerp Physics Engine (Emil Kowalski Motion Scale)
  const avatarCard = document.querySelector<HTMLElement>('[data-avatar-tilt]');
  if (avatarCard) {
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let targetTransX = 0;
    let targetTransY = 0;
    let currentTransX = 0;
    let currentTransY = 0;
    let isHovered = false;
    let isPressed = false;
    let rafId: number | null = null;

    const maxTilt = 12; // Refined tilt angle in degrees
    const maxTrans = 4; // Subtle 4px translation
    const lerpFactor = 0.16; // Snappy smooth momentum factor

    const updatePhysics = () => {
      currentX += (targetX - currentX) * lerpFactor;
      currentY += (targetY - currentY) * lerpFactor;
      currentTransX += (targetTransX - currentTransX) * lerpFactor;
      currentTransY += (targetTransY - currentTransY) * lerpFactor;

      if (!isPressed) {
        if (isHovered) {
          avatarCard.style.transform = `perspective(800px) translate3d(${currentTransX.toFixed(2)}px, ${currentTransY.toFixed(2)}px, 6px) rotateX(${currentY.toFixed(2)}deg) rotateY(${currentX.toFixed(2)}deg) scale3d(1.025, 1.025, 1.025)`;
        } else {
          avatarCard.style.transform = `perspective(800px) translate3d(${currentTransX.toFixed(2)}px, ${currentTransY.toFixed(2)}px, 0px) rotateX(${currentY.toFixed(2)}deg) rotateY(${currentX.toFixed(2)}deg) scale3d(1, 1, 1)`;
        }
      }

      const isSettled =
        Math.abs(targetX - currentX) < 0.01 &&
        Math.abs(targetY - currentY) < 0.01 &&
        Math.abs(targetTransX - currentTransX) < 0.01 &&
        Math.abs(targetTransY - currentTransY) < 0.01;

      if (!isSettled || isHovered) {
        rafId = requestAnimationFrame(updatePhysics);
      } else {
        rafId = null;
      }
    };

    const startPhysicsLoop = () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updatePhysics);
      }
    };

    avatarCard.addEventListener('mousemove', (e) => {
      const rect = avatarCard.getBoundingClientRect();
      const relX = (e.clientX - rect.left) / rect.width;
      const relY = (e.clientY - rect.top) / rect.height;

      targetX = (relX - 0.5) * maxTilt;
      targetY = (relY - 0.5) * -maxTilt;
      targetTransX = (relX - 0.5) * maxTrans;
      targetTransY = (relY - 0.5) * maxTrans;

      avatarCard.style.setProperty('--mouse-x', `${(relX * 100).toFixed(1)}%`);
      avatarCard.style.setProperty('--mouse-y', `${(relY * 100).toFixed(1)}%`);

      isHovered = true;
      startPhysicsLoop();
    });

    avatarCard.addEventListener('mouseleave', () => {
      isHovered = false;
      targetX = 0;
      targetY = 0;
      targetTransX = 0;
      targetTransY = 0;
      startPhysicsLoop();
    });

    // Tactile Press Feedback (Emil Kowalski Rule: instant responsive press scale)
    avatarCard.addEventListener('pointerdown', () => {
      isPressed = true;
      avatarCard.classList.add('is-pressed');
    });

    const releasePress = () => {
      if (isPressed) {
        isPressed = false;
        avatarCard.classList.remove('is-pressed');
        startPhysicsLoop();
      }
    };

    window.addEventListener('pointerup', releasePress);
    window.addEventListener('pointercancel', releasePress);
  }
</script>
