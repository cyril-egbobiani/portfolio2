---
import emailIcon from '../assets/images/email.svg?url';
import githubIcon from '../assets/images/github.svg?url';
import linkedinIcon from '../assets/images/linkedin.svg?url';
import xIcon from '../assets/images/x.svg?url';
import profileImg from '../assets/images/profile-.png?url';

const socialLinks = [
  { label: 'X', href: 'https://x.com', icon: xIcon },
  { label: 'GitHub', href: 'https://github.com', icon: githubIcon },
  { label: 'LinkedIn', href: 'https://www.linkedin.com', icon: linkedinIcon },
  { label: 'Email', href: 'mailto:egbobianicyril@gmail.com', icon: emailIcon },
];
---

<!-- Reading order is deliberate and descending: greeting, then the one thing
     I do, then context, then details, then links. Nothing competes. -->
<section class="hero pt-28 sm:pt-32">

  <div class="hero-top">
    <img
      class="hero-avatar"
      src={profileImg}
      alt="Cyril Egbobiani"
      width="104"
      height="104"
      loading="eager"
    />
    <span class="hero-hi">Hey, I'm Cyril Egbobiani.</span>
  </div>

  <h1 class="statement">I design and build products.</h1>

  <p class="lede">
    About three years in, mostly web with some mobile, working out of Lagos. I came
    to software through drawing, and the instinct carried over. You keep adjusting
    something until it stops feeling wrong.
  </p>

  <nav class="social-row" aria-label="Social links">
    {socialLinks.map((link) => (
      <a class="social-link" href={link.href} aria-label={link.label}>
        <img class="social-link__icon" src={link.icon} alt="" />
        <span>{link.label}</span>
      </a>
    ))}
  </nav>

</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 24px;
  }

  .hero-avatar {
    width: 52px;
    height: 52px;
    border-radius: 9999px;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  /* Greeting is warm but subordinate — it sets tone, it is not the headline */
  .hero-hi {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1;
    color: var(--text-secondary);
  }

  /* The single largest thing on the page. One idea, one line. */
  .statement {
    margin: 0 0 18px;
    font-family: var(--font-sans);
    font-size: 28px;
    line-height: 1.28;
    letter-spacing: -0.038em;
    font-weight: 500;
    color: var(--text-primary);
  }

  .lede {
    margin: 0 0 26px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 54ch;
  }

  /* Quiet text links rather than four bordered pills, which read as noise
     directly under the headline. */
  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 160ms var(--ease-smooth-out),
      transform 160ms var(--ease-smooth-out);
  }

  .social-link__icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    opacity: 0.45;
    transition: opacity 160ms var(--ease-smooth-out);
  }

  .social-link span {
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: border-color 160ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      color: var(--text-primary);
    }

    .social-link:hover .social-link__icon {
      opacity: 1;
    }

    .social-link:hover span {
      border-bottom-color: var(--border-strong);
    }
  }

  .social-link:active {
    transform: scale(0.97);
  }

  @media (max-width: 640px) {
    .statement {
      font-size: 24px;
    }

    .lede {
      font-size: 15.5px;
    }

    .social-row {
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link,
    .social-link__icon,
    .social-link span {
      transition: none;
    }

    .social-link:active {
      transform: none;
    }
  }
</style>
