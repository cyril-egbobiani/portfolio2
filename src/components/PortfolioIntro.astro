---
// PortfolioIntro.astro — Hero A from the design system.
// The cube sits above the name and role, then one line about how I work,
// then the two pill buttons with the socials on the right. The longer story
// (the drawing) lives on the About page.
import { Image } from 'astro:assets';
import avatar from '../assets/images/optimized/profile-avatar.webp';

const RESUME = 'https://drive.google.com/file/d/1XXSvad2gGp1N7c7Pc7x0WkOkr_0AUAWb/view';

const socials = [
  {
    name: 'X (Twitter)',
    href: 'https://x.com/CyrilEgbobiani',
    icon: `<svg width="15" height="15" viewBox="-0.86 -0.91 25.92 25.92" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    name: 'GitHub',
    href: 'https://github.com/cyril-egbobiani',
    icon: `<svg width="15" height="15" viewBox="-1.93 -2.18 27.36 27.36" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/cyril-egbobiani-6802002b8/',
    icon: `<svg width="15" height="15" viewBox="-1.08 -1.58 26.16 26.16" fill="none" stroke="currentColor" stroke-width="1.96" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="4" height="12" rx="1"/><circle cx="4" cy="4" r="2"/><path d="M10 9h4v2.5a4 4 0 0 1 4-2.5c2.5 0 4 1.5 4 4.5V21h-4v-6.5c0-1.2-.8-2-2-2s-2 .8-2 2V21h-4V9z"/></svg>`,
  },
];
---

<section class="intro">
  <div class="hero-id">
    <!-- The box: photo, monogram, home, and the pencil it all started with. Tap it for About. -->
    <a href="/about" class="box" aria-label="About me" title="About me" data-astro-prefetch>
      <div class="box__spin" aria-hidden="true">
        <div class="box__face box__face--1">
          <Image src={avatar} alt="" width={56} height={56} densities={[1, 2]} class="box__photo" loading="eager" />
        </div>
        <div class="box__face box__face--2"><span class="box__mono">CE</span></div>
        <div class="box__face box__face--3"><span class="meta-mono box__lag">LAG</span></div>
        <div class="box__face box__face--4">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.2-4.2L16.6 4.4a2 2 0 0 1 2.9 2.9L8.1 18.8z"/><path d="M14.8 6.2l3 3"/></svg>
        </div>
      </div>
    </a>

    <div class="hero-id__text">
      <h1 class="hero-name">Cyril Egbobiani</h1>
      <span class="hero-role">Software engineer &amp; product designer</span>
    </div>
  </div>

  <p class="lede">
    I work with thoughtful founders to build software that does what it was always meant to do, and does it well.
  </p>

  <div class="hero-actions">
    <div class="hero-actions__main">
      <a href="#contact" class="btn btn-primary">Get in touch</a>
      <a href={RESUME} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Résumé<span class="sr-only"> (opens in a new tab)</span></a>
    </div>
    <div class="hero-actions__social">
      {socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer" class="social-dot" aria-label={`${social.name} (opens in a new tab)`}>
          <span set:html={social.icon} />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 88px;
  }

  @media (min-width: 640px) {
    .intro { padding-top: 120px; }
  }

  /* ── Name row ─────────────────────────────────────────── */
  /* The cube sits above the name */
  .hero-id {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-id__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .hero-name {
    margin: 0;
    font-family: var(--font-title);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .hero-role {
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  /* ── The box ──────────────────────────────────────────── */
  .box {
    --cube: 56px;
    display: block;
    flex-shrink: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 160ms var(--ease-smooth-out);
    width: var(--cube);
    height: var(--cube);
    perspective: 600px;
  }

  .box:active { transform: scale(0.95); }

  .box:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }

  /* Pause on hover so the face you're about to tap holds still */
  @media (hover: hover) and (pointer: fine) {
    .box:hover .box__spin { animation-play-state: paused; }
  }

  .box__spin {
    position: relative;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--cube) / -2)) rotateY(0deg);
    animation: box-turn 10s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .box__face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
    border: 1px solid var(--border-default);
    background: var(--surface-card);
    color: var(--text-primary);
    backface-visibility: hidden;
  }

  .box__face--1 { transform: rotateY(0deg) translateZ(calc(var(--cube) / 2)); }
  .box__face--2 { transform: rotateY(90deg) translateZ(calc(var(--cube) / 2)); }
  .box__face--3 {
    transform: rotateY(180deg) translateZ(calc(var(--cube) / 2));
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
  }
  .box__face--4 {
    transform: rotateY(270deg) translateZ(calc(var(--cube) / 2));
    background: var(--brand-soft);
    color: var(--brand);
  }

  .box__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .box__mono {
    font-family: var(--font-title);
    font-size: 20px;
    line-height: 1;
  }

  .box__lag { color: inherit; font-size: 11px; }

  @keyframes box-turn {
    0%, 20%   { transform: translateZ(calc(var(--cube) / -2)) rotateY(0deg); }
    25%, 45%  { transform: translateZ(calc(var(--cube) / -2)) rotateY(-90deg); }
    50%, 70%  { transform: translateZ(calc(var(--cube) / -2)) rotateY(-180deg); }
    75%, 95%  { transform: translateZ(calc(var(--cube) / -2)) rotateY(-270deg); }
    100%      { transform: translateZ(calc(var(--cube) / -2)) rotateY(-360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .box__spin { animation: none; }
  }

  /* ── Copy ─────────────────────────────────────────────── */
  .lede {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  /* ── Actions ──────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 4px;
  }

  .hero-actions__main,
  .hero-actions__social {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero-actions__social { gap: 8px; }

  .social-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    color: var(--text-secondary);
    transition: color 160ms var(--ease-smooth-out), transform 140ms var(--ease-smooth-out);
  }

  .social-dot span { display: flex; }

  @media (hover: hover) and (pointer: fine) {
    .social-dot:hover { color: var(--text-primary); }
  }

  .social-dot:active { transform: scale(0.94); }

  @media (pointer: coarse) {
    .social-dot { width: 44px; height: 44px; }
  }
</style>
