---
// PortfolioIntro.astro — Uncluttered Intro with Clean MingCute Social Links
// Wide landscape photo banner + calm, unclustered copy + lightweight social links (no heavy pills).
import profileImg from '../assets/images/profile-.png?url';

const socials = [
  {
    name: 'X (Twitter)',
    href: 'https://x.com',
    icon: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>`,
  },
  {
    name: 'GitHub',
    href: 'https://github.com/cyril-egbobiani',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com',
    icon: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="4" height="12" rx="1"/><circle cx="4" cy="4" r="2"/><path d="M10 9h4v2.5a4 4 0 0 1 4-2.5c2.5 0 4 1.5 4 4.5V21h-4v-6.5c0-1.2-.8-2-2-2s-2 .8-2 2V21h-4V9z"/></svg>`,
  },
  {
    name: 'Email',
    href: 'mailto:egbobianicyril@gmail.com',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="14" x="3" y="5" rx="2.5"/><path d="m3 7 9 6 9-6"/></svg>`,
  },
  {
    name: 'Resume',
    href: 'https://drive.google.com/file/d/1XXSvad2gGp1N7c7Pc7x0WkOkr_0AUAWb/view',
    icon: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
];
---

<section class="hero flex flex-col gap-4 sm:gap-5">

  <!-- 1. Wide Display Photo Card with Soft Downward Dissolve -->
  <div class="hero-photo-card group">
    <img
      class="hero-photo-img"
      src={profileImg}
      alt="Cyril Egbobiani"
      loading="eager"
    />
    <div class="hero-blur-tint" aria-hidden="true"></div>
    <div class="hero-blur-filter" aria-hidden="true"></div>
  </div>

  <!-- 2. Text Content Block — Clean & Relaxed -->
  <div class="hero-text-block flex flex-col gap-3.5 w-full">
    <p class="lede">
      Hi, I'm Cyril—a Designer and Builder of software, mostly the parts people actually touch. The passion started from drawing, then I eventually found code and realized this was the missing piece I needed. Since then, I've been designing and building systems for web and mobile.
    </p>

    <p class="lede">
      I currently serve as a Frontend Engineer and UI/UX designer at <a href="https://iesl.ng" target="_blank" rel="noopener noreferrer" class="story-link">International Energy Services Limited</a>, where I design and build software solutions.
    </p>

    <!-- 3. Minimalist MingCute Social Links (Clean, unclustered, no heavy pills) -->
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 pt-1">
      {socials.map((social) => (
        <a
          href={social.href}
          target={social.href.startsWith('mailto:') ? '_self' : '_blank'}
          rel={social.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          class="social-link"
          aria-label={social.name}
        >
          <span class="social-link__icon" set:html={social.icon} />
          <span>{social.name}</span>
        </a>
      ))}
    </div>
  </div>

</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* ── Photo Banner Card (Sleek Panoramic Height) ── */
  .hero-photo-card {
    position: relative;
    width: 100%;
    aspect-ratio: 2.7 / 1;
    border: none;
    overflow: hidden;
    background: transparent;
    box-shadow: none;
  }

  @media (min-width: 640px) {
    .hero-photo-card {
      aspect-ratio: 3.2 / 1;
    }
  }

  .hero-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transform: scale(1.01);
    transition: transform 600ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-photo-card:hover .hero-photo-img {
      transform: scale(1.025);
    }
  }

  /* Progressive downward fade matching canvas */
  .hero-blur-tint {
    position: absolute;
    inset: 0;
    top: auto;
    height: 52%;
    background: linear-gradient(
      to top,
      var(--surface) 0%,
      color-mix(in srgb, var(--surface) 92%, transparent) 30%,
      color-mix(in srgb, var(--surface) 50%, transparent) 65%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 1;
    transition: background-color 150ms var(--ease-smooth-out);
  }

  .hero-blur-filter {
    position: absolute;
    inset: 0;
    top: auto;
    height: 52%;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.6) 45%, rgba(0, 0, 0, 0) 100%);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.6) 45%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* ── Introduction Typography ── */
  .lede {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-secondary);
    width: 100%;
    letter-spacing: -0.01em;
  }

  .story-link {
    color: var(--text-primary);
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms var(--ease-smooth-out), opacity 160ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .story-link:hover {
      opacity: 0.75;
    }
  }

  /* ── Clean MingCute Social Links ── */
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      color 160ms var(--ease-smooth-out),
      transform 160ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      color: var(--text-primary);
    }
  }

  .social-link:active {
    transform: scale(0.96);
  }

  .social-link__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: color 160ms var(--ease-smooth-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover .social-link__icon {
      color: var(--text-primary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo-img,
    .social-link {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
