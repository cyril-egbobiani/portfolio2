---
// ContactSection.astro — Interactive Contact Section
---

<section class="relative flex flex-col gap-5" id="contact">
  <!-- Section Header -->
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title font-display leading-[1.4] tracking-normal font-bold">Let's talk.</h2>
      <span class="section-aside">Open for select freelance projects & collaborations</span>
    </div>
  </div>

  <!-- Contact Section Container -->
  <div class="contact-card reveal-item reveal-delay-1 flex flex-col gap-4 py-1">
    <p class="m-0 font-sans text-[15px] leading-[1.7] text-[var(--text-secondary)] font-normal">
      If you're building something thoughtful in consumer tech or creative software, I'd love to chat. Drop a line or copy my email below.
    </p>

    <!-- Email & Social Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
      
      <!-- Interactive Email Copy Pill -->
      <div
        class="email-box group relative flex items-center justify-between gap-3 rounded-[6px] bg-[var(--surface-subtle)] px-3 py-2 cursor-pointer select-none transition-[background-color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)] active:scale-[0.98]"
        data-copy-box
        data-lisse="8"
        role="button"
        tabindex="0"
        aria-label="Copy email address"
      >
        <div class="flex items-center gap-2 min-w-0 flex-1">
          <svg class="size-4 shrink-0 opacity-70 text-[var(--text-primary)] transition-opacity group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="14" x="3" y="5" rx="2.5" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <span class="truncate font-sans text-[13px] sm:text-sm text-[var(--text-primary)]">
            egbobianicyril@gmail.com
          </span>
        </div>

        <div class="copy-btn shrink-0 relative flex items-center gap-1.5 rounded-[5px] border border-[var(--border-subtle)] bg-[var(--surface)] px-2.5 py-1 text-xs text-[var(--text-muted)] transition-[color,background-color,border-color,box-shadow,transform] duration-200 ease-[var(--ease-smooth-out)] group-hover:text-[var(--text-primary)] group-hover:border-[var(--border-default)]">
          <span class="copy-btn__stage relative flex size-3.5 items-center justify-center shrink-0" aria-hidden="true">
            <!-- Copy icon -->
            <svg class="copy-btn__icon copy-btn__icon--copy size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="13" height="13" x="8" y="8" rx="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <!-- Check icon (draws on success) -->
            <svg class="copy-btn__icon copy-btn__icon--check size-3.5 text-emerald-700 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
          <!-- Morphing Text Slot -->
          <span class="copy-btn__text-slot relative inline-grid overflow-hidden">
            <span class="copy-btn__text copy-btn__text--default font-sans text-xs font-medium">Copy</span>
            <span class="copy-btn__text copy-btn__text--copied font-sans text-xs font-semibold text-emerald-700 dark:text-emerald-400">Copied!</span>
          </span>
        </div>
      </div>

      <!-- Social Action Buttons -->
      <div class="flex items-center gap-2">
        <a
          href="https://x.com"
          target="_blank"
          rel="noopener noreferrer"
          data-lisse="8"
          class="social-pill flex items-center justify-center rounded-[6px] bg-[var(--surface-subtle)] px-3 py-2 font-sans text-xs font-medium text-[var(--text-muted)] no-underline transition-[color,background-color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
        >
          X
        </a>
        <a
          href="https://www.linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          data-lisse="8"
          class="social-pill flex items-center justify-center rounded-[6px] bg-[var(--surface-subtle)] px-3 py-2 font-sans text-xs font-medium text-[var(--text-muted)] no-underline transition-[color,background-color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
        >
          LinkedIn
        </a>
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          data-lisse="8"
          class="social-pill flex items-center justify-center rounded-[6px] bg-[var(--surface-subtle)] px-3 py-2 font-sans text-xs font-medium text-[var(--text-muted)] no-underline transition-[color,background-color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
        >
          GitHub
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .email-box:active,
  .social-pill:active {
    transform: scale(0.98);
  }

  /* ── Morph & Elastic Stretch Badge ── */
  .copy-btn {
    will-change: transform, border-color, background-color;
  }

  .email-box.is-copied .copy-btn {
    animation: copyBadgeMorph 460ms cubic-bezier(0.23, 1, 0.32, 1) both;
    background-color: #ffffff;
    border-color: rgba(5, 150, 105, 0.35);
    box-shadow: 0 1px 4px rgba(5, 150, 105, 0.12), 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  :global([data-theme="dark"]) .email-box.is-copied .copy-btn {
    background-color: rgba(16, 185, 129, 0.14);
    border-color: rgba(52, 211, 153, 0.38);
    box-shadow: 0 1px 6px rgba(16, 185, 129, 0.20);
  }

  @keyframes copyBadgeMorph {
    0% {
      transform: scale(0.92, 0.92);
    }
    35% {
      transform: scale(1.10, 0.92); /* Horizontal stretch & squash */
    }
    68% {
      transform: scale(0.97, 1.03); /* Elastic rebound */
    }
    100% {
      transform: scale(1, 1);
    }
  }

  /* ── Icon Cross-Swap + Path Stroke Draw ── */
  .copy-btn__stage {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .copy-btn__icon {
    position: absolute;
    transition:
      transform 260ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      filter 240ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform, opacity, filter;
  }

  .copy-btn__icon--copy {
    transform: rotate(0deg) scale(1);
    opacity: 1;
    filter: blur(0);
  }

  .copy-btn__icon--check {
    transform: rotate(-35deg) scale(0.35);
    opacity: 0;
    filter: blur(2px);
  }

  /* SVG stroke draw for checkmark */
  .copy-btn__icon--check polyline {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition: stroke-dashoffset 280ms cubic-bezier(0.23, 1, 0.32, 1) 50ms;
  }

  .email-box.is-copied .copy-btn__icon--copy {
    transform: rotate(45deg) scale(0.35);
    opacity: 0;
    filter: blur(2px);
  }

  .email-box.is-copied .copy-btn__icon--check {
    transform: rotate(0deg) scale(1);
    opacity: 1;
    filter: blur(0);
  }

  .email-box.is-copied .copy-btn__icon--check polyline {
    stroke-dashoffset: 0;
  }

  /* ── Text Swap Slot ── */
  .copy-btn__text-slot {
    display: inline-grid;
    grid-template-areas: "label";
    align-items: center;
    line-height: 1.2;
  }

  .copy-btn__text {
    grid-area: label;
    white-space: nowrap;
    transition:
      transform 240ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      filter 240ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform, opacity, filter;
  }

  .copy-btn__text--default {
    transform: translateY(0);
    opacity: 1;
    filter: blur(0);
  }

  .copy-btn__text--copied {
    transform: translateY(8px);
    opacity: 0;
    filter: blur(2px);
    pointer-events: none;
  }

  .email-box.is-copied .copy-btn__text--default {
    transform: translateY(-8px);
    opacity: 0;
    filter: blur(2px);
  }

  .email-box.is-copied .copy-btn__text--copied {
    transform: translateY(0);
    opacity: 1;
    filter: blur(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .social-pill:hover,
    .email-box:hover {
      transform: translateY(-1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-btn,
    .copy-btn__icon,
    .copy-btn__icon--check polyline,
    .copy-btn__text {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initEmailCopy() {
    const box = document.querySelector<HTMLElement>('[data-copy-box]');
    const email = 'egbobianicyril@gmail.com';

    if (!box) return;

    let copyTimer: number | undefined;

    const handleCopy = async () => {
      if (box.classList.contains('is-copied')) return;

      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = email;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }

      box.classList.add('is-copied');

      window.clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => {
        box.classList.remove('is-copied');
      }, 1900);
    };

    box.addEventListener('click', handleCopy);
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        handleCopy();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmailCopy);
  } else {
    initEmailCopy();
  }
  document.addEventListener('astro:page-load', initEmailCopy);
</script>
