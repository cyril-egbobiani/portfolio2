<section class="flex flex-col gap-6" id="contact">
<h2 class="m-0 font-sans text-sm sm:text-base font-normal tracking-tight text-[var(--text-muted)]">Contact</h2>
  <div class="flex flex-col gap-4 text-base leading-5" style="color: var(--text-muted)">
    <p class="m-0">I’m basically everywhere but primarily, I’m on <a class=" no-underline transition hover:opacity-80" href="https://x.com" style="color: var(--text-primary)">X</a>, <a class=" no-underline transition hover:opacity-80" href="https://www.linkedin.com" style="color: var(--text-primary)">LinkedIn</a> and <a class=" no-underline transition hover:opacity-80" href="https://github.com" style="color: var(--text-primary)">GitHub</a>.</p>
    <p class="m-0 flex items-center gap-1">
      <a class="no-underline transition hover:opacity-80" href="mailto:egbobianicyril@gmail.com" style="color: var(--rose)">egbobianicyril@gmail.com</a>
<button
        class="copy-btn"
        type="button"
        aria-label="Copy email address"
        data-copy-btn
      >
        <span class="copy-btn__stage" aria-hidden="true">
          <!-- Copy icon (Hero Icons) -->
          <svg class="copy-btn__icon copy-btn__icon--copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
          </svg>
          <!-- Check icon (Hero Icons) -->
          <svg class="copy-btn__icon copy-btn__icon--check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m4.5 12.75 6 6 9-13.5" />
          </svg>
        </span>
      </button>
    </p>
  </div>


</section>

<style>
.copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--rose);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-smooth-out);
  }

  .copy-btn:hover {
    color: var(--rose-hover);
  }

  .copy-btn__stage {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    overflow: hidden;
  }

  .copy-btn__icon {
    position: absolute;
    width: 16px;
    height: 16px;
    transition:
      transform var(--duration-medium) var(--ease-smooth-out),
      opacity var(--duration-medium) var(--ease-smooth-out);
    will-change: transform, opacity;
  }

  /* Copy icon default state */
  .copy-btn__icon--copy {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }

  .copy-btn__icon--check {
    transform: rotate(90deg) scale(0.4);
    opacity: 0;
  }

  /* When copied, swap to check */
  .copy-btn.is-copied .copy-btn__icon--copy {
    transform: rotate(-90deg) scale(0.4);
    opacity: 0;
  }

  .copy-btn.is-copied .copy-btn__icon--check {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }

.copy-btn.is-copied {
    color: var(--rose);
  }


</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-btn]');
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  const email = 'egbobianicyril@gmail.com';

  let toastTimer: number | undefined;

  const showToast = () => {
    if (!toast) return;
    toast.hidden = false;
    // Force reflow so the transition plays when re-showing
    void toast.offsetWidth;
    toast.classList.add('is-visible');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove('is-visible');
    }, 2000);
  };

  if (btn) {
    btn.addEventListener('click', async () => {
      if (btn.classList.contains('is-copied')) return;
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        // Fallback for older browsers
        const ta = document.createElement('textarea');
        ta.value = email;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      btn.classList.add('is-copied');
      showToast();
      setTimeout(() => btn.classList.remove('is-copied'), 1600);
    });
  }
</script>
