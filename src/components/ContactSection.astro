---
// ContactSection.astro — Interactive Contact Section
---

<section class="relative flex flex-col gap-5" id="contact">
  <!-- Section Header -->
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title">Let's talk.</h2>
      <span class="section-aside">Open for select freelance projects & collaborations</span>
    </div>
  </div>

  <!-- Contact Section Container -->
  <div class="contact-card reveal-item reveal-delay-1 flex flex-col gap-4 py-1">
    <p class="m-0 font-sans text-[15px] leading-[1.7] text-[var(--text-secondary)] font-normal">
      If you're building something thoughtful in consumer tech or creative software, I'd love to chat. Drop a line or copy my email below.
    </p>

    <!-- Email & Social Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
      
      <!-- Interactive Email Copy Pill -->
      <div
        class="email-box group relative flex items-center justify-between gap-3 rounded-[6px] bg-[var(--surface-subtle)] px-3 py-2 cursor-pointer select-none transition-[background-color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:bg-[var(--surface-interactive)] active:scale-[0.98]"
        data-copy-box
        role="button"
        tabindex="0"
        aria-label="Copy email address"
      >
        <div class="flex items-center gap-2 min-w-0">
          <svg class="size-4 shrink-0 opacity-70 text-[var(--text-primary)] transition-opacity group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="14" x="3" y="5" rx="2.5" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <span class="truncate font-mono text-[13.5px] sm:text-sm text-[var(--text-primary)]">
            egbobianicyril@gmail.com
          </span>
        </div>

        <div class="copy-btn flex items-center gap-1 rounded-[4px] bg-[var(--surface)] px-2 py-1 text-xs text-[var(--text-muted)] transition-[color] duration-160 ease-[var(--ease-smooth-out)] group-hover:text-[var(--text-primary)]">
          <span class="copy-btn__stage relative flex size-3.5 items-center justify-center" aria-hidden="true">
            <!-- Copy icon -->
            <svg class="copy-btn__icon copy-btn__icon--copy size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="13" height="13" x="8" y="8" rx="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <!-- Check icon -->
            <svg class="copy-btn__icon copy-btn__icon--check size-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
          <span class="copy-btn__label font-mono text-xs font-medium">Copy</span>
        </div>
      </div>

      <!-- Social Action Buttons -->
      <div class="flex items-center gap-2">
        <a
          href="https://x.com"
          target="_blank"
          rel="noopener noreferrer"
          class="social-pill flex items-center justify-center rounded-[6px] bg-[var(--surface-subtle)] px-3 py-2 font-mono text-xs font-medium text-[var(--text-muted)] no-underline transition-[color,background-color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
        >
          X
        </a>
        <a
          href="https://www.linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="social-pill flex items-center justify-center rounded-[6px] bg-[var(--surface-subtle)] px-3 py-2 font-mono text-xs font-medium text-[var(--text-muted)] no-underline transition-[color,background-color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
        >
          LinkedIn
        </a>
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="social-pill flex items-center justify-center rounded-[6px] bg-[var(--surface-subtle)] px-3 py-2 font-mono text-xs font-medium text-[var(--text-muted)] no-underline transition-[color,background-color,transform] duration-160 ease-[var(--ease-smooth-out)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-interactive)] active:scale-[0.97]"
        >
          GitHub
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .email-box:active,
  .social-pill:active {
    transform: scale(0.98);
  }

  .copy-btn__icon {
    position: absolute;
    transition:
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform, opacity;
  }

  .copy-btn__icon--copy {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }

  .copy-btn__icon--check {
    transform: rotate(90deg) scale(0.4);
    opacity: 0;
  }

  .email-box.is-copied .copy-btn__icon--copy {
    transform: rotate(-90deg) scale(0.4);
    opacity: 0;
  }

  .email-box.is-copied .copy-btn__label {
    color: var(--text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .social-pill:hover,
    .email-box:hover {
      transform: translateY(-1px);
    }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-copy-box]');
  const label = box?.querySelector<HTMLElement>('.copy-btn__label');
  const email = 'egbobianicyril@gmail.com';

  if (box && label) {
    const handleCopy = async () => {
      if (box.classList.contains('is-copied')) return;
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = email;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      box.classList.add('is-copied');
      label.textContent = 'Copied!';

      setTimeout(() => {
        box.classList.remove('is-copied');
        label.textContent = 'Copy';
      }, 1800);
    };

    box.addEventListener('click', handleCopy);
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        handleCopy();
      }
    });
  }
</script>
