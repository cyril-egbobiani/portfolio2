---
// ContactSection.astro — "Say hello": the email as a ring pill with a copy
// button inside it, then the socials on a hairline.
const EMAIL = 'egbobianicyril@gmail.com';

const socials = [
  { name: 'X', href: 'https://x.com/CyrilEgbobiani' },
  { name: 'GitHub', href: 'https://github.com/cyril-egbobiani' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/cyril-egbobiani-6802002b8/' },
];
---

<section class="contact flex flex-col gap-6 scroll-mt-20 sm:scroll-mt-24" id="contact">
  <h2 class="contact__title reveal-item">Say hello</h2>

  <p class="contact__lede">
    If you're building something thoughtful in consumer tech or creative software, I'd love to chat.
    Open to select freelance projects and collaborations.
  </p>

  <div class="email-pill">
    <a href={`mailto:${EMAIL}`} class="email-pill__address">{EMAIL}</a>
    <button type="button" class="email-pill__copy" data-copy-email={EMAIL} aria-live="polite">
      <svg class="email-pill__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="13" height="13" x="8" y="8" rx="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <span data-copy-label>Copy</span>
    </button>
  </div>

  <div class="contact__foot">
    <div class="contact__socials">
      {socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer">{social.name}<span class="sr-only"> (opens in a new tab)</span></a>
      ))}
    </div>
    <span class="meta-mono">© {new Date().getFullYear()}</span>
  </div>
</section>

<style>
  .contact__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .contact__lede {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* Ring pill: the address on the left, an inset copy chip on the right */
  .email-pill {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    height: 44px;
    padding: 4px 4px 4px 18px;
    box-sizing: border-box;
    border-radius: 9999px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
  }

  .email-pill__address {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 15px;
    color: var(--text-primary);
    text-decoration: none;
  }

  .email-pill__address:hover { color: var(--brand); }

  .email-pill__copy {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border: none;
    border-radius: 9999px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    box-shadow: var(--shadow-btn);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: transform 140ms var(--ease-smooth-out);
  }

  .email-pill__copy:active { transform: scale(0.96); }

  .email-pill__copy:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .email-pill__copy.is-copied {
    background: var(--brand);
    color: var(--brand-contrast);
  }

  .contact__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .contact__socials {
    display: flex;
    gap: 20px;
    font-size: var(--text-sm);
  }

  .contact__socials a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .contact__socials a:hover { color: var(--text-primary); }
</style>

<script>
  function initCopyEmail() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      let timer: number | undefined;

      button.addEventListener('click', async () => {
        const email = button.dataset.copyEmail ?? '';
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          const field = document.createElement('textarea');
          field.value = email;
          document.body.appendChild(field);
          field.select();
          document.execCommand('copy');
          field.remove();
        }
        button.classList.add('is-copied');
        if (label) label.textContent = 'Copied';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.classList.remove('is-copied');
          if (label) label.textContent = 'Copy';
        }, 1800);
      });
    });
  }

  initCopyEmail();
  document.addEventListener('astro:page-load', initCopyEmail);
</script>
