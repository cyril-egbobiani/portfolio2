---
// StackSection.astro — Logos only. Grey at rest, brand colour and a name
// tooltip on hover or keyboard focus.
import { stack } from '../data/stack';
---

<section class="flex flex-col gap-6" id="stack">
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title">Stack</h2>
    </div>
  </div>

  <ul class="stack" role="list">
    {stack.map((item) => (
      <li>
        <button type="button" class="stack__item" aria-label={item.name} style={`--brand-c: ${item.hex}`}>
          <span class="stack__logo" aria-hidden="true">
            {item.path ? (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d={item.path} /></svg>
            ) : (
              <span class="stack__mono">{item.mono}</span>
            )}
          </span>
          <span class="stack__tip" aria-hidden="true">{item.name}</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack__item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    border-radius: var(--radius-card);
    background: transparent;
    color: var(--text-muted);
    cursor: default;
    -webkit-tap-highlight-color: transparent;
  }

  .stack__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 160ms var(--ease-smooth-out), transform 160ms var(--ease-smooth-out);
  }

  .stack__mono {
    font-family: var(--font-title);
    font-size: 20px;
    line-height: 1;
  }

  .stack__tip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    margin-bottom: 4px;
    padding: 4px 8px;
    border-radius: 9999px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition: opacity 150ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 150ms cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 2;
  }

  .stack__item:hover .stack__logo,
  .stack__item:focus-visible .stack__logo {
    color: var(--brand-c);
    transform: translateY(-1px);
  }

  .stack__item:hover .stack__tip,
  .stack__item:focus-visible .stack__tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .stack__item:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .stack__logo,
    .stack__tip { transition: none; }
  }
</style>
