---
import type { Project } from '../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;
---

<article class="card p-7">
  <h3 class="mb-3 text-xl font-semibold" style="color: var(--text-primary)">{project.title}</h3>
  <p class="mb-5 leading-7" style="color: var(--text-secondary)">{project.description}</p>
  <a class="card-link" href={project.url}>
    View project →
  </a>
</article>
