---
// JournalRow.astro — One journal entry as a hairline row: the day in mono on
// the left, the title and one-line summary, then the read time (or where it
// lives, for posts elsewhere) on the right.
import { sourceLabel, type JournalEntry } from '../data/journal';

interface Props {
  entry: JournalEntry;
}

const { entry } = Astro.props;
const linkAttrs = entry.external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : { 'data-astro-prefetch': '' };
const day = entry.date.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', timeZone: 'UTC' }).toUpperCase();
---

<li class="journal-tile-item" data-journal-source={entry.external ? 'elsewhere' : 'here'}>
  <a href={entry.href} class="j-row" {...linkAttrs}>
    <time class="j-row__day" datetime={entry.date.toISOString()}>{day}</time>
    <span class="j-row__body">
      <span class="j-row__title">
        {entry.title}
        {entry.draft && <span class="j-row__draft">Draft</span>}
      </span>
      <span class="j-row__excerpt">{entry.excerpt}</span>
    </span>
    <span class="j-row__end">
      {entry.external ? <>{sourceLabel(entry.source).toUpperCase()} ↗<span class="sr-only"> (opens in a new tab)</span></> : <>{entry.readingMinutes} MIN</>}
    </span>
  </a>
</li>

<style>
  .journal-tile-item {
    list-style: none;
  }

  .j-row {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .j-row__day,
  .j-row__end {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .j-row__day { width: 56px; }

  .j-row__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .j-row__title {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    transition: color 160ms var(--ease-smooth-out);
  }

  .j-row__excerpt {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .j-row__draft {
    padding: 0 7px;
    border-radius: 9999px;
    background: var(--brand-soft);
    font-size: 11px;
    font-weight: 500;
    line-height: 18px;
    color: var(--brand);
  }

  @media (max-width: 479px) {
    .j-row { gap: 14px; }
    .j-row__end { display: none; }
  }

  @media (hover: hover) and (pointer: fine) {
    .j-row:hover .j-row__title { color: var(--brand); }
  }

  .j-row:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
</style>
