---
// JournalRow.astro — One journal entry in a list (homepage + /journal)
import { formatJournalDate, sourceLabel, type JournalEntry } from '../data/journal';
import NavArrow from './NavArrow.astro';

interface Props {
  entry: JournalEntry;
  showYear?: boolean;
}

const { entry, showYear = true } = Astro.props;
const linkAttrs = entry.external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : { 'data-astro-prefetch': '' };
---

<li class="journal-row-item" data-journal-source={entry.external ? 'elsewhere' : 'here'}>
  <a href={entry.href} class="journal-row" {...linkAttrs}>
    <time class="journal-row__date" datetime={entry.date.toISOString()}>
      {formatJournalDate(entry.date, showYear)}
    </time>

    <span class="journal-row__body">
      <span class="journal-row__title">
        {entry.title}
        {entry.draft && <span class="journal-row__draft">Draft</span>}
      </span>
      <span class="journal-row__excerpt">{entry.excerpt}</span>
    </span>

    <span class="journal-row__meta">
      {entry.external ? (
        <>
          {sourceLabel(entry.source)}
          <NavArrow direction="up-right" size={12} />
        </>
      ) : (
        <>{entry.readingMinutes} min read</>
      )}
    </span>
  </a>
</li>

<style>
  .journal-row-item {
    list-style: none;
  }

  .journal-row-item + .journal-row-item {
    border-top: 1px solid var(--border-subtle);
  }

  /* Mobile: date + meta on top, title block below */
  .journal-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'date meta'
      'body body';
    column-gap: 16px;
    row-gap: 5px;
    margin: 0 -12px;
    padding: 14px 12px;
    border-radius: 12px;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 160ms var(--ease-smooth-out),
      transform 160ms var(--ease-smooth-out);
  }

  @media (min-width: 640px) {
    .journal-row {
      grid-template-columns: 92px 1fr auto;
      grid-template-areas: 'date body meta';
      align-items: baseline;
    }
  }

  .journal-row__date {
    grid-area: date;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .journal-row__body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .journal-row__title {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .journal-row__excerpt {
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .journal-row__title { font-size: var(--text-base); }
    .journal-row__excerpt { font-size: var(--text-base); }
  }

  .journal-row__meta {
    grid-area: meta;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: var(--text-sm);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .journal-row__draft {
    margin-left: 8px;
    padding: 1px 7px;
    border-radius: 9999px;
    background: var(--surface-interactive);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-muted);
    vertical-align: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .journal-row:hover {
      background: var(--surface-subtle);
    }
  }

  .journal-row:active {
    transform: scale(0.99);
  }

  .journal-row:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-row {
      transition: none;
    }
  }
</style>
