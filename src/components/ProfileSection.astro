---
// ProfileSection.astro — Story & Personal Interests section (integrated onto homepage)
import photographyImg from '../assets/images/Image (Photography).png?url';
import footballImg from '../assets/images/image (Football).png?url';
import cookingImg from '../assets/images/Image (Cooking).png?url';
import carsImg from '../assets/images/Image (Cars).png?url';
import profile from '../assets/images/profile-1.png?url';

const interests = [
  {
    title: 'Photography',
    subtitle: 'Capturing the soul of my city',
    image: photographyImg,
   
  },
  {
    title: 'Football',
    subtitle: '#Come on you Gunners!!!!',
    image: footballImg,
  },
  {
    title: 'Cooking',
    subtitle: 'Mum really influenced me',
    image: cookingImg,
  },
  {
    title: 'Cars',
    subtitle: 'Big fan of Automotive design',
    image: carsImg,
  },
];
---

<section class="flex flex-col gap-10" id="about">
  
  <!-- Section Header -->
  <div class="flex items-center justify-between">
    <h2 class="m-0 font-sans text-sm sm:text-base font-normal tracking-tight text-[var(--text-muted)]">About</h2>
  </div>

  <!-- Hero Framed Banner -->
  <div class="group relative overflow-hidden rounded-[8px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] transition-all duration-300 ease-[var(--ease-smooth-out)]">
    <img
      src={profile}
      alt="Cyril Egbobiani workspace"
      class="h-[200px] sm:h-[280px] w-full object-cover object-center transition-transform duration-700 ease-[var(--ease-smooth-out)] group-hover:scale-[1.02]"
      loading="lazy"
    />
  </div>

  <!-- Editorial Narrative Statement -->
  <div class="flex flex-col gap-4">
    <h3 class="m-0 font-display text-xl sm:text-2xl font-normal leading-[1.3] tracking-[-0.04em] text-[var(--text-primary)]">
      Design curiosity came first. Code gave it a way to become <span class="italic font-normal text-[var(--text-primary)]">more</span> useful.
    </h3>
    <p class="m-0 text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">
      I've always liked making things, pulling them apart, and understanding why they work. That started with sketching, physical objects, and small experiments. Software made that curiosity feel bigger because the idea, interaction, and final experience can all live in the same medium.
    </p>
  </div>

  <!-- Hair-Line Separator -->
  <div class="w-full border-t border-dashed border-[var(--border-subtle)]" role="separator" aria-hidden="true"></div>

  <!-- Beyond Code & Design (Personal Interests Grid) -->
  <div class="flex flex-col gap-5">
    <div class="flex items-center">
      <h3 class="m-0 font-sans text-xs sm:text-sm font-normal tracking-tight text-[var(--text-muted)]">
        Beyond code & design
      </h3>
    </div>

    <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
      {interests.map((item) => (
        <div class="interest-card group relative flex h-[105px] w-full overflow-hidden rounded-[8px] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-3.5 transition-all duration-300 ease-[var(--ease-smooth-out)] hover:border-[var(--border-default)] hover:bg-[var(--surface-interactive)]">
          
          <!-- Left Details -->
          <div class="z-10 flex flex-col justify-between pr-4">
            <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--text-muted)]">
              {item.tag}
            </span>
            <div class="flex flex-col">
              <span class="font-display text-base font-normal tracking-[-0.03em] text-[var(--text-primary)]">
                {item.title}
              </span>
              <span class="text-xs text-[var(--text-muted)] font-sans">
                {item.subtitle}
              </span>
            </div>
          </div>

          <!-- Right Thumbnail Image (Masked Split View) -->
          <div class="absolute right-0 top-0 bottom-0 h-full w-[42%] overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="h-full w-full object-cover object-center grayscale contrast-[1.05] opacity-60 transition-all duration-500 ease-[var(--ease-smooth-out)] group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105"
              loading="lazy"
            />
            <!-- Gradient Blend to Surface -->
            <div class="absolute inset-0 bg-gradient-to-r from-[var(--surface-subtle)] via-transparent to-transparent group-hover:from-[var(--surface-interactive)]"></div>
          </div>

        </div>
      ))}
    </div>
  </div>

</section>

<style>
  @media (hover: hover) and (pointer: fine) {
    .interest-card:hover {
      transform: translateY(-2px);
    }
  }

  .interest-card:active {
    transform: scale(0.98);
  }
</style>
