---
// ProfileSection.astro — the human half.
// Deliberately does NOT retell the origin story; the hero already covers that.
import photographyImg from '../assets/images/Image (Photography).png?url';
import footballImg from '../assets/images/image (Football).png?url';
import cookingImg from '../assets/images/Image (Cooking).png?url';
import carsImg from '../assets/images/Image (Cars).png?url';
import profile from '../assets/images/profile-1.png?url';

const interests = [
  { title: 'Photography', subtitle: 'mostly around Lagos', image: photographyImg },
  { title: 'Football', subtitle: '#Come on you Gunners!!!!', image: footballImg },
  { title: 'Cooking', subtitle: 'Mum really influenced me', image: cookingImg },
  { title: 'Cars', subtitle: 'automotive design, mainly', image: carsImg },
];
---

<section class="relative flex flex-col gap-7" id="about">

  <div class="section-head">
    <div class="section-head__text">
      <h2 class="section-title">A bit more about me.</h2>
      <span class="section-aside">the non-software half</span>
    </div>
  </div>

  <div class="portrait">
    <img src={profile} alt="Cyril Egbobiani" loading="lazy" />
  </div>

  <p class="about-copy">
    Most of what I know, I learned by building things badly the first time. I like
    problems I can sit with for a while, and I care about the details at the end
    that people feel but never point at. I also just like talking to people about
    what they're making.
  </p>

  <div class="interests">
    <span class="hand-label">when I'm not at a screen</span>

    <div class="interest-grid">
      {interests.map((item) => (
        <figure class="interest">
          <div class="interest__frame">
            <img src={item.image} alt={item.title} loading="lazy" />
          </div>
          <figcaption>
            <span class="interest__title">{item.title}</span>
            <span class="interest__sub">{item.subtitle}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

</section>

<style>
  .portrait {
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 640px) {
    .portrait img {
      height: 300px;
    }
  }

  .about-copy {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .interests {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 6px;
  }

  .interest-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  @media (min-width: 560px) {
    .interest-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .interest {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  /* The photograph is the point — shown in full colour, uncropped by overlays */
  .interest__frame {
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
    aspect-ratio: 4 / 5;
  }

  .interest__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--duration-very-slow) var(--ease-smooth-out);
  }

  .interest figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 1px;
  }

  .interest__title {
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .interest__sub {
    font-size: 12px;
    line-height: 1.4;
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .interest:hover .interest__frame img {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interest__frame img {
      transition: none;
    }

    .interest:hover .interest__frame img {
      transform: none;
    }
  }
</style>
