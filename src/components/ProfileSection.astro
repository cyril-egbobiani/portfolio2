---
// ProfileSection.astro — Editorial Profile Teaser on index.astro linking to /about
import profilePolaroid from '../assets/images/optimized/profile-polaroid.webp?url';
---

<section class="relative flex flex-col gap-6" id="about">
  <div class="section-head reveal-item">
    <div class="section-head__text">
      <h2 class="section-title font-display leading-[1.4] tracking-normal font-bold">A bit more about me</h2>
    </div>
  </div>

  <!-- Profile Teaser Card -->
  <a
    href="/about"
    class="profile-teaser-card group relative flex flex-col sm:flex-row items-center gap-6 p-6 sm:p-7 rounded-[14px] bg-[var(--surface-subtle)] border border-[var(--border-subtle)] hover:border-[var(--border-interactive)] transition-[border-color,background-color,transform] duration-200 ease-[var(--ease-smooth-out)] no-underline text-inherit cursor-pointer active:scale-[0.99] reveal-item reveal-delay-1"
    aria-label="Visit Cyril's dedicated profile page"
  >
    <!-- Left: Polaroid Preview with subtle tilt -->
    <div class="polaroid-mini-wrapper shrink-0">
      <div class="polaroid-mini bg-white p-2 pb-4 shadow-md rounded-[2px] border border-black/5 transform -rotate-3 transition-transform duration-200 ease-[var(--ease-smooth-out)] group-hover:rotate-0 group-hover:scale-105">
        <div class="w-24 h-28 overflow-hidden bg-zinc-100">
          <img src={profilePolaroid} alt="Cyril Egbobiani" class="w-full h-full object-cover grayscale contrast-105" loading="lazy" decoding="async" width="96" height="112" />
        </div>
        <div class="mt-2 text-center">
          <span class="font-display text-[12px] font-semibold text-zinc-900 leading-none">Cyril</span>
        </div>
      </div>
    </div>

    <!-- Right: Editorial copy + Arrow -->
    <div class="flex flex-col gap-2.5 flex-1 text-left">
      <p class="m-0 text-[14.5px] sm:text-[15.5px] leading-[1.65] text-[var(--text-secondary)]">
        Most of what I know, I learned by building things badly the first time. Explore my verified pass, personal moodboard, photography around Lagos, and creative background.
      </p>

      <div class="inline-flex items-center gap-1.5 text-[13.5px] font-medium text-[var(--text-primary)] group-hover:text-[var(--text-muted)] transition-colors pt-1">
        <span>Open profile &amp; explore moodboard</span>
        <svg class="size-4 transition-transform duration-160 ease-[var(--ease-smooth-out)] group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>
</section>

<style>
  .profile-teaser-card {
    will-change: transform, border-color;
  }

  @media (hover: hover) and (pointer: fine) {
    .profile-teaser-card:hover {
      background-color: var(--surface-interactive);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .polaroid-mini,
    .profile-teaser-card {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
