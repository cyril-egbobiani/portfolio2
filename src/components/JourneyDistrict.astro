      const fl = [], fa = [];
      for (let k = 0; k < 7; k++) { const x = D[0] + 1.1 + k * 0.95, y = D[1] + 1.4, s = Math.sin(t * 1.4 + k) * 0.15, top = [x + s, y, 4.6 + (k % 3) * 0.5]; fl.push(p3([[x, y, 3.4], top])); (k % 2 ? fl : fa).push(p3(ringAx(top, BN, 0.38, 5, k), true)); }
      draw(fl.join(''), COL.mid); draw(fa.join(''), COL.acc);
