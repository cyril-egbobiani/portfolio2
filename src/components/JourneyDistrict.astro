---
// JourneyDistrict.astro — "District 01 · Art", a Hairline-style isometric
// lot for the About page. The childhood chapter: a storybook cottage with a
// pencil for a chimney, a giant pencil drawing an endless loop, a football
// goal, the palette, a sculpture in progress, paintbrush trees and the open
// sketchbook. The flip-wheel car visits: it arrives, scans, lands, taps the
// ball into the net, drives across the paper printing rose tread, then lifts
// off for the next district; the lot carries on until it comes round again.
//
// Plain SVG + one script, no dependencies. Follows the site theme through
// [data-theme='dark']; the rose accent is --brand. Pauses off-screen and in
// background tabs, and honours prefers-reduced-motion (a still frame).
interface Props {
  label?: string;
}
const {
  label = 'An isometric line drawing of a childhood lot: a cottage, a giant pencil drawing on paper, a football goal, a paint palette, a sculpture and paintbrush trees. A small hovering car visits, scores a goal and drives across the paper before flying off.',
} = Astro.props;
---

<figure class="journey">
  <div class="journey__fig" data-journey role="img" aria-label={label}>
    <svg viewBox="-166 -136 320 234" aria-hidden="true"><g data-scene></g></svg>
  </div>
  <figcaption class="journey__cap">
    <span class="journey__name"><b>01</b> Loved art</span>
    <button type="button" class="journey__toggle" data-journey-toggle aria-pressed="false" aria-label="Pause animation">
      <svg viewBox="0 0 16 16" aria-hidden="true" class="journey__icon journey__icon--pause"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg>
      <svg viewBox="0 0 16 16" aria-hidden="true" class="journey__icon journey__icon--play"><path d="M5.5 3.6v8.8l7-4.4z" /></svg>
    </button>
  </figcaption>
</figure>

<style>
  /* Hairline tokens, tuned to the site: the plate is the page surface, the
     outlines are the text colour, the interiors step down, rose is --brand. */
  .journey {
    --hairline-plate: var(--surface);
    --hairline-hi: #232327;
    --hairline-edge: #a4a4ac;
    --hairline-mid: #c3c3c9;
    --hairline-lo: #e0e0e4;
    --hairline-accent: var(--brand);
    --hairline-stroke: 0.9;
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global([data-theme='dark']) .journey {
    --hairline-hi: #ececef;
    --hairline-edge: #6c6c74;
    --hairline-mid: #4a4a52;
    --hairline-lo: #2a2a30;
  }

  .journey__fig {
    width: 100%;
    aspect-ratio: 320 / 234;
  }

  .journey__fig > svg { display: block; width: 100%; height: 100%; overflow: hidden; }

  .journey__fig :global(path) {
    vector-effect: non-scaling-stroke;
    stroke-width: var(--hairline-stroke);
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .journey__cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--hairline-edge);
  }

  .journey__name b { font-weight: 400; color: var(--text-secondary); margin-right: 4px; }

  .journey__toggle {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: -6px -8px -6px 0;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .journey__toggle:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--brand); }

  @media (hover: hover) and (pointer: fine) {
    .journey__toggle:hover { color: var(--text-primary); background: var(--surface-subtle); }
  }

  .journey__icon { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .journey__toggle[aria-pressed='true'] .journey__icon--pause,
  .journey__toggle[aria-pressed='false'] .journey__icon--play { display: none; }
</style>

<script>
  // @ts-nocheck — a hand-tuned drawing script; types would only add noise.
  /*
   * Hairline rules kept: one stroke width, bright silhouettes, dim folds and
   * interiors, a single rose accent, no words inside the figure.
   * Isometric projection; solids are convex polyhedra drawn with exact face
   * visibility; things are painted far to near (x + y).
   */
  function initJourney(root) {
    const NS = 'http://www.w3.org/2000/svg';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COL = { hi: 'var(--hairline-hi)', edge: 'var(--hairline-edge)', mid: 'var(--hairline-mid)', lo: 'var(--hairline-lo)', plate: 'var(--hairline-plate)', acc: 'var(--hairline-accent)' };

    // ── Projection ──
    const C = Math.cos(Math.PI / 6), S = 0.5;
    let FLIP = 1, ZOFF = 0;
    let XF = { p: 0, r: 0, cz: 18 }, YAW = 0;
    const rot = ([x, y, z], p, r, cz) => {
      const dz = z - cz, x1 = x * Math.cos(p) - dz * Math.sin(p), z1 = dz * Math.cos(p) + x * Math.sin(p);
      return [x1, y * Math.cos(r) - z1 * Math.sin(r), cz + y * Math.sin(r) + z1 * Math.cos(r)];
    };
    const W3 = (x, y, z) => { if (XF.p || XF.r) [x, y, z] = rot([x, y, z], XF.p, XF.r, XF.cz); if (YAW) [x, y] = [x * Math.cos(YAW) - y * Math.sin(YAW), x * Math.sin(YAW) + y * Math.cos(YAW)]; return [(FLIP * x - y) * C, (FLIP * x + y) * S - (z + ZOFF)]; };
    const f = n => n.toFixed(2);
    const p2 = (pts, close) => pts.map((p, i) => (i ? 'L' : 'M') + f(p[0]) + ' ' + f(p[1])).join('') + (close ? 'Z' : '');
    const p3 = (pts, close) => p2(pts.map(p => W3(...p)), close);
    let G;
    const draw = (d, stroke, fill = 'none') => { const n = document.createElementNS(NS, 'path'); n.setAttribute('d', d); n.setAttribute('stroke', stroke); n.setAttribute('fill', fill); G.append(n); };
    const dot = pts => pts.map(p => { const c = W3(...p); return `M${f(c[0])} ${f(c[1])}h0.01`; }).join('');

    // ── Convex polyhedra ──
    const sub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
    const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
    const dotv = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
    const norm = a => { const l = Math.hypot(...a) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };
    // the view direction, carried into the vehicle's own (pitched, rolled) frame
    const view = () => { let [x, y, z] = [FLIP, 1, 1]; if (YAW) [x, y] = [x * Math.cos(YAW) + y * Math.sin(YAW), -x * Math.sin(YAW) + y * Math.cos(YAW)]; if (!(XF.p || XF.r)) return [x, y, z]; const r = -XF.r, p = -XF.p; const y1 = y * Math.cos(r) - z * Math.sin(r), z1 = y * Math.sin(r) + z * Math.cos(r); return [x * Math.cos(p) - z1 * Math.sin(p), y1, z1 * Math.cos(p) + x * Math.sin(p)]; };

    // A solid: vertices and faces (index loops). Normals are made to point away
    // from the centroid, so face winding never matters.
    function solid(verts, faces, opts = {}) {
      const c = verts.reduce((a, v) => [a[0] + v[0] / verts.length, a[1] + v[1] / verts.length, a[2] + v[2] / verts.length], [0, 0, 0]);
      const fs = faces.map(ix => {
        const p = ix.map(i => verts[i]);
        let n = [0, 0, 0];
        for (let i = 0; i < p.length; i++) { const a = p[i], b = p[(i + 1) % p.length]; n[0] += (a[1] - b[1]) * (a[2] + b[2]); n[1] += (a[2] - b[2]) * (a[0] + b[0]); n[2] += (a[0] - b[0]) * (a[1] + b[1]); }
        n = norm(n);
        const fc = p.reduce((a, v) => [a[0] + v[0] / p.length, a[1] + v[1] / p.length, a[2] + v[2] / p.length], [0, 0, 0]);
        if (dotv(n, sub(fc, c)) < 0) n = n.map(x => -x);
        return { ix, n };
      });
      return { verts, faces: fs, c, ...opts };
    }
    // Loft between rings of equal length ([x, y, z] points), capped both ends.
    function loft(rings, opts) {
      const N = rings[0].length, verts = rings.flat(), faces = [];
      for (let r = 0; r < rings.length - 1; r++) for (let i = 0; i < N; i++) { const j = (i + 1) % N; faces.push([r * N + i, r * N + j, (r + 1) * N + j, (r + 1) * N + i]); }
      faces.push([...Array(N).keys()]);
      faces.push([...Array(N).keys()].map(i => (rings.length - 1) * N + i).reverse());
      return solid(verts, faces, opts);
    }
    // A side profile [x, z] extruded across y, with half-width w(z) so the
    // sides can lean in (a tumblehome).
    function prism(profile, w, opts) {
      const N = profile.length;
      const L = profile.map(([x, z]) => [x, -w(z), z]), R = profile.map(([x, z]) => [x, w(z), z]);
      const faces = [[...Array(N).keys()], [...Array(N).keys()].map(i => N + i)];
      for (let i = 0; i < N; i++) { const j = (i + 1) % N; faces.push([i, j, N + j, N + i]); }
      return solid([...L, ...R], faces, opts);
    }
    const box = (x0, x1, y0, y1, z0, z1, opts) => loft([[[x0, y0, z0], [x1, y0, z0], [x1, y1, z0], [x0, y1, z0]], [[x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1]]], opts);

    // Draw one solid: fill visible faces, then bright silhouette edges and dim
    // fold edges (two visible faces meeting at an angle).
    function render(s) {
      const V = view();
      const vis = s.faces.map(fc => dotv(fc.n, V) > 1e-6);
      s.faces.forEach((fc, i) => { if (vis[i]) draw(p3(fc.ix.map(k => s.verts[k]), true), COL.plate, COL.plate); });
      const edges = new Map();
      s.faces.forEach((fc, fi) => fc.ix.forEach((a, k) => { const b = fc.ix[(k + 1) % fc.ix.length]; const key = a < b ? a + '_' + b : b + '_' + a; (edges.get(key) || edges.set(key, []).get(key)).push(fi); }));
      const sil = [], fold = [];
      for (const [key, fl] of edges) {
        const [a, b] = key.split('_').map(Number);
        const v = fl.filter(i => vis[i]);
        if (!v.length) continue;
        const seg = p3([s.verts[a], s.verts[b]]);
        if (v.length === 1 || fl.length === 1) sil.push(seg);
        else if (dotv(s.faces[fl[0]].n, s.faces[fl[1]].n) < 0.985) fold.push(seg);
      }
      if (fold.length) draw(fold.join(''), s.fold || COL.mid);
      draw(sil.join(''), s.line || COL.hi);
    }
    const faceVisible = n => dotv(n, view()) > 1e-6;

    // ── Wheels (shared look with the wagon, faceted rims) ──
    function wheel(x, r, yOut, tw, phi) {
      const side = yOut > 0 ? 1 : -1, yIn = yOut - side * tw;
      const ring = (yy, rad, n = 28) => Array.from({ length: n }, (_, k) => { const a = k / n * Math.PI * 2; return [x + rad * Math.cos(a), yy, r + rad * Math.sin(a)]; });
      const tyre = loft([ring(yIn, r), ring(yIn + side * 1.2, r + 0.45), ring(yOut - side * 1.2, r + 0.45), ring(yOut, r)].map(rg => rg), {});
      render(tyre);
      if (side < 0) return;
      const yy = yOut - 0.4, rim = r * 0.6;
      // tread on the visible band
      const tr = [];
      for (let k = 0; k < 20; k++) { const a = phi + k * Math.PI / 10; if (FLIP * Math.cos(a) + Math.sin(a) < 0.3) continue; const px = x + (r + 0.45) * Math.cos(a), pz = r + (r + 0.45) * Math.sin(a); tr.push(p3([[px, yOut - 1.2, pz], [px, yOut - tw * (k % 2 ? 0.35 : 0.6), pz]])); }
      draw(tr.join(''), COL.mid);
      // a hexagonal rim with six spokes
      const hex = Array.from({ length: 6 }, (_, k) => { const a = phi + k * Math.PI / 3; return [x + rim * Math.cos(a), yy, r + rim * Math.sin(a)]; });
      draw(p3(hex, true), COL.hi);
      draw(hex.map(p => p3([[x + (p[0] - x) * 0.25, yy, r + (p[2] - r) * 0.25], p])).join(''), COL.mid);
      draw(p3(Array.from({ length: 6 }, (_, k) => { const a = phi + k * Math.PI / 3 + Math.PI / 6; return [x + rim * 0.26 * Math.cos(a), yy, r + rim * 0.26 * Math.sin(a)]; }), true), COL.acc);
    }

    // ── The sketchbook, as a faceted slab on any plane ──
    // o: origin, u/v: unit in-plane axes, n: plane normal; size su × sv, thick t.
    function sketchbook(o, u, v, n, su, sv, t, strapAt = 0.5) {
      const at = (a, b, h) => [o[0] + u[0] * a + v[0] * b + n[0] * h, o[1] + u[1] * a + v[1] * b + n[1] * h, o[2] + u[2] * a + v[2] * b + n[2] * h];
      const ch = 1.2, rect = h => [[ch, 0], [su - ch, 0], [su, ch], [su, sv - ch], [su - ch, sv], [ch, sv], [0, sv - ch], [0, ch]].map(([a, b]) => at(a, b, h));
      render(loft([rect(0), rect(t)]));
      // ring binding down the spine edge (the u = 0 side)
      const rs = [];
      for (let k = 0; k < 5; k++) { const b = sv * (k + 0.8) / 5.6; rs.push(p3(Array.from({ length: 9 }, (_, i) => { const a = Math.PI * i / 8; return at(-1.1 * Math.sin(a), b, t / 2 + (t / 2 + 0.4) * Math.cos(a)); }))); }
      draw(rs.join(''), COL.edge);
      // the strap, across the book and down both sides
      const s = su * strapAt;
      draw(p3([at(s, -1.4, 0), at(s, 0, t), at(s, sv, t), at(s, sv + 1.4, 0)]), COL.acc);
    }

    // ════════════════ Flip-wheel vehicle ════════════════
    // Drive mode: fat tyres in angular arches. Hover mode: each wheel swings out
    // on a hinged arm and folds flat, its hub opening into a repulsor — a
    // turbine fan with energy rings — so the wheels become four vectoring
    // rotors around the body, quadcopter-style. One parameter K (0 drive →
    // 1 hover) drives the whole transition.
    const U = { w: 17, axF: 27, axR: -25, zb: 9, r: 8.6, tw: 7.8 };
    const LOWER = [[-40, U.zb], [-40, 24.6], [30, 23.4], [44, 18.4], [46.4, 13], [43.4, U.zb]];
    const CAB = [[-38.6, 23.6], [-38.6, 27.6], [-30, 32.2], [-8, 33.6], [26.4, 23.6]];
    const cabW = z => 15.6 - (z - 23.6) * (5.2 / 10);
    const roofZ = x => x < -8 ? 32.2 + (x + 30) * (1.4 / 22) : 33.6 - (x + 8) * (10 / 34.4);
    const box8 = pts => solid(pts, [[0, 1, 2, 3], [4, 5, 6, 7], [0, 1, 5, 4], [1, 2, 6, 5], [2, 3, 7, 6], [3, 0, 4, 7]]);
    const plate = (q, y0, y1) => box8([...q.map(([x, z]) => [x, y0, z]), ...q.map(([x, z]) => [x, y1, z])]);
    const hexRing = (cx, cy, cz, rad, axis, rot = Math.PI / 6) => Array.from({ length: 6 }, (_, i) => { const a = i / 6 * Math.PI * 2 + rot; const u = rad * Math.cos(a), v = rad * Math.sin(a); return axis === 'x' ? [cx, cy + u, cz + v] : axis === 'y' ? [cx + u, cy, cz + v] : [cx + u, cy + v, cz]; });
    const smooth = (a, b, x) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
    const bump = (a, b, c, d, x) => smooth(a, b, x) * (1 - smooth(c, d, x));

    // Hinge for each wheel: an axis along x at the arch crown, just outboard.
    const HY = U.w + 0.6, HZ = U.r + 9.2;
    // Rotate a wheel-local point about the hinge by angle ang (side-signed).
    function foldPt([x, y, z], side, ang) {
      const yh = side * HY, dy = y - yh, dz = z - HZ, a = side * ang;
      return [x, yh + dy * Math.cos(a) - dz * Math.sin(a), HZ + dy * Math.sin(a) + dz * Math.cos(a)];
    }

    function flipWheel(x, side, K, phi, spin, tilt) {
      const ang = K * Math.PI / 2 + tilt * K;
      const r = U.r, yOut = side * (U.w + 1.6), yIn = yOut - side * U.tw, FP = p => foldPt(p, side, ang);
      const ring = (yy, rad, n = 28) => Array.from({ length: n }, (_, k) => { const a = k / n * Math.PI * 2; return FP([x + rad * Math.cos(a), yy, r + rad * Math.sin(a)]); });
      // the arm: from the hinge knuckle down to the hub's inner face
      const hub = [x, yIn, r], hinge = [x, side * HY, HZ];
      const a0 = FP([x - 1.4, hub[1] + side * 0.2, hub[2]]), a1 = FP([x + 1.4, hub[1] + side * 0.2, hub[2]]);
      render(box8([[x - 1.4, hinge[1] - 0.8, hinge[2] - 0.6], [x + 1.4, hinge[1] - 0.8, hinge[2] - 0.6], a1, a0,
        [x - 1.4, hinge[1] + 0.8, hinge[2] + 0.6], [x + 1.4, hinge[1] + 0.8, hinge[2] + 0.6], [a1[0], a1[1] + 1, a1[2] + 1], [a0[0], a0[1] + 1, a0[2] + 1]]));
      // tyre: a bulging loft between its two sidewalls
      render(loft([ring(yIn, r), ring(yIn + side * 1.2, r + 0.45), ring(yOut - side * 1.2, r + 0.45), ring(yOut, r)]));
      // which way does the outer face look?
      const nOut = sub(FP([x, yOut + side, r]), FP([x, yOut, r]));
      if (!faceVisible(nOut)) return;
      const yy = yOut + side * 0.05;
      // drive: tread blocks on the visible band. hover: the tyre is now a duct
      // shroud, so the tread goes smooth.
      const tr = [];
      for (let k = 0; k < 22; k++) {
        const a = phi + k * Math.PI / 11, nrm = sub(FP([x + Math.cos(a), yOut - side * 3, r + Math.sin(a)]), FP([x, yOut - side * 3, r]));
        if (!faceVisible(nrm)) continue;
        const px = x + (r + 0.45) * Math.cos(a), pz = r + (r + 0.45) * Math.sin(a);
        if (K < 0.5) tr.push(p3([FP([px, yOut - side * 1.2, pz]), FP([px, yOut - side * U.tw * (k % 2 ? 0.36 : 0.6), pz])]));
      }
      if (K < 0.5) {
        // drive face: hexagonal rim, six spokes, a rose hub
        const rim = Array.from({ length: 6 }, (_, k) => { const a = phi + k * Math.PI / 3; return FP([x + r * 0.6 * Math.cos(a), yy, r + r * 0.6 * Math.sin(a)]); });
        draw(p3(rim, true), COL.hi);
        draw(rim.map((p, k) => { const a = phi + k * Math.PI / 3; return p3([FP([x + r * 0.15 * Math.cos(a), yy, r + r * 0.15 * Math.sin(a)]), p]); }).join(''), COL.mid);
        draw(p3(ring(yy, r * 0.15, 6), true), COL.acc);
      } else {
        // hover face: the hub opens into a ducted repulsor — shroud lip, nine
        // swept turbine blades spinning, a pulsing energy ring, three motor
        // struts to a hex hub, and vent slots round the lip
        draw(p3(ring(yy, r * 0.86), true), COL.hi);
        const bl = [];
        for (let k = 0; k < 9; k++) {
          const a = spin + k * Math.PI * 2 / 9;
          bl.push(p3([0.2, 0.5, 0.82].map((rr, i) => FP([x + r * rr * Math.cos(a + i * 0.32), yy, r + r * rr * Math.sin(a + i * 0.32)]))));
        }
        draw(bl.join(''), COL.edge);
        draw(p3(ring(yy, r * (0.6 + 0.05 * Math.sin(spin * 0.6))), true), COL.acc);
        const sv = [];
        for (let k = 0; k < 3; k++) { const a = k * Math.PI * 2 / 3 + Math.PI / 2; sv.push(p3([FP([x + r * 0.2 * Math.cos(a), yy + side * 0.3, r + r * 0.2 * Math.sin(a)]), FP([x + r * 0.86 * Math.cos(a), yy + side * 0.3, r + r * 0.86 * Math.sin(a)])])); }
        draw(sv.join(''), COL.hi);
        draw(p3(ring(yy + side * 0.3, r * 0.2, 6), true), COL.hi);
        draw(p3(ring(yy + side * 0.3, r * 0.08, 6), true), COL.acc);
        const vs = [];
        for (let k = 0; k < 16; k++) { const a = k * Math.PI / 8 + 0.13; vs.push(p3([FP([x + r * 0.9 * Math.cos(a), yy, r + r * 0.9 * Math.sin(a)]), FP([x + r * 0.98 * Math.cos(a), yy, r + r * 0.98 * Math.sin(a)])])); }
        draw(vs.join(''), COL.edge);
      }
    }

    // Arches wrap the flip joint: seven facets, a slim trim, and the hinge
    // knuckle housed in the crown. The inner liner shows when the wheel is out.
    const archPts = x => [[x - 12.6, U.zb], [x - 11.6, 14.2], [x - 9, 17.8], [x - 4.4, 19.6], [x + 4.4, 19.6], [x + 9, 17.8], [x + 11.6, 14.2], [x + 12.6, U.zb]];
    let VX = 1, VY = 1;
    function arches(near, K) {
      const s = near ? VY : -VY;
      for (const x of [U.axF, U.axR]) {
        const a = archPts(x);
        if (near && K > 0.02) draw(p3(a.map(([px, pz]) => [x + (px - x) * 0.9, s * (U.w + 0.02), pz]).slice(1, -1)), COL.lo);
        for (let i = 0; i < a.length - 1; i++) {
          const [p, q] = [a[i], a[i + 1]], dx = q[0] - p[0], dz = q[1] - p[1], l = Math.hypot(dx, dz), nx = -dz / l * 1.8, nz = dx / l * 1.8;
          render(plate([[p[0], p[1]], [q[0], q[1]], [q[0] - nx, q[1] - nz], [p[0] - nx, p[1] - nz]], s * (U.w - 0.2), s * (U.w + 1.4)));
        }
        // hinge knuckle at the crown
