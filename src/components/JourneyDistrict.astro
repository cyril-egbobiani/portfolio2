    }
    function pencilTrail(t) {
      const s = t * 0.8, ghost = [], trail = [];
      for (let i = 0; i <= 96; i++) ghost.push(penAt(i / 96 * Math.PI * 2));
      for (let i = 0; i <= 30; i++) trail.push(penAt(s - 2.2 + i / 30 * 2.2));
      draw(p3(ghost, true), COL.lo);
      draw(p3(trail), COL.hi);
      draw(p3(circ(...penAt(s).slice(0, 2), 1.4, 1.4, 6, 0.8), true), COL.acc);
    }
    function giantPencil(t) {
      const s = t * 0.8, tip = penAt(s);
      const vel = norm([PEN.rx * Math.cos(s), 2 * PEN.ry * Math.cos(2 * s), 0]);
      const lean = 0.4, ax = norm([-vel[0] * Math.sin(lean), -vel[1] * Math.sin(lean), Math.cos(lean)]);
      const r0 = t * 0.25;
      const parts = [
        () => render(lathe(tip, ax, [[0, 0.08], [2.6, 1.3], [8, 4.4], [50, 4.4]], 6, r0)),
        () => { render(lathe(add(tip, mul(ax, 50)), ax, [[0, 4.75], [5, 4.75]], 12, r0)); draw([51.6, 53.4].map(d => p3(ringAx(add(tip, mul(ax, d)), ax, 4.8, 12, r0).filter(p => dotv(sub(p, add(tip, mul(ax, d))), view()) > -0.5))).join(''), COL.mid); },
