      for (const s of STONES) render(slabXY(s.pts, 0, 0.55));
      draw(STONES.filter((_, i) => i % 2).map(s => p3([[s.c[0] - s.r * 0.5, s.c[1] - 0.3, 0.6], [s.c[0] + s.r * 0.2, s.c[1] + 0.4, 0.6]])).join(''), COL.lo);
    }
    // one depth bin of lawn: grass in three swept blades, flowers on bent
    // stems with a bud, low clover; all sway with a slow wave of wind
    function lawnBin(L, t) {
      const lo = [], mid = [], acc = [];
      const wind = (x, y) => Math.sin(t * 1.1 - (x + y) * 0.05) * 0.5 + Math.sin(t * 2.3 + x * 0.2) * 0.12;
      for (const g of L.tufts) {
        const w = wind(g.x, g.y) * g.sp;
        for (const k of [-1, 0, 1]) {
          const bx = g.x + k * 0.55, by = g.y - k * 0.25, hh = g.h * (k ? 0.75 : 1), lx = (g.lean + k * 0.9 + w) * hh * 0.35;
          lo.push(p3([[bx, by, 0], [bx + lx * 0.35, by - lx * 0.1, hh * 0.55], [bx + lx, by - lx * 0.3, hh]]));
        }
      }
      for (const f of L.flowers) {
        const w = wind(f.x, f.y), lx = (f.lean + w) * 0.6, top = [f.x + lx, f.y - lx * 0.3, f.h];
        mid.push(p3([[f.x, f.y, 0], [f.x + lx * 0.3, f.y, f.h * 0.6], top]));
        lo.push(p3([[f.x + lx * 0.2, f.y, f.h * 0.35], [f.x + lx * 0.2 + 0.9, f.y - 0.3, f.h * 0.5]]));
