      }
      if (layer === 'air') for (const [d, o] of lv) { draw(d, COL.mid); G.lastChild.setAttribute('stroke-opacity', o.toFixed(2)); }
      for (const [ti, off] of [[13, 0], [11, 2.7]]) {
        const tr = TREES[ti], u = ((t + off) % 5.4) / 5.4, top = 12 * tr.s + 4.6 * tr.s + (tr.type === 'mop' ? 13.3 : 13.5) * tr.s, gx = tr.x + 1.6, gy = tr.y + 1.6;
        if (u < 0.5) {
          if (layer !== 'air') continue;
          const k = u / 0.5, z = (top - 1) * (1 - k * k);
          const P = plane([gx, gy, z]);
          draw(p3([P(0, 0.9), P(0.45, 0.1), P(0.3, -0.35), P(0, -0.5), P(-0.3, -0.35), P(-0.45, 0.1)], true), COL.acc);
          G.lastChild.setAttribute('stroke-opacity', Math.min(1, k * 6).toFixed(2));
        } else {
          if (layer !== 'ground') continue;
          const k = (u - 0.5) / 0.5;
          for (const j of [0, 0.35]) { const kk = k - j; if (kk <= 0) continue; draw(p3(circ(gx, gy, 0.6 + kk * 4, 0.6 + kk * 4, 16, 0.05), true), COL.acc); G.lastChild.setAttribute('stroke-opacity', ((1 - kk) * 0.8).toFixed(2)); }
        }
      }
    }

    // ── The open sketchbook on the grass, pages turning ──
    function openBook(t) {
      const [bx, by] = BOOK, W = 12, H = 17, z = 1.2;
      render(slabXY([[bx - W - 1, by - H / 2 - 1], [bx + W + 1, by - H / 2 - 1], [bx + W + 1, by + H / 2 + 1], [bx - W - 1, by + H / 2 + 1]], 0, 0.6));
      render(slabXY([[bx - W, by - H / 2], [bx, by - H / 2], [bx, by + H / 2], [bx - W, by + H / 2]], 0.6, z));
      render(slabXY([[bx, by - H / 2], [bx + W, by - H / 2], [bx + W, by + H / 2], [bx, by + H / 2]], 0.6, z));
      // scribbles on both pages, rings down the spine, the rose strap
      const sc = []; for (let k = 0; k < 5; k++) { const yy = by - H / 2 + 3 + k * 2.6; sc.push(p3([[bx - W + 2, yy, z + 0.05], [bx - 2 - (k % 3) * 1.6, yy, z + 0.05]])); }
      sc.push(p3(circ(bx + W / 2, by - 1, 3.4, 4.2, 16, z + 0.05), true), p3([[bx + 3, by + 5.6, z + 0.05], [bx + W - 2, by + 5.6, z + 0.05]]));
      draw(sc.join(''), COL.mid);
      draw(Array.from({ length: 5 }, (_, k) => p3(Array.from({ length: 7 }, (_, i) => { const a = Math.PI * i / 6; return [bx - 1.1 * Math.cos(a), by - H / 2 + 2 + k * 3.2, z + 1.1 * Math.sin(a)]; }))).join(''), COL.edge);
      draw(p3([[bx + W + 1, by + 2, 0.6], [bx + W + 3.5, by + 3, 0], [bx + W + 5, by + 6, 0]]), COL.acc);
      // a page turns every few seconds, on the motion curve
      const u = (t % 3.4) / 1.1;
      if (u < 1) {
        const e = 1 - Math.pow(1 - u, 3), a = e * Math.PI;
        const a2 = Math.min(Math.PI, a + 0.55 * Math.sin(a) + 0.2 * Math.sin(u * Math.PI));
        const k1 = [bx + W * 0.5 * Math.cos(a), 0, z + W * 0.5 * Math.sin(a)];
        const k2 = [k1[0] + W * 0.5 * Math.cos(a2), 0, k1[2] + W * 0.5 * Math.sin(a2)];
        const seg = (p, q, n) => { const o = [-Math.sin(n) * 0.25, 0, Math.cos(n) * 0.25]; const v = (pt, yy, d) => [pt[0] + d[0], yy, pt[2] + d[2]]; const zz = [0, 0, 0];
          return box8([v(p, by - H / 2, zz), v(q, by - H / 2, zz), v(q, by + H / 2, zz), v(p, by + H / 2, zz), v(p, by - H / 2, o), v(q, by - H / 2, o), v(q, by + H / 2, o), v(p, by + H / 2, o)]); };
        const sp = [bx, 0, z];
        const s1 = () => render(seg(sp, k1, a)), s2 = () => render(seg(k1, k2, a2));
        (a < Math.PI / 2 ? [s2, s1] : [s1, s2]).forEach(fn => fn());
      }
    }

    // ── Air layer: the speech bubble, sheets flying out of the window ──
    function bubble(t) {
      const P = plane([-27, -38, 59 + Math.sin(t * 1.6) * 1.2]);
      const R = Array.from({ length: 12 }, (_, i) => { const a = i / 12 * Math.PI * 2 + Math.PI / 12; return [11 * Math.cos(a), 6.6 * Math.sin(a)]; });
      render(loft([[P(-4, -5.6, 0.2), P(-7.6, -10.4, 0.2), P(0, -5.6, 0.2)], [P(-4, -5.6, 1.2), P(-7.6, -10.4, 1.2), P(0, -5.6, 1.2)]]));
      render(loft([R.map(([a, b]) => P(a, b, 0)), R.map(([a, b]) => P(a, b, 1.4))]));
      const live = Math.floor(t * 2.4) % 3;
      [-4.5, 0, 4.5].forEach((a, i) => draw(p3(ringAx(P(a, 0, 1.45), BN, 1.1, 6), true), i === live ? COL.acc : COL.hi));
    }
    function sheets(t) {
      const from = [-46, -50, 9.5], to = [-16, -18, 0.3];
      for (let k = 0; k < 3; k++) {
        const u = (t * 0.16 + k / 3) % 1, p = lerp3(from, to, u);
        p[2] += Math.sin(u * Math.PI) * 18 - u * 2;
        const a = u * 6 + k, b = Math.sin(u * 9 + k) * 0.9;
        const q = ([x, y]) => add(p, rot([x, y, 0], b, a * 0.6, 0));
        group({ opacity: Math.min(1, Math.sin(u * Math.PI) * 2.2).toFixed(2) }, () => {
          render(box8([q([-3, -2.2]), q([3, -2.2]), q([3, 2.2]), q([-3, 2.2]), add(q([-3, -2.2]), [0, 0, 0.2]), add(q([3, -2.2]), [0, 0, 0.2]), add(q([3, 2.2]), [0, 0, 0.2]), add(q([-3, 2.2]), [0, 0, 0.2])]));
          draw(p3([q([-2, -1]), q([1.6, -1])]) + p3([q([-2, 0.4]), q([0.8, 0.4])]), COL.lo);
        });
      }
    }

    // ── The car's visit ──
    // A 32 s day on the lot, then a pause while the lot carries on without it:
    //  0.0  arrives along the road, hovering        3.4  holds, scans the lot
    //  4.6  turns in the air to face the pitch      6.0  lands on the pad
    //  7.0  rolls up and taps the ball into the net 9.2  nods
    // 10.4  drives the lawn to the giant pencil's sheet, its tyres printing
    //       rose tread across the paper            19.4  pauses, looks back
    // 20.4  lifts, climbs, turns for the exit      23.0  boosts away
    // 25.4  gone; tracks fade; the lot breathes until the next lap.
    // Every lap the shot goes to the other corner.
    const CYCLE = 32, SC = 0.42, KICK = 9.2;
    const LAND = [-28, ROAD.yc], CONTACT = GOAL.o[1] + GOAL.spot + 1.7 + 46.4 * SC;
    // the lawn route, a smooth curve through waypoints, sampled by length
    const ROUTE = (() => {
      const W = [[-28, CONTACT], [-27.4, 27], [-21, 21], [-10, 19.6], [-1.5, 17.6], [3.6, 9.6], [4.4, 0], [8.4, -9.6], [18, -13], [36, -13], [54, -13]];
      const P = [W[0], ...W, W[W.length - 1]], pts = [];
      for (let i = 1; i < P.length - 2; i++) for (let k = 0; k < 24; k++) {
        const u = k / 24, [p0, p1, p2, p3] = [P[i - 1], P[i], P[i + 1], P[i + 2]];
        pts.push([0, 1].map(j => 0.5 * (2 * p1[j] + (-p0[j] + p2[j]) * u + (2 * p0[j] - 5 * p1[j] + 4 * p2[j] - p3[j]) * u * u + (-p0[j] + 3 * p1[j] - 3 * p2[j] + p3[j]) * u * u * u)));
      }
      pts.push(W[W.length - 1]);
      const L = [0]; for (let i = 1; i < pts.length; i++) L.push(L[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
      const at = d => { d = Math.max(0, Math.min(L[L.length - 1], d)); let i = 1; while (i < L.length - 1 && L[i] < d) i++; const k = (d - L[i - 1]) / (L[i] - L[i - 1] || 1), a = pts[i - 1], b = pts[i]; return { p: [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k], yaw: Math.atan2(b[1] - a[1], b[0] - a[0]) }; };
      return { at, len: L[L.length - 1] };
    })();
    const EXIT = [150, ROAD.yc + 6], EXITYAW = Math.atan2(EXIT[1] - -13, EXIT[0] - 54);
    const easeIO = x => { x = Math.min(1, Math.max(0, x)); return x * x * (3 - 2 * x); };
    const lerp = (a, b, k) => a + (b - a) * k;
    function visit(T, lap = 0) {
      const deg = Math.PI / 180;
      let x = LAND[0], y = LAND[1], yaw = 0, K = 1, alt = 0, pitch = 0, thrust = 0, front = 0, speed = 0, dist = 0, scan = -1, show = true;
      const roadIn = 20.6;
      if (T < 3.4) { const u = T / 3.4; x = LAND[0] - 122 * Math.pow(1 - u, 3); speed = Math.pow(1 - u, 2); front = speed * 0.6 + bump(2.3, 2.8, 3.2, 3.6, T); pitch = 7 * bump(2.3, 2.8, 3.2, 3.6, T); alt = 2 * bump(2.3, 2.8, 3.2, 3.6, T); }
      else if (T < 4.6) { scan = (T - 3.4) / 1.2; const s = Math.exp(-(T - 3.4) * 2.6) * Math.cos((T - 3.4) * 7); pitch = 3 * s; alt = s; }
      else if (T < 6.0) { yaw = -Math.PI / 2 * easeIO((T - 4.6) / 1.4); }
      else if (T < 7.0) { yaw = -Math.PI / 2; K = 1 - easeIO(T - 6.0); }
      else if (T < KICK) { yaw = -Math.PI / 2; K = 0; const k = easeIO((T - 7.0) / (KICK - 7.0)); y = LAND[1] - roadIn * k; dist = roadIn * k; }
      else if (T < 10.4) { yaw = -Math.PI / 2; K = 0; y = CONTACT; dist = roadIn; const k = (T - KICK) / 1.2; pitch = -2.6 * Math.sin(k * Math.PI * 2) * (1 - k); }
      else if (T < 20.4) {
        K = 0; const k = easeIO((T - 10.4) / 9), d = ROUTE.len * k, r = ROUTE.at(d);
        [x, y] = r.p; yaw = r.yaw; dist = roadIn + d;
        if (T > 19.4) yaw += 0.12 * Math.sin((T - 19.4) * Math.PI * 2) * (1 - (T - 19.4));
        pitch = -1.6 * bump(10.4, 11, 11.4, 12, T) + 1.4 * bump(18.6, 19.1, 19.3, 19.7, T);
      }
      else if (T < 25.4) {
        [x, y] = ROUTE.at(ROUTE.len).p; dist = roadIn + ROUTE.len;
        K = easeIO(T - 20.4);
        alt = 12 * easeIO((T - 20.8) / 2.2);
        yaw = EXITYAW * easeIO((T - 21.4) / 1.6);
        if (T > 23) { const u = (T - 23) / 2.4; x = lerp(x, EXIT[0], u * u); y = lerp(y, EXIT[1], u * u); speed = Math.min(1, u * 2); }
        const boost = bump(22.9, 23.3, 24, 24.6, T);
        pitch = -6 * boost; thrust = Math.max(boost, speed * 0.7);
      }
      else show = false;
      const parked = smooth(6.2, 6.9, T) * (1 - smooth(7.0, 7.6, T));
      return { x, y, yaw, show, dist, scan, parked, kickAt: KICK, corner: lap % 2 ? -1 : 1, st: { K, pitch: pitch * deg, roll: 0, tilt: 0, thrust, front, alt, stretch: 1, speed } };
    }
    // world position of a wheel's contact point for a car at (x, y, yaw)
    const wheelAt = (x, y, yaw, ax, side) => { const lx = ax * SC, ly = side * (U.w + 1.6 - U.tw / 2) * SC; return [x + lx * Math.cos(yaw) - ly * Math.sin(yaw), y + lx * Math.sin(yaw) + ly * Math.cos(yaw)]; };
    // tread printed in rose where the rear tyres crossed the paper
    function treadPrints(T) {
      if (T < 10.4) return;
      const k = easeIO((T - 10.4) / 9), dNow = ROUTE.len * Math.min(1, k), fade = 1 - smooth(26, 31, T);
      if (fade <= 0) return;
      const inSheet = ([x, y]) => x > SHEET.x0 + 0.6 && x < SHEET.x1 - 0.6 && y > SHEET.y0 + 0.6 && y < SHEET.y1 - 0.6;
      const edge = [], tick = [];
      for (const side of [-1, 1]) {
        let run = [], ticks = [];
        const flush = () => { if (run.length > 1) for (const o of [-1, 1]) edge.push(p3(run.map(([p, n]) => [p[0] + n[0] * 1.6 * o, p[1] + n[1] * 1.6 * o, 0.78]))); run = []; };
        for (let d = 0, i = 0; d <= dNow; d += 1.3, i++) {
          const r = ROUTE.at(d), p = wheelAt(r.p[0], r.p[1], r.yaw, U.axR, side), n = [-Math.sin(r.yaw), Math.cos(r.yaw)];
          if (inSheet(p)) { run.push([p, n]); tick.push(p3([[p[0] - n[0] * 1.4, p[1] - n[1] * 1.4, 0.78], [p[0] + n[0] * 1.4 + Math.cos(r.yaw) * 0.5, p[1] + n[1] * 1.4 + Math.sin(r.yaw) * 0.5, 0.78]])); }
          else flush();
        }
        flush();
      }
      if (edge.length) { draw(edge.join(''), COL.mid); G.lastChild.setAttribute('stroke-opacity', fade.toFixed(2)); }
      if (tick.length) { draw(tick.join(''), COL.acc); G.lastChild.setAttribute('stroke-opacity', (0.85 * fade).toFixed(2)); }
    }
    // a calm scan pulse: two rose rings rolling out across the lot
    function scanRings(v) {
      if (v.scan < 0) return;
      for (const j of [0, 0.3]) { const k = v.scan - j; if (k <= 0) continue; const r = 10 + 150 * easeIO(k), ring = circ(v.x, v.y, r, r, 96, 0.06), runs = []; let run = []; ring.concat([ring[0]]).forEach(q => { if (Math.abs(q[0]) < TILE.x - 1.5 && Math.abs(q[1]) < TILE.y - 1.5) run.push(q); else { if (run.length > 1) runs.push(p3(run)); run = []; } }); if (run.length > 1) runs.push(p3(run)); if (!runs.length) continue; draw(runs.join(''), COL.acc); G.lastChild.setAttribute('stroke-opacity', ((1 - k) * 0.55).toFixed(2)); }
    }

    // ── Compose ──
    // Every item draws into its own group. Still things are drawn once and
    // kept; slow things (sway, wind) refresh every few frames, round-robin;
    // only what moves fast is redrawn each frame. Groups are re-ordered far to
    // near each frame, so the car slots in between trees as it drives.
    const lanternAt = () => [DOORX + 3.5 + 2.3, HOUSE.y1 + 1.2, 9.6];
    const CACHE = new Map();
    let FRAME = 0;
    function district(t, phi, spin, root) {
      const T = t % CYCLE, v = visit(T, Math.floor(t / CYCLE));
      FRAME++;
      const items = [
        { id: 'ground', k: -1e9, mode: 'static', fn: () => { slab(); groundMarks(); sheet(); pitchMarks(); } },
        { id: 'groundLive', k: -1e9 + 1, fn: () => {
          if (v.parked > 0.02) { draw(p3(circ(PAD[0], PAD[1], 9.8, 9.8, 6, 0.05, Math.PI / 6), true), COL.acc); G.lastChild.setAttribute('stroke-opacity', v.parked.toFixed(2)); }
          pencilTrail(t); treadPrints(T); drift(t, 'ground'); scanRings(v); } },
        { id: 'house', k: -112, mode: 'static', fn: () => house(t) },
        { id: 'lantern', k: -111.9, fn: () => draw(p3(ringAx(add(lanternAt(), [0, 0, 1.2]), BN, 0.32 + 0.06 * Math.sin(t * 3.1), 5), true), COL.acc) },
        { id: 'pencil', k: PEN.cx + PEN.cy, fn: () => giantPencil(t) },
        { id: 'football', k: GOAL.o[0] + GOAL.o[1], fn: () => { cornerFlag(t); football(t, T, v); } },
        { id: 'book', k: BOOK[0] + BOOK[1], mode: 'slow', every: 2, fn: () => openBook(t) },
        { id: 'palette', k: PAL[0] + PAL[1], mode: 'slow', every: 2, fn: () => palette(t) },
        { id: 'sculpture', k: SCULPT[0] + SCULPT[1], mode: 'slow', every: 2, fn: () => sculpture(t) },
        { id: 'line', k: TREES[1].x + TREES[1].y + 0.5, mode: 'slow', every: 3, fn: () => clothesline(t) },
        ...TREES.map((tr, i) => ({ id: 'tree' + i, k: tr.x + tr.y, mode: 'slow', every: 4, ph: i, fn: () => brushTree(tr, t) })),
        ...[...LAWN].map(([b, L], i) => ({ id: 'lawn' + b, k: b * 6 + 3 - 0.01, mode: 'slow', every: 6, ph: i, fn: () => lawnBin(L, t) })),
        ...(v.show ? [{ id: 'car', k: v.x + v.y + 8, fn: () => { const [sx, sy] = W3(v.x, v.y, 0); group({ transform: `translate(${f(sx)} ${f(sy)}) scale(${SC})` }, () => { YAW = v.yaw; vehicle({ K: v.st.K, t, phi: -v.dist / (SC * U.r), spin, ...v.st }); YAW = 0; }); } }] : []),
        { id: 'air', k: 1e9, fn: () => { drift(t, 'air'); puffs(t); sheets(t); bubble(t); } },
      ];
      const nodes = [];
      for (const it of items.sort((a, b) => a.k - b.k)) {
        let c = CACHE.get(it.id);
        const mode = it.mode || 'fast';
        const need = !c || mode === 'fast' || (mode === 'slow' && (FRAME + (it.ph || 0)) % it.every === 0) || root.__force;
        if (need) { const g = document.createElementNS(NS, 'g'), prev = G; G = g; it.fn(); G = prev; if (c) c.g = g; else CACHE.set(it.id, c = { g }); }
        nodes.push(c.g);
      }
      root.replaceChildren(...nodes);
      root.__force = false;
      return v;
    }

    // ── Player ──
    const g = root.querySelector('[data-scene]');
    const fig = root.closest('.journey');
    const btn = fig && fig.querySelector('[data-journey-toggle]');
    const lowPower = matchMedia('(hover: none)').matches;
    let t = reduce ? 9.6 : 0, spin = 0, playing = !reduce, onScreen = false, raf = 0, last = 0, since = 0;
    const paint = () => { FLIP = 1; district(t, 0, spin, g); };
    function tick(now) {
      raf = 0;
      if (!running()) { last = 0; return; }
      const dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
      since += dt;
      // phones and tablets draw at ~30 fps; desktops every frame
      if (!lowPower || since >= 1 / 32) {
        t += since;
        const v = visit(t % CYCLE, Math.floor(t / CYCLE));
        spin += since * (4 + 10 * v.st.thrust) * v.st.K;
        since = 0;
        paint();
      }
      raf = requestAnimationFrame(tick);
    }
    const running = () => playing && onScreen && !document.hidden && root.isConnected;
    const kick = () => { if (running() && !raf) { last = 0; raf = requestAnimationFrame(tick); } };
    const sync = () => {
      if (!btn) return;
      btn.setAttribute('aria-pressed', String(!playing));
      btn.setAttribute('aria-label', playing ? 'Pause animation' : 'Play animation');
    };

    paint();
    sync();
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; kick(); }, { rootMargin: '120px' });
      io.observe(root);
      document.addEventListener('astro:before-swap', () => { io.disconnect(); playing = false; }, { once: true });
    } else { onScreen = true; kick(); }
    document.addEventListener('visibilitychange', kick);
    btn && btn.addEventListener('click', () => { playing = !playing; sync(); kick(); });
  }

  function initAll() {
    document.querySelectorAll('[data-journey]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = 'true';
      initJourney(root);
    });
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>
