    }
    const slopeN = (dy, dz) => { let n = norm([0, -dz, dy]); if (n[2] < 0) n = mul(n, -1); return n; };
    function slopePlate(xa, xb, e, r, th) {
      const n = slopeN(r[0] - e[0], r[1] - e[1]), P = (x, [y, z], k) => add([x, y, z], mul(n, k));
      return { n, s: box8([P(xa, e, 0), P(xb, e, 0), P(xb, r, 0), P(xa, r, 0), P(xa, e, th), P(xb, e, th), P(xb, r, th), P(xa, r, th)]) };
    }

