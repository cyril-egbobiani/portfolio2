    }

    // ── The cottage: stone plinth, steep roof with fish-scale shingles, a
    // rounded ridge roll and fascia, rafter tails, half-timbered gable with an
    // oculus, an arched door, a bay window with a flower box, a bench with a
    // jar of brushes, and the pencil chimney rising from a brick collar ──
    const arc = (cx, cz, r, a0, a1, n = 10) => Array.from({ length: n + 1 }, (_, i) => { const a = a0 + (a1 - a0) * i / n; return [cx + r * Math.cos(a), cz + r * Math.sin(a)]; });
    // diamond lattice in a (u, v) rectangle, mapped through m(u, v)
    function lattice(m, u0, u1, v0, v1, step) {
      const out = [];
      for (const sg of [1, -1]) for (let c = -40; c <= 40; c += step) {
        // line v - v0 = sg * (u - u0) + c, clipped to the rectangle
        const pts = [];
        for (const u of [u0, u1]) { const v = v0 + sg * (u - u0) + c; if (v >= v0 - 1e-6 && v <= v1 + 1e-6) pts.push([u, v]); }
        for (const v of [v0, v1]) { const u = u0 + (v - v0 - c) * sg; if (u > u0 + 1e-6 && u < u1 - 1e-6) pts.push([u, v]); }
        if (pts.length >= 2) out.push(p3([m(...pts[0]), m(...pts[1])]));
      }
      return out.join('');
    }
    // brick or stone courses on a wall rectangle
    function courses(m, u0, u1, v0, v1, ch, bw) {
      const out = [];
      for (let v = v0 + ch, r = 0; v < v1 - 0.2; v += ch, r++) out.push(p3([m(u0, v), m(u1, v)]));
      for (let v = v0, r = 0; v < v1 - 0.1; v += ch, r++) for (let u = u0 + (r % 2 ? bw / 2 : bw); u < u1 - 0.3; u += bw) out.push(p3([m(u, v), m(u, Math.min(v1, v + ch))]));
