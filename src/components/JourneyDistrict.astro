      render(lathe(c0, [0, 0, 1], [[0, 2.3], [7.5, 2.3]], 6, 0.3));
      render(lathe(add(c0, [0, 0, 7.5]), [0, 0, 1], [[0, 2.55], [2.2, 2.55]], 12, 0.3));
      render(lathe(add(c0, [0, 0, 9.7]), [0, 0, 1], [[0, 2.25], [1.7, 2.25], [2.4, 1.6], [2.7, 0.8]], 12, 0.3, { line: COL.acc }));
      // the front slope with fish-scale shingles
      const F = slopePlate(x0 - gov, x1 + gov, eF, rr, th);
      render(F.s);
      const sp = (x, s) => add([x, eF[0] + (rr[0] - eF[0]) * s, eF[1] + (rr[1] - eF[1]) * s], mul(F.n, th + 0.04));
      const sc = [];
      for (let k = 1; k < 10; k++) { const s = k * 0.098; for (let x = x0 - gov + (k % 2 ? 1.3 : 2.6); x < x1 + gov - 1.3; x += 2.6) sc.push(p3([sp(x - 1.3, s), sp(x - 0.95, s - 0.028), sp(x, s - 0.042), sp(x + 0.95, s - 0.028), sp(x + 1.3, s)])); }
      draw(sc.join(''), COL.lo);
      // bargeboards on the visible gable, under each slope's end
      for (const e of [eF, eB]) { const n = slopeN(rr[0] - e[0], rr[1] - e[1]), Q = (x, [y, z], k) => add([x, y, z], mul(n, k)), xa = x1 + gov - 0.8, xb = x1 + gov + 0.05;
        render(box8([Q(xa, e, 0), Q(xa, rr, 0), Q(xa, rr, -1.4), Q(xa, e, -1.4), Q(xb, e, 0), Q(xb, rr, 0), Q(xb, rr, -1.4), Q(xb, e, -1.4)])); }
      // soft edges: a fascia roll along the eave, a ridge roll, a finial
      const fd = norm([0, rr[0] - eF[0], rr[1] - eF[1]]);
      render(lathe(add(add([x0 - gov, eF[0], eF[1]], mul(F.n, th / 2)), mul(fd, 0.1)), [1, 0, 0], [[0, 0.78], [x1 - x0 + 2 * gov, 0.78]], 8));
      render(lathe([x0 - gov - 0.3, ym, R + 1.05], [1, 0, 0], [[0, 1.3], [x1 - x0 + 2 * gov + 0.6, 1.3]], 8));
      render(lathe([x1 + gov + 0.3, ym, R + 2.1], [0, 0, 1], [[0, 0.6], [1.6, 0.6], [2.3, 1], [4.2, 0.06]], 6));
    }
    // eraser-dust puffs rising from the chimney
    function puffs(t) {
      for (let k = 0; k < 3; k++) {
        const u = (t * 0.3 + k / 3) % 1, c = [-78 + u * 5, -58 - u * 2, 47.6 + u * 8];
        draw(p3(ringAx(c, [0, 0, 1], 1.1 + u * 2.4, 6, u * 1.4), true), COL.mid);
        G.lastChild.setAttribute('stroke-opacity', (Math.sin(u * Math.PI) * 0.9).toFixed(2));
      }
    }

    // ── The football corner: a goal with a net that billows, a faceted ball
    // chipped in from the spot and rolled back out, chalk lines on a mown
    // patch, a corner flag with a rose pennant ──
    // a truncated icosahedron, faces found from the icosahedron's vertices
    // (pentagons) and the dodecahedron's (hexagons)
    const BALL = (() => {
      const ph = (1 + Math.sqrt(5)) / 2, V = [];
      const cyc = ([x, y, z]) => [[x, y, z], [y, z, x], [z, x, y]];
      const signs = (p, f) => { for (const sx of p[0] ? [1, -1] : [1]) for (const sy of p[1] ? [1, -1] : [1]) for (const sz of p[2] ? [1, -1] : [1]) f([p[0] * sx, p[1] * sy, p[2] * sz]); };
      for (const base of [[0, 1, 3 * ph], [1, 2 + ph, 2 * ph], [ph, 2, 2 * ph + 1]]) for (const c of cyc(base)) signs(c, v => V.push(v));
      const centers = [];
      for (const c of cyc([0, 1, ph])) signs(c, v => centers.push([v, 5]));
      signs([1, 1, 1], v => centers.push([v, 6]));
      for (const c of cyc([0, 1 / ph, ph])) signs(c, v => centers.push([v, 6]));
      const faces = centers.map(([c, n]) => {
        const cn = norm(c), d = V.map(v => dotv(v, cn)), mx = Math.max(...d);
        const ix = d.map((x, i) => [x, i]).filter(([x]) => x > mx - 1e-6).map(([, i]) => i);
        const [, u, w] = basis(cn);
        ix.sort((i, j) => Math.atan2(dotv(V[i], w), dotv(V[i], u)) - Math.atan2(dotv(V[j], w), dotv(V[j], u)));
        return { ix, pent: n === 5 };
      });
      const R0 = Math.hypot(...V[0]);
      return { V: V.map(v => mul(v, 1 / R0)), faces };
    })();
    const rodrigues = (v, k, a) => { const c = Math.cos(a), s = Math.sin(a); return add(add(mul(v, c), mul(cross(k, v), s)), mul(k, dotv(k, v) * (1 - c))); };
    function drawBall(c, r, q) {
      // q: list of [axis, angle] rotations, applied in order
      const verts = BALL.V.map(v => { let p = v; for (const [k, a] of q) p = rodrigues(p, k, a); return add(c, mul(p, r)); });
      const s = solid(verts, BALL.faces.map(f => f.ix));
      render(s);
      // the pentagon patches: an inset outline on each visible one
      const out = [];
      BALL.faces.forEach((f, i) => { if (!f.pent || !faceVisible(s.faces[i].n)) return; const fc = f.ix.reduce((a, k) => add(a, mul(verts[k], 1 / 5)), [0, 0, 0]); out.push(p3(f.ix.map(k => lerp3(fc, verts[k], 0.62)), true)); });
      draw(out.join(''), COL.hi);
    }
    // the ball's loop: rest on the spot, chip into the top corner, the net
    // takes it, it drops and is rolled back out to the spot
    // the ball waits on the spot; when the car taps it, it's chipped into a
    // top corner, the net takes it, it rests there until the car has gone,
    // then rolls back out to the spot
    function ballState(T, kickAt, corner) {
      const r = 1.7, spot = [0, GOAL.spot], hit = [4.6 * corner, -GOAL.d + 1.8], u = T - kickAt;
      const ease = x => 1 - Math.pow(1 - Math.min(1, Math.max(0, x)), 3);
      let a = 0, b = spot[1], z = r, net = 0, fly = 0, travel = 0;
      if (u >= 0 && u < 0.9) { const k = u / 0.9; a = hit[0] * k; b = spot[1] + (hit[1] - spot[1]) * k; z = r + 7.2 * Math.sin(Math.PI * k * 0.82) + k * 0.6; fly = 1; travel = 18 * k; }
      else if (u >= 0.9 && u < 5.3) { const k = Math.min(1, (u - 0.9) / 1.3); a = hit[0]; b = hit[1] + 0.8 * k; z = Math.max(r, (r + 6.4) * (1 - k * k)); net = u < 2.2 ? Math.exp(-k * 3) * Math.cos(k * 9) : 0; travel = 18 + 2 * k; }
      else if (u >= 5.3 && u < 7.5) { const k = ease((u - 5.3) / 2.2); a = hit[0] * (1 - k); b = hit[1] + 0.8 + (spot[1] - hit[1] - 0.8) * k; travel = 20 + 22 * k; }
      return { u, a, b, z, r, net, fly, hit, travel };
    }
    // a box goal: a flat top net, a vertical back net (it takes the ball and
    // billows), and side nets; frame tubes are rounded
    const HB = 0.86;
    function netBack(st) {
      const { w, h, d } = GOAL, hb = h * HB, out = [];
      const bulge = (a, z) => st.net * 2.4 * Math.sin(Math.PI * Math.min(1, z / hb)) * Math.exp(-((a - st.hit[0]) ** 2) / 16);
      const P = (a, z) => add(GL(a, -d, z), mul(GN, -bulge(a, z)));
      for (let k = 1; k < 7; k++) { const z = hb * k / 7; out.push(p3(Array.from({ length: 13 }, (_, i) => P(-w + 2 * w * i / 12, z)))); }
      for (let i = 1; i < 12; i++) { const a = -w + 2 * w * i / 12; out.push(p3(Array.from({ length: 8 }, (_, k) => P(a, hb * k / 7)))); }
      draw(out.join(''), COL.edge);
      if (st.net > 0.05) { draw(p3(ringAx(P(st.hit[0], hb * 0.6), GN, 1.2 + (1 - st.net) * 2.2, 8), true), COL.acc); G.lastChild.setAttribute('stroke-opacity', Math.min(1, st.net).toFixed(2)); }
    }
    function netFront() {
      const { w, h, d } = GOAL, hb = h * HB, out = [];
      const top = (a, b) => GL(a, b, h + (hb - h) * (-b / d));
      for (let i = 1; i < 12; i++) { const a = -w + 2 * w * i / 12; out.push(p3([top(a, 0), top(a, -d)])); }
      for (let k = 1; k < 4; k++) { const b = -d * k / 4; out.push(p3([top(-w, b), top(w, b)])); }
      for (const sa of [-1, 1]) {
        for (let k = 1; k < 4; k++) { const b = -d * k / 4; out.push(p3([GL(sa * w, b, 0), top(sa * w, b)])); }
        for (let k = 1; k < 5; k++) { const z = hb * k / 5; out.push(p3([GL(sa * w, 0, z), GL(sa * w, -d, z)])); }
      }
      draw(out.join(''), COL.edge);
    }
    function goalFrame(part) {
      const { w, h, d } = GOAL, hb = h * HB, r = 0.55;
      const bar = (p, q, rr = r) => render(lathe(p, sub(q, p), [[0, rr], [Math.hypot(...sub(q, p)), rr]], 8));
      if (part === 'back') {
        bar(GL(-w, -d, 0), GL(w, -d, 0), 0.3);
        for (const sa of [-1, 1]) bar(GL(sa * w, -d, 0), GL(sa * w, -d, hb), 0.3);
        bar(GL(-w, -d, hb), GL(w, -d, hb), 0.3);
        return;
      }
      for (const sa of [-1, 1]) { bar(GL(sa * w, 0, 0), GL(sa * w, -d, 0), 0.3); bar(GL(sa * w, 0, h), GL(sa * w, -d, hb), 0.3); }
      bar(GL(-w, 0, 0), GL(-w, 0, h + r));
      bar(GL(w, 0, 0), GL(w, 0, h + r));
      bar(GL(-w - r, 0, h), GL(w + r, 0, h));
    }
    function pitchMarks() {
      const { w, six, spot, box, boxW } = GOAL, g = (a, b) => GL(a, b, 0.05);
      // mown bands, then chalk
      const bands = []; for (let b = 3; b < box + 4; b += 3.4) bands.push(p3([g(-boxW - 4, b), g(boxW + 4, b)]));
      draw(bands.join(''), COL.lo);
      draw(p3([g(-boxW - 5, 0), g(boxW + 5, 0)]) + p3([g(-w - 4, 0), g(-w - 4, six), g(w + 4, six), g(w + 4, 0)]) + p3([g(-boxW, 0), g(-boxW, box), g(boxW, box), g(boxW, 0)]) + p3(circ(...g(0, spot).slice(0, 2), 0.5, 0.5, 6, 0.05), true)
        + p3(Array.from({ length: 13 }, (_, i) => { const th = 0.65 + i / 12 * (Math.PI - 1.3); return g(7 * Math.cos(th), spot + 7 * Math.sin(th)); }).filter(p => true)), COL.mid);
    }
    function cornerFlag(t) {
      const base = GL(GOAL.boxW + 5, 0, 0), H = 11;
      render(lathe(base, [0, 0, 1], [[0, 0.28], [H, 0.24], [H + 0.5, 0.06]], 6));
      const wave = (k, z) => add(add(base, [0, 0, z]), add(mul(GU, k * 5.2), mul(GN, Math.sin(t * 3 - k * 2.6) * 1.1 * k)));
      const pts = [wave(0, H - 0.2), wave(0.5, H - 0.9), wave(1, H - 1.6), wave(0.5, H - 2.5), wave(0, H - 3.4)];
      draw(p3(pts, true), COL.acc, COL.plate);
      draw(p3([wave(0.08, H - 1.8), wave(0.5, H - 1.7)]), COL.acc);
    }
    function football(t, T, v) {
      const st = ballState(T, v.kickAt, v.corner);
      const c = GL(st.a, st.b, st.z);
      // a soft shadow on the grass when the ball is up
      if (st.z > st.r + 0.2) draw(p3(circ(...GL(st.a, st.b, 0).slice(0, 2), st.r * (1 - (st.z - st.r) / 24), st.r * 0.8 * (1 - (st.z - st.r) / 24), 12, 0.06), true), COL.lo);
      // roll: rotation about the axis across the direction of travel
      const travel = st.travel;
      const q = [[norm(cross([0, 0, 1], add(mul(GN, -1), mul(GU, 0.25)))), travel / st.r], [[0, 0, 1], 0.5]];
      goalFrame('back');
      netBack(st);
      const ball = () => {
        drawBall(c, st.r, q);
        // speed dashes behind it in flight
        if (st.fly) { const back = norm(sub(GL(0, GOAL.spot, 1.7), c)); draw([0, 1, 2].map(i => { const o = add(c, mul(ringAx([0, 0, 0], back, 0.9, 3, i * 2.1)[0], 1)); return p3([add(o, mul(back, 2)), add(o, mul(back, 4.4 - i * 0.6))]); }).join(''), COL.acc); }
      };
      if (st.b < 0) { ball(); netFront(); goalFrame(); } else { netFront(); goalFrame(); ball(); }
    }

    // ── The palette, a brush dipping into rose ──
    function palette(t) {
      const [px, py] = PAL, rot = -0.35;
      const R = ([a, b]) => [px + a * Math.cos(rot) - b * Math.sin(rot), py + a * Math.sin(rot) + b * Math.cos(rot)];
      const outline = Array.from({ length: 14 }, (_, i) => { const a = i / 14 * Math.PI * 2; return R([20 * Math.cos(a), 13 * Math.sin(a)]); });
      render(slabXY(outline, 0, 1.4));
      draw(p3(circ(...R([-12, 4]), 2.6, 2.6, 6, 1.45), true), COL.mid);
      const dabs = [[-7, -7], [2, -9], [10, -6], [14, 2], [6, 6]];
      dabs.forEach(([a, b], i) => { const [x, y] = R([a, b]); render(slabXY(circ(x, y, 2.5, 2.5, 6, 0, i * 0.5).map(p => p.slice(0, 2)), 1.4, 2.2, i === 3 ? { line: COL.acc } : {})); });
      // the brush: handle end resting on the rim, tuft dipping into the rose dab
      const [dx, dy] = R([14, 2]), dip = 2.4 + 2.2 * Math.max(0, Math.sin(t * 1.6));
      const tipP = [dx, dy, dip], endP = [...R([2, 19]), 1.4], ax = norm(sub(tipP, endP)), L = Math.hypot(...sub(tipP, endP));
      render(lathe(endP, ax, [[0, 0.6], [L - 8, 0.95]], 6));
      render(lathe(add(endP, mul(ax, L - 8)), ax, [[0, 1.15], [2.8, 1.15]], 8));
      render(lathe(add(endP, mul(ax, L - 5.2)), ax, [[0, 1.25], [2, 1.6], [5.2, 0.08]], 6, 0, { line: COL.acc }));
    }

    // ── Paintbrush trees: round, mop, chisel and fan tips ──
    function brushTree(tr, t) {
      const { x, y, type, s, ph } = tr, H = 12 * s, Z = [0, 0, 1];
      render(lathe([x, y, 0], Z, [[0, 1.35 * s], [H, 0.95 * s]], 6, ph));
      render(lathe([x, y, H], Z, [[0, 1.6 * s], [3.8 * s, 1.6 * s], [4.6 * s, 1.3 * s]], 8, ph));
      draw(p3(Array.from({ length: 9 }, (_, i) => { const a = -Math.PI / 4 + i / 8 * Math.PI; return [x + 1.62 * s * Math.cos(a), y + 1.62 * s * Math.sin(a), H + 1.9 * s]; })), COL.mid);
      const b = H + 4.6 * s, sw = k => [Math.sin(t * 1.3 + ph) * 1.2 * s * k, Math.cos(t * 1.1 + ph) * 0.8 * s * k, 0];
      const R = (z, r, k, n = 6) => ringAx(add([x, y, b + z * s], sw(k)), Z, Math.max(r * s, 0.06), n, ph);
      if (type === 'round') render(loft([R(0, 1.9, 0), R(3, 3.3, 0.2), R(7, 3.1, 0.5), R(13.5, 0, 1)]));
      else if (type === 'mop') render(loft([R(0, 2.1, 0, 8), R(2, 4, 0.1, 8), R(4.8, 5.2, 0.3, 8), R(8, 5, 0.5, 8), R(10.6, 3.6, 0.75, 8), R(12.4, 1.4, 0.9, 8), R(13.3, 0, 1, 8)]));
      else if (type === 'chisel') {
        // flat bristles squared off at an angle
        const e = [Math.cos(ph), Math.sin(ph), 0], f = [-Math.sin(ph), Math.cos(ph), 0];
        const rect = (z, w, d, k, slant = 0) => [[-w, -d], [w, -d], [w, d], [-w, d]].map(([u, v]) => add(add([x, y, b + (z + slant * u / w) * s], sw(k)), add(mul(e, u * s), mul(f, v * s))));
        render(loft([rect(0, 2.1, 1.5, 0), rect(3, 3.5, 1.8, 0.2), rect(7, 3.8, 1.45, 0.5), rect(10.6, 3.7, 0.12, 0.9, 1.6)]));
      } else {
        // a fan brush, opened square to the viewer, with its bristle lines
        const a = -Math.PI / 4 + 0.35 * Math.sin(ph), e = [Math.cos(a), Math.sin(a), 0], f = [-Math.sin(a), Math.cos(a), 0], tilt = Math.sin(t * 1.1 + ph) * 0.07;
        const F = (u, w, d) => { const uu = u * Math.cos(tilt) - w * Math.sin(tilt), ww = u * Math.sin(tilt) + w * Math.cos(tilt); return add([x, y, b + ww * s], add(mul(e, uu * s), mul(f, d * s))); };
        const prof = [[-1.4, 0], [1.4, 0], ...Array.from({ length: 11 }, (_, i) => { const g = 1.1 - i * 0.22; return [9 * Math.sin(g), 1.2 + 8.4 * Math.cos(g)]; })];
        render(loft([prof.map(([u, w]) => F(u, w, -0.55)), prof.map(([u, w]) => F(u, w, 0.55))]));
        const side = dotv(f, view()) > 0 ? 0.6 : -0.6;
        draw(Array.from({ length: 9 }, (_, i) => { const g = 0.95 - i * 0.2375; return p3([F(0, 0.6, side), F(8.1 * Math.sin(g), 1.2 + 7.6 * Math.cos(g), side)]); }).join(''), COL.lo);
      }
    }

    // ── A clothesline between two trees, swatches and sheets pegged to dry ──
    function clothesline(t) {
      const A = [TREES[0].x, TREES[0].y, 10.6], B = [TREES[1].x, TREES[1].y, 11], sag = 2.6;
      const P = u => { const p = lerp3(A, B, u), k = 4 * u * (1 - u); return [p[0], p[1] + Math.sin(t * 0.9) * 0.5 * k, p[2] - sag * k]; };
      draw(p3(Array.from({ length: 21 }, (_, i) => P(i / 20))), COL.mid);
      [0.16, 0.33, 0.5, 0.67, 0.84].forEach((u, i) => {
        const top = P(u), q = Math.sin(t * 1.2 + i * 1.3) * 0.2 + 0.08, hgt = i % 2 ? 4.6 : 5.6, w = 2.1;
        const dn = [0, Math.sin(q), -Math.cos(q)], nn = [0, Math.cos(q), Math.sin(q)];
        const S = (a, d, h = 0) => add(add(add(top, [a, 0, 0]), mul(dn, d)), mul(nn, h));
        render(box8([S(-w, 0), S(w, 0), S(w, hgt), S(-w, hgt), S(-w, 0, 0.15), S(w, 0, 0.15), S(w, hgt, 0.15), S(-w, hgt, 0.15)]));
        const m = (a, d) => S(a, d, 0.2);
        if (i === 0) draw(p3([m(-1.3, 1.4), m(1.2, 1.4)]) + p3([m(-1.3, 2.6), m(0.6, 2.6)]) + p3([m(-1.3, 3.8), m(1, 3.8)]), COL.lo);
        if (i === 1) draw(p3(Array.from({ length: 9 }, (_, k) => m(Math.cos(k / 8 * 6.283) * 1.1, 2.3 + Math.sin(k / 8 * 6.283) * 1.1))), COL.lo);
        if (i === 2) draw(p3(Array.from({ length: 7 }, (_, k) => m(-1.4 + k * 0.47, 2.8 + (k % 2 ? -0.5 : 0.5)))), COL.acc);
        if (i === 3) draw(p3([m(-1.5, 3.8), m(-0.4, 1.6), m(0.4, 3), m(0.9, 2.2), m(1.5, 3.8)]), COL.lo);
        if (i === 4) draw([0, 1, 2, 3].map(k => p3([m(-1.4 + k * 0.9, 4.6), m(-0.4 + k * 0.9, 1)])).join(''), COL.lo);
        // two pegs
        draw(p3([m(-w + 0.6, -0.5), m(-w + 0.6, 0.8)]) + p3([m(w - 0.6, -0.5), m(w - 0.6, 0.8)]), COL.hi);
      });
    }

    // ── Sculpture in progress: a block on a soft plinth, a form being freed
    // from it, chisel marks, a chisel tapping, chips, a mallet on the grass ──
    function sculpture(t) {
      const [sx, sy] = SCULPT, rot = 0.3;
      const sq = (r, z, ins = 0) => [[-r, -r], [r, -r], [r, r], [-r, r]].map(([a, b]) => [sx + (a - Math.sign(a) * ins) * Math.cos(rot) - (b - Math.sign(b) * ins) * Math.sin(rot), sy + (a - Math.sign(a) * ins) * Math.sin(rot) + (b - Math.sign(b) * ins) * Math.cos(rot), z]);
      render(loft([sq(4.8, 0), sq(4.8, 2.2), sq(4.8, 2.9, 0.6)]));
      render(loft([sq(3.4, 2.9), sq(3.4, 7.4)]));
      const M = (a, b, z) => [sx + a * Math.cos(rot) - b * Math.sin(rot), sy + a * Math.sin(rot) + b * Math.cos(rot), z];
      // chisel marks on the block's two visible faces
      const cm = [];
      for (let k = 0; k < 7; k++) { const z = 3.6 + (k * 0.61) % 3.2, a = -2.6 + (k * 0.83) % 5; cm.push(p3([M(a, 3.45, z), M(a + 0.7, 3.45, z + 0.5)]), p3([M(3.45, a, z + 0.3), M(3.45, a + 0.6, z + 0.8)])); }
      draw(cm.join(''), COL.lo);
      // the emerging form: a faceted egg, still rough at its base
      render(lathe(M(0.4, 0.2, 7.4), [0.06, 0.04, 1], [[0, 2.9], [1.5, 3.5], [3.6, 3.6], [5.8, 2.8], [7.1, 1.3], [7.6, 0.2]], 7, 0.4));
      draw(p3([M(0.6, 3.4, 9.6), M(1.6, 3.1, 10.8)]) + p3([M(2.2, 2.4, 11.6), M(2.9, 1.6, 12.4)]) + p3([M(3.3, 0.4, 9.4), M(3.4, -0.6, 10.4)]), COL.mid);
      // the chisel, tapping every couple of seconds, a chip flying off
      const k = (t % 2.4) / 2.4, push = k < 0.06 ? k / 0.06 : Math.max(0, 1 - (k - 0.06) / 0.2);
      const tip = M(2.6, 2.7, 9.6), ax = norm([0.5, 0.9, 0.45]), base = add(tip, mul(ax, 0.6 + 0.6 * (1 - push)));
      render(lathe(base, ax, [[0, 0.08], [1.4, 0.35], [3.2, 0.35]], 6, 0, { line: COL.acc }));
      render(lathe(add(base, mul(ax, 3.2)), ax, [[0, 0.55], [3.6, 0.6], [4, 0.4]], 6));
      if (k < 0.35) { const u = k / 0.35, c = add(tip, [u * 3, u * 4.4, 4 * u - 7 * u * u]); draw(p3([c, add(c, [0.6, 0.2, 0.3]), add(c, [0.2, 0.6, -0.2])], true), COL.mid); }
      // chips scattered at the foot, and the mallet resting on the grass
      draw([[5, 3], [6, -1], [-2, 6], [3, 6.5], [6.4, 4.4]].map(([a, b], i) => { const c = M(a, b, 0.1); return p3([c, add(c, [0.7, 0.2 * i, 0]), add(c, [0.2, 0.7, 0])], true); }).join(''), COL.lo);
      const mh = M(-9.5, -2.5, 0.55);
      render(lathe(mh, [1, 0.25, 0], [[0, 0.4], [6.4, 0.5]], 6));
      render(lathe(add(mh, [6.6, 1.65 - 1.8, 0.75]), [-0.25, 1, 0], [[0, 1.1], [0.4, 1.3], [3.2, 1.3], [3.6, 1.1]], 8));
    }

    // ── Drifting: bristle leaves falling from the groves, ink drops dripping
    // from two brush tips and rippling where they land ──
    function drift(t, layer) {
      const leaves = [[3, 0], [8, 2.3], [11, 4.1], [5, 5.6]];
      const lv = [];
      for (const [ti, off] of leaves) {
        const tr = TREES[ti], u = ((t + off) % 8) / 8, fall = Math.min(1, u / 0.78);
        const top = [tr.x, tr.y, 12 * tr.s + 10 * tr.s];
        const c = [top[0] + fall * 7 + Math.sin(u * 14 + off) * 1.6, top[1] + fall * 5 + Math.cos(u * 11) * 1.2, top[2] * (1 - fall) + 0.2];
        const a = u * 9 + off, e = [Math.cos(a) * 1.2, Math.sin(a) * 1.2, Math.sin(u * 12) * 0.5 * (1 - fall)], f = [-Math.sin(a) * 0.45, Math.cos(a) * 0.45, 0];
        const op = Math.min(1, u * 8) * (u > 0.85 ? (1 - u) / 0.15 : 1);
