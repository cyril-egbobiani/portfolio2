      if (mid.length) draw(mid.join(''), COL.mid);
      if (acc.length) draw(acc.join(''), COL.acc);
    }

    // ── The sheet and the giant pencil ──
    const penAt = s => [PEN.cx + PEN.rx * Math.sin(s), PEN.cy + PEN.ry * Math.sin(2 * s), 0.75];
    function sheet() {
      const { x0, x1, y0, y1 } = SHEET, dog = 7;
      render(slabXY([[x0, y0], [x1, y0], [x1, y1 - dog], [x1 - dog, y1], [x0, y1]], 0, 0.7));
      // the dog-eared corner folded back over the page
      render(slabXY([[x1, y1 - dog], [x1 - dog, y1], [x1 - dog, y1 - dog]], 0.7, 0.9));
      // old doodles: a star and a spiral, faint
      const star = Array.from({ length: 10 }, (_, i) => { const a = i * Math.PI / 5 - Math.PI / 2, r = i % 2 ? 2.6 : 6; return [x0 + 10 + r * Math.cos(a), y1 - 11 + r * Math.sin(a), 0.75]; });
