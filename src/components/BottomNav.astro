---
// BottomNav.astro — One menu button with a quick sheet (homepage)
// Closed: a small pill that names the section you're reading.
// Open: a short sheet with every destination (keys 1–4 jump straight there)
// and quick actions: copy email, résumé, LinkedIn, theme.

const icons = {
  projects: `<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M2.069 5.258C2 5.626 2 6.067 2 6.95V14c0 3.771 0 5.657 1.172 6.828C4.343 22 6.229 22 10 22h4c3.771 0 5.657 0 6.828-1.172C22 19.657 22 17.771 22 14v-2.202c0-2.632 0-3.949-.77-4.804a3 3 0 0 0-.224-.225C20.151 6 18.835 6 16.202 6h-.374c-1.153 0-1.73 0-2.268-.153a4 4 0 0 1-.848-.352C12.224 5.224 11.816 4.816 11 4l-.55-.55c-.274-.274-.41-.41-.554-.53a4 4 0 0 0-2.18-.903C7.53 2 7.336 2 6.95 2c-.883 0-1.324 0-1.692.07A4 4 0 0 0 2.07 5.257M12.25 10a.75.75 0 0 1 .75-.75h5a.75.75 0 0 1 0 1.5h-5a.75.75 0 0 1-.75-.75"/></svg>`,
  services: `<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 3.34c1.026-.592 2.209-.55 3.24-.13a5.35 5.35 0 0 1 1.82 1.254a5.9 5.9 0 0 1 1.804-1.21c.997-.413 2.142-.488 3.136.086s1.502 1.602 1.644 2.672a5.9 5.9 0 0 1-.147 2.169c.75.186 1.433.51 1.996.948c.88.684 1.507 1.688 1.507 2.872c0 1.178-.62 2.177-1.492 2.86a5.3 5.3 0 0 1-1.929.938c.197.722.25 1.453.152 2.139c-.155 1.096-.71 2.134-1.731 2.723c-1.026.592-2.209.55-3.24.131a5.35 5.35 0 0 1-1.819-1.255c-.55.53-1.165.946-1.805 1.211c-.997.413-2.142.487-3.136-.087S5.498 19.06 5.356 17.99a5.9 5.9 0 0 1 .147-2.169a5.35 5.35 0 0 1-1.996-.948C2.627 14.19 2 13.185 2 12.002c0-1.179.621-2.179 1.493-2.862a5.3 5.3 0 0 1 1.928-.938a5.3 5.3 0 0 1-.152-2.138C5.424 4.967 5.979 3.929 7 3.34m5 4.661a4 4 0 1 0 0 8a4 4 0 0 0 0-8m0 2a2 2 0 1 1 0 4a2 2 0 0 1 0-4"/></svg>`,
  about: `<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.489 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.512-1.003 1.986c-.56.45-1.299.747-2.084.955C16.336 21.86 14.23 22 12 22s-4.336-.14-5.913-.559c-.785-.207-1.524-.505-2.084-.955C3.41 20.012 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.178-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10"/></svg>`,
  journal: `<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor"><path d="M5.655 2.227c-.432.113-.711.273-.928.486c-.305.299-.504.719-.613 1.512C4.002 5.042 4 6.124 4 7.676v8.568a4.7 4.7 0 0 1 1.299-.592q.17-.045.356-.072z"/><path d="M7.31 15.514h12.69V7.676c0-1.552-.002-2.634-.114-3.451c-.109-.793-.308-1.213-.613-1.512c-.306-.3-.735-.495-1.544-.601C16.896 2.002 15.79 2 14.207 2H9.793c-1.002 0-1.812 0-2.483.029z"/><path d="M7.473 17.135c-1.079 0-1.456.007-1.746.083a2.44 2.44 0 0 0-1.697 1.538q.024.574.084 1.019c.109.793.308 1.213.613 1.512c.306.3.735.495 1.544.601c.834.11 1.939.112 3.522.112h4.414c1.584 0 2.689-.002 3.522-.112c.81-.106 1.238-.301 1.544-.601c.305-.299.504-.719.613-1.512c.091-.666.11-1.51.113-2.64z"/></g></svg>`,
};

const links = [
  { id: 'projects', href: '/#projects', label: 'Work', icon: icons.projects },
  { id: 'services', href: '/#services', label: 'What I do', icon: icons.services },
  { id: 'about', href: '/about', label: 'About', icon: icons.about },
  { id: 'journal', href: '/journal', label: 'Journal', icon: icons.journal },
];

const EMAIL = 'egbobianicyril@gmail.com';
---

<nav class="qm" aria-label="Main" data-qm>
  <div class="qm-backdrop" data-qm-backdrop aria-hidden="true"></div>

  <div class="qm-sheet" id="qmSheet" role="dialog" aria-modal="true" aria-label="Menu" data-qm-sheet inert>
    <ul class="qm-list" role="list">
      {links.map((link, index) => (
        <li style={`--i: ${index}`}>
          <a href={link.href} class="qm-link" data-qm-link={link.id}>
            <span class="qm-link__icon" set:html={link.icon} />
            <span class="qm-link__label">{link.label}</span>
            <kbd class="qm-link__key" aria-hidden="true">{index + 1}</kbd>
          </a>
        </li>
      ))}
    </ul>

    <div class="qm-actions" style="--i: 4">
      <button type="button" class="qm-action qm-action--wide" data-qm-copy aria-label={`Copy email address ${EMAIL}`}>
        <svg class="qm-copy-idle" width="16" height="16" viewBox="0.4 0.9 19.2 19.2" aria-hidden="true">
          <path fill="currentColor" d="M18 7.373V14.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 2 14.5V7.373l7.746 4.558a.5.5 0 0 0 .508 0zM15.5 4a2.5 2.5 0 0 1 2.485 2.223L10 10.92L2.015 6.223A2.5 2.5 0 0 1 4.5 4z" />
        </svg>
        <svg class="qm-copy-done" width="16" height="16" viewBox="0.96 0.46 22.08 22.08" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12" />
        </svg>
        <span data-qm-copy-text>Copy email</span>
      </button>
      <a href="https://drive.google.com/file/d/1XXSvad2gGp1N7c7Pc7x0WkOkr_0AUAWb/view" target="_blank" rel="noopener noreferrer" class="qm-action qm-action--wide">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M4 4a2 2 0 0 1 2-2h8.586a2 2 0 0 1 1.414.586l3.414 3.414A2 2 0 0 1 20 7.414V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm10 0v3a1 1 0 0 0 1 1h3zM8 12a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2zm0 4a1 1 0 1 0 0 2h5a1 1 0 1 0 0-2z" />
        </svg>
        Résumé<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <a href="https://www.linkedin.com/in/cyril-egbobiani-6802002b8/" target="_blank" rel="noopener noreferrer" class="qm-action" aria-label="LinkedIn (opens in a new tab)">
        <svg width="16" height="16" viewBox="1.2 1.2 21.6 21.6" aria-hidden="true">
          <path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z" />
        </svg>
      </a>
      <button type="button" class="qm-action" data-qm-theme aria-label="Switch theme">
        <svg class="qm-theme-sun" width="16" height="16" viewBox="-1.32 -1.32 26.64 26.64" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M12 2v2.5M12 19.5v2.5M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12h2.5M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77" />
        </svg>
        <svg class="qm-theme-moon" width="16" height="16" viewBox="1.2 1.2 21.6 21.6" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12.003 3a9 9 0 1 0 8.997 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1h.003z" />
        </svg>
      </button>
    </div>
  </div>

  <button type="button" class="qm-button" aria-expanded="false" aria-controls="qmSheet" data-qm-toggle>
    <span class="qm-button__dot" aria-hidden="true"></span>
    <span class="qm-button__where" data-qm-where>Home</span>
    <span class="qm-button__hint" data-qm-hint>Menu</span>
    <span class="qm-button__icon" aria-hidden="true">
      <svg class="qm-icon-menu" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M5 9h14M5 15h14" />
      </svg>
      <svg class="qm-icon-close" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M7 7l10 10M17 7 7 17" />
      </svg>
    </span>
  </button>
</nav>

<style>
  .qm {
    position: fixed;
    left: 0;
    right: 0;
    bottom: max(20px, calc(12px + env(safe-area-inset-bottom, 0px)));
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    /* Menu-only hairline, quieter than --border-subtle so the pill doesn't outline itself */
    --qm-border: rgba(0, 0, 0, 0.04);
  }

  :global([data-theme='dark']) .qm {
    --qm-border: rgba(255, 255, 255, 0.04);
  }

  /* ── Backdrop: dims the page a little so the sheet reads as a layer ── */
  .qm-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.18);
    opacity: 0;
    transition: opacity 240ms var(--ease-smooth-out);
  }

  :global([data-theme='dark']) .qm-backdrop {
    background: rgba(0, 0, 0, 0.55);
  }

  .qm[data-open] .qm-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── The pill ── */
  .qm-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 6px 0 18px;
    border: 1px solid var(--qm-border);
    border-radius: 9999px;
    background: var(--surface-raised);
    color: var(--text-primary);
    font-family: var(--font-sans);
    box-shadow: 0 10px 28px -14px rgba(0, 0, 0, 0.28);
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
    transition: transform 160ms var(--ease-smooth-out);
    animation: qmIn 480ms cubic-bezier(0.23, 1, 0.32, 1) 150ms both;
  }

  :global([data-theme='dark']) .qm-button {
    box-shadow: none;
  }

  @keyframes qmIn {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.94);
    }
  }

  .qm-button:active {
    transform: scale(0.96);
  }

  .qm-button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  /* The one spot of colour at rest: it marks the section you're on */
  .qm-button__dot {
    width: 6px;
    height: 6px;
    margin-right: -4px;
    border-radius: 9999px;
    background: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  .qm-button__where {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    transition:
      opacity 140ms ease,
      transform 220ms var(--ease-smooth-out);
  }

  .qm-button__where.is-swapping {
    opacity: 0;
    transform: translateY(4px);
  }

  .qm-button__hint {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .qm-button__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9999px;
    background: var(--surface-interactive);
  }

  .qm-button__icon svg {
    grid-area: 1 / 1;
    transition:
      opacity 180ms ease,
      transform 320ms var(--ease-bounce);
  }

  .qm-icon-close,
  .qm[data-open] .qm-icon-menu {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .qm[data-open] .qm-icon-close {
    opacity: 1;
    transform: none;
  }

  /* ── The sheet ── */
  .qm-sheet {
    position: relative;
    width: min(336px, calc(100vw - 28px));
    margin-bottom: 10px;
    padding: 6px;
    border: 1px solid var(--qm-border);
    border-radius: 20px;
    background: var(--surface-raised);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.3);
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    transform-origin: bottom center;
    visibility: hidden;
    transition:
      opacity 200ms var(--ease-smooth-out),
      transform 280ms var(--ease-smooth-out),
      visibility 0s linear 280ms;
  }

  :global([data-theme='dark']) .qm-sheet {
    box-shadow: none;
  }

  .qm[data-open] .qm-sheet {
    opacity: 1;
    transform: none;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 200ms var(--ease-smooth-out),
      transform 320ms var(--ease-bounce),
      visibility 0s;
  }

  .qm-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Rows settle in one after another */
  .qm-list li,
  .qm-actions {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .qm[data-open] .qm-list li,
  .qm[data-open] .qm-actions {
    opacity: 1;
    transform: none;
    transition:
      opacity 240ms var(--ease-smooth-out) calc(var(--i) * 30ms + 40ms),
      transform 320ms var(--ease-smooth-out) calc(var(--i) * 30ms + 40ms);
  }

  .qm-link {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    padding: 0 12px;
    border-radius: 14px;
    color: var(--text-primary);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 160ms var(--ease-smooth-out),
      transform 140ms var(--ease-smooth-out);
  }

  .qm-link__icon {
    display: grid;
    place-items: center;
    color: var(--text-muted);
    transition: color 160ms var(--ease-smooth-out);
  }

  .qm-link__key {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    margin-left: auto;
    border-radius: 6px;
    background: var(--surface-subtle);
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-muted);
  }

  .qm-link[aria-current] {
    background: var(--surface-interactive);
    color: var(--brand);
  }

  .qm-link[aria-current] .qm-link__icon {
    color: var(--brand);
  }

  .qm-link[aria-current] .qm-link__key {
    background: var(--surface-raised);
  }

  @media (hover: hover) and (pointer: fine) {
    .qm-link:hover {
      background: var(--surface-interactive);
    }

    .qm-link:hover .qm-link__icon {
      color: var(--text-primary);
    }
  }

  /* Number keys only make sense with a keyboard */
  @media (hover: none) {
    .qm-link__key {
      display: none;
    }
  }

  .qm-link:active {
    transform: scale(0.96);
  }

  .qm-link:focus-visible,
  .qm-action:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .qm-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 38px 38px;
    gap: 6px;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--border-subtle);
  }

  .qm-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 40px;
    padding: 0;
    white-space: nowrap;
    border: 0;
    border-radius: 12px;
    background: var(--surface-subtle);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-smooth-out),
      color 160ms var(--ease-smooth-out),
      transform 140ms var(--ease-smooth-out);
  }

  /* Labelled actions keep breathing room around their icon and text */
  /* Icons never get squeezed by the label beside them */
  .qm-action svg,
  .qm-link__icon :global(svg) {
    flex-shrink: 0;
  }

  .qm-action--wide {
    padding: 0 14px;
    font-size: 13px;
  }

  @media (hover: hover) and (pointer: fine) {
    .qm-action:hover {
      background: var(--surface-interactive);
      color: var(--text-primary);
    }
  }

  .qm-action:active {
    transform: scale(0.96);
  }

  .qm-copy-done,
  .qm-action.is-copied .qm-copy-idle,
  .qm-theme-sun,
  :global([data-theme='dark']) .qm-theme-moon {
    display: none;
  }

  .qm-action.is-copied .qm-copy-done,
  :global([data-theme='dark']) .qm-theme-sun {
    display: block;
  }

  /* Confirmation is the other place colour earns its keep */
  .qm-action.is-copied {
    background: var(--brand-soft);
    color: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .qm-backdrop,
    .qm-button,
    .qm-button__where,
    .qm-button__icon svg,
    .qm-sheet,
    .qm-list li,
    .qm-actions,
    .qm-link,
    .qm-action {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  const EMAIL = 'egbobianicyril@gmail.com';

  function initQuickMenu() {
    const root = document.querySelector<HTMLElement>('[data-qm]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';

    const toggle = root.querySelector<HTMLButtonElement>('[data-qm-toggle]')!;
    const sheet = root.querySelector<HTMLElement>('[data-qm-sheet]')!;
    const backdrop = root.querySelector<HTMLElement>('[data-qm-backdrop]')!;
    const where = root.querySelector<HTMLElement>('[data-qm-where]')!;
    const hint = root.querySelector<HTMLElement>('[data-qm-hint]')!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-qm-link]')];
    const copy = root.querySelector<HTMLButtonElement>('[data-qm-copy]');
    const copyText = root.querySelector<HTMLElement>('[data-qm-copy-text]');
    const theme = root.querySelector<HTMLButtonElement>('[data-qm-theme]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let open = false;
    let openedAtY = 0;

    const setOpen = (value: boolean, { focus = false } = {}) => {
      if (open === value) return;
      open = value;
      root.toggleAttribute('data-open', value);
      sheet.inert = !value;
      toggle.setAttribute('aria-expanded', String(value));
      hint.textContent = value ? 'Close' : 'Menu';
      if (value) openedAtY = window.scrollY;
      if (focus) (value ? links.find((l) => l.hasAttribute('aria-current')) ?? links[0] : toggle).focus({ preventScroll: true });
    };

    // ── Which section is on screen ──
    const sections = [
      { id: 'projects', label: 'Work', tab: 'projects' },
      { id: 'services', label: 'What I do', tab: 'services' },
      { id: 'experience', label: 'Experience', tab: null },
      { id: 'contact', label: 'Contact', tab: null },
    ]
      .map((section) => ({ ...section, el: document.getElementById(section.id) }))
      .filter((section): section is typeof section & { el: HTMLElement } => Boolean(section.el));

    let currentLabel = where.textContent ?? '';
    let swapTimer: ReturnType<typeof setTimeout> | undefined;

    const update = () => {
      const line = window.innerHeight * 0.45;
      let current: (typeof sections)[number] | null = null;
      for (const section of sections) {
        if (section.el.getBoundingClientRect().top <= line) current = section;
      }
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (max > 0 && window.scrollY >= max - 4 && sections.length) current = sections[sections.length - 1];

      links.forEach((link) => {
        if (current && link.dataset.qmLink === current.tab) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });

      const label = current?.label ?? 'Home';
      if (label === currentLabel) return;
      currentLabel = label;
      clearTimeout(swapTimer);
      if (reduceMotion) {
        where.textContent = label;
        return;
      }
      where.classList.add('is-swapping');
      swapTimer = setTimeout(() => {
        where.textContent = label;
        where.classList.remove('is-swapping');
      }, 140);
    };

    let ticking = false;
    const onScroll = () => {
      if (open && Math.abs(window.scrollY - openedAtY) > 60) setOpen(false);
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    // ── Interaction ──
    // Focus moves into the sheet only for keyboard activation (a tap or click has detail > 0)
    toggle.addEventListener('click', (event) => setOpen(!open, { focus: event.detail === 0 }));
    // Closing from the backdrop hands focus back to the button, not the page body
    backdrop.addEventListener('click', () => setOpen(false, { focus: sheet.contains(document.activeElement) }));

    const go = (link: HTMLAnchorElement, event?: Event) => {
      const href = link.getAttribute('href') ?? '';
      const target = href.startsWith('/#') ? document.getElementById(href.slice(2)) : null;
      setOpen(false);
      if (!target) {
        if (!event) navigate(link.getAttribute('href') ?? '/');
        return;
      }
      event?.preventDefault();
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', href.slice(1));
    };

    links.forEach((link) => link.addEventListener('click', (event) => go(link, event)));

    const onKeydown = (event: KeyboardEvent) => {
      if (!open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false, { focus: true });
        return;
      }
      // Tab stays inside the sheet while it is open
      if (event.key === 'Tab') {
        const stops = [...sheet.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
        if (stops.length === 0) return;
        const first = stops[0];
        const last = stops[stops.length - 1];
        const active = document.activeElement;
        if (event.shiftKey && (active === first || !sheet.contains(active))) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
        return;
      }
      if (/^[1-4]$/.test(event.key) && !event.metaKey && !event.ctrlKey && !event.altKey) {
        const link = links[Number(event.key) - 1];
        if (link) {
          event.preventDefault();
          go(link);
        }
      }
    };

    root.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (open && next && !root.contains(next)) setOpen(false);
    });

    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(EMAIL);
        copy.classList.add('is-copied');
        if (copyText) copyText.textContent = 'Copied';
        setTimeout(() => {
          copy.classList.remove('is-copied');
          if (copyText) copyText.textContent = 'Copy email';
        }, 1800);
      } catch {
        window.location.href = `mailto:${EMAIL}`;
      }
    });

    // The label names what pressing it will do, not just "switch theme"
    const describeTheme = () => {
      if (!theme) return;
      const goingDark = document.documentElement.dataset.theme !== 'dark';
      theme.setAttribute('aria-label', goingDark ? 'Switch to dark theme' : 'Switch to light theme');
    };
    describeTheme();
    new MutationObserver(describeTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    theme?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.classList.add('theme-switching');
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('portfolio-theme', next);
      } catch {
        // Storage can be unavailable (private mode); the theme still switches for this visit
      }
      describeTheme();
      setTimeout(() => document.documentElement.classList.remove('theme-switching'), 120);
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('keydown', onKeydown);
    update();

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('keydown', onKeydown);
        clearTimeout(swapTimer);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initQuickMenu);
</script>
