---
// BottomNav.astro — One menu button with a quick sheet (homepage)
// Closed: a small pill that names the section you're reading.
// Open: a 300px menu card with every destination (keys 1–4 jump straight
// there), then the email with a copy button, and the theme switch.

// Line icons from the design system: 16px, 1.4 stroke, round caps
const icons = {
  projects: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h3l1.5 1.5h4.5A1.5 1.5 0 0 1 14 6v5.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 11.5z"/></svg>`,
  services: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2l1.4 3.6L13 7l-3.6 1.4L8 12l-1.4-3.6L3 7l3.6-1.4z"/></svg>`,
  about: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="5.5" r="2.5"/><path d="M3 13.5c.8-2.4 2.7-3.5 5-3.5s4.2 1.1 5 3.5"/></svg>`,
  journal: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 2.5h7a1.5 1.5 0 0 1 1.5 1.5v9.5H5A1.5 1.5 0 0 1 3.5 12V3A.5.5 0 0 1 4 2.5z"/><path d="M6 6h4M6 8.5h3"/></svg>`,
};

const links = [
  { id: 'projects', href: '/#projects', label: 'Work', icon: icons.projects },
  { id: 'services', href: '/#services', label: 'What I do', icon: icons.services },
  { id: 'about', href: '/about', label: 'About', icon: icons.about },
  { id: 'journal', href: '/journal', label: 'Journal', icon: icons.journal },
];

const EMAIL = 'egbobianicyril@gmail.com';
---

<nav class="qm" aria-label="Main" data-qm>
  <div class="qm-backdrop" data-qm-backdrop aria-hidden="true"></div>

  <div class="qm-sheet" id="qmSheet" role="dialog" aria-modal="true" aria-label="Menu" data-qm-sheet inert>
    <ul class="qm-list" role="list">
      {links.map((link, index) => (
        <li style={`--i: ${index}`}>
          <a href={link.href} class="qm-link" data-qm-link={link.id}>
            <span class="qm-link__icon" set:html={link.icon} />
            <span class="qm-link__label">{link.label}</span>
            <kbd class="qm-link__key" aria-hidden="true">{index + 1}</kbd>
          </a>
        </li>
      ))}
    </ul>

    <div class="qm-divider" aria-hidden="true"></div>

    <div class="qm-actions" style="--i: 4">
      <div class="qm-email">
        <span class="qm-email__text">{EMAIL}</span>
        <button type="button" class="qm-chip" data-qm-copy aria-label={`Copy email address ${EMAIL}`}>
          <svg class="qm-copy-idle" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.5"/><path d="M3 10.5V3.5A1 1 0 0 1 4 2.5h6.5"/></svg>
          <svg class="qm-copy-done" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7"/></svg>
        </button>
      </div>
      <button type="button" class="qm-square" data-qm-theme aria-label="Switch theme">
        <svg class="qm-theme-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 9.5A5.5 5.5 0 0 1 6.5 3a5.5 5.5 0 1 0 6.5 6.5z"/></svg>
        <svg class="qm-theme-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="2.8"/><path d="M8 1.5v1.3M8 13.2v1.3M1.5 8h1.3M13.2 8h1.3M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"/></svg>
      </button>
    </div>
  </div>

  <button type="button" class="qm-button" aria-expanded="false" aria-controls="qmSheet" data-qm-toggle>
    <span class="sr-only" data-qm-where>Home</span>
    <span class="sr-only" data-qm-hint>Menu</span>
    <span class="qm-button__icon" aria-hidden="true">
      <span class="qm-icon-menu qm-dots">
        <span></span><span></span><span></span><span></span>
      </span>
      <svg class="qm-icon-close" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M7 7l10 10M17 7 7 17" />
      </svg>
    </span>
  </button>
</nav>

<style>
  /* A circle centred on the bottom edge: it keeps the small footprint of the
     orb while sitting where the thumb naturally rests. The sheet opens upward
     from the same point. */
  .qm {
    position: fixed;
    left: 0;
    right: 0;
    bottom: max(16px, calc(10px + env(safe-area-inset-bottom, 0px)));
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    /* Menu-only hairline, quieter than --border-subtle so the pill doesn't outline itself */
    --qm-border: rgba(0, 0, 0, 0.04);
  }

  :global([data-theme='dark']) .qm {
    --qm-border: rgba(255, 255, 255, 0.04);
  }

  /* ── Backdrop: dims the page a little so the sheet reads as a layer ── */
  .qm-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.18);
    opacity: 0;
    transition: opacity 240ms var(--ease-smooth-out);
  }

  :global([data-theme='dark']) .qm-backdrop {
    background: rgba(0, 0, 0, 0.55);
  }

  .qm[data-open] .qm-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── The pill ── */
  .qm-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 9999px;
    /* The primary button: soft dark in light mode, soft light in dark mode */
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    font-family: var(--font-sans);
    box-shadow: var(--shadow-btn);
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
    transition: transform 160ms var(--ease-smooth-out);
    animation: qmIn 480ms cubic-bezier(0.23, 1, 0.32, 1) 150ms both;
  }

  @keyframes qmIn {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.94);
    }
  }

  .qm-button:active {
    transform: scale(0.96);
  }

  .qm-button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  .qm-button__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
  }

  .qm-button__icon > * {
    grid-area: 1 / 1;
    transition:
      opacity 180ms ease,
      transform 320ms var(--ease-bounce);
  }

  /* ── Four dots: one per destination in the sheet ──
     If a fifth link is ever added to `links` above, this mark stops being
     true and should change with it. On hover they push apart, as if the
     menu has already started to open. */
  .qm-dots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    width: 14px;
  }

  .qm-dots span {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: currentColor;
    transition: transform 340ms var(--ease-bounce);
  }

  @media (hover: hover) and (pointer: fine) {
    .qm-button:hover .qm-dots span:nth-child(1) { transform: translate(-1px, -1px); }
    .qm-button:hover .qm-dots span:nth-child(2) { transform: translate(1px, -1px); }
    .qm-button:hover .qm-dots span:nth-child(3) { transform: translate(-1px, 1px); }
    .qm-button:hover .qm-dots span:nth-child(4) { transform: translate(1px, 1px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .qm-dots span {
      transition: none;
    }

    .qm-button:hover .qm-dots span {
      transform: none;
    }
  }

  .qm-icon-close,
  .qm[data-open] .qm-icon-menu {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .qm[data-open] .qm-icon-close {
    opacity: 1;
    transform: none;
  }

  /* ── The sheet ── */
  .qm-sheet {
    position: relative;
    width: min(300px, calc(100vw - 32px));
    margin-bottom: 12px;
    padding: 6px;
    box-sizing: border-box;
    /* Card 14 = row 8 + pad 6. The float shadow is used here and nowhere else */
    border-radius: var(--radius-menu);
    background: var(--surface-card);
    box-shadow: var(--shadow-float);
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    transform-origin: bottom center;
    visibility: hidden;
    transition:
      opacity 200ms var(--ease-smooth-out),
      transform 280ms var(--ease-smooth-out),
      visibility 0s linear 280ms;
  }

  .qm[data-open] .qm-sheet {
    opacity: 1;
    transform: none;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 200ms var(--ease-smooth-out),
      transform 320ms var(--ease-bounce),
      visibility 0s;
  }

  .qm-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Rows settle in one after another */
  .qm-list li,
  .qm-actions {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .qm[data-open] .qm-list li,
  .qm[data-open] .qm-actions {
    opacity: 1;
    transform: none;
    transition:
      opacity 240ms var(--ease-smooth-out) calc(var(--i) * 30ms + 40ms),
      transform 320ms var(--ease-smooth-out) calc(var(--i) * 30ms + 40ms);
  }

  .qm-link {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-tile);
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 160ms var(--ease-smooth-out),
      transform 140ms var(--ease-smooth-out);
  }

  .qm-link__icon {
    display: grid;
    place-items: center;
    color: var(--text-secondary);
    transition: color 160ms var(--ease-smooth-out);
  }

  /* Key chip: a tiny ring card */
  .qm-link__key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    box-sizing: border-box;
    margin-left: auto;
    border-radius: 5px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  /* Active row: rose tint, rose text */
  .qm-link[aria-current] {
    background: var(--brand-soft);
    color: var(--brand);
  }

  .qm-link[aria-current] .qm-link__icon,
  .qm-link[aria-current] .qm-link__key {
    color: var(--brand);
  }

  @media (hover: hover) and (pointer: fine) {
    .qm-link:not([aria-current]):hover {
      background: var(--surface-inset);
    }

    .qm-link:hover .qm-link__icon {
      color: var(--text-primary);
    }
  }

  /* Number keys only make sense with a keyboard */
  @media (hover: none) {
    .qm-link__key {
      display: none;
    }
  }

  .qm-link:active {
    transform: scale(0.96);
  }

  .qm-link:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .qm-divider {
    height: 1px;
    margin: 4px 6px;
    background: var(--border-subtle);
  }

  /* Footer: the email in a well with a copy chip, then the theme square */
  .qm-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 2px 4px 0;
  }

  .qm-email {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 4px 0 10px;
    box-sizing: border-box;
    border-radius: var(--radius-tile);
    background: var(--surface-inset);
  }

  .qm-email__text {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .qm-chip,
  .qm-square {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 160ms var(--ease-smooth-out), transform 140ms var(--ease-smooth-out), background-color 160ms var(--ease-smooth-out);
  }

  .qm-chip {
    margin-left: auto;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-inset);
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
  }

  .qm-square {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-tile);
    background: var(--surface-inset);
  }

  @media (hover: hover) and (pointer: fine) {
    .qm-chip:hover,
    .qm-square:hover { color: var(--text-primary); }
  }

  .qm-chip:active,
  .qm-square:active { transform: scale(0.94); }

  .qm-chip:focus-visible,
  .qm-square:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .qm-copy-done,
  .qm-chip.is-copied .qm-copy-idle,
  .qm-theme-sun,
  :global([data-theme='dark']) .qm-theme-moon {
    display: none;
  }

  .qm-chip.is-copied .qm-copy-done,
  :global([data-theme='dark']) .qm-theme-sun {
    display: block;
  }

  .qm-chip.is-copied {
    background: var(--brand-soft);
    color: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .qm-backdrop,
    .qm-button,
    .qm-button__where,
    .qm-button__icon svg,
    .qm-sheet,
    .qm-list li,
    .qm-actions,
    .qm-link,
    .qm-chip,
    .qm-square {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  const EMAIL = 'egbobianicyril@gmail.com';

  function initQuickMenu() {
    const root = document.querySelector<HTMLElement>('[data-qm]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';

    const toggle = root.querySelector<HTMLButtonElement>('[data-qm-toggle]')!;
    const sheet = root.querySelector<HTMLElement>('[data-qm-sheet]')!;
    const backdrop = root.querySelector<HTMLElement>('[data-qm-backdrop]')!;
    const where = root.querySelector<HTMLElement>('[data-qm-where]')!;
    const hint = root.querySelector<HTMLElement>('[data-qm-hint]')!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-qm-link]')];
    const copy = root.querySelector<HTMLButtonElement>('[data-qm-copy]');
    const theme = root.querySelector<HTMLButtonElement>('[data-qm-theme]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let open = false;
    let openedAtY = 0;

    const setOpen = (value: boolean, { focus = false } = {}) => {
      if (open === value) return;
      open = value;
      root.toggleAttribute('data-open', value);
      sheet.inert = !value;
      toggle.setAttribute('aria-expanded', String(value));
      hint.textContent = value ? 'Close' : 'Menu';
      if (value) openedAtY = window.scrollY;
      if (focus) (value ? links.find((l) => l.hasAttribute('aria-current')) ?? links[0] : toggle).focus({ preventScroll: true });
    };

    // ── Which section is on screen ──
    const sections = [
      { id: 'projects', label: 'Work', tab: 'projects' },
      { id: 'services', label: 'What I do', tab: 'services' },
      { id: 'experience', label: 'Experience', tab: null },
      { id: 'contact', label: 'Contact', tab: null },
    ]
      .map((section) => ({ ...section, el: document.getElementById(section.id) }))
      .filter((section): section is typeof section & { el: HTMLElement } => Boolean(section.el));

    let currentLabel = where.textContent ?? '';

    const update = () => {
      const line = window.innerHeight * 0.45;
      let current: (typeof sections)[number] | null = null;
      for (const section of sections) {
        if (section.el.getBoundingClientRect().top <= line) current = section;
      }
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (max > 0 && window.scrollY >= max - 4 && sections.length) current = sections[sections.length - 1];

      links.forEach((link) => {
        if (current && link.dataset.qmLink === current.tab) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });

      const label = current?.label ?? 'Home';
      if (label === currentLabel) return;
      currentLabel = label;
      where.textContent = label;
    };

    let ticking = false;
    const onScroll = () => {
      if (open && Math.abs(window.scrollY - openedAtY) > 60) setOpen(false);
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    // ── Interaction ──
    // Focus moves into the sheet only for keyboard activation (a tap or click has detail > 0)
    toggle.addEventListener('click', (event) => setOpen(!open, { focus: event.detail === 0 }));
    // Closing from the backdrop hands focus back to the button, not the page body
    backdrop.addEventListener('click', () => setOpen(false, { focus: sheet.contains(document.activeElement) }));

    const go = (link: HTMLAnchorElement, event?: Event) => {
      const href = link.getAttribute('href') ?? '';
      const target = href.startsWith('/#') ? document.getElementById(href.slice(2)) : null;
      setOpen(false);
      if (!target) {
        if (!event) navigate(link.getAttribute('href') ?? '/');
        return;
      }
      event?.preventDefault();
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', href.slice(1));
    };

    links.forEach((link) => link.addEventListener('click', (event) => go(link, event)));

    const onKeydown = (event: KeyboardEvent) => {
      if (!open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false, { focus: true });
        return;
      }
      // Tab stays inside the sheet while it is open
      if (event.key === 'Tab') {
        const stops = [...sheet.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
        if (stops.length === 0) return;
        const first = stops[0];
        const last = stops[stops.length - 1];
        const active = document.activeElement;
        if (event.shiftKey && (active === first || !sheet.contains(active))) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
        return;
      }
      if (/^[1-4]$/.test(event.key) && !event.metaKey && !event.ctrlKey && !event.altKey) {
        const link = links[Number(event.key) - 1];
        if (link) {
          event.preventDefault();
          go(link);
        }
      }
    };

    root.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (open && next && !root.contains(next)) setOpen(false);
    });

    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(EMAIL);
        copy.classList.add('is-copied');
        copy.setAttribute('aria-label', 'Email copied');
        setTimeout(() => {
          copy.classList.remove('is-copied');
          copy.setAttribute('aria-label', `Copy email address ${EMAIL}`);
        }, 1800);
      } catch {
        window.location.href = `mailto:${EMAIL}`;
      }
    });

    // The label names what pressing it will do, not just "switch theme"
    const describeTheme = () => {
      if (!theme) return;
      const goingDark = document.documentElement.dataset.theme !== 'dark';
      theme.setAttribute('aria-label', goingDark ? 'Switch to dark theme' : 'Switch to light theme');
    };
    describeTheme();
    new MutationObserver(describeTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    theme?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.classList.add('theme-switching');
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('portfolio-theme', next);
      } catch {
        // Storage can be unavailable (private mode); the theme still switches for this visit
      }
      describeTheme();
      setTimeout(() => document.documentElement.classList.remove('theme-switching'), 120);
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('keydown', onKeydown);
    update();

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('keydown', onKeydown);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initQuickMenu);
</script>
