---
// BottomNav.astro — Refined Dual-Island Floating Navigation (Direction 2: Harmonized)
// Retains the detached dual-island architecture (Island A: Nav, Island B: Action Satellite)
// while completely reskinning the materiality to speak the site's true design language:
// • Frosted architectural glassmorphism with delicate hairlines (var(--border-subtle))
// • Ergonomic 44px height matching the portfolio's restrained modular scale
// • Fluid sliding indicator pill matching the "Builds / Designs" segmented control
// • Restored custom vector icons (Briefcase, Equalizer Sliders, Profile Silhouette)
// • Quick Connect popover with live availability, 1-tap email copy, theme toggle & links
// • Emil Kowalski motion tokens: cubic-bezier(0.23, 1, 0.32, 1), :active press feedback
---

<nav class="dock-cluster-anchor" aria-label="Floating navigation dock">

  <!-- ── Floating Quick Connect & Controls Popover Card (Flow 3 + Flow 2) ── -->
  <div
    class="dock-popover-card"
    id="dockPopover"
    role="dialog"
    aria-modal="true"
    aria-label="Quick Connect and Actions"
    aria-hidden="true"
  >

    <!-- 1-Tap Copy Email Action (borderless, icon-driven feedback) -->
    <div
      class="popover-email-box"
      role="button"
      tabindex="0"
      aria-label="Copy Cyril's email address"
      data-popover-copy-email
    >
      <div class="popover-email-left">
        <svg class="popover-glyph" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="14" x="3" y="5" rx="2.5" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        <span class="email-val">egbobianicyril@gmail.com</span>
      </div>

      <div class="popover-copy-action" aria-hidden="true">
        <svg class="copy-glyph copy-glyph--idle" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <svg class="copy-glyph copy-glyph--copied" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
    </div>

    <!-- Quick Utilities Row: Pure borderless icon tiles (no text clutter) -->
    <div class="popover-tools-row">
      <!-- Theme Switcher -->
      <button
        type="button"
        class="popover-tool-btn"
        data-popover-theme-toggle
        aria-label="Switch theme"
        title="Switch theme"
      >
        <span class="tool-icon-slot">
          <!-- Sun icon (shown in dark mode) -->
          <svg class="popover-glyph theme-icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="4.5" />
            <path stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M12 2v2.5M12 19.5v2.5M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12h2.5M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"/>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="popover-glyph theme-icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.003 3a9 9 0 1 0 8.997 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1h.003z" />
          </svg>
        </span>
      </button>

      <!-- Resume PDF -->
      <a
        href="https://drive.google.com/file/d/1XXSvad2gGp1N7c7Pc7x0WkOkr_0AUAWb/view"
        target="_blank"
        rel="noopener noreferrer"
        class="popover-tool-btn"
        aria-label="Resume PDF"
        title="Resume PDF"
      >
        <svg class="popover-glyph" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M0 0h24v24H0z" fill="none"/>
          <path fill="currentColor" d="M4 4a2 2 0 0 1 2-2h8.586a2 2 0 0 1 1.414.586l3.414 3.414A2 2 0 0 1 20 7.414V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm10 0v3a1 1 0 0 0 1 1h3zM8 12a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2zm0 4a1 1 0 1 0 0 2h5a1 1 0 1 0 0-2z"/>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/cyril-egbobiani-6802002b8/"
        target="_blank"
        rel="noopener noreferrer"
        class="popover-tool-btn"
        aria-label="LinkedIn Profile"
        title="LinkedIn Profile"
      >
        <svg class="popover-glyph" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M0 0h24v24H0z" fill="none"/>
          <path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- ── Dual-Island Floating Dock Cluster ── -->
  <div class="dock-cluster" data-dock-cluster>

    <!-- ── Invisible balancing spacer (ensures Island A is dead-center on screen) ── -->
    <div class="dock-spacer" aria-hidden="true"></div>

    <!-- ── Island A: Main Navigation Capsule (3 Destinations) ── -->
    <div class="dock-main-capsule" role="tablist" data-dock-main-capsule>
      <!-- Fluid Refined Sliding Highlight Pill -->
      <div class="dock-sliding-pill" data-dock-sliding-pill aria-hidden="true"></div>

      <!-- Item 1: Work (MingCute Folder) -->
      <a
        href="/#projects"
        class="dock-tab is-active"
        data-dock-tab="projects"
        role="tab"
        aria-label="Work"
      >
        <span class="dock-tab-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="currentColor" fill-rule="evenodd" d="M2.06935 5.25839C2 5.62595 2 6.06722 2 6.94975V14C2 17.7712 2 19.6569 3.17157 20.8284C4.34315 22 6.22876 22 10 22H14C17.7712 22 19.6569 22 20.8284 20.8284C22 19.6569 22 17.7712 22 14V11.7979C22 9.16554 22 7.84935 21.2305 6.99383C21.1598 6.91514 21.0849 6.84024 21.0062 6.76946C20.1506 6 18.8345 6 16.2021 6H15.8284C14.6747 6 14.0979 6 13.5604 5.84678C13.2651 5.7626 12.9804 5.64471 12.7121 5.49543C12.2237 5.22367 11.8158 4.81578 11 4L10.4497 3.44975C10.1763 3.17633 10.0396 3.03961 9.89594 2.92051C9.27652 2.40704 8.51665 2.09229 7.71557 2.01738C7.52976 2 7.33642 2 6.94975 2C6.06722 2 5.62595 2 5.25839 2.06935C3.64031 2.37464 2.37464 3.64031 2.06935 5.25839ZM12.25 10C12.25 9.58579 12.5858 9.25 13 9.25H18C18.4142 9.25 18.75 9.58579 18.75 10C18.75 10.4142 18.4142 10.75 18 10.75H13C12.5858 10.75 12.25 10.4142 12.25 10Z" clip-rule="evenodd" />
          </svg>
        </span>
        <span class="dock-tooltip" aria-hidden="true">Work</span>
      </a>

      <!-- Item 2: Services (MingCute Scalloped Badge) -->
      <a
        href="/#services"
        class="dock-tab"
        data-dock-tab="services"
        role="tab"
        aria-label="What I do"
      >
        <span class="dock-tab-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="currentColor" d="M7 3.34c1.026-.592 2.209-.55 3.24-.13a5.35 5.35 0 0 1 1.82 1.254a5.9 5.9 0 0 1 1.804-1.21c.997-.413 2.142-.488 3.136.086s1.502 1.602 1.644 2.672a5.9 5.9 0 0 1-.147 2.169c.75.186 1.433.51 1.996.948c.88.684 1.507 1.688 1.507 2.872c0 1.178-.62 2.177-1.492 2.86a5.3 5.3 0 0 1-1.929.938c.197.722.25 1.453.152 2.139c-.155 1.096-.71 2.134-1.731 2.723c-1.026.592-2.209.55-3.24.131a5.35 5.35 0 0 1-1.819-1.255c-.55.53-1.165.946-1.805 1.211c-.997.413-2.142.487-3.136-.087S5.498 19.06 5.356 17.99a5.9 5.9 0 0 1 .147-2.169a5.35 5.35 0 0 1-1.996-.948C2.627 14.19 2 13.185 2 12.002c0-1.179.621-2.179 1.493-2.862a5.3 5.3 0 0 1 1.928-.938a5.3 5.3 0 0 1-.152-2.138C5.424 4.967 5.979 3.929 7 3.34m5 4.661a4 4 0 1 0 0 8a4 4 0 0 0 0-8m0 2a2 2 0 1 1 0 4a2 2 0 0 1 0-4" />
          </svg>
        </span>
        <span class="dock-tooltip" aria-hidden="true">What I do</span>
      </a>

      <!-- Item 3: About (MingCute User Profile) -->
      <a
        href="/about"
        class="dock-tab"
        data-dock-tab="about"
        role="tab"
        aria-label="About"
      >
        <span class="dock-tab-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="currentColor" d="M12 13c2.396 0 4.575.694 6.178 1.672c.8.489 1.484 1.064 1.978 1.69c.486.615.844 1.351.844 2.138c0 .845-.411 1.512-1.003 1.986c-.56.45-1.299.747-2.084.955C16.336 21.86 14.23 22 12 22s-4.336-.14-5.913-.559c-.785-.207-1.524-.505-2.084-.955C3.41 20.012 3 19.345 3 18.5c0-.787.358-1.523.844-2.139c.494-.625 1.178-1.2 1.978-1.69C7.425 13.695 9.605 13 12 13m0-11a5 5 0 1 1 0 10a5 5 0 0 1 0-10" />
          </svg>
        </span>
        <span class="dock-tooltip" aria-hidden="true">About</span>
      </a>

      <!-- Item: Journal (notebook) -->
      <a
        href="/journal"
        class="dock-tab"
        data-dock-tab="journal"
        role="tab"
        aria-label="Journal"
      >
        <span class="dock-tab-icon">
          <svg width="16" height="16" viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <g fill="currentColor">
              <path d="M5.65517 2.22732C5.2225 2.34037 4.9438 2.50021 4.72718 2.71244C4.42179 3.01165 4.22268 3.43172 4.11382 4.225C4.00176 5.04159 4 6.12387 4 7.67568V16.2442C4.38867 15.9781 4.82674 15.7756 5.29899 15.6517C5.41296 15.6217 5.53103 15.5983 5.65517 15.5799V2.22732Z" />
              <path d="M7.31034 15.5135C7.32206 15.5135 7.33382 15.5135 7.34563 15.5135L20 15.5135V7.67568C20 6.12387 19.9982 5.04159 19.8862 4.22499C19.7773 3.43172 19.5782 3.01165 19.2728 2.71244C18.9674 2.41324 18.5387 2.21816 17.729 2.11151C16.8955 2.00172 15.7908 2 14.2069 2H9.7931C8.79138 2 7.98133 2.00069 7.31034 2.02897V15.5135Z" />
              <path d="M7.47341 17.1351C6.39395 17.1351 6.01657 17.1421 5.72738 17.218C4.93365 17.4264 4.30088 18.0044 4.02952 18.7558C4.0463 19.1382 4.07259 19.4746 4.11382 19.775C4.22268 20.5683 4.42179 20.9884 4.72718 21.2876C5.03258 21.5868 5.46135 21.7818 6.27103 21.8885C7.10452 21.9983 8.2092 22 9.7931 22H14.2069C15.7908 22 16.8955 21.9983 17.729 21.8885C18.5387 21.7818 18.9674 21.5868 19.2728 21.2876C19.5782 20.9884 19.7773 20.5683 19.8862 19.775C19.9776 19.1088 19.9956 18.2657 19.9991 17.1351H7.47341Z" />
            </g>
          </svg>
        </span>
        <span class="dock-tooltip" aria-hidden="true">Journal</span>
      </a>
    </div>

    <!-- ── Island B: Detached Circular Satellite Action Button ── -->
    <button
      type="button"
      class="dock-satellite-btn"
      id="dockSatelliteBtn"
      aria-label="Quick Connect and Actions"
      aria-expanded="false"
      aria-haspopup="dialog"
    >
      <span class="satellite-icon-slot">
        <svg class="satellite-plus-glyph" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </span>
      <span class="dock-tooltip" aria-hidden="true">Connect</span>
    </button>

  </div>

  <!-- Invisible Dismissal Backdrop -->
  <div class="dock-backdrop" id="dockBackdrop" aria-hidden="true"></div>

</nav>

<style>
  /* ── Fixed Anchor at Viewport Bottom ── */
  .dock-cluster-anchor {
    position: fixed;
    bottom: max(22px, calc(22px + env(safe-area-inset-bottom, 0px)));
    left: 0;
    right: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    user-select: none;
  }

  /* ── Invisible Balancing Spacer (centers Island A precisely on screen) ── */
  .dock-spacer {
    width: 44px;
    height: 44px;
    pointer-events: none;
    opacity: 0;
    flex-shrink: 0;
  }

  @media (max-width: 380px) {
    .dock-spacer {
      display: none;
    }
  }

  /* ── Dual-Island Cluster Layout (8px intentional companion gap) ── */
  .dock-cluster {
    position: relative;
    z-index: 20;
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    animation: dockEntrance 450ms cubic-bezier(0.23, 1, 0.32, 1) 150ms both;
  }

  @keyframes dockEntrance {
    0% {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     ISLAND A: MAIN NAVIGATION CAPSULE (HARMONIZED GLASS)
     Restrained 44px height with architectural hairline borders
     ═══════════════════════════════════════════════════════════════ */
  .dock-main-capsule {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 3.5px;
    border-radius: 9999px;
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 6px 20px -10px rgba(0, 0, 0, 0.14);
    box-sizing: border-box;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  :global([data-theme="dark"]) .dock-main-capsule {
    box-shadow: none;
  }

  /* ── Fluid Sliding Highlight Pill (Aligned with Builds/Designs Switch) ── */
  .dock-sliding-pill {
    position: absolute;
    top: 3.5px;
    bottom: 3.5px;
    left: 0;
    width: 54px;
    border-radius: 9999px;
    background: var(--surface-interactive);
    border: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    will-change: transform, width, opacity;
    box-sizing: border-box;
    transition:
      transform 280ms cubic-bezier(0.23, 1, 0.32, 1),
      width 240ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 160ms ease;
  }

  /* ── Individual Nav Tab ── */
  .dock-tab {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 37px;
    border-radius: 9999px;
    color: var(--text-muted);
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    transition:
      color 160ms var(--ease-smooth-out),
      transform 140ms var(--ease-smooth-out);
    -webkit-tap-highlight-color: transparent;
  }

  .dock-tab.is-active {
    color: var(--text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .dock-tab:hover {
      color: var(--text-primary);
    }
  }

  .dock-tab:active {
    transform: scale(0.92);
  }

  .dock-tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .dock-tab:hover .dock-tab-icon {
      transform: scale(1.06);
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     ISLAND B: DETACHED CIRCULAR SATELLITE BUTTON (HARMONIZED)
     Exact matching 44px height, solid 100% surface & hairline border
     ═══════════════════════════════════════════════════════════════ */
  .dock-satellite-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 6px 20px -10px rgba(0, 0, 0, 0.14);
    color: var(--text-primary);
    cursor: pointer;
    padding: 0;
    box-sizing: border-box;
    transition:
      color 160ms ease,
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 200ms ease,
      background-color 200ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  :global([data-theme="dark"]) .dock-satellite-btn {
    box-shadow: none;
    color: var(--text-secondary);
  }

  @media (hover: hover) and (pointer: fine) {
    .dock-satellite-btn:hover {
      color: var(--text-primary);
      transform: translateY(-1px);
    }
  }

  .dock-satellite-btn:active {
    transform: scale(0.90);
  }

  .satellite-icon-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 260ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .dock-satellite-btn.is-open .satellite-icon-slot {
    transform: rotate(45deg);
  }

  /* ═══════════════════════════════════════════════════════════════
     QUICK CONNECT & CONTROLS POPOVER SHEET (FLOW 3 + FLOW 2)
     Solid 100% surface with crisp elevation
     ═══════════════════════════════════════════════════════════════ */
  .dock-popover-card {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    width: 250px;
    max-width: calc(100vw - 32px);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 12px 32px -14px rgba(0, 0, 0, 0.16);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 8px) scale(0.96);
    transform-origin: bottom center;
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
    z-index: 30;
  }

  :global([data-theme="dark"]) .dock-popover-card {
    box-shadow: none;
  }

  .dock-popover-card.is-open {
    pointer-events: auto;
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }
  /* 1-Tap Copy Email Row (Completely Borderless) */
  .popover-email-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: var(--surface-subtle);
    border: none;
    border-radius: 9px;
    padding: 7px 10px;
    cursor: pointer;
    transition:
      background-color 160ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 140ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .popover-email-box:hover {
      background: var(--surface-interactive);
    }
  }

  .popover-email-box:active {
    transform: scale(0.98);
  }

  .popover-email-left {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  .popover-glyph {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .email-val {
    font-family: var(--font-sans);
    font-size: 11.5px;
    color: var(--text-primary);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .popover-copy-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .copy-glyph {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: opacity 160ms ease, transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .copy-glyph--copied {
    opacity: 0;
    transform: scale(0.6);
  }

  .popover-email-box.is-copied .copy-glyph--idle {
    opacity: 0;
    transform: scale(0.6);
  }

  .popover-email-box.is-copied .copy-glyph--copied {
    opacity: 1;
    transform: scale(1);
  }

  /* Tools & Utilities Row (Borderless Action Tiles) */
  .popover-tools-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .popover-tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    border-radius: 9px;
    background: var(--surface-subtle);
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 140ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .popover-tool-btn:hover {
      background: var(--surface-interactive);
      color: var(--text-primary);
      transform: translateY(-1px);
    }
  }

  .popover-tool-btn:active {
    transform: scale(0.92);
  }

  .tool-icon-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .theme-icon-sun {
    display: none !important;
  }
  .theme-icon-moon {
    display: block !important;
  }

  :global([data-theme="dark"]) .theme-icon-sun {
    display: block !important;
  }
  :global([data-theme="dark"]) .theme-icon-moon {
    display: none !important;
  }

  /* Backdrop for dismissing popover on outside click */
  .dock-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
  }

  .dock-backdrop.is-active {
    pointer-events: auto;
  }

  /* ── Precision Micro-Tooltips on Hover ── */
  .dock-tooltip {
    position: absolute;
    bottom: calc(100% + 9px);
    left: 50%;
    transform: translate(-50%) scale(0.92);
    transform-origin: bottom center;
    background: var(--surface-raised);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: -0.01em;
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 140ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
    z-index: 100;
  }

  @media (hover: hover) and (pointer: fine) {
    .dock-tab:hover .dock-tooltip,
    .dock-satellite-btn:hover .dock-tooltip {
      opacity: 1;
      transform: translate(-50%) scale(1);
    }
  }

  /* ── Reduced Motion ── */
  @media (prefers-reduced-motion: reduce) {
    .dock-cluster,
    .dock-sliding-pill,
    .dock-tab,
    .dock-satellite-btn,
    .dock-popover-card {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  function initDualIslandDock() {
    const mainCapsule = document.querySelector<HTMLElement>('[data-dock-main-capsule]');
    const pill = document.querySelector<HTMLElement>('[data-dock-sliding-pill]');
    const tabs = document.querySelectorAll<HTMLElement>('[data-dock-tab]');
    const satelliteBtn = document.getElementById('dockSatelliteBtn');
    const popover = document.getElementById('dockPopover');
    const backdrop = document.getElementById('dockBackdrop');
    const emailBox = document.querySelector<HTMLElement>('[data-popover-copy-email]');
    const themeToggleBtn = document.querySelector<HTMLButtonElement>('[data-popover-theme-toggle]');

    if (!mainCapsule || !pill || tabs.length === 0) return;

    let activeTab: HTMLElement | null = null;
    const path = window.location.pathname;
    // Inner pages pin their own tab instead of using the homepage scroll spy
    const pinnedTab = path.startsWith('/about') ? 'about' : path.startsWith('/journal') ? 'journal' : null;
    const isSubPage = pinnedTab !== null;

    // ── 1. Determine Active Tab ──
    if (isSubPage) {
      activeTab = document.querySelector<HTMLElement>(`[data-dock-tab="${pinnedTab}"]`);
    } else {
      const hash = window.location.hash.replace('#', '');
      if (hash) {
        activeTab = document.querySelector<HTMLElement>(`[data-dock-tab="${hash}"]`);
      }
      if (!activeTab) {
        activeTab = document.querySelector<HTMLElement>('[data-dock-tab="projects"]');
      }
    }

    function movePillTo(targetEl: HTMLElement, immediate = false) {
      if (!pill || !mainCapsule || !targetEl) return;
      // targetEl.offsetLeft & offsetWidth are pure layout coordinates immune to scale transforms
      const left = targetEl.offsetLeft;
      const width = targetEl.offsetWidth;

      if (width <= 0) return;

      if (immediate) {
        pill.style.transition = 'none';
      } else {
        pill.style.transition = 'transform 280ms cubic-bezier(0.23, 1, 0.32, 1), width 240ms cubic-bezier(0.23, 1, 0.32, 1), opacity 160ms ease';
      }

      pill.style.transform = `translateX(${left}px)`;
      pill.style.width = `${width}px`;
      pill.style.opacity = '1';
    }

    function setActive(newActiveEl: HTMLElement | null, immediate = false) {
      if (!newActiveEl) return;
      activeTab = newActiveEl;
      tabs.forEach((tab) => tab.classList.remove('is-active'));
      activeTab.classList.add('is-active');
      movePillTo(activeTab, immediate);
    }

    // Always align pill on init or view-transition swap
    if (activeTab) {
      setActive(activeTab, true);
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (activeTab) movePillTo(activeTab, true);
        });
      });
    }

    // Prevent duplicate event listener bindings on repeated Astro navigations
    if (mainCapsule.dataset.bound === 'true') {
      return;
    }
    mainCapsule.dataset.bound = 'true';

    // ── 2. Magnetic Hover & Smooth Navigation ──
    let isClickScrolling = false;
    let clickScrollTimer: ReturnType<typeof setTimeout> | null = null;

    tabs.forEach((tab) => {
      tab.addEventListener('mouseenter', () => {
        movePillTo(tab);
      });

      tab.addEventListener('click', (e) => {
        const href = tab.getAttribute('href');
        if (href && href.startsWith('/#')) {
          const sectionId = href.replace('/#', '');
          const targetSection = document.getElementById(sectionId);
          if (targetSection && !isSubPage) {
            e.preventDefault();
            setActive(tab);

            // Lock scroll spy during smooth scroll so pill doesn't flicker
            isClickScrolling = true;
            if (clickScrollTimer) clearTimeout(clickScrollTimer);
            clickScrollTimer = setTimeout(() => {
              isClickScrolling = false;
            }, 850);

            targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.pushState(null, '', `#${sectionId}`);
          }
        }
      });
    });

    mainCapsule.addEventListener('mouseleave', () => {
      if (activeTab) {
        movePillTo(activeTab);
      }
    });

    // ── 3. Scroll Spy for Homepage Sections ──
    let observer: IntersectionObserver | null = null;

    if (!isSubPage) {
      const sectionIds = ['projects', 'services'];
      const observedSections = sectionIds
        .map((id) => document.getElementById(id))
        .filter(Boolean) as HTMLElement[];

      if (observedSections.length > 0 && typeof IntersectionObserver !== 'undefined') {
        observer = new IntersectionObserver(
          (entries) => {
            if (isClickScrolling) return;

            const visible = entries.filter((e) => e.isIntersecting);
            if (visible.length > 0) {
              const topSection = visible.sort(
                (a, b) => b.intersectionRatio - a.intersectionRatio
              )[0];
              const matchedTab = document.querySelector<HTMLElement>(
                `[data-dock-tab="${topSection.target.id}"]`
              );
              if (matchedTab && matchedTab !== activeTab) {
                setActive(matchedTab);
              }
            }
          },
          {
            rootMargin: '-15% 0px -40% 0px',
            threshold: [0.15, 0.35, 0.6],
          }
        );

        observedSections.forEach((sec) => observer?.observe(sec));
      }
    }

    // ── 4. Scroll Monitoring: Hero Reset & Popover Dismissal ──
    let popoverOpenScrollY = 0;

    const handleWindowScroll = () => {
      // Auto-close popover if user scrolled by more than 35px
      if (popover?.classList.contains('is-open') && Math.abs(window.scrollY - popoverOpenScrollY) > 35) {
        closePopover();
      }

      if (isClickScrolling || isSubPage) return;

      // Reset to Projects (Work) when scrolled to the top hero section
      const projectsSection = document.getElementById('projects');
      const topCutoff = projectsSection ? Math.max(160, projectsSection.offsetTop - 180) : 260;
      if (window.scrollY < topCutoff) {
        const projectsTab = document.querySelector<HTMLElement>('[data-dock-tab="projects"]');
        if (projectsTab && activeTab !== projectsTab) {
          setActive(projectsTab);
        }
      }
    };

    window.addEventListener('scroll', handleWindowScroll, { passive: true });

    // Auto-realign pill on resize or font loading
    let ro: ResizeObserver | null = null;
    if (typeof ResizeObserver !== 'undefined') {
      ro = new ResizeObserver(() => {
        if (activeTab) movePillTo(activeTab, true);
      });
      ro.observe(mainCapsule);
    }

    const handleResize = () => {
      if (activeTab) movePillTo(activeTab, true);
    };
    window.addEventListener('resize', handleResize);

    // ── 5. Quick Connect Satellite Popover Toggle ──
    function closePopover() {
      popover?.classList.remove('is-open');
      satelliteBtn?.classList.remove('is-open');
      satelliteBtn?.setAttribute('aria-expanded', 'false');
      backdrop?.classList.remove('is-active');
    }

    function openPopover() {
      popoverOpenScrollY = window.scrollY;
      popover?.classList.add('is-open');
      satelliteBtn?.classList.add('is-open');
      satelliteBtn?.setAttribute('aria-expanded', 'true');
      backdrop?.classList.add('is-active');
    }

    satelliteBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isOpen = popover?.classList.contains('is-open');
      if (isOpen) {
        closePopover();
      } else {
        openPopover();
      }
    });

    backdrop?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      closePopover();
    });

    popover?.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && popover?.classList.contains('is-open')) {
        closePopover();
      }
    };
    window.addEventListener('keydown', handleKeydown);

    // ── 6. 1-Tap Clipboard Email Copy ──
    if (emailBox) {
      emailBox.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          await navigator.clipboard.writeText('egbobianicyril@gmail.com');
          emailBox.classList.add('is-copied');
          setTimeout(() => {
            emailBox.classList.remove('is-copied');
          }, 2000);
        } catch (err) {
          console.warn('Clipboard write failed:', err);
        }
      });
    }

    // ── 7. Integrated Theme Switcher ──
    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const isDark = document.documentElement.dataset.theme === 'dark';
        const nextTheme = isDark ? 'light' : 'dark';

        document.documentElement.classList.add('theme-switching');
        document.documentElement.dataset.theme = nextTheme;

        try {
          localStorage.setItem('portfolio-theme', nextTheme);
        } catch (err) {
          console.warn('LocalStorage error:', err);
        }

        setTimeout(() => {
          document.documentElement.classList.remove('theme-switching');
        }, 120);
      });
    }

    // Clean up window listeners on Astro page navigation swap
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', handleWindowScroll);
      window.removeEventListener('keydown', handleKeydown);
      window.removeEventListener('resize', handleResize);
      observer?.disconnect();
      if (ro) ro.disconnect();
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDualIslandDock);
  } else {
    initDualIslandDock();
  }
  document.addEventListener('astro:page-load', initDualIslandDock);
</script>
