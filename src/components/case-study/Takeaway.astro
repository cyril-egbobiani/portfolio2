---
// Takeaway.astro — A short callout that lands the point of a section
import BeaconMark from '../BeaconMark.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="cs-block cs-takeaway" data-cs-reveal data-beacon-host>
  <BeaconMark size={28} class="cs-takeaway__beacon" />
  <div>
    <p class="cs-takeaway__title">{title}</p>
    <div class="cs-takeaway__text">
      <slot />
    </div>
  </div>
</aside>
