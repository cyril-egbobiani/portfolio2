---
// Options.astro — Compare the directions you considered. Wrap <Option> panels;
// the script turns them into pill tabs (without JavaScript they stack).
---

<div class="cs-block cs-options" data-cs-options data-cs-reveal>
  <div class="cs-options__tabs" data-cs-options-tabs></div>
  <div class="cs-options__panels">
    <slot />
  </div>
</div>
