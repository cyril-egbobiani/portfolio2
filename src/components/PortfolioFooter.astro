---
// PortfolioFooter.astro — The one footer used on every page: Lagos time and back to top.
// `compact` is the tighter spacing used on reading pages, where the page has
// already ended on its own "Next" link.
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<!-- One footer for every page: Lagos time in mono, and back to top.
     The time is filled in by the script below, so every page shows it the same way. -->
<footer class:list={['site-footer', { 'site-footer--compact': compact }]} id="footer">
  <span class="site-footer__time"><span data-lagos-time></span>WAT (UTC+1)</span>
  <button type="button" class="site-footer__top" data-back-top aria-label="Scroll back to top" title="Back to top">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4"/></svg>
  </button>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 48px;
  }

  /* Reading pages already end on their own links, so less space below */
  .site-footer--compact {
    padding-bottom: 40px;
  }

  .site-footer__time {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .site-footer__top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: var(--surface-card);
    box-shadow: var(--shadow-ring);
    color: var(--text-secondary);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms var(--ease-smooth-out), transform 140ms var(--ease-smooth-out);
  }

  .site-footer__top svg {
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__top:hover { color: var(--text-primary); }
    .site-footer__top:hover svg { transform: translateY(-2px); }
  }

  .site-footer__top:active { transform: scale(0.94); }

  .site-footer__top:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__top,
    .site-footer__top svg { transition: none; }
  }
</style>

<script>
  function updateLagosTime() {
    const timeEls = document.querySelectorAll<HTMLElement>('[data-lagos-time]');
    if (!timeEls.length) return;

    try {
      const now = new Date();
      const timeStr = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Africa/Lagos',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      }).format(now);
      timeEls.forEach((el) => {
        el.textContent = `${timeStr} `;
      });
    } catch {
      timeEls.forEach((el) => {
        el.textContent = '';
      });
    }
  }

  function setupFooter() {
    const backTopBtn = document.querySelector<HTMLButtonElement>('[data-back-top]');
    if (backTopBtn && !backTopBtn.dataset.bound) {
      backTopBtn.dataset.bound = 'true';
      backTopBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      });
    }

    updateLagosTime();
  }

  setupFooter();
  setInterval(updateLagosTime, 10000);
  document.addEventListener('astro:page-load', setupFooter);
</script>
