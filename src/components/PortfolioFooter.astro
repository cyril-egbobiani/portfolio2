---
// PortfolioFooter.astro — Minimalist footer with MingCute back-to-top icon button
---

<footer class="flex flex-col gap-8 pt-4 pb-12 reveal-item" id="footer">
  <!-- Hair-line separator with faded gradient mask -->
  <div class="w-full border-t border-dashed border-[var(--border-subtle)] border-masked-x" role="separator" aria-hidden="true"></div>

  <div class="flex items-center justify-between gap-6">
    <!-- Brand Stamp & Time Zone -->
    <div class="flex items-center">
      <p class="m-0 font-sans text-[14px] text-[var(--text-muted)] tracking-tight flex flex-wrap items-center gap-x-1.5 gap-y-0.5">
        <span class="font-mono text-[14px] text-[var(--text-secondary)] tracking-normal">
          <span data-lagos-time></span>WAT (UTC+1)
        </span>
      </p>
    </div>

    <!-- Right: MingCute Circular Back-to-Top Icon Button -->
    <div class="flex items-center">
      <button
        type="button"
        class="back-top-btn group inline-flex items-center justify-center w-8 h-8 rounded-full bg-[var(--bg-surface)] hover:bg-[var(--bg-surface)] hover:bg-black/10 dark:hover:bg-white/15 text-[var(--text-primary)] transition-all duration-200 active:scale-[0.94] border-none cursor-pointer"
        data-back-top
        aria-label="Scroll back to top"
        title="Back to top"
      >
        <svg class="size-4 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19V5M5 12l7-7 7 7" />
        </svg>
      </button>
    </div>
  </div>
</footer>

<script>
  function updateLagosTime() {
    const timeEls = document.querySelectorAll<HTMLElement>('[data-lagos-time]');
    if (!timeEls.length) return;

    try {
      const now = new Date();
      const timeStr = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Africa/Lagos',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      }).format(now);
      timeEls.forEach((el) => {
        el.textContent = `${timeStr} `;
      });
    } catch {
      timeEls.forEach((el) => {
        el.textContent = '';
      });
    }
  }

  function setupFooter() {
    const backTopBtn = document.querySelector<HTMLButtonElement>('[data-back-top]');
    if (backTopBtn && !backTopBtn.dataset.bound) {
      backTopBtn.dataset.bound = 'true';
      backTopBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      });
    }

    updateLagosTime();
  }

  setupFooter();
  setInterval(updateLagosTime, 10000);
  document.addEventListener('astro:page-load', setupFooter);
</script>
